  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "British Columbia or Alberta"
  }, {
    "@language" : "fr",
    "@value" : "Colombie-Britannique ou Alberta"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "British Columbia or Alberta, whose private-sector privacy Acts are declared substantially similar to PIPEDA."
  }, {
    "@language" : "fr",
    "@value" : "La Colombie-Britannique ou l'Alberta, dont les lois sur la protection des renseignements personnels dans le secteur privé sont déclarées essentiellement similaires à la LPRPDE."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000349"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "4"
  } ],

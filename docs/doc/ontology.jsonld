    "@language" : "en",
    "@value" : "security event"
  }, {
    "@language" : "fr",
    "@value" : "événement de sécurité"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000015"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An observable occurrence in an information system or network that may be relevant to security, such as a failed login or a malware detection. An event can be part of an incident; most events are not."
  }, {
    "@language" : "fr",
    "@value" : "Occurrence observable dans un système d'information ou un réseau qui peut intéresser la sécurité, comme un échec d'ouverture de session ou une détection de logiciel malveillant. Un événement peut faire partie d'un incident; la plupart n'en font pas partie."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],

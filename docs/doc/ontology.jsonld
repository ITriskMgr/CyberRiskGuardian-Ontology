  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An actual occurrence of an adverse event affecting the organisation's assets or information, including a confidentiality incident under Loi 25."
  }, {
    "@language" : "fr",
    "@value" : "Occurrence réelle d'un événement défavorable touchant les actifs ou l'information de l'organisation, y compris un incident de confidentialité au sens de la Loi 25."
  } ],

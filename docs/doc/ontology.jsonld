  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "exception de surveillance"
  }, {
    "@language" : "en",
    "@value" : "monitoring exception"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000541"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record that continuous monitoring, such as a key risk indicator or automated control check, flagged a deviation. It is not an audit finding; it becomes the basis of one only if an audit engagement evaluates it against criteria."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement indiquant qu'une surveillance continue, comme un indicateur clé de risque ou une vérification automatisée, a signalé un écart. Ce n'est pas une constatation d'audit; il n'en devient le fondement que si une mission d'audit l'évalue au regard de critères."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {

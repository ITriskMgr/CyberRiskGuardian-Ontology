    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of the complete set of items, such as transactions, accounts or events over a period, from which a sample is drawn or over which a control is tested."
  }, {
    "@language" : "fr",
    "@value" : "Description de l'ensemble complet des éléments, comme des transactions, des comptes ou des événements sur une période, dans lequel un échantillon est prélevé ou sur lequel une mesure est testée."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],

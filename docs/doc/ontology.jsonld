  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of a notification or escalation about an incident to a stated audience, such as management, affected persons, customers or a regulator, with when it was sent and what it covered."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement d'un avis ou d'une transmission à un niveau supérieur concernant un incident, adressé à un public précisé, comme la direction, les personnes concernées, des clients ou une autorité, avec la date d'envoi et ce qu'il couvrait."
  } ],

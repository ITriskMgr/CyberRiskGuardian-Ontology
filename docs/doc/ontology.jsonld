}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001117",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "action de réponse"
  }, {
    "@language" : "en",
    "@value" : "response action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directive that defines a kind of action a playbook may take, such as disabling an account, isolating a host or blocking a domain, with its risk class and the approval it needs. It is the definition, not an execution."
  }, {
    "@language" : "fr",
    "@value" : "Directive qui définit un type d'action qu'un guide peut entreprendre, comme désactiver un compte, isoler un hôte ou bloquer un domaine, avec sa classe de risque et l'approbation qu'elle exige. C'est la définition, et non une exécution."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SOAR section 2 (ResponseAction); may be related to a D3FEND defensive technique."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "OASIS CACAO Security Playbooks Version 2.0, Committee Specification 01 (2023-11-27)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],

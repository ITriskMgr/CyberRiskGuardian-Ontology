}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001098",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "enregistrement d'événement de sécurité"
  }, {
    "@language" : "en",
    "@value" : "security event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000338"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0001109"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An observation that points to one security event held in an operational store, with the source that emitted it, when it occurred and was recorded, and the profile it was normalised under. It does not carry the event payload."
  }, {
    "@language" : "fr",
    "@value" : "Observation qui renvoie à un événement de sécurité conservé dans un dépôt opérationnel, avec la source qui l'a émis, le moment où il s'est produit et a été enregistré, et le profil selon lequel il a été normalisé. Elle ne contient pas le contenu de l'événement."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2 (SecurityEventReference). The event itself is the existing security event (a process); this is the record of it."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],

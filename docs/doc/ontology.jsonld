    "@language" : "en",
    "@value" : "P1 review group 1 (\"I'll follow your recommendations for all the decisions\", 19:26)"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000890",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "directive review"
  }, {
    "@language" : "fr",
    "@value" : "revue de directive"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000228"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "policy review"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A planned act in which a directive or some of its statements are reviewed, on schedule or after a trigger such as a regulatory change, an incident or an audit finding, ending in a decision to keep, revise or retire them."
  }, {
    "@language" : "fr",
    "@value" : "Acte planifié par lequel une directive ou certains de ses énoncés sont revus, selon le calendrier ou à la suite d'un déclencheur comme un changement réglementaire, un incident ou une constatation d'audit, et qui aboutit à la décision de les maintenir, de les réviser ou de les retirer."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "POL section 4 (PolicyReview, PolicyChangeEvent); CSF 2.0 GV.PO-02; SP 800-53 PL-1 (review and update frequency); ISO/IEC 27002:2022 control 5.1 (cited by number)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 27002:2022, control 5.1 (Policies for information security); identifier cited"
  }, {
    "@language" : "en",
    "@value" : "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "NIST CSF 2.0 (CSWP 29), category GV.PO (Policy), subcategories GV.PO-01 and GV.PO-02"
  }, {
    "@language" : "en",
    "@value" : "NIST SP 800-53 Rev. 5, control PL-1 (Policy and Procedures) and the -1 controls of each family"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],

  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A procedure that sets the steps, conditions, actions and approvals by which a kind of alert or incident is to be handled, manually or by automation, such as a CACAO playbook."
  }, {
    "@language" : "fr",
    "@value" : "Procédure qui fixe les étapes, conditions, actions et approbations selon lesquelles un type d'alerte ou d'incident doit être traité, manuellement ou par automatisation, comme un guide CACAO."
  } ],

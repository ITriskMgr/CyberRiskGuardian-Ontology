  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Kept rigid by decision Q3: defined by kind; relational value moved to AssetValuation (review H4)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)"
  }, {
    "@language" : "en",
    "@value" : "Phase 1 report (8 Oct 2026), section 5 and recorded decisions"
  } ],

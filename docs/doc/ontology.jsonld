}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000900",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "provision version"
  }, {
    "@language" : "fr",
    "@value" : "version de disposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of the wording of a provision as in force over a stated period, kept when an amendment changes that wording, so that earlier assessments can be reproduced against the text that applied then."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement du libellé d'une disposition tel qu'il était en vigueur pendant une période donnée, conservé lorsqu'une modification change ce libellé, afin que les évaluations antérieures puissent être reproduites au regard du texte alors applicable."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Decision D5 (a): versions stay at instrument level; a provision version is recorded only when an amendment changes the wording."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {

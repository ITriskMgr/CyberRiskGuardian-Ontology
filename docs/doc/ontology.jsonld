  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An information, software, hardware, network, service or facility entity of a kind used to process, store, transmit or protect information or to deliver services; whether and how much a given organisation values it is recorded in an asset valuation."
  }, {
    "@language" : "fr",
    "@value" : "Entité informationnelle, logicielle, matérielle, réseau, de service ou d'installation d'un type utilisé pour traiter, stocker, transmettre ou protéger de l'information ou pour fournir des services; la valeur qu'une organisation donnée lui accorde est consignée dans une évaluation d'actif."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],

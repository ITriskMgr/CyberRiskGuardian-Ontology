}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000527",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "control deficiency"
  }, {
    "@language" : "fr",
    "@value" : "déficience de contrôle"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record that the design, implementation or operation of an existing control measure does not allow it to meet its objective, identified by a control assessment, with its severity. Unlike a control gap, which describes an expected control that is absent or inadequate (often in a risk scenario), a deficiency is an assessed result about a measure in place."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement indiquant que la conception, la mise en œuvre ou le fonctionnement d'une mesure appliquée existante ne lui permet pas d'atteindre son objectif, relevé par une évaluation de mesure, avec sa gravité. Contrairement à un écart de contrôle, qui décrit un contrôle attendu absent ou insuffisant (souvent dans un scénario de risque), une déficience est un résultat d'évaluation portant sur une mesure en place."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "GAPS D05 (deficiency). Distinguished from the 0.1.0 control gap in the definition (independent review, 2026-10-11)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-11"
  } ],
  "https://w3id.org/crgo/CRGO_0000291" : [ {
    "@value" : "0.9.0"
  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "GRCA review item 2"
  } ]
}, {

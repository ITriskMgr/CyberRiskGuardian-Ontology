  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An analytical hypothesis that a stated adversary behaviour may be present in the organisation's environment, put forward to direct a threat hunt."
  }, {
    "@language" : "fr",
    "@value" : "Hypothèse explicative selon laquelle un comportement adverse donné pourrait être présent dans l'environnement de l'organisation, avancée pour orienter une chasse aux menaces."
  } ],

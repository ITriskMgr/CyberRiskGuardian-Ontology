}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001097",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "source de télémétrie"
  }, {
    "@language" : "en",
    "@value" : "telemetry source"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "log source"
  }, {
    "@language" : "fr",
    "@value" : "source de journaux"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of a product, service or device configured to send security logs or events to an organisation's monitoring, with the asset it runs on, the kinds of data it sends and how they are collected."
  }, {
    "@language" : "fr",
    "@value" : "Description d'un produit, d'un service ou d'un appareil configuré pour transmettre des journaux ou des événements de sécurité à la surveillance d'une organisation, avec l'actif sur lequel il fonctionne, les types de données qu'il transmet et leur mode de collecte."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2 (TelemetrySource). A record about the source, not the asset itself, so that a log-producing asset is not reclassified."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "MITRE ATT&CK Enterprise 19.2: detection strategies, analytics and data components (STIX bundle enterprise-attack.json)"
  } ],

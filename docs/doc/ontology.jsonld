  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of the usual behaviour of a user, account, host or service over a stated period, against which deviations are measured. CRGO holds its metadata, not the profile data."
  }, {
    "@language" : "fr",
    "@value" : "Description du comportement habituel d'un utilisateur, d'un compte, d'un hôte ou d'un service pendant une période donnée, à partir de laquelle les écarts sont mesurés. CRGO en conserve les métadonnées, et non les données du profil."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],

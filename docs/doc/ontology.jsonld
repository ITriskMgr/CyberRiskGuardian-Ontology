    "@language" : "en",
    "@value" : "Person"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An Animal that is a member of the species Homo sapiens."
  } ]
}, {
  "@id" : "https://www.commoncoreontologies.org/ont00001808",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is about"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."
  } ]
} ]
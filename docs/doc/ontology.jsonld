  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "instrument juridique"
  }, {
    "@language" : "en",
    "@value" : "legal instrument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#changeNote" : [ {
    "@language" : "en",
    "@value" : "0.10.0 (2026-10-12): definition widened to contracts and directives to be transposed, with the new instrument kinds."
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A statute, regulation, regulatory guideline, directive to be transposed or binding contract taken as a whole, identified by its official citation or reference, with its jurisdiction and the dates of its publication, coming into force, application and consolidation. Its provisions are the concepts of the corresponding CRGO vocabulary or, for an organisation's contracts, its own clauses."
  }, {
    "@language" : "fr",
    "@value" : "Loi, règlement, ligne directrice réglementaire, directive à transposer ou contrat contraignant pris dans son ensemble, identifié par sa citation officielle ou sa référence, avec sa juridiction et les dates de sa publication, de son entrée en vigueur, de sa prise d'effet et de sa mise à jour. Ses dispositions sont les concepts du vocabulaire CRGO correspondant ou, pour les contrats d'une organisation, leurs propres clauses."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],

  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "analyseur syntaxique"
  }, {
    "@language" : "en",
    "@value" : "parser"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A versioned specification of how raw records of a telemetry source are converted into structured events under a normalisation profile."
  }, {
    "@language" : "fr",
    "@value" : "Spécification versionnée de la façon dont les enregistrements bruts d'une source de télémétrie sont convertis en événements structurés selon un profil de normalisation."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {

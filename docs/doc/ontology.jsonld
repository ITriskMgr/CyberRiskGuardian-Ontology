  } ],
  "http://www.w3.org/2004/02/skos/core#changeNote" : [ {
    "@language" : "en",
    "@value" : "0.10.0 (2026-10-12): alternative labels 'policy requirement' / 'exigence de politique' added (POL PolicyRequirement)."
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A single rule within a policy, stated so that compliance with it can be assessed, such as 'privileged access is reviewed every quarter'."
  }, {
    "@language" : "fr",
    "@value" : "Règle unique d'une politique, formulée de manière à pouvoir en évaluer le respect, comme « les accès privilégiés sont revus chaque trimestre »."
  } ],

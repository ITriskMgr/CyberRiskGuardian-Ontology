  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of how much an entity matters to a given organisation, recording its criticality, its confidentiality, integrity and availability requirements, its owner and whether it is a crown jewel."
  }, {
    "@language" : "fr",
    "@value" : "Description de l'importance d'une entité pour une organisation donnée, qui consigne sa criticité, ses exigences de confidentialité, d'intégrité et de disponibilité, son propriétaire et son statut de joyau de la couronne."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000064"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Carries the context-dependent part of 'asset' so Asset can stay rigid (decision Q3); maps CRG CROWN."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",

  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "attestation"
  }, {
    "@language" : "fr",
    "@value" : "attestation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A dated declaration by an identified agent about a stated subject and scope, such as having read a policy version or that a requirement is met. It records what the agent declares, not what was verified."
  }, {
    "@language" : "fr",
    "@value" : "Déclaration datée d'un agent identifié portant sur un objet et un périmètre précisés, comme le fait d'avoir lu une version de politique ou le fait qu'une exigence soit respectée. Elle consigne ce que l'agent déclare, et non ce qui a été vérifié."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Improvement I2: common parent of policy acknowledgement and compliance attestation; disjoint from compliance determination and audit conclusion."
  } ],

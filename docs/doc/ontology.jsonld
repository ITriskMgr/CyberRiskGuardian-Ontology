  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A dated record of an assessor's judgement of whether the evidence gathered is sufficient, relevant, current and in scope for a stated objective or criterion."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement daté du jugement d'un évaluateur sur le caractère suffisant, pertinent, actuel et conforme au périmètre des preuves recueillies pour un objectif ou un critère donné."
  } ],

  }, {
    "@id" : "https://www.commoncoreontologies.org/ont00001163"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A dated record that a stated source reported a value or category for an entity at a stated time, such as the EPSS score of a vulnerability on a given day. An observation reports what a source said; it is not an estimate made for an assessment."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement daté indiquant qu'une source donnée a rapporté une valeur ou une catégorie pour une entité à un moment donné, comme le score EPSS d'une vulnérabilité un jour donné. Une observation rapporte ce qu'une source a dit; ce n'est pas une estimation faite pour une appréciation."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000068"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Disjoint from estimate (specification rule 3: separate source facts from model estimates); negative fixture tests it."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"
  }, {
    "@language" : "en",
    "@value" : "W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {

  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A control that an external assurance report assumes the user organisation operates, without which the service provider's controls may not achieve their objectives."
  }, {
    "@language" : "fr",
    "@value" : "Mesure que le rapport d'assurance externe suppose exploitée par l'organisation utilisatrice, sans laquelle les mesures du fournisseur de services pourraient ne pas atteindre leurs objectifs."
  } ],

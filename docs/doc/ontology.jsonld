  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of a consequence an incident had, or is estimated to have had, along one impact dimension, such as hours of service lost or the number of records exposed, with whether it is observed or estimated."
  }, {
    "@language" : "fr",
    "@value" : "Description d'une conséquence qu'un incident a eue, ou est estimé avoir eue, selon une dimension d'impact, comme les heures de service perdues ou le nombre d'enregistrements exposés, en précisant si elle est observée ou estimée."
  } ],

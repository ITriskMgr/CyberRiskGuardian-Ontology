}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001108",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "detection test"
  }, {
    "@language" : "fr",
    "@value" : "essai de détection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000347"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A control assessment in which a detection rule or strategy is exercised under controlled conditions, such as by replaying or simulating the technique, to check that it raises the expected alert."
  }, {
    "@language" : "fr",
    "@value" : "Évaluation de mesure dans laquelle une règle ou une stratégie de détection est mise à l'épreuve dans des conditions contrôlées, par exemple en rejouant ou en simulant la technique, pour vérifier qu'elle déclenche l'alerte attendue."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2 (DetectionTest). Reuses control assessment: test result, assessor, date and evidence (decision S3). It tests one rule or strategy, not the whole control measure: consumers that report a measure's effectiveness leave detection tests out."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],

}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000475",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "analytical hypothesis"
  }, {
    "@language" : "fr",
    "@value" : "hypothèse explicative"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A proposed explanation, such as a suspected cause of a control failure, recorded so that it can be tested against evidence. Until it is tested it is not a fact or a conclusion."
  }, {
    "@language" : "fr",
    "@value" : "Explication proposée, comme la cause présumée de la défaillance d'une mesure, consignée afin d'être vérifiée au regard des preuves. Tant qu'elle n'est pas vérifiée, ce n'est ni un fait ni une conclusion."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "GRCA section 10 (observed versus hypothesised cause); GAPS D08. Distinct from assumption: an assumption is taken as true for an estimate, a hypothesis is put forward to be tested."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"
  }, {
    "@language" : "en",
    "@value" : "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-11"
  } ],
  "https://w3id.org/crgo/CRGO_0000291" : [ {
    "@value" : "0.9.0"
  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "GRCA review item 5 (all terms, including the GRCA additions)"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000476",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "distribution d'une estimation"
  }, {
    "@language" : "en",
    "@value" : "estimate distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of the probability distribution that expresses the uncertainty of an estimate, giving its family (for example triangular or lognormal) and its parameters."
  }, {
    "@language" : "fr",
    "@value" : "Description de la loi de probabilité qui exprime l'incertitude d'une estimation, indiquant sa famille (par exemple triangulaire ou lognormale) et ses paramètres."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "GAPS D08 (distributions); estimates already carry bounds, sample size and confidence (0.8.0)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"
  } ],

}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001104",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "indicateur de menace"
  }, {
    "@language" : "en",
    "@value" : "threat indicator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "indicateur de compromission"
  }, {
    "@language" : "en",
    "@value" : "indicator of compromise"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of a pattern, such as a file hash, address, domain or behaviour, that a source states may indicate malicious activity, with its validity period, its confidence as given by the source and how that confidence is defined. A match with an indicator is not by itself an incident or an attribution."
  }, {
    "@language" : "fr",
    "@value" : "Description d'un motif, comme une empreinte de fichier, une adresse, un domaine ou un comportement, qu'une source présente comme pouvant indiquer une activité malveillante, avec sa période de validité, la confiance indiquée par la source et la définition de cette confiance. Une correspondance avec un indicateur ne constitue pas à elle seule un incident ni une attribution."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM sections 1 and 2 (no confirmation or attribution from an indicator match); STIX 2.1 indicator."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",

  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "P1 review group 2"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000902",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "regulatory submission"
  }, {
    "@language" : "fr",
    "@value" : "transmission réglementaire"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "déclaration à l'autorité"
  }, {
    "@language" : "en",
    "@value" : "regulatory filing"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of a notice, filing or report sent to an authority under an obligation, with when it was submitted, its state and the receipt or acknowledgement obtained."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement d'un avis, d'un dépôt ou d'un rapport transmis à une autorité en vertu d'une obligation, avec sa date de transmission, son état et l'accusé de réception obtenu."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "CMP section 4 (RegulatorySubmission); links to breach reportability assessments for incident notices."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  } ],

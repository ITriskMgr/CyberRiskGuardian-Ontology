    "@language" : "en",
    "@value" : "GRCA review item 5 (all terms, including the GRCA additions)"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000477",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "analytical result"
  }, {
    "@language" : "fr",
    "@value" : "résultat analytique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of a result computed outside CRGO by a named model and version, such as a CyberRiskGuardian risk calculation, with the inputs it used and when it was computed. CRGO stores it as a proposed risk estimate and never derives it by reasoning."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement d'un résultat calculé hors de CRGO par un modèle et une version nommés, comme un calcul de risque de CyberRiskGuardian, avec les données d'entrée utilisées et la date du calcul. CRGO le conserve comme estimation de risque proposée et ne le déduit jamais par raisonnement."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",

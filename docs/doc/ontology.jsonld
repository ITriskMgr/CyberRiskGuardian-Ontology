    "@language" : "en",
    "@value" : "detection gap"
  }, {
    "@language" : "fr",
    "@value" : "lacune de détection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000018"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A control gap finding that a technique, risk scenario or asset has no adequate detection, or that the telemetry a detection needs is missing or unhealthy."
  }, {
    "@language" : "fr",
    "@value" : "Constat de lacune de contrôle selon lequel une technique, un scénario de risque ou un actif n'est pas adéquatement détecté, ou selon lequel la télémétrie nécessaire à une détection est absente ou défaillante."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2 (DetectionGap). Reuses control gap finding and 'has control gap' (decision S3)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],

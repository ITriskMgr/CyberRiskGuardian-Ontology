  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000910",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit observation"
  }, {
    "@language" : "fr",
    "@value" : "observation d'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A preliminary record of a condition noted during an engagement that has not yet been validated against criteria and evidence. It is not a finding and carries no audit conclusion."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement préliminaire d'une situation relevée pendant une mission, qui n'a pas encore été validée au regard des critères et des preuves. Ce n'est pas une constatation et elle ne porte aucune conclusion d'audit."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Decision D8: disjoint from audit finding; a validated observation is linked to the finding it became."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {

  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2 (HuntingHypothesis). Until tested it is not a finding (0.9.0 analytical hypothesis)."
  } ],

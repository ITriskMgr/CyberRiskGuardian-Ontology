}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000340",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "EPSS observation"
  }, {
    "@language" : "fr",
    "@value" : "observation EPSS"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000338"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An observation of the Exploit Prediction Scoring System score of a published vulnerability on a given day: FIRST's estimated probability that the vulnerability is exploited in the wild in the following 30 days, with its percentile among all scored vulnerabilities. It concerns the vulnerability in general, not its presence in any organisation, and it is not the likelihood of a risk scenario."
  }, {
    "@language" : "fr",
    "@value" : "Observation du score de l'Exploit Prediction Scoring System d'une vulnérabilité publiée un jour donné : la probabilité, estimée par FIRST, que la vulnérabilité soit exploitée dans les 30 jours suivants, avec son centile parmi toutes les vulnérabilités évaluées. Elle porte sur la vulnérabilité en général, non sur sa présence dans une organisation, et ce n'est pas la vraisemblance d'un scénario de risque."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000068"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Replaces the 0.8.0 EPSS likelihood estimates (decision D4); specification section 5 (do not conflate probability of exploitation with scenario likelihood)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"
  }, {
    "@language" : "en",
    "@value" : "FIRST, Exploit Prediction Scoring System: model documentation and data (first.org/epss)"
  } ],

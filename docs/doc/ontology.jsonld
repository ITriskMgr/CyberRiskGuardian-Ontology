  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000901",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "compliance deadline"
  }, {
    "@language" : "fr",
    "@value" : "échéance de conformité"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of when an obligation must be met, either on a calendar date or within a period counted from a triggering event, such as 72 hours after becoming aware of a breach, with how the date is computed."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement du moment où une obligation doit être respectée, soit à une date fixe, soit dans un délai compté à partir d'un événement déclencheur, comme 72 heures après la prise de connaissance d'une atteinte, avec le mode de calcul de la date."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "CMP sections 4 and 8; generalises the incident-specific 'notification due by'."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-12"
  } ],

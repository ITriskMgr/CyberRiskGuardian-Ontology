  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "autorité de réglementation"
  }, {
    "@language" : "en",
    "@value" : "regulatory authority"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00001180"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "organisme de réglementation"
  }, {
    "@language" : "en",
    "@value" : "regulator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An organisation with legal power to issue, supervise or enforce legal instruments in a jurisdiction, such as a data protection authority."
  }, {
    "@language" : "fr",
    "@value" : "Organisation ayant le pouvoir légal d'édicter, de surveiller ou de faire appliquer des instruments juridiques dans une juridiction, comme une autorité de protection des données."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "CMP section 4 (RegulatoryAuthority). Until now CRGO recorded issuers only as text on source records."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  } ],

  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit charter"
  }, {
    "@language" : "fr",
    "@value" : "charte d'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "charte d'audit interne"
  }, {
    "@language" : "en",
    "@value" : "internal audit charter"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directive approved by the governing body that sets the internal audit function's purpose, authority, responsibilities and reporting lines."
  }, {
    "@language" : "fr",
    "@value" : "Directive approuvée par l'organe de gouvernance qui fixe la mission, les pouvoirs, les responsabilités et les liens hiérarchiques de la fonction d'audit interne."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {

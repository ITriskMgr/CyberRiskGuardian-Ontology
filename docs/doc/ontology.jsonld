}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000351",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000348"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Canada (federal legal order)"
  }, {
    "@language" : "fr",
    "@value" : "Canada (ordre juridique fédéral)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Canada as the legal order of federal statutes and regulators. It is the jurisdiction of an instrument, not a place: an organisation's establishment, markets and data subjects are given by a province or territory."
  }, {
    "@language" : "fr",
    "@value" : "Le Canada en tant qu'ordre juridique des lois et autorités fédérales. C'est la juridiction d'un instrument, non un lieu : l'établissement, les marchés et les personnes concernées d'une organisation sont indiqués par une province ou un territoire."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000349"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "2"
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-11"
  } ],
  "https://w3id.org/crgo/CRGO_0000291" : [ {
    "@value" : "0.9.0"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000352",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000348"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Canadian province or territory without substantially similar privacy law"
  }, {
    "@language" : "fr",
    "@value" : "province ou territoire canadien sans loi essentiellement similaire"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A Canadian province or territory other than Québec, British Columbia and Alberta, whose private sector is not covered by a provincial law declared substantially similar to PIPEDA."
  }, {
    "@language" : "fr",
    "@value" : "Province ou territoire canadien autre que le Québec, la Colombie-Britannique et l'Alberta, dont le secteur privé n'est pas régi par une loi provinciale déclarée essentiellement similaire à la LPRPDE."
  } ],

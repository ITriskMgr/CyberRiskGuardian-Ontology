    "@language" : "en",
    "@value" : "Planned Act"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An Act in which at least one Agent plays a causative role and which is prescribed by some Directive Information Content Entity held by at least one of the Agents."
  } ]
}, {
  "@id" : "https://www.commoncoreontologies.org/ont00000476",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],

  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "operating effectiveness assessment"
  }, {
    "@language" : "fr",
    "@value" : "évaluation de l'efficacité opérationnelle"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000347"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A control assessment that tests whether a control measure operated as designed throughout a stated period, over a stated population or sample."
  }, {
    "@language" : "fr",
    "@value" : "Évaluation de mesure qui vérifie si une mesure appliquée a fonctionné comme prévu pendant toute une période donnée, sur une population ou un échantillon donné."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {

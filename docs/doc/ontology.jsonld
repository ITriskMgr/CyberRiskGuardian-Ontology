  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A dated record of whether an incident must be reported to a regulator or to affected persons under a stated provision, such as a confidentiality incident presenting a risk of serious injury under Loi 25 or a personal data breach under the GDPR."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement daté indiquant si un incident doit être déclaré à une autorité ou aux personnes concernées en vertu d'une disposition donnée, comme un incident de confidentialité présentant un risque de préjudice sérieux selon la Loi 25 ou une violation de données à caractère personnel selon le RGPD."
  } ],

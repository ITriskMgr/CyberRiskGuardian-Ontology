  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A role borne by an agent or artifact in virtue of which it may initiate a threat event, intentionally or not."
  }, {
    "@language" : "fr",
    "@value" : "Rôle porté par un agent ou un artefact en vertu duquel il peut déclencher un événement de menace, intentionnellement ou non."

  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000903",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "dispense réglementaire"
  }, {
    "@language" : "en",
    "@value" : "regulatory exemption"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directive issued by an authority that relieves an organisation, for a stated scope and period, from an obligation or part of it, on a stated legal basis. Only an authority with power over the obligation can grant it; an internal approval cannot."
  }, {
    "@language" : "fr",
    "@value" : "Directive émise par une autorité qui dispense une organisation, pour un périmètre et une période donnés, de tout ou partie d'une obligation, sur un fondement juridique précisé. Seule une autorité compétente à l'égard de l'obligation peut l'accorder; une approbation interne ne le peut pas."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "CMP sections 4 and 9 (ComplianceException: internal approval does not remove a binding duty). Distinct from policy exception, which cannot waive law."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {

}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000892",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "accusé de lecture de politique"
  }, {
    "@language" : "en",
    "@value" : "policy acknowledgement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000891"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An attestation by a person that they have received and read an exact policy version that applies to them. Acknowledging a policy is not understanding or complying with it."
  }, {
    "@language" : "fr",
    "@value" : "Attestation par laquelle une personne déclare avoir reçu et lu une version précise d'une politique qui s'applique à elle. Prendre connaissance d'une politique n'équivaut ni à la comprendre ni à la respecter."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "POL sections 4 and 7 (acknowledged is not understood or compliant). Instances belong in organisation graphs or the application (POL section 1: no employee PII in CRGO)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"
  } ],

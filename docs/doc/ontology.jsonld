    "@value" : "threat event type"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of a kind of event that, if it occurred, could adversely affect assets, such as credential phishing, ransomware encryption or a server-room fire."
  }, {
    "@language" : "fr",
    "@value" : "Description d'un type d'événement qui, s'il se produisait, pourrait porter atteinte à des actifs, comme l'hameçonnage d'identifiants, le chiffrement par rançongiciel ou l'incendie d'une salle des serveurs."
  } ],

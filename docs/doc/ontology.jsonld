  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000909",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit workpaper"
  }, {
    "@language" : "fr",
    "@value" : "feuille de travail d'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "dossier de travail"
  }, {
    "@language" : "en",
    "@value" : "working paper"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record prepared by an auditor that documents work performed, evidence examined and conclusions reached in an engagement, with who prepared it and who reviewed it. CRGO holds its metadata, not its content."
  }, {
    "@language" : "fr",
    "@value" : "Document établi par un auditeur qui consigne les travaux effectués, les preuves examinées et les conclusions tirées dans une mission, avec son auteur et son réviseur. CRGO en conserve les métadonnées, et non le contenu."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "AUD sections 5 and 9 (self-review check); GIAS Standard 14.6 (Engagement Documentation); ITAF 1204 (Performance and Supervision); cited by number."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"
  }, {
    "@language" : "en",
    "@value" : "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"
  } ],

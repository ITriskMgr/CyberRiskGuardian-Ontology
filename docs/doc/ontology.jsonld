}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000342",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "rôle de fournisseur"
  }, {
    "@language" : "en",
    "@value" : "supplier role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000023"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "third party"
  }, {
    "@language" : "fr",
    "@value" : "tiers"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A role of an organisation that supplies goods, services or the operation of assets to another organisation, which comes to depend on it."
  }, {
    "@language" : "fr",
    "@value" : "Rôle d'une organisation qui fournit des biens, des services ou l'exploitation d'actifs à une autre organisation, laquelle en vient à en dépendre."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000068"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Anti-rigid (OntoClean): an organisation is a supplier only relative to a customer, so modelled as a BFO role borne by the organisation."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"

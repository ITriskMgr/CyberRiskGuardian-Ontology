  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A condition of the organisation, its environment or its systems that increases or decreases the likelihood that a threat event causes harm, without being a weakness of a specific control."
  }, {
    "@language" : "fr",
    "@value" : "Condition de l'organisation, de son environnement ou de ses systèmes qui augmente ou diminue la probabilité qu'un événement de menace cause un préjudice, sans être une faiblesse d'un contrôle précis."
  } ],

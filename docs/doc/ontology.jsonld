  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "dossier de sécurité"
  }, {
    "@language" : "en",
    "@value" : "security case"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A planned act in which analysts examine one or more alerts, events or reports to establish what happened, whether it is an incident and what its scope is, with its case status as last recorded."
  }, {
    "@language" : "fr",
    "@value" : "Acte planifié par lequel des analystes examinent une ou plusieurs alertes, événements ou signalements pour établir ce qui s'est passé, s'il s'agit d'un incident et quelle en est l'étendue, avec l'état du dossier selon le dernier enregistrement."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SOAR section 2 (SecurityInvestigation). The incident itself is the existing incident; its confirmation is the existing incident confirmation (decision S5)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3"
  } ],

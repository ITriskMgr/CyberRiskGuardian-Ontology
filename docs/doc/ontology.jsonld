    "@language" : "fr",
    "@value" : "révoquée le"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Gives when an approval decision was revoked."
  }, {
    "@language" : "fr",
    "@value" : "Indique quand une décision d'approbation a été révoquée."
  } ],

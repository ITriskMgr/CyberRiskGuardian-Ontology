}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000908",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit plan entry"
  }, {
    "@language" : "fr",
    "@value" : "entrée du plan d'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An entry of an audit plan for one candidate or planned engagement, with its priority rationale, its state (proposed, approved, deferred, cancelled or completed) and, when deferred or cancelled, the reason and who authorised it."
  }, {
    "@language" : "fr",
    "@value" : "Entrée d'un plan d'audit pour une mission envisagée ou prévue, avec la justification de sa priorité, son état (proposée, approuvée, reportée, annulée ou réalisée) et, en cas de report ou d'annulation, le motif et l'auteur de l'autorisation."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "AUD sections 5 and 7; needed by AUD CQ-09 (changes between plan versions and who authorised deferrals)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"
  } ],

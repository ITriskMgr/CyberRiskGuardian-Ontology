}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000351",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000348"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Canada (federal legal order)"
  }, {
    "@language" : "fr",
    "@value" : "Canada (ordre juridique fédéral)"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Canada as the legal order of federal statutes and regulators. It is the jurisdiction of an instrument, not a place: an organisation's establishment, markets and data subjects are given by a province or territory."
  }, {
    "@language" : "fr",
    "@value" : "Le Canada en tant qu'ordre juridique des lois et autorités fédérales. C'est la juridiction d'un instrument, non un lieu : l'établissement, les marchés et les personnes concernées d'une organisation sont indiqués par une province ou un territoire."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000349"
  } ],

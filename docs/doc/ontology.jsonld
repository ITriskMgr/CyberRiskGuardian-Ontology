}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000907",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit methodology"
  }, {
    "@language" : "fr",
    "@value" : "méthodologie d'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directive that sets how an audit function plans, performs and reports engagements, including its sampling and rating rules, identified by version."
  }, {
    "@language" : "fr",
    "@value" : "Directive qui fixe la façon dont une fonction d'audit planifie, réalise et communique ses missions, y compris ses règles d'échantillonnage et de cotation, désignée par sa version."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "AUD section 5 (AuditMethodology); GIAS Standard 9.3 (cited by number)."
  } ],

}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001118",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "approval gate"
  }, {
    "@language" : "fr",
    "@value" : "point d'approbation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directive that an action, or a class of actions, may be executed only after a stated authority has approved it, or under a stated pre-authorisation, for example when it targets a critical asset."
  }, {
    "@language" : "fr",
    "@value" : "Directive selon laquelle une action, ou une classe d'actions, ne peut être exécutée qu'après l'approbation d'une autorité précisée, ou en vertu d'une préautorisation précisée, par exemple lorsqu'elle vise un actif critique."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SOAR sections 2 and 5."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-13"
  } ],
  "https://w3id.org/crgo/CRGO_0000291" : [ {
    "@value" : "0.10.0"
  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "0.10.0 final review group 2"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001119",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "approval decision"
  }, {
    "@language" : "fr",
    "@value" : "décision d'approbation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000504"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A decision record granting or denying the execution of a response action, or pre-authorising a stated class of actions for a stated scope and period, by an identified authority."
  }, {
    "@language" : "fr",
    "@value" : "Relevé de décision qui accorde ou refuse l'exécution d'une action de réponse, ou qui préautorise une classe d'actions précisée pour un périmètre et une période donnés, par une autorité identifiée."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SOAR section 2 (ApprovalDecision); reuses decision record (decision S3). An approval is about one execution or a narrowly scoped pre-authorisation."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-13"
  } ],
  "https://w3id.org/crgo/CRGO_0000291" : [ {
    "@value" : "0.10.0"
  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "0.10.0 final review group 2"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001120",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "automation execution record"
  }, {
    "@language" : "fr",
    "@value" : "enregistrement d'exécution automatisée"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0001121"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of one run of a playbook version: what triggered it, when it started and ended, its status and the investigation or incident it served. The full execution history stays in the operational store."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement d'une exécution d'une version de guide : ce qui l'a déclenchée, son début et sa fin, son état et l'enquête ou l'incident qu'elle a servi. L'historique complet reste dans le dépôt opérationnel."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SOAR section 2 (AutomationExecution)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-13"
  } ],

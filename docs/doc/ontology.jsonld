    "@language" : "fr",
    "@value" : "source de menace"
  }, {
    "@language" : "en",
    "@value" : "threat actor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A role borne by an agent or artifact in virtue of which it may initiate a threat event, intentionally or not."
  }, {
    "@language" : "fr",
    "@value" : "Rôle porté par un agent ou un artefact en vertu duquel il peut déclencher un événement de menace, intentionnellement ou non."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000064"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Role keeps people and organisations rigid; environmental sources are described with ThreatSourceDescription (review M)."
  } ],

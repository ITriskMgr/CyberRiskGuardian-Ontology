}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000912",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "assertion de correspondance"
  }, {
    "@language" : "en",
    "@value" : "mapping assertion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directional statement, subject to review, that a source requirement corresponds to a target requirement in a stated way (exact, full or partial coverage, broader, narrower, related or conflicting), with the editions mapped, the rationale, the confidence, the reviewer and its review state. A mapping is not evidence of compliance."
  }, {
    "@language" : "fr",
    "@value" : "Énoncé orienté, soumis à une revue, selon lequel une exigence source correspond à une exigence cible d'une façon précisée (exacte, couverture totale ou partielle, plus large, plus étroite, liée ou contradictoire), avec les éditions mises en correspondance, la justification, le degré de confiance, le réviseur et l'état de la revue. Une correspondance ne prouve pas la conformité."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"

  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a risk scenario to the entity that would initiate it: the bearer of a threat source role, such as a person, organisation, artifact or natural feature. Use hasThreatSourceDescription when only the kind of source is known."
  }, {
    "@language" : "fr",
    "@value" : "Relie un scénario de risque à l'entité qui le déclencherait : le porteur d'un rôle de source de menace, par exemple une personne, une organisation, un artefact ou un élément naturel. Utiliser hasThreatSourceDescription lorsque seul le type de source est connu."
  } ],

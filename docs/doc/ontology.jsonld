}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000895",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "compliance objective"
  }, {
    "@language" : "fr",
    "@value" : "objectif de conformité"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000010"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A measurable objective that a compliance programme sets itself, such as reviewing every obligation of the register once a year."
  }, {
    "@language" : "fr",
    "@value" : "Objectif mesurable que se fixe un programme de conformité, comme revoir chaque obligation du registre une fois par année."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"

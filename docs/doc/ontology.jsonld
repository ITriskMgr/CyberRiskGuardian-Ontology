    "@value" : "0.10.0 final review group 2"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001121",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "action execution record"
  }, {
    "@language" : "fr",
    "@value" : "enregistrement d'exécution d'action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of one attempt to carry out a response action on a target, with its time, status, the approval relied on and the evidence it produced."
  }, {
    "@language" : "fr",
    "@value" : "Enregistrement d'une tentative d'exécution d'une action de réponse sur une cible, avec son moment, son état, l'approbation invoquée et les preuves produites."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {

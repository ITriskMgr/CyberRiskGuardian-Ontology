    "@language" : "en",
    "@value" : "0.10.0 final review group 1 (\"go ahead\", 02:42)"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001099",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "normalisation profile"
  }, {
    "@language" : "fr",
    "@value" : "profil de normalisation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "normalization profile"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A versioned specification of how the fields of a telemetry source are mapped to a common event schema, such as an OCSF event class, so that events from different sources can be compared."
  }, {
    "@language" : "fr",
    "@value" : "Spécification versionnée de la façon dont les champs d'une source de télémétrie sont mis en correspondance avec un schéma d'événements commun, comme une classe d'événements OCSF, afin que les événements de sources différentes puissent être comparés."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2; OCSF 1.9.0. Mapping to an OCSF class is a correspondence, not an equivalence of taxonomies (SIEM section 5)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "Open Cybersecurity Schema Framework (OCSF) 1.9.0, categories and event classes (github.com/ocsf/ocsf-schema, Apache-2.0)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {

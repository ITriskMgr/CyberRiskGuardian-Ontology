  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000911",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit quality review"
  }, {
    "@language" : "fr",
    "@value" : "revue de qualité de l'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000228"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A planned act in which the work of an engagement or of the audit function is evaluated against its methodology and the standards it follows, by a supervisor, an internal quality assessor or an external assessor."
  }, {
    "@language" : "fr",
    "@value" : "Acte planifié par lequel les travaux d'une mission ou de la fonction d'audit sont évalués au regard de sa méthodologie et des normes qu'elle suit, par un superviseur, un évaluateur interne de la qualité ou un évaluateur externe."
  } ],

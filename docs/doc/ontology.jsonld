    "@language" : "en",
    "@value" : "data asset"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "fr",
    "@value" : "Actif constitué de contenu informationnel, comme un jeu de données, un ensemble de dossiers ou un document, indépendamment du support qui le porte."
  }, {
    "@language" : "en",
    "@value" : "An asset that is information content, such as a data set, a record collection or a document, independent of the medium that carries it."
  } ],

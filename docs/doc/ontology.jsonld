    "@value" : "incident"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000015"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0001112"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "incident de confidentialité"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An actual occurrence of an adverse event affecting the organisation's assets or information, including a confidentiality incident under Loi 25."
  }, {
    "@language" : "fr",
    "@value" : "Occurrence réelle d'un événement défavorable touchant les actifs ou l'information de l'organisation, y compris un incident de confidentialité au sens de la Loi 25."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "Needed for the Loi 25 incident register and history."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)"
  }, {
    "@language" : "en",
    "@value" : "Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents"
  } ],

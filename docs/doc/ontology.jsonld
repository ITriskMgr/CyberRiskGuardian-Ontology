  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A numbered or titled part of a directive version that contains one or more policy statements, used to cite where a statement appears."
  }, {
    "@language" : "fr",
    "@value" : "Partie numérotée ou titrée d'une version de directive qui contient un ou plusieurs énoncés de politique, servant à citer l'emplacement d'un énoncé."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {

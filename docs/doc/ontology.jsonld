    "@value" : "0.10.0"
  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "0.10.0 final review group 1 (\"go ahead\", 02:42)"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001102",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "detection rule"
  }, {
    "@language" : "fr",
    "@value" : "règle de détection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A versioned, deployable specification of the conditions under which events should raise an alert, such as a Sigma rule or a rule in a product's native language, with its status and the telemetry it needs."
  }, {
    "@language" : "fr",
    "@value" : "Spécification versionnée et déployable des conditions dans lesquelles des événements doivent déclencher une alerte, comme une règle Sigma ou une règle dans le langage propre d'un produit, avec son état et la télémétrie dont elle a besoin."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2; Sigma specification v2.1.0. The rule carries out a detective control measure (rule for measure); its effectiveness is shown by detection tests, never assumed."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "Sigma rules specification v2.1.0 (SigmaHQ, 2025-09-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],
  "https://w3id.org/crgo/CRGO_0000289" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000182"
  } ],
  "https://w3id.org/crgo/CRGO_0000290" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-13"
  } ],
  "https://w3id.org/crgo/CRGO_0000291" : [ {
    "@value" : "0.10.0"
  } ],
  "https://w3id.org/crgo/CRGO_0000292" : [ {
    "@language" : "en",
    "@value" : "0.10.0 final review group 1 (\"go ahead\", 02:42)"
  } ]
}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001103",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "correlation rule"
  }, {
    "@language" : "fr",
    "@value" : "règle de corrélation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0001102"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A detection rule whose conditions combine several events or alerts, over a time window or by a shared attribute."
  }, {
    "@language" : "fr",
    "@value" : "Règle de détection dont les conditions combinent plusieurs événements ou alertes, sur une fenêtre de temps ou selon un attribut commun."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM section 2; Sigma correlation rules."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "Sigma rules specification v2.1.0 (SigmaHQ, 2025-09-12)"
  } ],
  "https://w3id.org/crgo/CRGO_0000288" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000181"
  } ],

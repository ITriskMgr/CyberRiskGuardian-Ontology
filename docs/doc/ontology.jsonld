}, {
  "@id" : "https://w3id.org/crgo/CRGO_0001106",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "couverture de détection"
  }, {
    "@language" : "en",
    "@value" : "detection coverage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000853"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A dated statement that a detection strategy or rule covers a technique, a risk scenario or an asset, with its coverage status (untested, validated, degraded or missing) and the tests that support it. Coverage is a claim to be tested, not a guarantee of detection."
  }, {
    "@language" : "fr",
    "@value" : "Énoncé daté selon lequel une stratégie ou une règle de détection couvre une technique, un scénario de risque ou un actif, avec l'état de couverture (non testée, validée, dégradée ou absente) et les essais qui l'étayent. La couverture est une affirmation à vérifier, et non une garantie de détection."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SIEM sections 2 and 5 (coverage needs a rule or strategy, a scenario or technique, and validation metadata)."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"
  } ],

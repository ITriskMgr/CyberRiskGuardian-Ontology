  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "audit function"
  }, {
    "@language" : "fr",
    "@value" : "fonction d'audit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000300"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "fonction d'audit interne"
  }, {
    "@language" : "en",
    "@value" : "internal audit function"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "fr",
    "@value" : "Groupe d'agents d'une organisation qui exerce l'audit interne en vertu d'une charte, sous la direction du responsable de l'audit interne."
  }, {
    "@language" : "en",
    "@value" : "The group of agents in an organisation that performs internal audit under a charter, led by the chief audit executive."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "AUD section 5; GIAS Domain III (cited by number). The function is the unit; the chief audit executive role is held within it."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"
  }, {
    "@language" : "en",
    "@value" : "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"
  } ],

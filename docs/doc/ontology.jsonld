    "@value" : "faille"
  }, {
    "@language" : "en",
    "@value" : "weakness"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A disposition of a material asset, such as a device, storage medium or network equipment, or of an organisation, that a threat source can exploit to cause harm. Weaknesses of software, information or controls are recorded as vulnerability descriptions."
  }, {
    "@language" : "fr",
    "@value" : "Disposition d'un actif matériel, comme un appareil, un support de stockage ou un équipement réseau, ou d'une organisation, qu'une source de menace peut exploiter pour causer un préjudice. Les faiblesses des logiciels, de l'information ou des contrôles sont consignées comme descriptions de vulnérabilité."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {

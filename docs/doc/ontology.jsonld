  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an incident to a risk scenario it is evidence about. An incident supports a scenario's likelihood estimate; it does not prove it, and its absence does not disprove it."
  }, {
    "@language" : "fr",
    "@value" : "Relie un incident à un scénario de risque dont il constitue une preuve. Un incident appuie l'estimation de vraisemblance d'un scénario sans la prouver, et son absence ne l'infirme pas."
  } ],

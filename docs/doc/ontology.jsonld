}, {
  "@id" : "https://w3id.org/crgo/CRGO_0000502",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "dérogation"
  }, {
    "@language" : "en",
    "@value" : "policy exception"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.commoncoreontologies.org/ont00000965"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000903"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "fr",
    "@value" : "exemption"
  }, {
    "@language" : "en",
    "@value" : "waiver"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directive that permits a stated deviation from a policy statement, technical standard or control for a stated scope (role, asset or process) and period, approved by an identified authority and usually with compensating controls. It does not waive a legal obligation."
  }, {
    "@language" : "fr",
    "@value" : "Directive qui autorise un écart déterminé par rapport à un énoncé de politique, une norme technique ou une mesure, pour une portée (rôle, actif ou processus) et une période données, approuvée par une autorité identifiée et généralement assortie de mesures compensatoires. Elle ne dispense d'aucune obligation légale."
  } ],
  "https://w3id.org/crgo/CRGO_0000283" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000069"
  } ],
  "https://w3id.org/crgo/CRGO_0000284" : [ {
    "@id" : "https://w3id.org/crgo/CRGO_0000063"
  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "GAPS D01; GRCA section 6 (waiver or exception). Distinct from risk acceptance, which retains a risk rather than permitting a deviation from a rule."
  } ],
  "https://w3id.org/crgo/CRGO_0000286" : [ {
    "@language" : "en",
    "@value" : "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"
  }, {
    "@language" : "en",
    "@value" : "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"
  } ],

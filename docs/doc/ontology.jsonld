  } ],
  "https://w3id.org/crgo/CRGO_0000285" : [ {
    "@language" : "en",
    "@value" : "SOAR section 2 (IncidentCommunication). A notice to a regulator is also recorded as a regulatory submission (0.10.0)."
  } ],

        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC TS 27008:2019, Guidelines for the assessment of information security controls (1st edition, 2019-01); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/crgo/CRGO_0000649 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000649">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000645"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000646"/>
        <rdfs:label xml:lang="en">stratified selection</rdfs:label>
        <rdfs:label xml:lang="fr">sélection stratifiée</rdfs:label>
        <skos:definition xml:lang="fr">La population est divisée en strates, échantillonnées séparément.</skos:definition>
        <skos:definition xml:lang="en">The population is divided into strata, each sampled separately.</skos:definition>

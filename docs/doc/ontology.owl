    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000885 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000885">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">famille de politiques</rdfs:label>
        <rdfs:label xml:lang="en">policy family</rdfs:label>
        <skos:definition xml:lang="en">A named grouping of related directives, such as all the documents on access control, used to find the policies, standards and procedures that cover the same subject.</skos:definition>
        <skos:definition xml:lang="fr">Regroupement nommé de directives apparentées, comme l&apos;ensemble des documents sur le contrôle d&apos;accès, servant à repérer les politiques, normes et procédures qui portent sur un même sujet.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL section 4 (PolicyFamily); needed by POL CQ03 and CQ08.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000886 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000886">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">directive version</rdfs:label>
        <rdfs:label xml:lang="fr">version de directive</rdfs:label>
        <skos:definition xml:lang="en">A fixed release of a policy, technical standard, procedure, guideline, audit charter or methodology, identified by a version label, with its approval, effective and retirement dates. Once effective its content does not change; a change makes a new version.</skos:definition>
        <skos:definition xml:lang="fr">Diffusion figée d&apos;une politique, d&apos;une norme technique, d&apos;une procédure, d&apos;une ligne directrice, d&apos;une charte ou d&apos;une méthodologie d&apos;audit, désignée par un libellé de version, avec ses dates d&apos;approbation, d&apos;entrée en vigueur et de retrait. Une fois en vigueur, son contenu ne change plus; toute modification crée une nouvelle version.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Decision D4: one version class for all directives (POL PolicyVersion generalised). Distinct from instrument version, which is a version of a legal instrument.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000887 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000887">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000886"/>
        <rdfs:label xml:lang="en">policy version</rdfs:label>
        <rdfs:label xml:lang="fr">version de politique</rdfs:label>
        <skos:definition xml:lang="en">A directive version of a policy.</skos:definition>
        <skos:definition xml:lang="fr">Version de directive d&apos;une politique.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL section 4 (PolicyVersion); decision D4.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000888 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000888">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">article de politique</rdfs:label>
        <rdfs:label xml:lang="en">policy clause</rdfs:label>
        <skos:definition xml:lang="en">A numbered or titled part of a directive version that contains one or more policy statements, used to cite where a statement appears.</skos:definition>
        <skos:definition xml:lang="fr">Partie numérotée ou titrée d&apos;une version de directive qui contient un ou plusieurs énoncés de politique, servant à citer l&apos;emplacement d&apos;un énoncé.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL section 4 (PolicyClause). Optional in data: a statement may be cited by its own identifier.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000889 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000889">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">guideline</rdfs:label>
        <rdfs:label xml:lang="fr">ligne directrice interne</rdfs:label>
        <skos:altLabel xml:lang="en">policy guideline</skos:altLabel>
        <skos:definition xml:lang="en">A directive, issued as guidance separate from any policy, that recommends a practice without making it mandatory. Departing from a guideline needs no exception. A &apos;should&apos; or &apos;may&apos; statement written inside a policy is a policy statement, not a guideline.</skos:definition>
        <skos:definition xml:lang="fr">Directive, publiée à titre d&apos;orientation distincte de toute politique, qui recommande une pratique sans la rendre obligatoire. S&apos;en écarter n&apos;exige aucune dérogation. Un énoncé « devrait » ou « peut » rédigé dans une politique est un énoncé de politique, et non une ligne directrice.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL section 4 (PolicyGuideline). Disjoint from policy statement, so that a guidance document is never read as a binding requirement; modality distinguishes binding from non-binding statements within a policy.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000890 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000890">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="en">directive review</rdfs:label>
        <rdfs:label xml:lang="fr">revue de directive</rdfs:label>
        <skos:altLabel xml:lang="en">policy review</skos:altLabel>
        <skos:definition xml:lang="en">A planned act in which a directive or some of its statements are reviewed, on schedule or after a trigger such as a regulatory change, an incident or an audit finding, ending in a decision to keep, revise or retire them.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel une directive ou certains de ses énoncés sont revus, selon le calendrier ou à la suite d&apos;un déclencheur comme un changement réglementaire, un incident ou une constatation d&apos;audit, et qui aboutit à la décision de les maintenir, de les réviser ou de les retirer.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL section 4 (PolicyReview, PolicyChangeEvent); CSF 2.0 GV.PO-02; SP 800-53 PL-1 (review and update frequency); ISO/IEC 27002:2022 control 5.1 (cited by number).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27002:2022, control 5.1 (Policies for information security); identifier cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST CSF 2.0 (CSWP 29), category GV.PO (Policy), subcategories GV.PO-01 and GV.PO-02</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-53 Rev. 5, control PL-1 (Policy and Procedures) and the -1 controls of each family</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000891 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000891">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">attestation</rdfs:label>
        <rdfs:label xml:lang="fr">attestation</rdfs:label>
        <skos:definition xml:lang="en">A dated declaration by an identified agent about a stated subject and scope, such as having read a policy version or that a requirement is met. It records what the agent declares, not what was verified.</skos:definition>
        <skos:definition xml:lang="fr">Déclaration datée d&apos;un agent identifié portant sur un objet et un périmètre précisés, comme le fait d&apos;avoir lu une version de politique ou le fait qu&apos;une exigence soit respectée. Elle consigne ce que l&apos;agent déclare, et non ce qui a été vérifié.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Improvement I2: common parent of policy acknowledgement and compliance attestation; disjoint from compliance determination and audit conclusion.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000892 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000892">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000891"/>
        <rdfs:label xml:lang="fr">accusé de lecture de politique</rdfs:label>
        <rdfs:label xml:lang="en">policy acknowledgement</rdfs:label>
        <skos:definition xml:lang="en">An attestation by a person that they have received and read an exact policy version that applies to them. Acknowledging a policy is not understanding or complying with it.</skos:definition>
        <skos:definition xml:lang="fr">Attestation par laquelle une personne déclare avoir reçu et lu une version précise d&apos;une politique qui s&apos;applique à elle. Prendre connaissance d&apos;une politique n&apos;équivaut ni à la comprendre ni à la respecter.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL sections 4 and 7 (acknowledged is not understood or compliant). Instances belong in organisation graphs or the application (POL section 1: no employee PII in CRGO).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000893 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000893">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">exigence de formation</rdfs:label>
        <rdfs:label xml:lang="en">training requirement</rdfs:label>
        <skos:definition xml:lang="en">A directive that persons in a stated role or scope complete stated training, usually because a policy statement applies to them. Completing training is not the same as acknowledging or complying.</skos:definition>
        <skos:definition xml:lang="fr">Directive exigeant que les personnes d&apos;un rôle ou d&apos;un périmètre précisés suivent une formation donnée, généralement parce qu&apos;un énoncé de politique s&apos;applique à elles. Suivre la formation ne revient ni à prendre connaissance de la politique ni à la respecter.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL sections 4-5 (TrainingRequirement, requiresTraining); decision D7.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 1 (&quot;I&apos;ll follow your recommendations for all the decisions&quot;, 19:26)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000894 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000894">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="en">compliance programme</rdfs:label>
        <rdfs:label xml:lang="fr">programme de conformité</rdfs:label>
        <skos:definition xml:lang="fr">Plan par lequel une organisation exploite son système de management de la conformité : son périmètre, les obligations et engagements qu&apos;il couvre, ses objectifs, les rôles en cause et son cycle de revue.</skos:definition>
        <skos:definition xml:lang="en">The plan by which an organisation operates its compliance management system: its scope, the obligations and commitments it covers, its objectives, the roles involved and its review cycle.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP section 4 (ComplianceProgram); ISO 37301:2021 clauses 4.3-4.4 and 6.2 (cited by number).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000895 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000895">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000010"/>
        <rdfs:label xml:lang="en">compliance objective</rdfs:label>
        <rdfs:label xml:lang="fr">objectif de conformité</rdfs:label>
        <skos:definition xml:lang="en">A measurable objective that a compliance programme sets itself, such as reviewing every obligation of the register once a year.</skos:definition>
        <skos:definition xml:lang="fr">Objectif mesurable que se fixe un programme de conformité, comme revoir chaque obligation du registre une fois par année.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP section 4; ISO 37301:2021 clause 6.2.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000896 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000896">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">interprétation d&apos;exigence</rdfs:label>
        <rdfs:label xml:lang="en">requirement interpretation</rdfs:label>
        <skos:definition xml:lang="en">A statement, subject to legal review, of how an organisation reads an obligation, provision or framework requirement for its own situation, with the assumptions made and its legal review state. It is the organisation&apos;s reading, not the text and not legal advice.</skos:definition>
        <skos:definition xml:lang="fr">Énoncé, soumis à une revue juridique, de la façon dont une organisation lit une obligation, une disposition ou une exigence de référentiel au regard de sa propre situation, avec les hypothèses retenues et l&apos;état de sa revue juridique. C&apos;est la lecture de l&apos;organisation, et non le texte ni un avis juridique.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP sections 4 and 9 (privilege flag).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000897 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000897">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001180"/>
        <rdfs:label xml:lang="fr">autorité de réglementation</rdfs:label>
        <rdfs:label xml:lang="en">regulatory authority</rdfs:label>
        <skos:altLabel xml:lang="fr">organisme de réglementation</skos:altLabel>
        <skos:altLabel xml:lang="en">regulator</skos:altLabel>
        <skos:definition xml:lang="en">An organisation with legal power to issue, supervise or enforce legal instruments in a jurisdiction, such as a data protection authority.</skos:definition>
        <skos:definition xml:lang="fr">Organisation ayant le pouvoir légal d&apos;édicter, de surveiller ou de faire appliquer des instruments juridiques dans une juridiction, comme une autorité de protection des données.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP section 4 (RegulatoryAuthority). Until now CRGO recorded issuers only as text on source records.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000898 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000898">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000504"/>
        <rdfs:label xml:lang="fr">adoption de référentiel</rdfs:label>
        <rdfs:label xml:lang="en">framework adoption</rdfs:label>
        <skos:definition xml:lang="en">A decision record by which an organisation has committed to meet a framework, or a stated part of it, for a stated scope, which makes its requirements commitments of that organisation. It records the commitment, not conformity.</skos:definition>
        <skos:definition xml:lang="fr">Relevé de décision par lequel une organisation s&apos;engage à respecter un référentiel, ou une partie précisée de celui-ci, pour un périmètre donné, ce qui fait de ses exigences des engagements de cette organisation. Il consigne l&apos;engagement, et non la conformité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Improvement I4; CMP section 7 (source kind &apos;voluntary standard&apos;, &apos;internal commitment&apos;). A decision record, so it reuses decided on, decision made by and decision outcome.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000899 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000899">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="fr">campagne d&apos;évaluation de la conformité</rdfs:label>
        <rdfs:label xml:lang="en">compliance assessment campaign</rdfs:label>
        <skos:definition xml:lang="en">A planned act in which an organisation assesses compliance with a stated set of obligations or requirements, for a stated scope, period and method, producing compliance determinations.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel une organisation évalue sa conformité à un ensemble précisé d&apos;obligations ou d&apos;exigences, pour un périmètre, une période et une méthode donnés, et qui produit des constats de conformité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP section 4 (ComplianceAssessment as a campaign); conflict C3: the per-requirement result stays the compliance determination.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000900 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000900">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">provision version</rdfs:label>
        <rdfs:label xml:lang="fr">version de disposition</rdfs:label>
        <skos:definition xml:lang="en">A record of the wording of a provision as in force over a stated period, kept when an amendment changes that wording, so that earlier assessments can be reproduced against the text that applied then.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement du libellé d&apos;une disposition tel qu&apos;il était en vigueur pendant une période donnée, conservé lorsqu&apos;une modification change ce libellé, afin que les évaluations antérieures puissent être reproduites au regard du texte alors applicable.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Decision D5 (a): versions stay at instrument level; a provision version is recorded only when an amendment changes the wording.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000901 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000901">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">compliance deadline</rdfs:label>
        <rdfs:label xml:lang="fr">échéance de conformité</rdfs:label>
        <skos:definition xml:lang="en">A record of when an obligation must be met, either on a calendar date or within a period counted from a triggering event, such as 72 hours after becoming aware of a breach, with how the date is computed.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement du moment où une obligation doit être respectée, soit à une date fixe, soit dans un délai compté à partir d&apos;un événement déclencheur, comme 72 heures après la prise de connaissance d&apos;une atteinte, avec le mode de calcul de la date.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP sections 4 and 8; generalises the incident-specific &apos;notification due by&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000902 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000902">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">regulatory submission</rdfs:label>
        <rdfs:label xml:lang="fr">transmission réglementaire</rdfs:label>
        <skos:altLabel xml:lang="fr">déclaration à l&apos;autorité</skos:altLabel>
        <skos:altLabel xml:lang="en">regulatory filing</skos:altLabel>
        <skos:definition xml:lang="en">A record of a notice, filing or report sent to an authority under an obligation, with when it was submitted, its state and the receipt or acknowledgement obtained.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement d&apos;un avis, d&apos;un dépôt ou d&apos;un rapport transmis à une autorité en vertu d&apos;une obligation, avec sa date de transmission, son état et l&apos;accusé de réception obtenu.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP section 4 (RegulatorySubmission); links to breach reportability assessments for incident notices.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000903 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000903">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">dispense réglementaire</rdfs:label>
        <rdfs:label xml:lang="en">regulatory exemption</rdfs:label>
        <skos:definition xml:lang="en">A directive issued by an authority that relieves an organisation, for a stated scope and period, from an obligation or part of it, on a stated legal basis. Only an authority with power over the obligation can grant it; an internal approval cannot.</skos:definition>
        <skos:definition xml:lang="fr">Directive émise par une autorité qui dispense une organisation, pour un périmètre et une période donnés, de tout ou partie d&apos;une obligation, sur un fondement juridique précisé. Seule une autorité compétente à l&apos;égard de l&apos;obligation peut l&apos;accorder; une approbation interne ne le peut pas.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP sections 4 and 9 (ComplianceException: internal approval does not remove a binding duty). Distinct from policy exception, which cannot waive law.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000904 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000904">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000891"/>
        <rdfs:label xml:lang="fr">attestation de conformité</rdfs:label>
        <rdfs:label xml:lang="en">compliance attestation</rdfs:label>
        <skos:definition xml:lang="en">An attestation by an identified signatory that an organisation meets stated obligations or requirements for a stated scope and period, citing what it is based on. It is a management declaration, not an audit conclusion.</skos:definition>
        <skos:definition xml:lang="fr">Attestation par laquelle un signataire identifié déclare qu&apos;une organisation respecte des obligations ou des exigences précisées pour un périmètre et une période donnés, en citant ce sur quoi elle se fonde. C&apos;est une déclaration de la direction, et non une conclusion d&apos;audit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CMP section 4; AUD section 7 (management attestation is not an independent audit conclusion).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000905 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000905">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000300"/>
        <rdfs:label xml:lang="en">audit function</rdfs:label>
        <rdfs:label xml:lang="fr">fonction d&apos;audit</rdfs:label>
        <skos:altLabel xml:lang="fr">fonction d&apos;audit interne</skos:altLabel>
        <skos:altLabel xml:lang="en">internal audit function</skos:altLabel>
        <skos:definition xml:lang="fr">Groupe d&apos;agents d&apos;une organisation qui exerce l&apos;audit interne en vertu d&apos;une charte, sous la direction du responsable de l&apos;audit interne.</skos:definition>
        <skos:definition xml:lang="en">The group of agents in an organisation that performs internal audit under a charter, led by the chief audit executive.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">AUD section 5; GIAS Domain III (cited by number). The function is the unit; the chief audit executive role is held within it.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000906 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000906">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">audit charter</rdfs:label>
        <rdfs:label xml:lang="fr">charte d&apos;audit</rdfs:label>
        <skos:altLabel xml:lang="fr">charte d&apos;audit interne</skos:altLabel>
        <skos:altLabel xml:lang="en">internal audit charter</skos:altLabel>
        <skos:definition xml:lang="en">A directive approved by the governing body that sets the internal audit function&apos;s purpose, authority, responsibilities and reporting lines.</skos:definition>
        <skos:definition xml:lang="fr">Directive approuvée par l&apos;organe de gouvernance qui fixe la mission, les pouvoirs, les responsabilités et les liens hiérarchiques de la fonction d&apos;audit interne.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">AUD section 5; GIAS Standard 6.2 (cited by number). Versioned through directive versions.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000907 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000907">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">audit methodology</rdfs:label>
        <rdfs:label xml:lang="fr">méthodologie d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A directive that sets how an audit function plans, performs and reports engagements, including its sampling and rating rules, identified by version.</skos:definition>
        <skos:definition xml:lang="fr">Directive qui fixe la façon dont une fonction d&apos;audit planifie, réalise et communique ses missions, y compris ses règles d&apos;échantillonnage et de cotation, désignée par sa version.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">AUD section 5 (AuditMethodology); GIAS Standard 9.3 (cited by number).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000908 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000908">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">audit plan entry</rdfs:label>
        <rdfs:label xml:lang="fr">entrée du plan d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">An entry of an audit plan for one candidate or planned engagement, with its priority rationale, its state (proposed, approved, deferred, cancelled or completed) and, when deferred or cancelled, the reason and who authorised it.</skos:definition>
        <skos:definition xml:lang="fr">Entrée d&apos;un plan d&apos;audit pour une mission envisagée ou prévue, avec la justification de sa priorité, son état (proposée, approuvée, reportée, annulée ou réalisée) et, en cas de report ou d&apos;annulation, le motif et l&apos;auteur de l&apos;autorisation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">AUD sections 5 and 7; needed by AUD CQ-09 (changes between plan versions and who authorised deferrals).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000909 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000909">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">audit workpaper</rdfs:label>
        <rdfs:label xml:lang="fr">feuille de travail d&apos;audit</rdfs:label>
        <skos:altLabel xml:lang="fr">dossier de travail</skos:altLabel>
        <skos:altLabel xml:lang="en">working paper</skos:altLabel>
        <skos:definition xml:lang="en">A record prepared by an auditor that documents work performed, evidence examined and conclusions reached in an engagement, with who prepared it and who reviewed it. CRGO holds its metadata, not its content.</skos:definition>
        <skos:definition xml:lang="fr">Document établi par un auditeur qui consigne les travaux effectués, les preuves examinées et les conclusions tirées dans une mission, avec son auteur et son réviseur. CRGO en conserve les métadonnées, et non le contenu.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">AUD sections 5 and 9 (self-review check); GIAS Standard 14.6 (Engagement Documentation); ITAF 1204 (Performance and Supervision); cited by number.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000910 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000910">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">audit observation</rdfs:label>
        <rdfs:label xml:lang="fr">observation d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A preliminary record of a condition noted during an engagement that has not yet been validated against criteria and evidence. It is not a finding and carries no audit conclusion.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement préliminaire d&apos;une situation relevée pendant une mission, qui n&apos;a pas encore été validée au regard des critères et des preuves. Ce n&apos;est pas une constatation et elle ne porte aucune conclusion d&apos;audit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Decision D8: disjoint from audit finding; a validated observation is linked to the finding it became.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000911 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000911">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="en">audit quality review</rdfs:label>
        <rdfs:label xml:lang="fr">revue de qualité de l&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A planned act in which the work of an engagement or of the audit function is evaluated against its methodology and the standards it follows, by a supervisor, an internal quality assessor or an external assessor.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel les travaux d&apos;une mission ou de la fonction d&apos;audit sont évalués au regard de sa méthodologie et des normes qu&apos;elle suit, par un superviseur, un évaluateur interne de la qualité ou un évaluateur externe.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">AUD section 5; GIAS Standards 8.3-8.4, 12.1 and 12.3 (cited by number).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 3 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000912 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000912">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">assertion de correspondance</rdfs:label>
        <rdfs:label xml:lang="en">mapping assertion</rdfs:label>
        <skos:definition xml:lang="en">A directional statement, subject to review, that a source requirement corresponds to a target requirement in a stated way (exact, full or partial coverage, broader, narrower, related or conflicting), with the editions mapped, the rationale, the confidence, the reviewer and its review state. A mapping is not evidence of compliance.</skos:definition>
        <skos:definition xml:lang="fr">Énoncé orienté, soumis à une revue, selon lequel une exigence source correspond à une exigence cible d&apos;une façon précisée (exacte, couverture totale ou partielle, plus large, plus étroite, liée ou contradictoire), avec les éditions mises en correspondance, la justification, le degré de confiance, le réviseur et l&apos;état de la revue. Une correspondance ne prouve pas la conformité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Improvement I1; decision D6 (organisation crosswalks and newly reviewed mappings; approved direct mappings are not reified).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000913 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000913">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="fr">modalité normative</rdfs:label>
        <rdfs:label xml:lang="en">normative modality</rdfs:label>
        <skos:definition xml:lang="fr">Degré de contrainte d&apos;un énoncé de politique.</skos:definition>
        <skos:definition xml:lang="en">How binding a policy statement is.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>

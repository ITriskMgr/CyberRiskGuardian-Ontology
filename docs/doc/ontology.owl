        <skos:definition xml:lang="fr">Quantité de risque calculée égale à Pb(A) × Pb(ψ,A) × CVSS × appétit pour le risque × μ(E) ÷ θ × facteur.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>

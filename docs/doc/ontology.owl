    <!-- https://w3id.org/crgo/CRGO_0001017 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0001017">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000502"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000031"/>
        <rdfs:label xml:lang="en">authorised by risk acceptance</rdfs:label>
        <rdfs:label xml:lang="fr">autorisée par l&apos;acceptation du risque</rdfs:label>
        <skos:definition xml:lang="en">Relates a policy exception to the risk acceptance decision that accepts the risk it leaves. A policy exception does not imply a risk acceptance; the link is stated when one was made.</skos:definition>
        <skos:definition xml:lang="fr">Relie une dérogation à la décision d&apos;acceptation du risque qui accepte le risque qu&apos;elle laisse subsister. Une dérogation n&apos;implique pas une acceptation du risque; le lien est indiqué lorsqu&apos;il y en a une.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

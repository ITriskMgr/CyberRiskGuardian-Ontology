    <!-- https://w3id.org/crgo/CRGO_0000351 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000351">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000348"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000349"/>
        <rdfs:label xml:lang="en">Canada (federal legal order)</rdfs:label>
        <rdfs:label xml:lang="fr">Canada (ordre juridique fédéral)</rdfs:label>
        <skos:definition xml:lang="en">Canada as the legal order of federal statutes and regulators. It is the jurisdiction of an instrument, not a place: an organisation&apos;s establishment, markets and data subjects are given by a province or territory.</skos:definition>
        <skos:definition xml:lang="fr">Le Canada en tant qu&apos;ordre juridique des lois et autorités fédérales. C&apos;est la juridiction d&apos;un instrument, non un lieu : l&apos;établissement, les marchés et les personnes concernées d&apos;une organisation sont indiqués par une province ou un territoire.</skos:definition>
        <skos:notation>2</skos:notation>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:NamedIndividual>
    



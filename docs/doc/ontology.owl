        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000824 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000824">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000015"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:label xml:lang="en">incident informs scenario</rdfs:label>
        <rdfs:label xml:lang="fr">incident éclairant le scénario</rdfs:label>
        <skos:definition xml:lang="en">Relates an incident to a risk scenario it is evidence about. An incident supports a scenario&apos;s likelihood estimate; it does not prove it, and its absence does not disprove it.</skos:definition>
        <skos:definition xml:lang="fr">Relie un incident à un scénario de risque dont il constitue une preuve. Un incident appuie l&apos;estimation de vraisemblance d&apos;un scénario sans la prouver, et son absence ne l&apos;infirme pas.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D06: incident observations support, do not prove, scenario likelihood.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000825 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000825">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broadMatch"/>
        <rdfs:label xml:lang="en">narrower than</rdfs:label>
        <rdfs:label xml:lang="fr">plus étroit que</rdfs:label>
        <skos:definition xml:lang="en">Relates a concept of one vocabulary to a concept of another whose meaning includes it; every case of the subject is a case of the object.</skos:definition>
        <skos:definition xml:lang="fr">Relie un concept d&apos;un vocabulaire à un concept d&apos;un autre vocabulaire dont le sens l&apos;englobe; tout cas du sujet est un cas de l&apos;objet.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 11; OLIR &apos;subset of&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST OLIR relationship types (subset of, intersects with, equal, superset of, not related to)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000826 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000826">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#narrowMatch"/>
        <rdfs:label xml:lang="en">broader than</rdfs:label>
        <rdfs:label xml:lang="fr">plus large que</rdfs:label>
        <skos:definition xml:lang="en">Relates a concept of one vocabulary to a concept of another whose meaning it includes.</skos:definition>
        <skos:definition xml:lang="fr">Relie un concept d&apos;un vocabulaire à un concept d&apos;un autre vocabulaire dont il englobe le sens.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 11; OLIR &apos;superset of&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST OLIR relationship types (subset of, intersects with, equal, superset of, not related to)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000827 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000827">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
        <rdfs:label xml:lang="en">partially overlaps</rdfs:label>
        <rdfs:label xml:lang="fr">recoupe partiellement</rdfs:label>
        <skos:definition xml:lang="en">Relates two concepts of different vocabularies that share part of their meaning, neither including the other; the annotation states what is shared.</skos:definition>
        <skos:definition xml:lang="fr">Relie deux concepts de vocabulaires différents qui partagent une partie de leur sens sans que l&apos;un englobe l&apos;autre; l&apos;annotation précise ce qui est partagé.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 11; OLIR &apos;intersects with&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST OLIR relationship types (subset of, intersects with, equal, superset of, not related to)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000828 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000828">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
        <rdfs:label xml:lang="fr">contribue à la conformité à</rdfs:label>
        <rdfs:label xml:lang="en">supports compliance with</rdfs:label>
        <skos:definition xml:lang="en">Relates a control or framework requirement to a provision or obligation that implementing it can help meet. It never proves compliance: that needs a compliance determination with evidence.</skos:definition>
        <skos:definition xml:lang="fr">Relie une mesure ou une exigence de référentiel à une disposition ou à une obligation que sa mise en œuvre peut aider à respecter. Elle ne prouve jamais la conformité, qui exige un constat de conformité appuyé de preuves.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 6 (supports is not proves).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000829 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000829">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
        <rdfs:label xml:lang="en">fulfils criterion</rdfs:label>
        <rdfs:label xml:lang="fr">satisfait au critère</rdfs:label>
        <skos:definition xml:lang="en">Relates a control to an assurance criterion, such as a Trust Services criterion, that it is designed to meet.</skos:definition>
        <skos:definition xml:lang="fr">Relie une mesure à un critère d&apos;assurance, comme un critère des services de confiance, qu&apos;elle est conçue pour satisfaire.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 11.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">AICPA 2017 Trust Services Criteria for Security, Availability, Processing Integrity, Confidentiality, and Privacy (revised points of focus, 2022); identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000830 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000830">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
        <rdfs:label xml:lang="en">evaluates control</rdfs:label>
        <rdfs:label xml:lang="fr">évalue le contrôle</rdfs:label>
        <skos:definition xml:lang="en">Relates an assessment objective, such as an SP 800-53A objective, to the control or control enhancement whose implementation it assesses.</skos:definition>
        <skos:definition xml:lang="fr">Relie un objectif d&apos;évaluation, comme un objectif SP 800-53A, au contrôle ou à l&apos;amélioration de contrôle dont il évalue la mise en œuvre.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 12: 800-53A bound to the exact 800-53 control and version.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-53A Rev. 5 assessment objectives and methods (examine, interview, test), as carried in the SP 800-53 Rev. 5.2.0 OSCAL catalogue (2026-05-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000882 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000882">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000482"/>
        <rdfs:label xml:lang="en">role for</rdfs:label>
        <rdfs:label xml:lang="fr">rôle à l&apos;égard de</rdfs:label>
        <skos:definition xml:lang="en">Relates a governance role to the control measure, risk scenario, process or function it concerns, such as the backup control for a control owner role.</skos:definition>
        <skos:definition xml:lang="fr">Relie un rôle de gouvernance à la mesure appliquée, au scénario de risque, au processus ou à la fonction qu&apos;il concerne, comme la mesure de sauvegarde pour un rôle de propriétaire de mesure.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Lets ownership be answered for a date through role assignments (CQ-GRCA-01).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000883 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000883">

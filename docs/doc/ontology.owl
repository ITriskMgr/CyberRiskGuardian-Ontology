    <!-- https://w3id.org/crgo/CRGO_0000180 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000180">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000059"/>
        <rdfs:label xml:lang="en">2023 scenario-generator notebook v2-1b</rdfs:label>
        <rdfs:label xml:lang="fr">carnet de génération de scénarios 2023 v2-1b</rdfs:label>
        <skos:definition xml:lang="en">Legacy calculation method of the 2023 scenario generator, used to produce the original values of the scenario library.</skos:definition>
        <skos:definition xml:lang="fr">Méthode de calcul héritée du générateur de scénarios de 2023, utilisée pour produire les valeurs d&apos;origine de la bibliothèque de scénarios.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">Known defects of the 2023 notebook: its Monte Carlo step centres noise on the column mean rather than on each scenario&apos;s value, and its CVSS extraction is defective. Library values are therefore re-read from the generator&apos;s answers (decisions §6.1).</crgo:CRGO_0000292>
    </owl:NamedIndividual>
    



        <crgo:CRGO_0000286 xml:lang="en">W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000408 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000408">
        <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000338"/>
        <rdfs:label xml:lang="fr">observation de</rdfs:label>
        <rdfs:label xml:lang="en">observation of</rdfs:label>
        <skos:definition xml:lang="en">Relates an observation to the entity it reports on, such as a published vulnerability.</skos:definition>
        <skos:definition xml:lang="fr">Relie une observation à l&apos;entité sur laquelle elle porte, comme une vulnérabilité publiée.</skos:definition>
        <skos:scopeNote xml:lang="en">At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL.</skos:scopeNote>

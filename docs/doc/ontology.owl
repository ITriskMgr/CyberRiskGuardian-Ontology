        <crgo:CRGO_0000286 xml:lang="en">OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:DatatypeProperty>
    



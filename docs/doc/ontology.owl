    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000994">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">review state</rdfs:label>
        <rdfs:label xml:lang="fr">état de la revue</rdfs:label>

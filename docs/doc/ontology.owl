        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/crgo/CRGO_0000988 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000988">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000985"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000986"/>
        <rdfs:label xml:lang="fr">couverture totale</rdfs:label>
        <rdfs:label xml:lang="en">full coverage</rdfs:label>
        <skos:definition xml:lang="en">Meeting the source meets all of the target.</skos:definition>
        <skos:definition xml:lang="fr">Respecter la source permet de respecter toute la cible.</skos:definition>
        <skos:notation>2</skos:notation>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000034 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000034">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">indicateur clé de risque</rdfs:label>
        <rdfs:label xml:lang="en">key risk indicator</rdfs:label>
        <skos:altLabel xml:lang="fr">ICR</skos:altLabel>
        <skos:altLabel xml:lang="en">KRI</skos:altLabel>
        <skos:definition xml:lang="en">A description of a metric used to monitor one or more risk scenarios, with its measurement method, data source, owner, frequency, target and warning and critical thresholds.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une mesure servant à surveiller un ou plusieurs scénarios de risque, avec sa méthode de mesure, sa source de données, son responsable, sa fréquence, sa cible et ses seuils d&apos;alerte et critique.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG KRIS (step 19). Distinct from KRIQuantity (computed risk scores).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000035 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000035">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">budget calibration</rdfs:label>
        <rdfs:label xml:lang="fr">étalonnage du budget</rdfs:label>
        <skos:definition xml:lang="en">A description that relates the organisation&apos;s cybersecurity budget, as a share of its total IT budget, to its risk appetite using the CRG 4 / 7.8 / 12 percent band.</skos:definition>
        <skos:definition xml:lang="fr">Description qui relie le budget de cybersécurité de l&apos;organisation, en proportion de son budget TI total, à son appétit pour le risque selon la bande CRG de 4 / 7,8 / 12 pour cent.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG step 18 and budget.json.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, examples/medibec/source/data30.json and budget.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000036 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000036">

        <rdfs:label xml:lang="en">CRG normalised cross-check</rdfs:label>
        <rdfs:label xml:lang="fr">contre-vérification normalisée CRG</rdfs:label>
        <skos:definition xml:lang="fr">Score secondaire T × E × I × (1 − C), où C est approché par la résilience; après traitement × (1 − P × Q).</skos:definition>

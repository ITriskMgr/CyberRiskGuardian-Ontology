    <!-- https://w3id.org/crgo/CRGO_0000294 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000294">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">description de source de menace</rdfs:label>
        <rdfs:label xml:lang="en">threat source description</rdfs:label>
        <skos:definition xml:lang="en">A description of a kind of threat source, such as a financially motivated cybercriminal, a negligent employee or a flood, with its type, used when the source is not an identified agent or process.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un type de source de menace, comme un cybercriminel motivé par l&apos;appât du gain, un employé négligent ou une inondation, avec son type, utilisée lorsque la source n&apos;est pas un agent ou un processus identifié.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG &apos;threat_source&apos; is text; library scenarios belong to no organisation (review H1).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000295 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000295">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">description de vulnérabilité</rdfs:label>
        <rdfs:label xml:lang="en">vulnerability description</rdfs:label>
        <skos:altLabel xml:lang="en">weakness description</skos:altLabel>
        <skos:definition xml:lang="en">A description of a kind of weakness or predisposing condition, including weaknesses of software, information and controls, that a threat event can exploit.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un type de faiblesse ou de condition prédisposante, y compris les faiblesses des logiciels, de l&apos;information et des contrôles, qu&apos;un événement de menace peut exploiter.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG &apos;vulns&apos; is text (review H1, H6); may reference CWE.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000296 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000296">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">framework</rdfs:label>
        <rdfs:label xml:lang="fr">référentiel</rdfs:label>
        <skos:altLabel xml:lang="fr">norme</skos:altLabel>
        <skos:altLabel xml:lang="en">standard</skos:altLabel>
        <skos:definition xml:lang="en">A published standard, framework, law or catalogue whose requirements are held as a concept scheme, identified with its version, such as NIST CSF 2.0 or ISO/IEC 27002:2022.</skos:definition>
        <skos:definition xml:lang="fr">Norme, référentiel, loi ou catalogue publié dont les exigences sont consignées dans un schéma de concepts, identifié avec sa version, comme NIST CSF 2.0 ou ISO/IEC 27002:2022.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

        <skos:definition xml:lang="fr">Relie une leçon apprise à l&apos;incident ou à l&apos;exercice dont elle provient.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>

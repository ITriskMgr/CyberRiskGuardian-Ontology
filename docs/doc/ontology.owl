        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000293 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000293">
        <rdfs:label xml:lang="fr">faiblesse de</rdfs:label>
        <rdfs:label xml:lang="en">weakness of</rdfs:label>
        <skos:definition xml:lang="en">Relates a vulnerability, vulnerability description or predisposing condition to the asset, organisation or process it is a weakness of. Shortcut for BFO &apos;inheres in&apos;, which cannot be used when the asset is software or information: in BFO-2020 a disposition can inhere only in a material bearer, so the weakness of a software asset strictly inheres in the copies or devices that carry it.</skos:definition>
        <skos:definition xml:lang="fr">Relie une vulnérabilité ou une condition prédisposante à l&apos;actif, à l&apos;organisation ou au processus dont elle est une faiblesse. Raccourci de « inheres in » de BFO, inutilisable lorsque l&apos;actif est un logiciel ou de l&apos;information : dans BFO-2020, une disposition ne peut résider que dans un porteur matériel, de sorte que la faiblesse d&apos;un actif logiciel réside au sens strict dans les copies ou les appareils qui le portent.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Found by HermiT on the CRG test fixture: &apos;vulnerability inheres in software asset&apos; is inconsistent under BFO-2020.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 21838-2:2021 / BFO-2020, alignment target</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">MOACCO 1.2a (retired), Herzog et al. Security.owl concepts Threat, Vulnerability, Countermeasure</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000318 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000318">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000294"/>
        <rdfs:label xml:lang="fr">a pour description de source de menace</rdfs:label>
        <rdfs:label xml:lang="en">has threat source description</rdfs:label>
        <skos:definition xml:lang="en">Relates a risk scenario to a description of the kind of threat source that would initiate it.</skos:definition>
        <skos:definition xml:lang="fr">Relie un scénario de risque à la description du type de source de menace qui le déclencherait.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG &apos;threat_source&apos; (review H1).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000319 -->



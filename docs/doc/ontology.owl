    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000298 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000298">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:label xml:lang="fr">estimation de l&apos;impact</rdfs:label>
        <rdfs:label xml:lang="en">impact estimate</rdfs:label>
        <skos:altLabel xml:lang="fr">gravité</skos:altLabel>
        <skos:altLabel xml:lang="en">severity</skos:altLabel>
        <skos:definition xml:lang="en">An estimate of the magnitude of a scenario&apos;s consequences, on any scale.</skos:definition>
        <skos:definition xml:lang="fr">Estimation de l&apos;ampleur des conséquences d&apos;un scénario, sur toute échelle.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Generic layer (review M).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000299 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000299">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:label xml:lang="fr">niveau de risque</rdfs:label>
        <rdfs:label xml:lang="en">risk level</rdfs:label>
        <skos:definition xml:lang="en">An estimate of the magnitude of a risk, combining likelihood and impact by a stated method.</skos:definition>
        <skos:definition xml:lang="fr">Estimation de l&apos;ampleur d&apos;un risque, qui combine vraisemblance et impact selon une méthode déclarée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Generic layer (review M).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000300 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000300">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:label xml:lang="en">control effectiveness</rdfs:label>
        <rdfs:label xml:lang="fr">efficacité du contrôle</rdfs:label>
        <skos:definition xml:lang="en">An estimate of how well a control measure achieves its intended reduction of likelihood or impact, with the evidence for it.</skos:definition>
        <skos:definition xml:lang="fr">Estimation du degré auquel une mesure de contrôle atteint la réduction de vraisemblance ou d&apos;impact visée, avec les preuves à l&apos;appui.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Per-control effectiveness was missing; CRG only has package reductions (review H5).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000301 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000301">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000050"/>
        <rdfs:label xml:lang="en">pre-treatment ratio</rdfs:label>
        <rdfs:label xml:lang="fr">ratio avant traitement</rdfs:label>
        <skos:altLabel xml:lang="en">pre_ratio</skos:altLabel>
        <skos:definition xml:lang="en">A computed risk quantity equal to estimated risk divided by tolerated risk, before any treatment.</skos:definition>
        <skos:definition xml:lang="fr">Quantité de risque calculée égale au risque estimé divisé par le risque toléré, avant tout traitement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">crg_calc.py &apos;pre_ratio&apos; (review M round-trip).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000302 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000302">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">asset category</rdfs:label>
        <rdfs:label xml:lang="fr">catégorie d&apos;actif</rdfs:label>
        <skos:definition xml:lang="en">A kind of asset named in a scenario that belongs to no particular organisation.</skos:definition>
        <skos:definition xml:lang="fr">Type d&apos;actif nommé dans un scénario qui n&apos;appartient à aucune organisation en particulier.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000314 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000314">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">asset tier</rdfs:label>
        <rdfs:label xml:lang="fr">rang d&apos;actif</rdfs:label>
        <skos:definition xml:lang="fr">Indique si un actif est principal ou de soutien pour un processus donné.</skos:definition>
        <skos:definition xml:lang="en">Whether an asset is primary or supporting for a given process.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000337 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000337">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">notice de source</rdfs:label>
        <rdfs:label xml:lang="en">source record</rdfs:label>
        <skos:definition xml:lang="en">A description of a dataset, publication or legal text from which CRGO content was imported or derived, recording its issuer, official identifier, version, retrieval date, licence, what CRGO redistributes and the checksum of the file used.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un jeu de données, d&apos;une publication ou d&apos;un texte juridique dont un contenu de CRGO est importé ou dérivé, indiquant son émetteur, son identifiant officiel, sa version, sa date d&apos;obtention, sa licence, ce que CRGO en rediffuse et l&apos;empreinte du fichier utilisé.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification section 7 (SourceRecord fields); one per row of docs/baseline/source_registry.csv.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Stage 0 gap analysis (docs/baseline/gap_analysis.md, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000338 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000338">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001163"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000477"/>
        <rdfs:label xml:lang="en">observation</rdfs:label>
        <rdfs:label xml:lang="fr">observation</rdfs:label>
        <skos:definition xml:lang="en">A dated record that a stated source reported a value or category for an entity at a stated time, such as the EPSS score of a vulnerability on a given day. An observation reports what a source said; it is not an estimate made for an assessment.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant qu&apos;une source donnée a rapporté une valeur ou une catégorie pour une entité à un moment donné, comme le score EPSS d&apos;une vulnérabilité un jour donné. Une observation rapporte ce qu&apos;une source a dit; ce n&apos;est pas une estimation faite pour une appréciation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Disjoint from estimate (specification rule 3: separate source facts from model estimates); negative fixture tests it.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000339 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000339">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000475"/>
        <rdfs:label xml:lang="en">assumption</rdfs:label>
        <rdfs:label xml:lang="fr">hypothèse</rdfs:label>
        <skos:definition xml:lang="en">A statement taken as true without verification for an estimate, an assessment or a decision, recorded so that the result can be reviewed when the statement turns out to be false or changes.</skos:definition>
        <skos:definition xml:lang="fr">Énoncé tenu pour vrai sans vérification aux fins d&apos;une estimation, d&apos;une appréciation ou d&apos;une décision, consigné afin que le résultat puisse être revu si l&apos;énoncé se révèle faux ou change.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification sections 6, 7 and 11 (assessments depend on assumptions). Alt label &apos;hypothesis&apos; removed 2026-10-11 (project owner), to keep it apart from analytical hypothesis.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000340 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000340">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000338"/>
        <rdfs:label xml:lang="en">EPSS observation</rdfs:label>
        <rdfs:label xml:lang="fr">observation EPSS</rdfs:label>
        <skos:definition xml:lang="en">An observation of the Exploit Prediction Scoring System score of a published vulnerability on a given day: FIRST&apos;s estimated probability that the vulnerability is exploited in the wild in the following 30 days, with its percentile among all scored vulnerabilities. It concerns the vulnerability in general, not its presence in any organisation, and it is not the likelihood of a risk scenario.</skos:definition>
        <skos:definition xml:lang="fr">Observation du score de l&apos;Exploit Prediction Scoring System d&apos;une vulnérabilité publiée un jour donné : la probabilité, estimée par FIRST, que la vulnérabilité soit exploitée dans les 30 jours suivants, avec son centile parmi toutes les vulnérabilités évaluées. Elle porte sur la vulnérabilité en général, non sur sa présence dans une organisation, et ce n&apos;est pas la vraisemblance d&apos;un scénario de risque.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Replaces the 0.8.0 EPSS likelihood estimates (decision D4); specification section 5 (do not conflate probability of exploitation with scenario likelihood).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">FIRST, Exploit Prediction Scoring System: model documentation and data (first.org/epss)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000341 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000341">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000009"/>
        <rdfs:label xml:lang="fr">activité de traitement</rdfs:label>
        <rdfs:label xml:lang="en">processing activity</rdfs:label>
        <skos:altLabel xml:lang="fr">traitement de données</skos:altLabel>
        <skos:definition xml:lang="en">A business process, or part of one, in which an organisation collects, uses, discloses, keeps or destroys personal information for stated purposes.</skos:definition>
        <skos:definition xml:lang="fr">Processus d&apos;affaires, ou partie de processus, dans lequel une organisation recueille, utilise, communique, conserve ou détruit des renseignements personnels à des fins déterminées.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GDPR Art. 30 record entries; Loi 25 purposes of collection. Needed to evaluate applicability (specification section 9).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000342 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="fr">rôle de fournisseur</rdfs:label>
        <rdfs:label xml:lang="en">supplier role</rdfs:label>
        <skos:altLabel xml:lang="en">third party</skos:altLabel>
        <skos:altLabel xml:lang="fr">tiers</skos:altLabel>
        <skos:definition xml:lang="en">A role of an organisation that supplies goods, services or the operation of assets to another organisation, which comes to depend on it.</skos:definition>
        <skos:definition xml:lang="fr">Rôle d&apos;une organisation qui fournit des biens, des services ou l&apos;exploitation d&apos;actifs à une autre organisation, laquelle en vient à en dépendre.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Anti-rigid (OntoClean): an organisation is a supplier only relative to a customer, so modelled as a BFO role borne by the organisation.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000343 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000343">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">instrument juridique</rdfs:label>
        <rdfs:label xml:lang="en">legal instrument</rdfs:label>
        <skos:changeNote xml:lang="en">0.10.0 (2026-10-12): definition widened to contracts and directives to be transposed, with the new instrument kinds.</skos:changeNote>
        <skos:definition xml:lang="en">A statute, regulation, regulatory guideline, directive to be transposed or binding contract taken as a whole, identified by its official citation or reference, with its jurisdiction and the dates of its publication, coming into force, application and consolidation. Its provisions are the concepts of the corresponding CRGO vocabulary or, for an organisation&apos;s contracts, its own clauses.</skos:definition>
        <skos:definition xml:lang="fr">Loi, règlement, ligne directrice réglementaire, directive à transposer ou contrat contraignant pris dans son ensemble, identifié par sa citation officielle ou sa référence, avec sa juridiction et les dates de sa publication, de son entrée en vigueur, de sa prise d&apos;effet et de sa mise à jour. Ses dispositions sont les concepts du vocabulaire CRGO correspondant ou, pour les contrats d&apos;une organisation, leurs propres clauses.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification section 5 (separate instrument, provision, obligation, applicability, determination).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 6: changes to approved terms beyond D9 (reopens finding, version label, audit finding, policy statement, legal instrument, compliance determination)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000344 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000344">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">applicability condition</rdfs:label>
        <rdfs:label xml:lang="fr">condition d&apos;applicabilité</rdfs:label>
        <skos:changeNote xml:lang="en">0.10.0 (decision D9, 2026-10-12): definition widened to policy statements.</skos:changeNote>
        <skos:definition xml:lang="en">A description of a condition under which a legal instrument, one of its provisions or a policy statement applies to an organisation or part of it, such as its territory, organisation type, sector, role in processing personal information, a threshold or, for a policy statement, a role or asset category, written as a CRGO paraphrase or the organisation&apos;s own wording, with its citation and a machine-readable test.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une condition à laquelle un instrument juridique, l&apos;une de ses dispositions ou un énoncé de politique s&apos;applique à une organisation ou à une partie de celle-ci, comme son territoire, son type d&apos;organisation, son secteur, son rôle dans le traitement de renseignements personnels, un seuil ou, pour un énoncé de politique, un rôle ou une catégorie d&apos;actifs, rédigée comme une paraphrase de CRGO ou dans les termes de l&apos;organisation, avec sa citation et un test lisible par machine.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Conditions are evaluated over an organisation profile, never asserted as class membership (specification section 9).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OSFI Guideline B-13, scope (federally regulated financial institutions), 2022-07-31</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">PIPEDA ss. 4, 26(2)(b), Sch. 1 (S.C. 2000, c. 5, current to 2026-09-21)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000345 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000345">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000346"/>
        <rdfs:label xml:lang="en">applicability assessment</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation de l&apos;applicabilité</rdfs:label>
        <skos:changeNote xml:lang="en">0.10.0 (decision D9, 2026-10-12): definition widened to policy statements.</skos:changeNote>
        <skos:definition xml:lang="en">A dated record (not the act of assessing) of whether a legal instrument, provision or policy statement applies to a given organisation or part of it, giving the state reached (applicable, not applicable, potentially applicable or unknown) and the conditions found met, not met or undetermined.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant si un instrument juridique, une disposition ou un énoncé de politique s&apos;applique à une organisation donnée ou à une partie de celle-ci, avec l&apos;état retenu (applicable, non applicable, potentiellement applicable ou inconnu) et les conditions jugées remplies, non remplies ou indéterminées.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification section 9 states; &apos;unknown&apos; when a needed fact is absent, so missing data never yields &apos;not applicable&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000346 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000346">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000504"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000511"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000541"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000891"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000912"/>
        <rdfs:label xml:lang="en">compliance determination</rdfs:label>
        <rdfs:label xml:lang="fr">constat de conformité</rdfs:label>
        <skos:altLabel xml:lang="en">compliance assessment</skos:altLabel>
        <skos:changeNote xml:lang="en">0.10.0 (2026-10-12): definition widened to contractual obligations and adopted framework requirements (improvement I4).</skos:changeNote>
        <skos:definition xml:lang="en">A dated record, made by an identified assessor, of the extent to which a given organisation satisfies a legal provision or obligation, a contractual obligation or a requirement of a framework it has adopted, with the evidence relied on or an explicit statement of the missing evidence. A mapped control or framework requirement is not by itself evidence of compliance.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté, établi par un évaluateur identifié, du degré auquel une organisation donnée satisfait à une disposition ou à une obligation légale, à une obligation contractuelle ou à une exigence d&apos;un référentiel qu&apos;elle a adopté, avec les preuves retenues ou un énoncé explicite des preuves manquantes. Un contrôle ou une exigence de référentiel mis en correspondance ne constitue pas à lui seul une preuve de conformité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification sections 9 and 13 (state, assessor, date, evidence or evidence gap).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 6: changes to approved terms beyond D9 (reopens finding, version label, audit finding, policy statement, legal instrument, compliance determination)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000347 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000347">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="en">control assessment</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation d&apos;une mesure de sécurité</rdfs:label>
        <skos:altLabel xml:lang="en">control test</skos:altLabel>
        <skos:definition xml:lang="en">A planned act in which an assessor tests or reviews a control measure of an organisation at a stated date, over a stated scope and by a stated procedure, and records its result and the evidence gathered.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel un évaluateur teste ou examine une mesure de sécurité d&apos;une organisation à une date, sur un périmètre et selon une procédure donnés, et en consigne le résultat et les preuves recueillies.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification section 5 (separate objective, implementation and assessment result): control = objective, control measure = implementation, control assessment = test.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000348 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000348">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="fr">juridiction</rdfs:label>
        <rdfs:label xml:lang="en">jurisdiction</rdfs:label>
        <skos:definition xml:lang="en">A territory whose law or regulator CRGO&apos;s legal vocabularies come from, used to state where an organisation is established, offers services or has data subjects.</skos:definition>
        <skos:definition xml:lang="fr">Territoire dont proviennent le droit ou l&apos;autorité de réglementation des vocabulaires juridiques de CRGO, servant à indiquer où une organisation est établie, offre des services ou compte des personnes concernées.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000355 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000355">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">organisation type</rdfs:label>
        <rdfs:label xml:lang="fr">type d&apos;organisation</rdfs:label>
        <skos:definition xml:lang="fr">Catégorie juridique d&apos;une organisation qui détermine le régime de protection et de sécurité qui la lie.</skos:definition>
        <skos:definition xml:lang="en">The legal category of an organisation that decides which privacy and security regime binds it.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OSFI Guideline B-13, scope (federally regulated financial institutions), 2022-07-31</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">PIPEDA ss. 4, 26(2)(b), Sch. 1 (S.C. 2000, c. 5, current to 2026-09-21)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000362 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000362">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">processing role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle dans le traitement</rdfs:label>
        <skos:definition xml:lang="fr">Rôle d&apos;une organisation dans une activité de traitement.</skos:definition>
        <skos:definition xml:lang="en">The role an organisation plays in a processing activity.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000366 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000366">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="fr">catégorie de renseignements personnels</rdfs:label>
        <rdfs:label xml:lang="en">personal data category</rdfs:label>
        <skos:definition xml:lang="en">A category of personal information that a processing activity handles, used for applicability conditions and sensitivity.</skos:definition>
        <skos:definition xml:lang="fr">Catégorie de renseignements personnels traitée par une activité de traitement, utilisée pour les conditions d&apos;applicabilité et la sensibilité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000376 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000376">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">instrument kind</rdfs:label>
        <rdfs:label xml:lang="fr">type d&apos;instrument</rdfs:label>
        <skos:definition xml:lang="en">The kind of a legal instrument.</skos:definition>
        <skos:definition xml:lang="fr">Type d&apos;un instrument juridique.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000381 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000381">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">applicability state</rdfs:label>
        <rdfs:label xml:lang="fr">état d&apos;applicabilité</rdfs:label>
        <skos:definition xml:lang="fr">Résultat de l&apos;évaluation de l&apos;applicabilité d&apos;un instrument ou d&apos;une disposition à une organisation.</skos:definition>
        <skos:definition xml:lang="en">The result of evaluating whether an instrument or provision applies to an organisation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000387 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000387">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">compliance state</rdfs:label>
        <rdfs:label xml:lang="fr">état de conformité</rdfs:label>
        <skos:definition xml:lang="fr">Résultat d&apos;un constat de conformité.</skos:definition>
        <skos:definition xml:lang="en">The result of a compliance determination.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000394 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000394">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">condition kind</rdfs:label>
        <rdfs:label xml:lang="fr">type de condition</rdfs:label>
        <skos:definition xml:lang="en">The kind of fact an applicability condition tests.</skos:definition>
        <skos:definition xml:lang="fr">Type de fait que vérifie une condition d&apos;applicabilité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000401 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000401">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">control test result</rdfs:label>
        <rdfs:label xml:lang="fr">résultat d&apos;évaluation d&apos;une mesure</rdfs:label>
        <skos:definition xml:lang="fr">Résultat consigné par une évaluation de mesure de sécurité.</skos:definition>
        <skos:definition xml:lang="en">The result recorded by a control assessment.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000475 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000475">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">analytical hypothesis</rdfs:label>
        <rdfs:label xml:lang="fr">hypothèse explicative</rdfs:label>
        <skos:definition xml:lang="en">A proposed explanation, such as a suspected cause of a control failure, recorded so that it can be tested against evidence. Until it is tested it is not a fact or a conclusion.</skos:definition>
        <skos:definition xml:lang="fr">Explication proposée, comme la cause présumée de la défaillance d&apos;une mesure, consignée afin d&apos;être vérifiée au regard des preuves. Tant qu&apos;elle n&apos;est pas vérifiée, ce n&apos;est ni un fait ni une conclusion.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 10 (observed versus hypothesised cause); GAPS D08. Distinct from assumption: an assumption is taken as true for an estimate, a hypothesis is put forward to be tested.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000476 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000476">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">distribution d&apos;une estimation</rdfs:label>
        <rdfs:label xml:lang="en">estimate distribution</rdfs:label>
        <skos:definition xml:lang="en">A description of the probability distribution that expresses the uncertainty of an estimate, giving its family (for example triangular or lognormal) and its parameters.</skos:definition>
        <skos:definition xml:lang="fr">Description de la loi de probabilité qui exprime l&apos;incertitude d&apos;une estimation, indiquant sa famille (par exemple triangulaire ou lognormale) et ses paramètres.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D08 (distributions); estimates already carry bounds, sample size and confidence (0.8.0).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000477 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000477">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">analytical result</rdfs:label>
        <rdfs:label xml:lang="fr">résultat analytique</rdfs:label>
        <skos:definition xml:lang="en">A record of a result computed outside CRGO by a named model and version, such as a CyberRiskGuardian risk calculation, with the inputs it used and when it was computed. CRGO stores it as a proposed risk estimate and never derives it by reasoning.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement d&apos;un résultat calculé hors de CRGO par un modèle et une version nommés, comme un calcul de risque de CyberRiskGuardian, avec les données d&apos;entrée utilisées et la date du calcul. CRGO le conserve comme estimation de risque proposée et ne le déduit jamais par raisonnement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS section 8 (write-back contract); ADR-007: scoring and optimisation stay in the DSS.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO ADR-007, boundary between CRGO and the CyberRiskGuardian decision-support system (2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000478 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000478">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000300"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000479"/>
        <rdfs:label xml:lang="en">governing body</rdfs:label>
        <rdfs:label xml:lang="fr">organe de gouvernance</rdfs:label>
        <skos:altLabel xml:lang="en">board</skos:altLabel>
        <skos:altLabel xml:lang="fr">conseil d&apos;administration</skos:altLabel>
        <skos:definition xml:lang="en">A group of persons with ultimate accountability for directing and overseeing an organisation, such as a board of directors or a board of trustees.</skos:definition>
        <skos:definition xml:lang="fr">Groupe de personnes ayant la responsabilité ultime de diriger et de surveiller une organisation, comme un conseil d&apos;administration ou un conseil des fiduciaires.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4; GIAS Domain III (Governing the Internal Audit Function) addresses the board.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000479 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000479">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000300"/>
        <rdfs:label xml:lang="fr">comité de gouvernance</rdfs:label>
        <rdfs:label xml:lang="en">governance committee</rdfs:label>
        <skos:altLabel xml:lang="en">committee</skos:altLabel>
        <skos:definition xml:lang="en">A group of persons to which a governing body delegates the oversight of a defined area, such as audit, risk or compliance.</skos:definition>
        <skos:definition xml:lang="fr">Groupe de personnes auquel un organe de gouvernance délègue la surveillance d&apos;un domaine défini, comme l&apos;audit, les risques ou la conformité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4 (board and audit committees).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000480 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000480">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000479"/>
        <rdfs:label xml:lang="en">audit committee</rdfs:label>
        <rdfs:label xml:lang="fr">comité d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A governance committee that oversees internal and external audit, financial reporting and the system of internal control.</skos:definition>
        <skos:definition xml:lang="fr">Comité de gouvernance qui surveille l&apos;audit interne et externe, l&apos;information financière et le système de contrôle interne.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Principle 8 (Overseen by the Board).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000481 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000481">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000479"/>
        <rdfs:label xml:lang="fr">comité des risques</rdfs:label>
        <rdfs:label xml:lang="en">risk committee</rdfs:label>
        <skos:definition xml:lang="en">A governance committee that oversees risk appetite, risk exposure and the risk management framework.</skos:definition>
        <skos:definition xml:lang="fr">Comité de gouvernance qui surveille l&apos;appétence pour le risque, l&apos;exposition au risque et le cadre de gestion des risques.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">COSO ERM 2017, component Governance and Culture.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">COSO Enterprise Risk Management: Integrating with Strategy and Performance (2017); component and principle titles cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000482 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">governance role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de gouvernance</rdfs:label>
        <skos:definition xml:lang="en">A role that an agent bears within an organisation&apos;s governance, risk management, control or assurance arrangements, and that can be assigned and withdrawn without the agent changing.</skos:definition>
        <skos:definition xml:lang="fr">Rôle qu&apos;un agent assume dans les dispositifs de gouvernance, de gestion des risques, de contrôle ou d&apos;assurance d&apos;une organisation, et qui peut être attribué ou retiré sans que l&apos;agent change.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Anti-rigid (OntoClean), so a BFO role; GRCA section 4 (temporal role assignment).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 21838-2:2021 / BFO-2020, alignment target</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000483 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000483">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000482"/>
        <rdfs:label xml:lang="en">governing body member role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de membre d&apos;un organe de gouvernance</rdfs:label>
        <skos:definition xml:lang="fr">Rôle d&apos;une personne qui siège à un organe de gouvernance ou à l&apos;un de ses comités.</skos:definition>
        <skos:definition xml:lang="en">The role of a person who sits on a governing body or one of its committees.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000484 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000484">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000482"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000485"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000486"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000487"/>
        <rdfs:label xml:lang="en">first-line role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de première ligne</rdfs:label>
        <skos:definition xml:lang="en">A management role that owns and manages risk in delivering products, services and operations, including designing and operating controls.</skos:definition>
        <skos:definition xml:lang="fr">Rôle de gestion qui assume et gère le risque dans la prestation des produits, des services et des opérations, y compris la conception et le fonctionnement des mesures de contrôle.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4 (Three Lines roles). The IIA Three Lines Model (2020) was not available to CRGO; the role is modelled from the specification.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000485 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000485">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000482"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000486"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000487"/>
        <rdfs:label xml:lang="fr">rôle de deuxième ligne</rdfs:label>
        <rdfs:label xml:lang="en">second-line role</rdfs:label>
        <skos:definition xml:lang="en">A management role that gives expertise, support, monitoring and challenge on risk-related matters, such as risk management or compliance functions.</skos:definition>
        <skos:definition xml:lang="fr">Rôle de gestion qui apporte expertise, soutien, surveillance et remise en question sur les questions de risque, comme les fonctions de gestion des risques ou de conformité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000486 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000486">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000482"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000487"/>
        <rdfs:label xml:lang="fr">rôle de troisième ligne</rdfs:label>
        <rdfs:label xml:lang="en">third-line role</rdfs:label>
        <skos:altLabel xml:lang="en">internal audit role</skos:altLabel>
        <skos:definition xml:lang="fr">Rôle de l&apos;audit interne : assurance et conseil indépendants et objectifs donnés à l&apos;organe de gouvernance et à la direction sur la gouvernance, la gestion des risques et le contrôle.</skos:definition>
        <skos:definition xml:lang="en">The role of internal audit: independent and objective assurance and advice to the governing body and management on governance, risk management and control.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Domain I (Purpose of Internal Auditing); Principle 7 (Positioned Independently).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000487 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000487">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000482"/>
        <rdfs:label xml:lang="en">external assurance role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle d&apos;assurance externe</rdfs:label>
        <skos:definition xml:lang="fr">Rôle d&apos;un agent extérieur à l&apos;organisation, comme un auditeur externe ou un auditeur de services, qui donne une assurance sur sa gouvernance, sa gestion des risques ou son contrôle.</skos:definition>
        <skos:definition xml:lang="en">The role of an agent outside the organisation, such as an external auditor or service auditor, that gives assurance on its governance, risk management or control.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">AICPA 2017 Trust Services Criteria for Security, Availability, Processing Integrity, Confidentiality, and Privacy (revised points of focus, 2022); identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000488 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000488">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000486"/>
        <rdfs:label xml:lang="en">chief audit executive role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de responsable de l&apos;audit interne</rdfs:label>
        <skos:altLabel xml:lang="en">CAE</skos:altLabel>
        <skos:definition xml:lang="fr">Rôle de la personne responsable de diriger la fonction d&apos;audit interne et relevant fonctionnellement de l&apos;organe de gouvernance.</skos:definition>
        <skos:definition xml:lang="en">The role of the person accountable for leading the internal audit function and reporting functionally to the governing body.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standards 7.1 (Organizational Independence) and 7.2 (Chief Audit Executive Qualifications).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000489 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000489">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000485"/>
        <rdfs:label xml:lang="en">compliance officer role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de responsable de la conformité</rdfs:label>
        <skos:definition xml:lang="fr">Rôle de la personne responsable de la fonction conformité : recenser les obligations de conformité, surveiller la façon dont elles sont respectées et en rendre compte.</skos:definition>
        <skos:definition xml:lang="en">The role of the person responsible for the compliance function: identifying compliance obligations, monitoring how they are met and reporting on them.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ISO 37301:2021 clause 5.3 (roles, responsibilities and authorities).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000490 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000490">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000485"/>
        <rdfs:label xml:lang="en">risk management function role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de fonction de gestion des risques</rdfs:label>
        <skos:definition xml:lang="fr">Rôle d&apos;une personne ou d&apos;une unité qui tient à jour le cadre de gestion des risques, remet en question les appréciations du risque et rend compte du risque global.</skos:definition>
        <skos:definition xml:lang="en">The role of a person or unit that maintains the risk management framework, challenges risk assessments and reports aggregate risk.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000491 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000491">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000484"/>
        <rdfs:label xml:lang="en">control owner role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de propriétaire de mesure</rdfs:label>
        <skos:definition xml:lang="fr">Rôle de la personne responsable de la conception et du fonctionnement d&apos;une mesure de sécurité appliquée.</skos:definition>
        <skos:definition xml:lang="en">The role of the person accountable for the design and operation of a control measure.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000492 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000492">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000484"/>
        <rdfs:label xml:lang="en">risk owner role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de propriétaire du risque</rdfs:label>
        <skos:definition xml:lang="fr">Rôle de la personne qui a la responsabilité et l&apos;autorité de gérer un risque, y compris d&apos;en proposer le traitement ou l&apos;acceptation.</skos:definition>
        <skos:definition xml:lang="en">The role of the person with the accountability and authority to manage a risk, including proposing its treatment or acceptance.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Complements the 0.1.0 relation &apos;has risk owner&apos;, which stays the simple way to name an owner.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 31000:2018 (risk treatment options; paraphrased)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000493 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000493">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">attribution de rôle</rdfs:label>
        <rdfs:label xml:lang="en">role assignment</rdfs:label>
        <skos:definition xml:lang="en">A record that an agent bears a governance role over a stated period, so that who held the role on a given date can be answered.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement indiquant qu&apos;un agent assume un rôle de gouvernance pendant une période donnée, afin de pouvoir dire qui occupait le rôle à une date donnée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4 (temporal role assignment): roles change over time, so the period is on the assignment, not on the agent.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000494 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000494">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">delegation of authority</rdfs:label>
        <rdfs:label xml:lang="fr">délégation de pouvoirs</rdfs:label>
        <skos:definition xml:lang="en">A directive by which an agent grants another agent authority to decide or act within a stated scope, limit and period.</skos:definition>
        <skos:definition xml:lang="fr">Directive par laquelle un agent accorde à un autre agent le pouvoir de décider ou d&apos;agir dans une portée, une limite et une période données.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4; GAPS D07.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000495 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000495">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="fr">activité de surveillance</rdfs:label>
        <rdfs:label xml:lang="en">oversight activity</rdfs:label>
        <skos:definition xml:lang="en">A planned act in which a governing body, committee or senior manager reviews and challenges a report, a risk, a decision or an assurance result.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel un organe de gouvernance, un comité ou un cadre supérieur examine et remet en question un rapport, un risque, une décision ou un résultat d&apos;assurance.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 4 (oversight).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000496 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000496">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">independence assessment</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation de l&apos;indépendance</rdfs:label>
        <skos:definition xml:lang="en">A dated record of whether an assessor or assurance function is independent and objective with respect to the activity it assesses, with the threats to independence considered.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant si un évaluateur ou une fonction d&apos;assurance est indépendant et objectif à l&apos;égard de l&apos;activité qu&apos;il évalue, avec les menaces à l&apos;indépendance examinées.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Principles 2 (Maintain Objectivity) and 7 (Positioned Independently); ITAF 1002 and 1003.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000497 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000497">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">policy</rdfs:label>
        <rdfs:label xml:lang="fr">politique</rdfs:label>
        <skos:definition xml:lang="en">A directive approved by an organisation&apos;s governing body or senior management that states its intentions and rules for a domain, such as information security or privacy.</skos:definition>
        <skos:definition xml:lang="fr">Directive approuvée par l&apos;organe de gouvernance ou la haute direction d&apos;une organisation qui énonce ses intentions et ses règles pour un domaine, comme la sécurité de l&apos;information ou la protection des renseignements personnels.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01; ISO 37301:2021 clause 5.2 (compliance policy).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000498 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000498">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000889"/>
        <rdfs:label xml:lang="en">policy statement</rdfs:label>
        <rdfs:label xml:lang="fr">énoncé de politique</rdfs:label>
        <skos:altLabel xml:lang="fr">exigence de politique</skos:altLabel>
        <skos:altLabel xml:lang="en">policy requirement</skos:altLabel>
        <skos:changeNote xml:lang="en">0.10.0 (2026-10-12): alternative labels &apos;policy requirement&apos; / &apos;exigence de politique&apos; added (POL PolicyRequirement).</skos:changeNote>
        <skos:definition xml:lang="en">A single rule within a policy, stated so that compliance with it can be assessed, such as &apos;privileged access is reviewed every quarter&apos;.</skos:definition>
        <skos:definition xml:lang="fr">Règle unique d&apos;une politique, formulée de manière à pouvoir en évaluer le respect, comme « les accès privilégiés sont revus chaque trimestre ».</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01 (obligation, control objective, policy statement, procedure chain).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 6: changes to approved terms beyond D9 (reopens finding, version label, audit finding, policy statement, legal instrument, compliance determination)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000499 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000499">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">norme technique interne</rdfs:label>
        <rdfs:label xml:lang="en">technical standard</rdfs:label>
        <skos:definition xml:lang="en">An internal directive that specifies mandatory technical requirements implementing one or more policy statements, such as a password or encryption standard.</skos:definition>
        <skos:definition xml:lang="fr">Directive interne précisant les exigences techniques obligatoires qui mettent en œuvre un ou plusieurs énoncés de politique, comme une norme de mots de passe ou de chiffrement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01. Not an external standard such as ISO/IEC 27002, which is a framework.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000500 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000500">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="en">procedure</rdfs:label>
        <rdfs:label xml:lang="fr">procédure</rdfs:label>
        <skos:definition xml:lang="en">A plan that sets out the steps by which a policy statement or technical standard is carried out, by whom and when.</skos:definition>
        <skos:definition xml:lang="fr">Plan qui expose les étapes par lesquelles un énoncé de politique ou une norme technique est appliqué, par qui et quand.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000501 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000501">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">configuration baseline</rdfs:label>
        <rdfs:label xml:lang="fr">configuration de référence</rdfs:label>
        <skos:altLabel xml:lang="en">baseline</skos:altLabel>
        <skos:definition xml:lang="en">An approved set of configuration settings that a kind of system must meet, against which deviations are detected.</skos:definition>
        <skos:definition xml:lang="fr">Ensemble approuvé de paramètres de configuration auquel un type de système doit se conformer et par rapport auquel les écarts sont détectés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01 (baseline).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000502 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000502">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000903"/>
        <rdfs:label xml:lang="fr">dérogation</rdfs:label>
        <rdfs:label xml:lang="en">policy exception</rdfs:label>
        <skos:altLabel xml:lang="fr">exemption</skos:altLabel>
        <skos:altLabel xml:lang="en">waiver</skos:altLabel>
        <skos:definition xml:lang="en">A directive that permits a stated deviation from a policy statement, technical standard or control for a stated scope (role, asset or process) and period, approved by an identified authority and usually with compensating controls. It does not waive a legal obligation.</skos:definition>
        <skos:definition xml:lang="fr">Directive qui autorise un écart déterminé par rapport à un énoncé de politique, une norme technique ou une mesure, pour une portée (rôle, actif ou processus) et une période données, approuvée par une autorité identifiée et généralement assortie de mesures compensatoires. Elle ne dispense d&apos;aucune obligation légale.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01; GRCA section 6 (waiver or exception). Distinct from risk acceptance, which retains a risk rather than permitting a deviation from a rule.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000503 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000503">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000020"/>
        <rdfs:label xml:lang="en">compensating control</rdfs:label>
        <rdfs:label xml:lang="fr">mesure compensatoire</rdfs:label>
        <skos:definition xml:lang="en">A control measure put in place because a required control is not, or not fully, implemented, intended to reduce the same risk to a comparable degree.</skos:definition>
        <skos:definition xml:lang="fr">Mesure appliquée mise en place parce qu&apos;une mesure exigée n&apos;est pas, ou pas entièrement, mise en œuvre, et destinée à réduire le même risque dans une mesure comparable.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000504 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000504">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">decision record</rdfs:label>
        <rdfs:label xml:lang="fr">relevé de décision</rdfs:label>
        <skos:definition xml:lang="en">A dated record of a decision taken by an identified agent on a stated subject, such as approving a policy, an exception, a risk acceptance or the closure of a finding, with its outcome and rationale.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté d&apos;une décision prise par un agent identifié sur un objet donné, comme l&apos;approbation d&apos;une politique, d&apos;une dérogation, d&apos;une acceptation du risque ou de la clôture d&apos;une constatation, avec son résultat et sa justification.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D07 (approval record, rejection, deferral, rationale).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000505 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000505">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000504"/>
        <rdfs:label xml:lang="en">exception expiry review</rdfs:label>
        <rdfs:label xml:lang="fr">revue d&apos;échéance de dérogation</rdfs:label>
        <skos:definition xml:lang="en">A decision record made when a policy exception reaches its expiry date, deciding whether it is renewed, changed or ended.</skos:definition>
        <skos:definition xml:lang="fr">Relevé de décision établi lorsqu&apos;une dérogation arrive à échéance, décidant si elle est renouvelée, modifiée ou close.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01 (expiry review).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000506 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000506">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">conflict-of-interest declaration</rdfs:label>
        <rdfs:label xml:lang="fr">déclaration de conflit d&apos;intérêts</rdfs:label>
        <skos:definition xml:lang="en">A dated record in which an agent declares an interest that could impair, or appear to impair, its objectivity on a stated decision or assessment.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté par lequel un agent déclare un intérêt qui pourrait compromettre, ou sembler compromettre, son objectivité à l&apos;égard d&apos;une décision ou d&apos;une évaluation donnée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D07; GIAS Standard 2.3 (Disclosing Impairments to Objectivity).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000507 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000507">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000886"/>
        <rdfs:label xml:lang="en">instrument version</rdfs:label>
        <rdfs:label xml:lang="fr">version d&apos;un instrument</rdfs:label>
        <skos:definition xml:lang="en">A description of one version of a legal instrument or standard as in force or published over a stated period, such as a consolidation of a statute or an edition of a standard.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une version d&apos;un instrument juridique ou d&apos;une norme telle qu&apos;en vigueur ou publiée pendant une période donnée, comme une mise à jour d&apos;une loi ou une édition d&apos;une norme.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 6 (instrument version, supersession); GAPS D09.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000508 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000508">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">amendment</rdfs:label>
        <rdfs:label xml:lang="fr">modification</rdfs:label>
        <skos:definition xml:lang="en">A legal act or publication that changes the text of an instrument, producing a new version from a stated date.</skos:definition>
        <skos:definition xml:lang="fr">Acte juridique ou publication qui modifie le texte d&apos;un instrument et produit une nouvelle version à compter d&apos;une date donnée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D09.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000509 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000509">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">changement réglementaire</rdfs:label>
        <rdfs:label xml:lang="en">regulatory change</rdfs:label>
        <skos:definition xml:lang="en">A record that a legal instrument, provision or regulatory guidance relevant to CRGO users is new, amended or repealed, with the dates it was identified and takes effect.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement indiquant qu&apos;un instrument juridique, une disposition ou une orientation réglementaire pertinent pour les utilisateurs de CRGO est nouveau, modifié ou abrogé, avec ses dates de repérage et de prise d&apos;effet.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 6; GAPS D09.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000510 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000510">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">déclencheur de réévaluation</rdfs:label>
        <rdfs:label xml:lang="en">reassessment trigger</rdfs:label>
        <skos:definition xml:lang="en">A record that an event, such as a regulatory change, an incident, an audit finding or the expiry of an exception, requires an existing assessment or determination to be reviewed.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement indiquant qu&apos;un événement, comme un changement réglementaire, un incident, une constatation d&apos;audit ou l&apos;échéance d&apos;une dérogation, exige la révision d&apos;une évaluation ou d&apos;un constat existant.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D09 (reassessment trigger).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000511 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000511">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">non-conformité</rdfs:label>
        <rdfs:label xml:lang="en">nonconformity</rdfs:label>
        <skos:definition xml:lang="en">A dated record that a stated requirement, such as a provision, policy statement or management-system requirement, is not fulfilled by an organisation, raised by an audit, an assessment or self-reporting.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant qu&apos;une exigence donnée, comme une disposition, un énoncé de politique ou une exigence de système de management, n&apos;est pas satisfaite par une organisation, relevé par un audit, une évaluation ou une déclaration interne.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ISO 37301:2021 clause 10.2 (nonconformity and corrective action); ISO 19011:2018 clause 6.4 (audit findings may be nonconformities).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000512 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000512">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">evidence requirement</rdfs:label>
        <rdfs:label xml:lang="fr">exigence de preuve</rdfs:label>
        <skos:definition xml:lang="en">A directive stating what evidence must exist, and how it may be obtained, for a requirement or obligation to be shown as met.</skos:definition>
        <skos:definition xml:lang="fr">Directive précisant quelles preuves doivent exister, et comment elles peuvent être obtenues, pour démontrer qu&apos;une exigence ou une obligation est respectée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 6.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000513 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">obligated party role</rdfs:label>
        <rdfs:label xml:lang="fr">rôle de partie assujettie</rdfs:label>
        <skos:definition xml:lang="fr">Rôle d&apos;une organisation ou d&apos;une personne liée par une obligation ou une disposition légale.</skos:definition>
        <skos:definition xml:lang="en">The role of an organisation or person that a legal obligation or provision binds.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 6. Anti-rigid: an organisation is obligated only under a given instrument.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000514 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000514">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">documentary evidence</rdfs:label>
        <rdfs:label xml:lang="fr">preuve documentaire</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing documents, such as policies, contracts, plans or records prepared in the course of business.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant des documents, comme des politiques, des contrats, des plans ou des registres établis dans le cours des activités.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 9; ITAF 1205 (Evidence).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000515 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000515">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">configuration evidence</rdfs:label>
        <rdfs:label xml:lang="fr">preuve de configuration</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing system settings or configuration exports captured from a system at a stated time.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant des paramètres ou des exportations de configuration saisis dans un système à un moment donné.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000516 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000516">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="fr">preuve transactionnelle</rdfs:label>
        <rdfs:label xml:lang="en">transactional evidence</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing records of individual transactions or events, such as access requests, change tickets or log entries, from which samples can be drawn.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant des enregistrements de transactions ou d&apos;événements individuels, comme des demandes d&apos;accès, des billets de changement ou des entrées de journal, dans lesquels on peut prélever des échantillons.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000517 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000517">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">operational evidence</rdfs:label>
        <rdfs:label xml:lang="fr">preuve opérationnelle</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing output of the routine operation or monitoring of a control, such as reports, dashboards or alerts.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant le produit du fonctionnement courant ou de la surveillance d&apos;une mesure, comme des rapports, des tableaux de bord ou des alertes.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000518 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000518">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">interview evidence</rdfs:label>
        <rdfs:label xml:lang="fr">preuve par entretien</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing statements obtained by questioning knowledgeable persons, with who was interviewed and when.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant des déclarations obtenues en interrogeant des personnes compétentes, avec l&apos;identité des personnes interrogées et la date.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-53A Rev. 5 assessment objectives and methods (examine, interview, test), as carried in the SP 800-53 Rev. 5.2.0 OSCAL catalogue (2026-05-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000519 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000519">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">observational evidence</rdfs:label>
        <rdfs:label xml:lang="fr">preuve par observation</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing what an assessor saw while watching a process or control being performed.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant ce qu&apos;un évaluateur a constaté en observant l&apos;exécution d&apos;un processus ou d&apos;une mesure.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ISO/IEC TS 27008:2019 clause 7.3 (inspection techniques).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC TS 27008:2019, Guidelines for the assessment of information security controls (1st edition, 2019-01); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000520 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000520">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="fr">preuve d&apos;essai</rdfs:label>
        <rdfs:label xml:lang="en">test evidence</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing the result of an assessor exercising or re-performing a control under stated conditions and comparing actual with expected behaviour.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant le résultat d&apos;un évaluateur qui actionne ou réexécute une mesure dans des conditions données et compare le comportement réel au comportement attendu.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ISO/IEC TS 27008:2019 clause 7.4 (testing and validation techniques).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC TS 27008:2019, Guidelines for the assessment of information security controls (1st edition, 2019-01); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-53A Rev. 5 assessment objectives and methods (examine, interview, test), as carried in the SP 800-53 Rev. 5.2.0 OSCAL catalogue (2026-05-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000521 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000521">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">governance evidence</rdfs:label>
        <rdfs:label xml:lang="fr">preuve de gouvernance</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing governance acts, such as minutes, approvals, charters or delegations.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant des actes de gouvernance, comme des procès-verbaux, des approbations, des chartes ou des délégations.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000522 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000522">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="en">external assurance report</rdfs:label>
        <rdfs:label xml:lang="fr">rapport d&apos;assurance externe</rdfs:label>
        <skos:definition xml:lang="en">An evidence item describing a report issued by an independent assurer on an organisation&apos;s or a service provider&apos;s controls, such as a SOC 1 or SOC 2 report or a certification audit report, with its type, period, scope, opinion, exceptions and the controls it expects users to operate.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve décrivant un rapport émis par un assureur indépendant sur les mesures d&apos;une organisation ou d&apos;un fournisseur de services, comme un rapport SOC 1 ou SOC 2 ou un rapport d&apos;audit de certification, avec son type, sa période, son périmètre, son opinion, ses exceptions et les mesures qu&apos;il attend des utilisateurs.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 9 (SOC report scope, period, exceptions, CUECs).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">AICPA 2017 Trust Services Criteria for Security, Availability, Processing Integrity, Confidentiality, and Privacy (revised points of focus, 2022); identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000523 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000523">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">assurance report exception</rdfs:label>
        <rdfs:label xml:lang="fr">exception de rapport d&apos;assurance</rdfs:label>
        <skos:definition xml:lang="en">A deviation reported in an external assurance report, where a tested control did not operate as described during the period.</skos:definition>
        <skos:definition xml:lang="fr">Écart signalé dans un rapport d&apos;assurance externe, lorsqu&apos;une mesure testée n&apos;a pas fonctionné comme décrit pendant la période.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000524 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000524">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">complementary user entity control</rdfs:label>
        <rdfs:label xml:lang="fr">mesure complémentaire de l&apos;entité utilisatrice</rdfs:label>
        <skos:altLabel xml:lang="en">CUEC</skos:altLabel>
        <skos:definition xml:lang="en">A control that an external assurance report assumes the user organisation operates, without which the service provider&apos;s controls may not achieve their objectives.</skos:definition>
        <skos:definition xml:lang="fr">Mesure que le rapport d&apos;assurance externe suppose exploitée par l&apos;organisation utilisatrice, sans laquelle les mesures du fournisseur de services pourraient ne pas atteindre leurs objectifs.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 9.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000525 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000525">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">evidence sufficiency assessment</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation du caractère suffisant des preuves</rdfs:label>
        <skos:definition xml:lang="en">A dated record of an assessor&apos;s judgement of whether the evidence gathered is sufficient, relevant, current and in scope for a stated objective or criterion.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté du jugement d&apos;un évaluateur sur le caractère suffisant, pertinent, actuel et conforme au périmètre des preuves recueillies pour un objectif ou un critère donné.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 9 (explicit sufficiency assessment); ITAF 1205; GIAS Standard 14.1.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000526 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000526">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000347"/>
        <rdfs:label xml:lang="en">operating effectiveness assessment</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation de l&apos;efficacité opérationnelle</rdfs:label>
        <skos:definition xml:lang="en">A control assessment that tests whether a control measure operated as designed throughout a stated period, over a stated population or sample.</skos:definition>
        <skos:definition xml:lang="fr">Évaluation de mesure qui vérifie si une mesure appliquée a fonctionné comme prévu pendant toute une période donnée, sur une population ou un échantillon donné.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D05 (operating effectiveness over a period and population).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000527 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000527">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">control deficiency</rdfs:label>
        <rdfs:label xml:lang="fr">déficience de contrôle</rdfs:label>
        <skos:definition xml:lang="en">A record that the design, implementation or operation of an existing control measure does not allow it to meet its objective, identified by a control assessment, with its severity. Unlike a control gap, which describes an expected control that is absent or inadequate (often in a risk scenario), a deficiency is an assessed result about a measure in place.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement indiquant que la conception, la mise en œuvre ou le fonctionnement d&apos;une mesure appliquée existante ne lui permet pas d&apos;atteindre son objectif, relevé par une évaluation de mesure, avec sa gravité. Contrairement à un écart de contrôle, qui décrit un contrôle attendu absent ou insuffisant (souvent dans un scénario de risque), une déficience est un résultat d&apos;évaluation portant sur une mesure en place.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D05 (deficiency). Distinguished from the 0.1.0 control gap in the definition (independent review, 2026-10-11).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000528 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000528">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">population</rdfs:label>
        <rdfs:label xml:lang="fr">population</rdfs:label>
        <skos:definition xml:lang="en">A description of the complete set of items, such as transactions, accounts or events over a period, from which a sample is drawn or over which a control is tested.</skos:definition>
        <skos:definition xml:lang="fr">Description de l&apos;ensemble complet des éléments, comme des transactions, des comptes ou des événements sur une période, dans lequel un échantillon est prélevé ou sur lequel une mesure est testée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ITAF 2208 (Information Technology Audit Sampling).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000529 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000529">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="fr">plan d&apos;échantillonnage</rdfs:label>
        <rdfs:label xml:lang="en">sampling plan</rdfs:label>
        <skos:definition xml:lang="en">A plan that states how items are selected from a population, how many, and the tolerable and expected deviation on which the sample size is based.</skos:definition>
        <skos:definition xml:lang="fr">Plan qui précise comment les éléments sont choisis dans une population, combien, et les taux d&apos;écart tolérable et attendu sur lesquels repose la taille de l&apos;échantillon.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ITAF 2208; ISO/IEC TS 27008:2019 clause 7.5 (sampling techniques).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC TS 27008:2019, Guidelines for the assessment of information security controls (1st edition, 2019-01); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000530 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000530">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">sample item</rdfs:label>
        <rdfs:label xml:lang="fr">élément d&apos;échantillon</rdfs:label>
        <skos:definition xml:lang="en">A description of one item selected under a sampling plan and the result of testing it.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un élément choisi selon un plan d&apos;échantillonnage et du résultat de son essai.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000531 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000531">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">audit universe</rdfs:label>
        <rdfs:label xml:lang="fr">univers d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A description of all the auditable entities of an organisation from which the internal audit plan is drawn.</skos:definition>
        <skos:definition xml:lang="fr">Description de toutes les entités auditables d&apos;une organisation dans laquelle est puisé le plan d&apos;audit interne.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 9.4 (Internal Audit Plan).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000532 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000532">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">auditable entity</rdfs:label>
        <rdfs:label xml:lang="fr">entité auditable</rdfs:label>
        <skos:definition xml:lang="en">A description of a unit, process, system, programme or third party that can be the subject of an audit engagement.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une unité, d&apos;un processus, d&apos;un système, d&apos;un programme ou d&apos;un tiers qui peut faire l&apos;objet d&apos;une mission d&apos;audit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000533 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000533">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="en">audit plan</rdfs:label>
        <rdfs:label xml:lang="fr">plan d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A plan, usually approved by the governing body, that sets out the audit engagements to be performed over a stated period and why.</skos:definition>
        <skos:definition xml:lang="fr">Plan, généralement approuvé par l&apos;organe de gouvernance, qui énumère les missions d&apos;audit à réaliser pendant une période donnée et leur justification.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 9.4; ITAF 1202 (Audit Scheduling).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000534 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000534">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="en">audit work programme</rdfs:label>
        <rdfs:label xml:lang="fr">programme de travail d&apos;audit</rdfs:label>
        <skos:altLabel xml:lang="en">work program</skos:altLabel>
        <skos:definition xml:lang="en">A reusable plan of audit procedures for a domain, giving objectives, criteria, control references, methods, expected evidence, population and sampling rationale.</skos:definition>
        <skos:definition xml:lang="fr">Plan réutilisable de procédures d&apos;audit pour un domaine, indiquant les objectifs, les critères, les références de mesures, les méthodes, les preuves attendues, la population et la justification de l&apos;échantillonnage.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 8; GIAS Standard 13.6 (Work Program). Not the ISO 19011 &apos;audit programme&apos;, which is a set of audits: that is the audit plan here.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000535 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000535">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="en">audit procedure</rdfs:label>
        <rdfs:label xml:lang="fr">procédure d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A plan for one audit step, stating the assessment method, the objectives it serves, the evidence to obtain, the expected result and when a deviation counts as an exception.</skos:definition>
        <skos:definition xml:lang="fr">Plan d&apos;une étape d&apos;audit, indiquant la méthode d&apos;évaluation, les objectifs visés, les preuves à obtenir, le résultat attendu et les conditions dans lesquelles un écart constitue une exception.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000536 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000536">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="en">audit engagement</rdfs:label>
        <rdfs:label xml:lang="fr">mission d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A planned act of assurance or advice on an auditable entity, with stated objectives, scope, criteria and period, performed by an audit team.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié d&apos;assurance ou de conseil sur une entité auditable, avec des objectifs, un périmètre, des critères et une période donnés, réalisé par une équipe d&apos;audit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Principle 13 (Plan Engagements Effectively); ISO 19011:2018 clause 6 (conducting an audit).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000537 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000537">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000476"/>
        <rdfs:label xml:lang="en">audit objective</rdfs:label>
        <rdfs:label xml:lang="fr">objectif d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">An objective stating what an audit engagement is to establish, such as whether access to a system is restricted to authorised users.</skos:definition>
        <skos:definition xml:lang="fr">Objectif précisant ce qu&apos;une mission d&apos;audit doit établir, par exemple si l&apos;accès à un système est réservé aux utilisateurs autorisés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 13.3 (Engagement Objectives and Scope).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000538 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000538">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">audit criterion</rdfs:label>
        <rdfs:label xml:lang="fr">critère d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A requirement used as the reference against which the condition found is compared, such as a provision, a control objective, a policy statement or an assessment objective.</skos:definition>
        <skos:definition xml:lang="fr">Exigence servant de référence à laquelle la situation constatée est comparée, comme une disposition, un objectif de mesure, un énoncé de politique ou un objectif d&apos;évaluation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 13.4 (Evaluation Criteria); ITAF 1008 (Criteria).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000539 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000539">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">demande de preuves</rdfs:label>
        <rdfs:label xml:lang="en">evidence request</rdfs:label>
        <skos:definition xml:lang="en">A request from an assessor to an identified agent for stated evidence by a stated date.</skos:definition>
        <skos:definition xml:lang="fr">Demande adressée par un évaluateur à un agent identifié pour obtenir des preuves déterminées à une date donnée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000540 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000540">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000541"/>
        <rdfs:label xml:lang="fr">exception de surveillance</rdfs:label>
        <rdfs:label xml:lang="en">monitoring exception</rdfs:label>
        <skos:definition xml:lang="en">A record that continuous monitoring, such as a key risk indicator or automated control check, flagged a deviation. It is not an audit finding; it becomes the basis of one only if an audit engagement evaluates it against criteria.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement indiquant qu&apos;une surveillance continue, comme un indicateur clé de risque ou une vérification automatisée, a signalé un écart. Ce n&apos;est pas une constatation d&apos;audit; il n&apos;en devient le fondement que si une mission d&apos;audit l&apos;évalue au regard de critères.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GRCA section 10 (monitoring exception differs from audit finding).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000541 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000541">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000910"/>
        <rdfs:label xml:lang="en">audit finding</rdfs:label>
        <rdfs:label xml:lang="fr">constatation d&apos;audit</rdfs:label>
        <skos:changeNote xml:lang="en">0.10.0 (decision D8, 2026-10-12): alternative label &apos;audit observation&apos; removed; audit observation is now a separate class, disjoint from audit finding.</skos:changeNote>
        <skos:definition xml:lang="en">A record, made in an audit engagement, of the difference between a criterion and the condition found, with its observed or hypothesised cause, its effect, its significance and the evidence relied on.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement, établi dans une mission d&apos;audit, de l&apos;écart entre un critère et la situation constatée, avec sa cause observée ou présumée, son effet, son importance et les preuves retenues.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standards 14.2-14.3; ISO 19011:2018 clause 6.4.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 6: changes to approved terms beyond D9 (reopens finding, version label, audit finding, policy statement, legal instrument, compliance determination)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000542 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000542">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000891"/>
        <rdfs:label xml:lang="en">audit conclusion</rdfs:label>
        <rdfs:label xml:lang="fr">conclusion d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A record of the overall result of an audit engagement against its objectives, based on its findings.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement du résultat global d&apos;une mission d&apos;audit au regard de ses objectifs, fondé sur ses constatations.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 14.5 (Engagement Conclusions).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000543 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000543">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">audit report</rdfs:label>
        <rdfs:label xml:lang="fr">rapport d&apos;audit</rdfs:label>
        <skos:definition xml:lang="en">A document that communicates an audit engagement&apos;s objectives, scope, findings, conclusions, recommendations and management responses.</skos:definition>
        <skos:definition xml:lang="fr">Document qui communique les objectifs, le périmètre, les constatations, les conclusions, les recommandations et les réponses de la direction d&apos;une mission d&apos;audit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 15.1 (Final Engagement Communication); ITAF 1401 (Reporting).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000544 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000544">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">recommandation</rdfs:label>
        <rdfs:label xml:lang="en">recommendation</rdfs:label>
        <skos:definition xml:lang="en">A directive proposed by an assessor to address the cause or effect of a finding.</skos:definition>
        <skos:definition xml:lang="fr">Directive proposée par un évaluateur pour remédier à la cause ou à l&apos;effet d&apos;une constatation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 14.4 (Recommendations and Action Plans).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000545 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000545">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">management response</rdfs:label>
        <rdfs:label xml:lang="fr">réponse de la direction</rdfs:label>
        <skos:definition xml:lang="en">A dated record of management&apos;s position on a finding or recommendation, such as agreeing and committing to action, disagreeing, or accepting the risk.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté de la position de la direction sur une constatation ou une recommandation, comme l&apos;accord et l&apos;engagement à agir, le désaccord ou l&apos;acceptation du risque.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000546 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000546">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="fr">action corrective</rdfs:label>
        <rdfs:label xml:lang="en">corrective action</rdfs:label>
        <skos:altLabel xml:lang="en">action plan</skos:altLabel>
        <skos:altLabel xml:lang="fr">plan d&apos;action</skos:altLabel>
        <skos:definition xml:lang="en">A plan of action by an owner, with a due date, to eliminate the cause of a finding or nonconformity and prevent its recurrence.</skos:definition>
        <skos:definition xml:lang="fr">Plan d&apos;action confié à un responsable, avec une échéance, pour éliminer la cause d&apos;une constatation ou d&apos;une non-conformité et en empêcher la répétition.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">ISO 37301:2021 clause 10.2.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000547 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000547">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="en">follow-up verification</rdfs:label>
        <rdfs:label xml:lang="fr">vérification de suivi</rdfs:label>
        <skos:definition xml:lang="en">A planned act in which an assessor independent of the action owner checks whether a corrective action was implemented and is effective.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel un évaluateur indépendant du responsable de l&apos;action vérifie si une action corrective a été mise en œuvre et si elle est efficace.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GIAS Standard 15.2; ITAF 1402 (Follow-up Activities); ISO 19011:2018 clause 6.7.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000548 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000548">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000549"/>
        <rdfs:label xml:lang="fr">clôture de constatation</rdfs:label>
        <rdfs:label xml:lang="en">finding closure</rdfs:label>
        <skos:definition xml:lang="en">A dated record that a finding is closed, citing the follow-up verification or the risk acceptance it relies on.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant qu&apos;une constatation est close, en citant la vérification de suivi ou l&apos;acceptation du risque sur laquelle il s&apos;appuie.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000549 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000549">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">finding reopening</rdfs:label>
        <rdfs:label xml:lang="fr">réouverture de constatation</rdfs:label>
        <skos:definition xml:lang="en">A dated record that a closed finding is reopened, with the reason, such as the recurrence of the condition.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant qu&apos;une constatation close est rouverte, avec le motif, comme la réapparition de la situation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 3</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000550 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">security event</rdfs:label>
        <rdfs:label xml:lang="fr">événement de sécurité</rdfs:label>
        <skos:definition xml:lang="en">An observable occurrence in an information system or network that may be relevant to security, such as a failed login or a malware detection. An event can be part of an incident; most events are not.</skos:definition>
        <skos:definition xml:lang="fr">Occurrence observable dans un système d&apos;information ou un réseau qui peut intéresser la sécurité, comme un échec d&apos;ouverture de session ou une détection de logiciel malveillant. Un événement peut faire partie d&apos;un incident; la plupart n&apos;en font pas partie.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D06. Not disjoint from incident: an incident consists of one or more events (independent review, 2026-10-11).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000551 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000551">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">alerte de sécurité</rdfs:label>
        <rdfs:label xml:lang="en">security alert</rdfs:label>
        <skos:definition xml:lang="en">A notification, generated by a monitoring tool or a person, that one or more security events may indicate an incident and need triage.</skos:definition>
        <skos:definition xml:lang="fr">Notification, produite par un outil de surveillance ou une personne, indiquant qu&apos;un ou plusieurs événements de sécurité pourraient signaler un incident et doivent être triés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D06.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000552 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000552">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0001104"/>
        <rdfs:label xml:lang="fr">confirmation d&apos;incident</rdfs:label>
        <rdfs:label xml:lang="en">incident confirmation</rdfs:label>
        <skos:definition xml:lang="en">A dated record, made by an identified agent, that an incident has occurred, citing the alerts or events it is based on.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté, établi par un agent identifié, indiquant qu&apos;un incident s&apos;est produit, en citant les alertes ou événements sur lesquels il s&apos;appuie.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D06 (confirmed incident versus event). Modelled as a record because being confirmed is a status, not a kind of incident.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000553 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000553">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">breach reportability assessment</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation du caractère déclarable d&apos;un incident</rdfs:label>
        <skos:definition xml:lang="en">A dated record of whether an incident must be reported to a regulator or to affected persons under a stated provision, such as a confidentiality incident presenting a risk of serious injury under Loi 25 or a personal data breach under the GDPR.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant si un incident doit être déclaré à une autorité ou aux personnes concernées en vertu d&apos;une disposition donnée, comme un incident de confidentialité présentant un risque de préjudice sérieux selon la Loi 25 ou une violation de données à caractère personnel selon le RGPD.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D06 (reportable breach); Loi 25 s. 3.5; GDPR Arts. 33-34.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000554 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000554">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">entrée de chronologie d&apos;incident</rdfs:label>
        <rdfs:label xml:lang="en">incident timeline entry</rdfs:label>
        <skos:definition xml:lang="en">A dated entry in the timeline of an incident, recording what happened or was done and in which response phase.</skos:definition>
        <skos:definition xml:lang="fr">Entrée datée de la chronologie d&apos;un incident, indiquant ce qui s&apos;est passé ou a été fait et dans quelle phase de réponse.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000555 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000555">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">lesson learned</rdfs:label>
        <rdfs:label xml:lang="fr">leçon apprise</rdfs:label>
        <skos:definition xml:lang="en">A record of what an incident or exercise showed should change, such as a control, procedure or scenario estimate.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement de ce qu&apos;un incident ou un exercice a montré devoir changer, comme une mesure, une procédure ou l&apos;estimation d&apos;un scénario.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 4 (module kept)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000556 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000556">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">knowledge status</rdfs:label>
        <rdfs:label xml:lang="fr">statut épistémique</rdfs:label>
        <skos:definition xml:lang="fr">Catégorie épistémique d&apos;un enregistrement ou d&apos;une assertion, indiquant de quel type d&apos;affirmation il s&apos;agit et donc dans quelle mesure on peut s&apos;y fier.</skos:definition>
        <skos:definition xml:lang="en">The epistemic category of a record or assertion, saying what kind of claim it is and so how far it can be relied on.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000565 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000565">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">source access status</rdfs:label>
        <rdfs:label xml:lang="fr">statut d&apos;accès à la source</rdfs:label>
        <skos:definition xml:lang="fr">Indique si CRGO détient une source et peut l&apos;utiliser, et donc ce qu&apos;il peut en importer.</skos:definition>
        <skos:definition xml:lang="en">Whether CRGO holds and may use a source, and so what it can import from it.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Value set; members listed below.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 5 (all terms, including the GRCA additions)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000571 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000571">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">evidence quality</rdfs:label>
        <rdfs:label xml:lang="fr">qualité des preuves</rdfs:label>
        <skos:definition xml:lang="fr">Degré auquel les preuves qui sous-tendent une estimation ou une conclusion l&apos;appuient.</skos:definition>
        <skos:definition xml:lang="en">How strongly the evidence behind an estimate or conclusion supports it.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>

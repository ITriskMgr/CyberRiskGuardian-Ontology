        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0001063 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0001063">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000912"/>
        <rdfs:label xml:lang="en">mapped edition</rdfs:label>
        <rdfs:label xml:lang="fr">édition mise en correspondance</rdfs:label>
        <skos:definition xml:lang="en">Relates a mapping assertion to the source record or version of each side that was mapped, so that a later edition does not silently change it.</skos:definition>
        <skos:definition xml:lang="fr">Relie une assertion de correspondance à la notice de source ou à la version de chaque côté mise en correspondance, pour qu&apos;une édition ultérieure ne la modifie pas à l&apos;insu de tous.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">POL section 10 (edition changes must not silently mutate historical claims).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0001064 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0001064">
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000994"/>
        <rdfs:label xml:lang="fr">a pour état de revue</rdfs:label>
        <rdfs:label xml:lang="en">has review state</rdfs:label>
        <skos:definition xml:lang="en">Gives the review state of an organisation record such as a mapping assertion. A requirement interpretation also has a legal review state, which says whether counsel has reviewed it.</skos:definition>
        <skos:definition xml:lang="fr">Indique l&apos;état de la revue d&apos;un enregistrement d&apos;une organisation, comme une assertion de correspondance. Une interprétation d&apos;exigence a aussi un état de revue juridique, qui indique si un conseiller juridique l&apos;a revue.</skos:definition>
        <skos:scopeNote xml:lang="en">At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL.</skos:scopeNote>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0001065 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0001065">
        <rdfs:label xml:lang="en">reviewed by</rdfs:label>
        <rdfs:label xml:lang="fr">revu par</rdfs:label>
        <skos:definition xml:lang="en">Relates a record, such as a mapping assertion, a requirement interpretation, an audit workpaper or a report, to an agent who reviewed it.</skos:definition>
        <skos:definition xml:lang="fr">Relie un enregistrement, comme une assertion de correspondance, une interprétation d&apos;exigence, une feuille de travail ou un rapport d&apos;audit, à un agent qui l&apos;a revu.</skos:definition>

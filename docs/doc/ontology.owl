    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000033 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000033">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">cost allocation</rdfs:label>
        <rdfs:label xml:lang="fr">répartition des coûts</rdfs:label>
        <skos:definition xml:lang="en">A description of the share of a treatment initiative&apos;s initial and recurring cost charged to one risk scenario.</skos:definition>
        <skos:definition xml:lang="fr">Description de la part des coûts initiaux et récurrents d&apos;une initiative de traitement imputée à un scénario de risque.</skos:definition>

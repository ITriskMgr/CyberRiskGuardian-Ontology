    <!-- https://w3id.org/crgo/CRGO_0001062 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0001062">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000912"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000985"/>
        <rdfs:label xml:lang="fr">a pour type de correspondance</rdfs:label>
        <rdfs:label xml:lang="en">has mapping type</rdfs:label>
        <skos:definition xml:lang="en">Gives how the source of a mapping assertion corresponds to its target.</skos:definition>
        <skos:definition xml:lang="fr">Indique comment la source d&apos;une assertion de correspondance correspond à sa cible.</skos:definition>
        <skos:scopeNote xml:lang="en">At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL.</skos:scopeNote>

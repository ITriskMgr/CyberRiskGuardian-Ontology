    <!-- https://w3id.org/crgo/CRGO_0000648 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000648">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000645"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000646"/>
        <rdfs:label xml:lang="en">systematic selection</rdfs:label>
        <rdfs:label xml:lang="fr">sélection systématique</rdfs:label>
        <skos:definition xml:lang="en">Every n-th item is selected from a random start.</skos:definition>
        <skos:definition xml:lang="fr">Un élément sur n est choisi à partir d&apos;un point de départ aléatoire.</skos:definition>
        <skos:notation>2</skos:notation>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

    <!-- https://w3id.org/crgo/CRGO_0000183 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000183">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000011"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:label xml:lang="en">valuation of</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation de</rdfs:label>
        <skos:definition xml:lang="en">Relates an asset valuation to the entity it values.</skos:definition>
        <skos:definition xml:lang="fr">Relie une évaluation d&apos;actif à l&apos;entité qu&apos;elle évalue.</skos:definition>
        <skos:scopeNote xml:lang="en">At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL.</skos:scopeNote>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>

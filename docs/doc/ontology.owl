        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000055 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000055">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000050"/>
        <rdfs:label xml:lang="fr">ratio risque/tolérance</rdfs:label>
        <rdfs:label xml:lang="en">risk-to-tolerance ratio</rdfs:label>
        <skos:definition xml:lang="en">A computed risk quantity equal to residual risk divided by tolerated risk; below 0.90 is below tolerance and above 1.10 is above tolerance.</skos:definition>
        <skos:definition xml:lang="fr">Quantité de risque calculée égale au risque résiduel divisé par le risque toléré; sous 0,90 le risque est sous la tolérance et au-dessus de 1,10 il la dépasse.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000056 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000056">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000050"/>
        <rdfs:label xml:lang="en">cost-effectiveness</rdfs:label>
        <rdfs:label xml:lang="fr">rapport coût-efficacité</rdfs:label>
        <skos:definition xml:lang="en">A computed risk quantity equal to (estimated risk − residual risk) ÷ treatment cost × 1,000, the risk units removed per $1,000; the cost basis (first-year, annual or multi-year) is stated with the value.</skos:definition>
        <skos:definition xml:lang="fr">Quantité de risque calculée égale à (risque estimé − risque résiduel) ÷ coût du traitement × 1 000, soit les unités de risque retirées par tranche de 1 000 $.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    



        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000339"/>
        <rdfs:label xml:lang="en">depends on assumption</rdfs:label>
        <rdfs:label xml:lang="fr">repose sur l&apos;hypothèse</rdfs:label>

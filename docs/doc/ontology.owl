        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000409 -->



    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000447 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000447">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
        <rdfs:label xml:lang="en">comparable obligation</rdfs:label>
        <rdfs:label xml:lang="fr">obligation comparable</rdfs:label>
        <skos:definition xml:lang="en">Relates an obligation in one legal regime to a comparable obligation in another regime; comparable is not equivalent, and the annotation states the differences.</skos:definition>
        <skos:definition xml:lang="fr">Relie une obligation d&apos;un régime juridique à une obligation comparable d&apos;un autre régime; comparable ne veut pas dire équivalente, et l&apos;annotation précise les différences.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification section 3: framework mapping is not legal equivalence.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000448 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000448">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <rdfs:label xml:lang="fr">même obligation dans un autre régime</rdfs:label>
        <rdfs:label xml:lang="en">same obligation in another regime</rdfs:label>

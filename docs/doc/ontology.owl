        <rdfs:label xml:lang="en">related mapping</rdfs:label>
        <skos:definition xml:lang="fr">La source et la cible portent sur le même sujet sans couverture.</skos:definition>
        <skos:definition xml:lang="en">Source and target concern the same subject without coverage.</skos:definition>
        <skos:notation>6</skos:notation>

    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000823 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000823">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000555"/>
        <rdfs:label xml:lang="fr">recommande de modifier</rdfs:label>
        <rdfs:label xml:lang="en">recommends change to</rdfs:label>
        <skos:definition xml:lang="en">Relates a lesson learned to a control, procedure, scenario or estimate it says should change.</skos:definition>
        <skos:definition xml:lang="fr">Relie une leçon apprise à une mesure, une procédure, un scénario ou une estimation qu&apos;elle recommande de modifier.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>

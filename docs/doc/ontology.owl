        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/crgo/CRGO_0000989 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000989">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000985"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000986"/>
        <rdfs:label xml:lang="fr">couverture partielle</rdfs:label>
        <rdfs:label xml:lang="en">partial coverage</rdfs:label>
        <skos:definition xml:lang="en">Meeting the source meets only part of the target.</skos:definition>
        <skos:definition xml:lang="fr">Respecter la source ne permet de respecter qu&apos;une partie de la cible.</skos:definition>
        <skos:notation>3</skos:notation>

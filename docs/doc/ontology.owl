        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000054 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000054">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000050"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000299"/>
        <rdfs:label xml:lang="en">residual risk</rdfs:label>
        <rdfs:label xml:lang="fr">risque résiduel</rdfs:label>
        <skos:definition xml:lang="en">A computed risk quantity equal to estimated risk minus mitigated risk.</skos:definition>

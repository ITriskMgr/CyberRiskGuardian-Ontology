        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Free text from the 2023 generator; not a Control or ControlMeasure until reviewed.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 3 repair of the 2023 scenario library (decision Q-E, option 3), data/library/REPAIR_REPORT.md</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.2.0</crgo:CRGO_0000291>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000331 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/crgo/CRGO_0000331">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="fr">borne inférieure</rdfs:label>
        <rdfs:label xml:lang="en">lower bound</rdfs:label>
        <skos:definition xml:lang="en">Gives the smallest value observed or allowed for an estimate, such as the minimum across merged source records.</skos:definition>
        <skos:definition xml:lang="fr">Indique la plus petite valeur observée ou admise pour une estimation, comme le minimum parmi des enregistrements sources fusionnés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">Phase 3 repair of the 2023 scenario library (decision Q-E, option 3), data/library/REPAIR_REPORT.md</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.2.0</crgo:CRGO_0000291>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000332 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/crgo/CRGO_0000332">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="fr">borne supérieure</rdfs:label>
        <rdfs:label xml:lang="en">upper bound</rdfs:label>
        <skos:definition xml:lang="en">Gives the largest value observed or allowed for an estimate, such as the maximum across merged source records.</skos:definition>
        <skos:definition xml:lang="fr">Indique la plus grande valeur observée ou admise pour une estimation, comme le maximum parmi des enregistrements sources fusionnés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">Phase 3 repair of the 2023 scenario library (decision Q-E, option 3), data/library/REPAIR_REPORT.md</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.2.0</crgo:CRGO_0000291>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000333 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/crgo/CRGO_0000333">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">sample size</rdfs:label>
        <rdfs:label xml:lang="fr">taille d&apos;échantillon</rdfs:label>
        <skos:definition xml:lang="en">Gives how many source values an aggregated estimate was computed from.</skos:definition>
        <skos:definition xml:lang="fr">Indique le nombre de valeurs sources à partir desquelles une estimation agrégée a été calculée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">Phase 3 repair of the 2023 scenario library (decision Q-E, option 3), data/library/REPAIR_REPORT.md</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.2.0</crgo:CRGO_0000291>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An entity is anything that exists or has existed or will exist</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000016 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000016">
        <rdfs:label xml:lang="en">disposition</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed &amp; b&apos;s realization occurs when and because this bearer is in some special physical circumstances &amp; this realization occurs in virtue of the bearer&apos;s physical make-up</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- https://w3id.org/crgo/CRGO_0000001 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:label xml:lang="fr">actif</rdfs:label>
        <rdfs:label xml:lang="en">asset</rdfs:label>
        <skos:definition xml:lang="en">An information, software, hardware, network, service or facility entity of a kind used to process, store, transmit or protect information or to deliver services; whether and how much a given organisation values it is recorded in an asset valuation.</skos:definition>
        <skos:definition xml:lang="fr">Entité informationnelle, logicielle, matérielle, réseau, de service ou d&apos;installation d&apos;un type utilisé pour traiter, stocker, transmettre ou protéger de l&apos;information ou pour fournir des services; la valeur qu&apos;une organisation donnée lui accorde est consignée dans une évaluation d&apos;actif.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Kept rigid by decision Q3: defined by kind; relational value moved to AssetValuation (review H4).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000002 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000001"/>
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000958"/>
        <rdfs:label xml:lang="fr">actif informationnel</rdfs:label>
        <rdfs:label xml:lang="en">information asset</rdfs:label>
        <skos:altLabel xml:lang="en">data asset</skos:altLabel>
        <skos:definition xml:lang="fr">Actif constitué de contenu informationnel, comme un jeu de données, un ensemble de dossiers ou un document, indépendamment du support qui le porte.</skos:definition>
        <skos:definition xml:lang="en">An asset that is information content, such as a data set, a record collection or a document, independent of the medium that carries it.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Central in all corpora (patient records, données nominatives); CCO ICE is the right BFO-2020 home.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000003 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000001"/>
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">actif logiciel</rdfs:label>
        <rdfs:label xml:lang="en">software asset</rdfs:label>
        <skos:altLabel xml:lang="en">application</skos:altLabel>
        <skos:definition xml:lang="fr">Actif constitué d&apos;un programme ou d&apos;une application informatique, y compris sa configuration, considéré indépendamment du matériel qui l&apos;exécute.</skos:definition>
        <skos:definition xml:lang="en">An asset that is a computer program or application, including its configuration, considered independently of the hardware that runs it.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Software as instructions that prescribe machine behaviour (prescriptive ICE); CCO 2.2 core has no software class (review M).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000004 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000001"/>
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000995"/>
        <rdfs:label xml:lang="fr">actif matériel</rdfs:label>
        <rdfs:label xml:lang="en">hardware asset</rdfs:label>
        <skos:definition xml:lang="fr">Actif constitué d&apos;un artefact matériel servant à traiter, stocker ou transmettre de l&apos;information, comme un serveur, un poste de travail, un équipement réseau ou un appareil connecté.</skos:definition>
        <skos:definition xml:lang="en">An asset that is a material artifact used to process, store or transmit information, such as a server, workstation, network device or connected equipment.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Direct fit to CCO Material Artifact.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000005 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000004"/>
        <rdfs:label xml:lang="fr">appareil connecté</rdfs:label>
        <rdfs:label xml:lang="en">connected device</rdfs:label>
        <skos:altLabel xml:lang="en">IoT device</skos:altLabel>
        <skos:altLabel xml:lang="fr">objet connecté</skos:altLabel>
        <skos:definition xml:lang="en">A hardware asset with embedded computing and network connectivity whose malfunction can affect physical processes, such as an IoT, OT or medical device.</skos:definition>
        <skos:definition xml:lang="fr">Actif matériel doté de capacités de calcul et de connectivité réseau intégrées dont le dysfonctionnement peut toucher des processus physiques, comme un objet connecté, un équipement de technologie opérationnelle ou un dispositif médical.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Recurring in corpora (IoT, medical devices); CRG coverage list names OT/IoT/medical.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000006 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000004"/>
        <rdfs:label xml:lang="fr">actif réseau</rdfs:label>
        <rdfs:label xml:lang="en">network asset</rdfs:label>
        <skos:altLabel xml:lang="fr">réseau</skos:altLabel>
        <skos:definition xml:lang="en">A hardware asset, or an interconnected set of them, that carries communications between other assets, such as a local network, a WiFi network or an inter-establishment link.</skos:definition>
        <skos:definition xml:lang="fr">Actif matériel, ou ensemble interconnecté de tels actifs, qui achemine les communications entre d&apos;autres actifs, comme un réseau local, un réseau sans fil ou un lien inter-établissement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">RTSS, WiFi and telecom links recur; modelled as hardware for simplicity, see confidence note.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000007 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000001"/>
        <rdfs:label xml:lang="fr">actif de service</rdfs:label>
        <rdfs:label xml:lang="en">service asset</rdfs:label>
        <skos:altLabel xml:lang="en">SaaS</skos:altLabel>
        <skos:altLabel xml:lang="en">cloud service</skos:altLabel>
        <skos:definition xml:lang="fr">Actif constitué de la capacité d&apos;un fournisseur à offrir un service à l&apos;organisation, à l&apos;interne ou à titre de tiers, comme une application infonuagique, un hébergement, des télécommunications ou un service de sécurité géré; cette capacité réside dans les systèmes ou l&apos;organisation du fournisseur.</skos:definition>
        <skos:definition xml:lang="en">An asset that is a provider&apos;s capability to deliver a service to the organisation, internally or as a third party, such as a cloud application, hosting, telecommunications or a managed security service; the capability inheres in the provider&apos;s systems or organisation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Realizable entity (capability) rather than process, so a service can be owned, valued and depended on (review H3).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000008 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000001"/>
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000192"/>
        <rdfs:label xml:lang="fr">actif d&apos;installation</rdfs:label>
        <rdfs:label xml:lang="en">facility asset</rdfs:label>
        <skos:altLabel xml:lang="fr">salle des serveurs</skos:altLabel>
        <skos:definition xml:lang="fr">Actif constitué d&apos;un bâtiment, d&apos;une salle ou d&apos;un site qui abrite d&apos;autres actifs ou activités, comme une salle des serveurs, un centre de données, des archives ou une clinique.</skos:definition>
        <skos:definition xml:lang="en">An asset that is a building, room or site housing other assets or activities, such as a server room, data centre, archive or clinic.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Server rooms and archives are central in Cigale and 2012 scenarios.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000009 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">business process</rdfs:label>
        <rdfs:label xml:lang="fr">processus d&apos;affaires</rdfs:label>
        <skos:definition xml:lang="en">A process, consisting of recurring organisational activities, that delivers part of the organisation&apos;s mission and depends on assets.</skos:definition>
        <skos:definition xml:lang="fr">Processus, constitué d&apos;activités organisationnelles récurrentes, qui réalise une partie de la mission de l&apos;organisation et qui dépend d&apos;actifs.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG asset map (Objective, Process, Primary asset); Cigale field &apos;Processus d&apos;affaires visés&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000010 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000010">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000476"/>
        <rdfs:label xml:lang="en">business objective</rdfs:label>
        <rdfs:label xml:lang="fr">objectif d&apos;affaires</rdfs:label>
        <skos:definition xml:lang="en">An objective the organisation pursues that business processes support and that cybersecurity risk can threaten.</skos:definition>
        <skos:definition xml:lang="fr">Objectif poursuivi par l&apos;organisation, soutenu par des processus d&apos;affaires et que le risque de cybersécurité peut compromettre.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG traceability starts from objectives.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000011 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000011">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">asset valuation</rdfs:label>
        <rdfs:label xml:lang="fr">évaluation d&apos;actif</rdfs:label>
        <skos:altLabel xml:lang="en">crown jewel record</skos:altLabel>
        <skos:altLabel xml:lang="fr">joyau de la couronne</skos:altLabel>
        <skos:definition xml:lang="en">A description of how much an entity matters to a given organisation, recording its criticality, its confidentiality, integrity and availability requirements, its owner and whether it is a crown jewel.</skos:definition>
        <skos:definition xml:lang="fr">Description de l&apos;importance d&apos;une entité pour une organisation donnée, qui consigne sa criticité, ses exigences de confidentialité, d&apos;intégrité et de disponibilité, son propriétaire et son statut de joyau de la couronne.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Carries the context-dependent part of &apos;asset&apos; so Asset can stay rigid (decision Q3); maps CRG CROWN.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, examples/medibec/source/data30.json and budget.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000012 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="fr">rôle de source de menace</rdfs:label>
        <rdfs:label xml:lang="en">threat source role</rdfs:label>
        <skos:altLabel xml:lang="fr">source de menace</skos:altLabel>
        <skos:altLabel xml:lang="en">threat actor</skos:altLabel>
        <skos:definition xml:lang="en">A role borne by an agent or artifact in virtue of which it may initiate a threat event, intentionally or not.</skos:definition>
        <skos:definition xml:lang="fr">Rôle porté par un agent ou un artefact en vertu duquel il peut déclencher un événement de menace, intentionnellement ou non.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Role keeps people and organisations rigid; environmental sources are described with ThreatSourceDescription (review M).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">MOACCO 1.2a (retired), Herzog et al. Security.owl concepts Threat, Vulnerability, Countermeasure</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000014 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000014">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">description d&apos;événement de menace</rdfs:label>
        <rdfs:label xml:lang="en">threat event description</rdfs:label>
        <skos:altLabel xml:lang="en">threat event type</skos:altLabel>
        <skos:definition xml:lang="en">A description of a kind of event that, if it occurred, could adversely affect assets, such as credential phishing, ransomware encryption or a server-room fire.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un type d&apos;événement qui, s&apos;il se produisait, pourrait porter atteinte à des actifs, comme l&apos;hameçonnage d&apos;identifiants, le chiffrement par rançongiciel ou l&apos;incendie d&apos;une salle des serveurs.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Possible events are described, not instantiated (Phase 1 section 5.3); linked to ATT&amp;CK by mapping.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000015 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">incident</rdfs:label>
        <rdfs:label xml:lang="fr">incident</rdfs:label>
        <skos:altLabel xml:lang="fr">incident de confidentialité</skos:altLabel>
        <skos:definition xml:lang="en">An actual occurrence of an adverse event affecting the organisation&apos;s assets or information, including a confidentiality incident under Loi 25.</skos:definition>
        <skos:definition xml:lang="fr">Occurrence réelle d&apos;un événement défavorable touchant les actifs ou l&apos;information de l&apos;organisation, y compris un incident de confidentialité au sens de la Loi 25.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Needed for the Loi 25 incident register and history.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000016 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000016">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000548"/>
        <rdfs:label xml:lang="en">vulnerability</rdfs:label>
        <rdfs:label xml:lang="fr">vulnérabilité</rdfs:label>
        <skos:altLabel xml:lang="fr">faiblesse</skos:altLabel>
        <skos:altLabel xml:lang="fr">faille</skos:altLabel>
        <skos:altLabel xml:lang="en">weakness</skos:altLabel>
        <skos:definition xml:lang="en">A disposition of a material asset, such as a device, storage medium or network equipment, or of an organisation, that a threat source can exploit to cause harm. Weaknesses of software, information or controls are recorded as vulnerability descriptions.</skos:definition>
        <skos:definition xml:lang="fr">Disposition d&apos;un actif matériel, comme un appareil, un support de stockage ou un équipement réseau, ou d&apos;une organisation, qu&apos;une source de menace peut exploiter pour causer un préjudice. Les faiblesses des logiciels, de l&apos;information ou des contrôles sont consignées comme descriptions de vulnérabilité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Aligned to CCO Vulnerability; restricted to material bearers after HermiT finding and review H6.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Common Core Ontologies 2.2 (2026-08-13), alignment target</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">MOACCO 1.2a (retired), Herzog et al. Security.owl concepts Threat, Vulnerability, Countermeasure</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000017 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="fr">condition prédisposante</rdfs:label>
        <rdfs:label xml:lang="en">predisposing condition</rdfs:label>
        <skos:definition xml:lang="en">A condition of the organisation, its environment or its systems that increases or decreases the likelihood that a threat event causes harm, without being a weakness of a specific control.</skos:definition>
        <skos:definition xml:lang="fr">Condition de l&apos;organisation, de son environnement ou de ses systèmes qui augmente ou diminue la probabilité qu&apos;un événement de menace cause un préjudice, sans être une faiblesse d&apos;un contrôle précis.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">SP 800-30 Appendix F; examples: single telecom link, ground-floor server room.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000018 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000018">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">constat de lacune de contrôle</rdfs:label>
        <rdfs:label xml:lang="en">control gap finding</rdfs:label>
        <skos:altLabel xml:lang="fr">contrôle manquant</skos:altLabel>
        <skos:altLabel xml:lang="en">missing control</skos:altLabel>
        <skos:definition xml:lang="en">A description stating that an expected control is absent or inadequate in an organisation, such as no penetration testing or no continuity plan.</skos:definition>
        <skos:definition xml:lang="fr">Description qui constate l&apos;absence ou l&apos;insuffisance d&apos;un contrôle attendu dans une organisation, comme l&apos;absence de tests d&apos;intrusion ou de plan de continuité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Phase 1 gap 4; an absence cannot be a disposition, so modelled as a finding (review H2).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000019 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000019">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">control</rdfs:label>
        <rdfs:label xml:lang="fr">mesure de sécurité</rdfs:label>
        <skos:altLabel xml:lang="fr">contrôle</skos:altLabel>
        <skos:altLabel xml:lang="en">countermeasure</skos:altLabel>
        <skos:altLabel xml:lang="en">safeguard</skos:altLabel>
        <skos:definition xml:lang="en">A prescription of a measure that modifies risk, such as a policy, procedure, technical safeguard or practice, independent of whether any organisation has implemented it.</skos:definition>
        <skos:definition xml:lang="fr">Prescription d&apos;une mesure qui modifie le risque, comme une politique, une procédure, une protection technique ou une pratique, indépendamment de sa mise en œuvre par une organisation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Specification level; framework requirements map to it.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">MOACCO 1.2a (retired), Herzog et al. Security.owl concepts Threat, Vulnerability, Countermeasure</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000020 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000020">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">control measure</rdfs:label>
        <rdfs:label xml:lang="fr">mesure de sécurité appliquée</rdfs:label>
        <skos:altLabel xml:lang="en">implemented control</skos:altLabel>
        <skos:altLabel xml:lang="fr">mesure de contrôle</skos:altLabel>
        <skos:altLabel xml:lang="fr">mesure de mitigation</skos:altLabel>
        <skos:definition xml:lang="en">A description of a control as it stands in a given organisation, with its status (in place, planned or proposed), scope, owner and the evidence of its effectiveness.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un contrôle tel qu&apos;il se présente dans une organisation donnée, avec son statut (en place, prévu ou proposé), sa portée, son responsable et les preuves de son efficacité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Description rather than disposition so planned and proposed measures can be represented (Phase 1 gap 1).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000021 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000021">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">exigence de référentiel</rdfs:label>
        <rdfs:label xml:lang="en">framework requirement</rdfs:label>
        <skos:definition xml:lang="en">A requirement, control objective or outcome stated in a published framework or standard, identified by its official identifier.</skos:definition>
        <skos:definition xml:lang="fr">Exigence, objectif de contrôle ou résultat énoncé dans un référentiel ou une norme publiés, identifié par son identifiant officiel.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Framework items are SKOS concepts also typed with this class.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000022 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000022">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">legal obligation</rdfs:label>
        <rdfs:label xml:lang="fr">obligation légale</rdfs:label>
        <skos:definition xml:lang="en">A prescription of a duty imposed by a statute or regulation, identified by its legal citation, such as keeping a register of confidentiality incidents under Loi 25.</skos:definition>
        <skos:definition xml:lang="fr">Prescription d&apos;une obligation imposée par une loi ou un règlement, identifiée par sa référence juridique, comme la tenue d&apos;un registre des incidents de confidentialité en vertu de la Loi 25.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Loi 25 obligations are in the first SKOS schemes.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000023 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000023">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">risk scenario</rdfs:label>
        <rdfs:label xml:lang="fr">scénario de risque</rdfs:label>
        <skos:altLabel xml:lang="fr">scénario</skos:altLabel>
        <skos:definition xml:lang="en">A description of a plausible causal chain in which a threat source initiates a threat event that exploits a vulnerability or condition, affects assets or processes and leads to consequences.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une chaîne causale plausible dans laquelle une source de menace déclenche un événement de menace qui exploite une vulnérabilité ou une condition, touche des actifs ou des processus et entraîne des conséquences.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Reified n-ary node (Phase 1 section 5.3); CRG construction standard.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000024 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0000025"/>
        <rdfs:label xml:lang="en">library scenario</rdfs:label>
        <rdfs:label xml:lang="fr">scénario de bibliothèque</rdfs:label>
        <skos:definition xml:lang="en">A risk scenario written for no particular organisation, or generalised from one, kept in a library to seed candidate scenarios.</skos:definition>
        <skos:definition xml:lang="fr">Scénario de risque rédigé pour aucune organisation en particulier, ou généralisé à partir d&apos;une organisation, conservé dans une bibliothèque pour alimenter des scénarios candidats.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Holds the 2,158 consolidated 2023 rows (decision Q-E, option 3).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000025 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:label xml:lang="en">assessment scenario</rdfs:label>
        <rdfs:label xml:lang="fr">scénario d&apos;évaluation</rdfs:label>
        <skos:altLabel xml:lang="en">candidate scenario</skos:altLabel>
        <skos:altLabel xml:lang="en">selected scenario</skos:altLabel>
        <skos:definition xml:lang="en">A risk scenario stated for a specific organisation within a risk assessment, whether as a screened candidate or as a selected scenario.</skos:definition>
        <skos:definition xml:lang="fr">Scénario de risque énoncé pour une organisation précise dans le cadre d&apos;une appréciation du risque, qu&apos;il s&apos;agisse d&apos;un candidat présélectionné ou d&apos;un scénario retenu.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Candidate vs selected is a disposition value, not a subclass (OntoClean: anti-rigid).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000026 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000026">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">scenario step</rdfs:label>
        <rdfs:label xml:lang="fr">étape de scénario</rdfs:label>
        <skos:definition xml:lang="en">A description of one stage in the event sequence of a risk scenario, with its order and evidence basis.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une étape de la séquence d&apos;événements d&apos;un scénario de risque, avec son rang et le fondement de preuve.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG &apos;sequence&apos;; MediBec section 4.</crgo:CRGO_0000285>

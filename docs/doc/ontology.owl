     -->


    


    <!-- https://w3id.org/crgo/CRGO_0000062 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000062">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:label xml:lang="en">confidence level scheme</rdfs:label>
        <rdfs:label xml:lang="fr">schéma : niveau de confiance</rdfs:label>
        <skos:definition xml:lang="en">Concept scheme of the confidence level value set.</skos:definition>
        <skos:definition xml:lang="fr">Schéma de concepts de l&apos;ensemble de valeurs « niveau de confiance ».</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

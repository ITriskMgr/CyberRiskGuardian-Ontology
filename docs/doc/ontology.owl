    <!-- https://w3id.org/crgo/CRGO_0000194 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000194">
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000090"/>
        <rdfs:label xml:lang="fr">a pour type de source de menace</rdfs:label>
        <rdfs:label xml:lang="en">has threat source type</rdfs:label>
        <skos:definition xml:lang="fr">Classe un rôle de source de menace ou une description de source de menace selon la catégorie de NIST SP 800-30.</skos:definition>

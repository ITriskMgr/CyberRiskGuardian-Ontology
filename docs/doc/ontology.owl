        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000646"/>
        <rdfs:label xml:lang="en">random selection</rdfs:label>
        <rdfs:label xml:lang="fr">sélection aléatoire</rdfs:label>
        <skos:definition xml:lang="fr">Chaque élément a une probabilité de sélection égale et connue.</skos:definition>

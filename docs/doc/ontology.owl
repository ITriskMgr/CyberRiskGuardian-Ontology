    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000053 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000053">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000050"/>

    <!-- https://w3id.org/crgo/CRGO_0000050 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000050">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>

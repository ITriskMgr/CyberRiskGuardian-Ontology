        <rdfs:label xml:lang="fr">correspondance plus étroite</rdfs:label>
        <rdfs:label xml:lang="en">narrower mapping</rdfs:label>
        <skos:definition xml:lang="fr">La source est plus étroite que la cible.</skos:definition>
        <skos:definition xml:lang="en">The source is narrower than the target.</skos:definition>

        <rdfs:label xml:lang="fr">relève de</rdfs:label>
        <rdfs:label xml:lang="en">reports to</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent or body to the agent or body it reports to.</skos:definition>
        <skos:definition xml:lang="fr">Relie un agent ou un organe à l&apos;agent ou à l&apos;organe dont il relève.</skos:definition>

        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">due offset (hours)</rdfs:label>
        <rdfs:label xml:lang="fr">délai (heures)</rdfs:label>
        <skos:definition xml:lang="en">Gives the number of hours, counted from the triggering event, within which an event-triggered deadline falls.</skos:definition>
        <skos:definition xml:lang="fr">Indique le nombre d&apos;heures, comptées à partir de l&apos;événement déclencheur, dans lequel tombe une échéance déclenchée par un événement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Integer hours rather than xsd:duration, which is outside the OWL 2 datatype map (conflict C4); hours cover the 72-hour notices.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 2</crgo:CRGO_0000292>
    </owl:DatatypeProperty>
    



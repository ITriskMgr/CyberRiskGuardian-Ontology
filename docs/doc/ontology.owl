        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000297 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000297">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000037"/>
        <rdfs:label xml:lang="en">likelihood</rdfs:label>
        <rdfs:label xml:lang="fr">vraisemblance</rdfs:label>

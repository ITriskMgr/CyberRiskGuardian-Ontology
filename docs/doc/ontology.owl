    <!-- https://w3id.org/crgo/CRGO_0000324 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000324">
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000296"/>
        <rdfs:label xml:lang="fr">fait partie du référentiel</rdfs:label>
        <rdfs:label xml:lang="en">part of framework</rdfs:label>
        <skos:definition xml:lang="en">Relates a framework requirement or legal obligation to the framework, standard or law that states it.</skos:definition>
        <skos:definition xml:lang="fr">Relie une exigence de référentiel ou une obligation légale au référentiel, à la norme ou à la loi qui l&apos;énonce.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Review M.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000325 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000325">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="fr">a pour référence externe</rdfs:label>
        <rdfs:label xml:lang="en">has external reference</rdfs:label>
        <skos:definition xml:lang="en">Relates a description or control to a concept in an external catalogue, such as an ATT&amp;CK technique, a CWE weakness, a CAPEC pattern or a CVE record.</skos:definition>
        <skos:definition xml:lang="fr">Relie une description ou un contrôle à un concept d&apos;un catalogue externe, comme une technique ATT&amp;CK, une faiblesse CWE, un patron CAPEC ou un enregistrement CVE.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Review M; catalogues referenced by identifier.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 report (8 Oct 2026), section 5 and recorded decisions</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000335 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000335">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="fr">a pour exigence pertinente</rdfs:label>
        <rdfs:label xml:lang="en">has relevant requirement</rdfs:label>
        <skos:definition xml:lang="en">Relates a risk scenario to a requirement of a control framework, such as a NIST CSF 2.0 subcategory, a NIST SP 800-53 control or an ISO/IEC 27002 control, whose implementation would prevent, detect or limit the scenario.</skos:definition>
        <skos:definition xml:lang="fr">Relie un scénario de risque à une exigence d&apos;un référentiel de mesures, comme une sous-catégorie du NIST CSF 2.0, une mesure du NIST SP 800-53 ou une mesure de l&apos;ISO/IEC 27002, dont la mise en œuvre préviendrait, détecterait ou limiterait le scénario.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Links are proposed with a confidence on each assertion (OWL axiom annotation); used for threat, vulnerability and control identification (requirement R1).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">Phase 3 repair of the 2023 scenario library (decision Q-E, option 3), data/library/REPAIR_REPORT.md</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.3.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://www.commoncoreontologies.org/ont00001808 -->


    <owl:ObjectProperty rdf:about="https://www.commoncoreontologies.org/ont00001808">
        <rdfs:label xml:lang="en">is about</rdfs:label>
        <skos:definition xml:lang="en">x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y.</skos:definition>
    </owl:ObjectProperty>
    



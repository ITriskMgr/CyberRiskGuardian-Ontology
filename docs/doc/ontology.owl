        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000422 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000422">
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000343"/>
        <rdfs:label xml:lang="fr">disposition de</rdfs:label>
        <rdfs:label xml:lang="en">provision of</rdfs:label>
        <skos:definition xml:lang="en">Relates a provision, such as a concept of a CRGO legal vocabulary, to the legal instrument it belongs to.</skos:definition>
        <skos:definition xml:lang="fr">Relie une disposition, comme un concept d&apos;un vocabulaire juridique de CRGO, à l&apos;instrument juridique dont elle fait partie.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000423 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000423">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000343"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="fr">a pour période de vigueur</rdfs:label>
        <rdfs:label xml:lang="en">has in-force period</rdfs:label>
        <skos:definition xml:lang="en">Relates a legal instrument to the OWL-Time interval during which it is in force; the interval has no end while the instrument is not repealed.</skos:definition>
        <skos:definition xml:lang="fr">Relie un instrument juridique à l&apos;intervalle OWL-Time pendant lequel il est en vigueur; l&apos;intervalle n&apos;a pas de fin tant que l&apos;instrument n&apos;est pas abrogé.</skos:definition>
        <skos:scopeNote xml:lang="en">At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL.</skos:scopeNote>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">OWL-Time used where a period is the object of a claim (ADR-006).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">W3C Time Ontology in OWL (OWL-Time), edition of 2025-08-27 (slice: imports/time-slice.ttl)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000424 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000424">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000344"/>
        <rdfs:label xml:lang="fr">condition de</rdfs:label>
        <rdfs:label xml:lang="en">condition of</rdfs:label>
        <skos:changeNote xml:lang="en">0.10.0 (decision D9, 2026-10-12): definition widened to policy statements.</skos:changeNote>
        <skos:definition xml:lang="en">Relates an applicability condition to the instrument, provision or policy statement whose application it governs.</skos:definition>
        <skos:definition xml:lang="fr">Relie une condition d&apos;applicabilité à l&apos;instrument, à la disposition ou à l&apos;énoncé de politique dont elle régit l&apos;application.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000425 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000425">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000344"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000394"/>
        <rdfs:label xml:lang="fr">a pour type de condition</rdfs:label>
        <rdfs:label xml:lang="en">has condition kind</rdfs:label>
        <skos:definition xml:lang="en">Gives the kind of fact an applicability condition tests.</skos:definition>
        <skos:definition xml:lang="fr">Indique le type de fait que vérifie une condition d&apos;applicabilité.</skos:definition>
        <skos:scopeNote xml:lang="en">At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL.</skos:scopeNote>

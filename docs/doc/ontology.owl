    <!-- https://w3id.org/crgo/CRGO_0001156 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001156">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">information marking</rdfs:label>
        <rdfs:label xml:lang="fr">marquage de l&apos;information</rdfs:label>
        <skos:definition xml:lang="fr">Restriction de partage attachée à une information, selon le protocole TLP 2.0 de FIRST.</skos:definition>
        <skos:definition xml:lang="en">The sharing restriction attached to information, following the FIRST Traffic Light Protocol 2.0.</skos:definition>

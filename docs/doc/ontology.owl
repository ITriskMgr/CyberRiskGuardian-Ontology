    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000417">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000341"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000348"/>
        <rdfs:label xml:lang="en">data subjects in</rdfs:label>
        <rdfs:label xml:lang="fr">personnes concernées situées dans</rdfs:label>
        <skos:definition xml:lang="en">Relates a processing activity to a jurisdiction where persons whose information it handles are located.</skos:definition>
        <skos:definition xml:lang="fr">Relie une activité de traitement à une juridiction où se trouvent des personnes dont elle traite les renseignements.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000418 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000418">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000341"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000348"/>
        <rdfs:label xml:lang="fr">communique des renseignements personnels vers</rdfs:label>
        <rdfs:label xml:lang="en">transfers personal information to</rdfs:label>
        <skos:definition xml:lang="en">Relates a processing activity to a jurisdiction where personal information is disclosed to, or stored by, a recipient.</skos:definition>
        <skos:definition xml:lang="fr">Relie une activité de traitement à une juridiction où des renseignements personnels sont communiqués à un destinataire ou conservés par lui.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">Loi 25 s. 17; GDPR Chapter V; PIPEDA interprovincial and international disclosures.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CQLR c. P-39.1 ss. 1, 3.1-3.8, 17, 18.3; CQLR c. A-2.1 s. 3; CQLR c. R-22.1 s. 4 (LégisQuébec, updated to 2026-08-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">PIPEDA ss. 4, 26(2)(b), Sch. 1 (S.C. 2000, c. 5, current to 2026-09-21)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000419 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000419">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000342"/>
        <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00001180"/>
        <rdfs:label xml:lang="fr">fournisseur de</rdfs:label>
        <rdfs:label xml:lang="en">supplier to</rdfs:label>
        <skos:definition xml:lang="en">Relates a supplier role to the organisation that depends on what its bearer supplies.</skos:definition>
        <skos:definition xml:lang="fr">Relie un rôle de fournisseur à l&apos;organisation qui dépend de ce que fournit le porteur du rôle.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">The bearer is given by BFO &apos;bearer of&apos;; assets the supplier provides keep &apos;provided by&apos;.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000420 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000420">
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000348"/>
        <rdfs:label xml:lang="fr">a pour juridiction</rdfs:label>
        <rdfs:label xml:lang="en">has jurisdiction</rdfs:label>
        <skos:definition xml:lang="en">Relates a legal instrument, applicability assessment or compliance determination to its jurisdiction.</skos:definition>
        <skos:definition xml:lang="fr">Relie un instrument juridique, une évaluation de l&apos;applicabilité ou un constat de conformité à sa juridiction.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000421 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000421">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000343"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000376"/>
        <rdfs:label xml:lang="fr">a pour type d&apos;instrument</rdfs:label>
        <rdfs:label xml:lang="en">has instrument kind</rdfs:label>
        <skos:definition xml:lang="en">Gives the kind of a legal instrument.</skos:definition>

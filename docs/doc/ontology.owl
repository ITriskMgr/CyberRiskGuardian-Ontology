    <!-- https://w3id.org/crgo/CRGO_0000195 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000195">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:label xml:lang="fr">déclenché par</rdfs:label>
        <rdfs:label xml:lang="en">initiated by</rdfs:label>
        <skos:definition xml:lang="en">Relates a risk scenario to the entity that would initiate it: the bearer of a threat source role, such as a person, organisation, artifact or natural feature. Use hasThreatSourceDescription when only the kind of source is known.</skos:definition>
        <skos:definition xml:lang="fr">Relie un scénario de risque à l&apos;entité qui le déclencherait : le porteur d&apos;un rôle de source de menace, par exemple une personne, une organisation, un artefact ou un élément naturel. Utiliser hasThreatSourceDescription lorsque seul le type de source est connu.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000064"/>
        <crgo:CRGO_0000285 xml:lang="en">Range left open because bearers of a threat source role are of several BFO kinds; SHACL will check it (Phase 4).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000196 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000196">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:range rdf:resource="https://w3id.org/crgo/CRGO_0000014"/>
        <rdfs:label xml:lang="fr">a pour événement de menace</rdfs:label>
        <rdfs:label xml:lang="en">has threat event</rdfs:label>
        <skos:definition xml:lang="en">Relates a risk scenario to the threat event it describes.</skos:definition>
        <skos:definition xml:lang="fr">Relie un scénario de risque à l&apos;événement de menace qu&apos;il décrit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000197 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000197">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0000023"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="fr">exploite</rdfs:label>
        <rdfs:label xml:lang="en">exploits</rdfs:label>
        <skos:definition xml:lang="en">Relates a risk scenario to an identified vulnerability or predisposing condition, borne by a material asset or an organisation, that its threat event takes advantage of. Described weaknesses use hasVulnerabilityDescription.</skos:definition>
        <skos:definition xml:lang="fr">Relie un scénario de risque à une vulnérabilité ou à une condition prédisposante identifiée, portée par un actif matériel ou une organisation, dont profite son événement de menace. Les faiblesses décrites utilisent hasVulnerabilityDescription.</skos:definition>

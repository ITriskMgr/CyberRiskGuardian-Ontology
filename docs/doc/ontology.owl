        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000645"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000646"/>
        <rdfs:label xml:lang="en">haphazard selection</rdfs:label>
        <rdfs:label xml:lang="fr">sélection au hasard non statistique</rdfs:label>
        <skos:definition xml:lang="en">Items are chosen without a conscious bias, but not by a random process.</skos:definition>
        <skos:definition xml:lang="fr">Les éléments sont choisis sans biais conscient, mais pas par un processus aléatoire.</skos:definition>
        <skos:notation>4</skos:notation>

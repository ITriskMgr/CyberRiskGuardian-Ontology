    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000027 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000027">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">consequence description</rdfs:label>
        <rdfs:label xml:lang="fr">description de conséquence</rdfs:label>
        <skos:altLabel xml:lang="en">impact</skos:altLabel>
        <skos:definition xml:lang="en">A description of an outcome that a risk scenario could have for the organisation along one impact dimension.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un résultat qu&apos;un scénario de risque pourrait avoir pour l&apos;organisation selon une dimension d&apos;impact.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG &apos;consequences&apos; keyed by dimension.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000028 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000028">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="fr">appréciation du risque</rdfs:label>
        <rdfs:label xml:lang="en">risk assessment</rdfs:label>
        <skos:definition xml:lang="en">A planned act in which an organisation identifies, analyses and evaluates its cybersecurity risk scenarios over a stated period, using a stated method and risk appetite.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel une organisation identifie, analyse et évalue ses scénarios de risque de cybersécurité pour une période donnée, selon une méthode et un appétit pour le risque énoncés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">One CRG assessment file = one RiskAssessment.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000029 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000029">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">risk appetite statement</rdfs:label>
        <rdfs:label xml:lang="fr">énoncé d&apos;appétit pour le risque</rdfs:label>
        <skos:altLabel xml:lang="en">risk appetite</skos:altLabel>
        <skos:definition xml:lang="en">A prescription, approved by management, of how much cybersecurity risk the organisation is willing to accept, expressed in CRG on a 0-1 scale.</skos:definition>
        <skos:definition xml:lang="fr">Prescription, approuvée par la direction, du niveau de risque de cybersécurité que l&apos;organisation est prête à accepter, exprimée dans CRG sur une échelle de 0 à 1.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">CRG step 4 (0.1-0.9 bands).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000030 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000030">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">décision de traitement du risque</rdfs:label>
        <rdfs:label xml:lang="en">risk treatment decision</rdfs:label>
        <skos:definition xml:lang="en">A decision prescribing how a risk scenario is treated (modify, retain, avoid or share), by whom and with what authority.</skos:definition>
        <skos:definition xml:lang="fr">Décision qui prescrit le traitement d&apos;un scénario de risque (modifier, conserver, éviter ou partager), par qui et avec quelle autorité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000286 xml:lang="en">CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO 31000:2018 (risk treatment options; paraphrased)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000031 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000030"/>
        <rdfs:label xml:lang="fr">acceptation du risque</rdfs:label>
        <rdfs:label xml:lang="en">risk acceptance</rdfs:label>
        <skos:definition xml:lang="en">A risk treatment decision to retain a residual risk, recording the accepting authority and an expiry date.</skos:definition>
        <skos:definition xml:lang="fr">Décision de traitement du risque visant à conserver un risque résiduel, qui consigne l&apos;autorité qui l&apos;accepte et une date d&apos;expiration.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">MED-GOV-02 shows why authority and expiry matter.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Phase 1 scenario extraction (Drive folder &apos;scenarios&apos;): corpora A-D, F</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-08</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.1.0</crgo:CRGO_0000291>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0000032 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000032">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <rdfs:label xml:lang="fr">initiative de traitement</rdfs:label>
        <rdfs:label xml:lang="en">treatment initiative</rdfs:label>
        <skos:altLabel xml:lang="en">investment initiative</skos:altLabel>
        <skos:definition xml:lang="en">A plan to implement one or more control measures that addresses one or more risk scenarios, with owner, priority, costs and schedule.</skos:definition>
        <skos:definition xml:lang="fr">Plan de mise en œuvre d&apos;une ou de plusieurs mesures de contrôle visant un ou plusieurs scénarios de risque, avec responsable, priorité, coûts et calendrier.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

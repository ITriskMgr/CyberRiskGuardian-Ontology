        <crgo:CRGO_0000292 xml:lang="en">P1 review group 4 (0.10.0 additions)</crgo:CRGO_0000292>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/crgo/CRGO_0000990 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0000990">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000985"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000986"/>
        <rdfs:label xml:lang="en">broader mapping</rdfs:label>
        <rdfs:label xml:lang="fr">correspondance plus large</rdfs:label>
        <skos:definition xml:lang="fr">La source est plus large que la cible.</skos:definition>
        <skos:definition xml:lang="en">The source is broader than the target.</skos:definition>

    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0001324 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/crgo/CRGO_0001324">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>

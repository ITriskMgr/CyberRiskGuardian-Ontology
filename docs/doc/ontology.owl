        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">P1 review group 5 (values added to instrument kind and condition kind)</crgo:CRGO_0000292>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/crgo/CRGO_0001002 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/crgo/CRGO_0001002">
        <rdf:type rdf:resource="https://w3id.org/crgo/CRGO_0000376"/>
        <skos:inScheme rdf:resource="https://w3id.org/crgo/CRGO_0000377"/>
        <rdfs:label xml:lang="en">directive (to be transposed)</rdfs:label>
        <rdfs:label xml:lang="fr">directive (à transposer)</rdfs:label>
        <skos:definition xml:lang="en">An instrument that binds states to a result and is given effect through national law, such as a European Union directive.</skos:definition>
        <skos:definition xml:lang="fr">Instrument qui oblige des États quant au résultat et qui produit ses effets par le droit national, comme une directive de l&apos;Union européenne.</skos:definition>
        <skos:notation>5</skos:notation>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>

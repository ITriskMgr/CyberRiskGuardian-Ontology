    <!-- https://w3id.org/crgo/CRGO_0000037 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0000037">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001163"/>
        <rdfs:label xml:lang="en">estimate</rdfs:label>
        <rdfs:label xml:lang="fr">estimation</rdfs:label>
        <skos:definition xml:lang="en">A measurement content entity giving a value for some aspect of a risk scenario or control, with its scale, qualitative reading, rationale, evidence and confidence.</skos:definition>
        <skos:definition xml:lang="fr">Entité de contenu de mesure qui donne une valeur pour un aspect d&apos;un scénario de risque ou d&apos;un contrôle, avec son échelle, sa lecture qualitative, sa justification, ses preuves et son niveau de confiance.</skos:definition>

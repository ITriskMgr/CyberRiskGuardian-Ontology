    <!-- https://w3id.org/crgo/CRGO_0001097 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001097">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">source de télémétrie</rdfs:label>
        <rdfs:label xml:lang="en">telemetry source</rdfs:label>
        <skos:altLabel xml:lang="en">log source</skos:altLabel>
        <skos:altLabel xml:lang="fr">source de journaux</skos:altLabel>
        <skos:definition xml:lang="en">A description of a product, service or device configured to send security logs or events to an organisation&apos;s monitoring, with the asset it runs on, the kinds of data it sends and how they are collected.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un produit, d&apos;un service ou d&apos;un appareil configuré pour transmettre des journaux ou des événements de sécurité à la surveillance d&apos;une organisation, avec l&apos;actif sur lequel il fonctionne, les types de données qu&apos;il transmet et leur mode de collecte.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (TelemetrySource). A record about the source, not the asset itself, so that a log-producing asset is not reclassified.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">MITRE ATT&amp;CK Enterprise 19.2: detection strategies, analytics and data components (STIX bundle enterprise-attack.json)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001098 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001098">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000338"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0001109"/>
        <rdfs:label xml:lang="fr">enregistrement d&apos;événement de sécurité</rdfs:label>
        <rdfs:label xml:lang="en">security event record</rdfs:label>
        <skos:definition xml:lang="en">An observation that points to one security event held in an operational store, with the source that emitted it, when it occurred and was recorded, and the profile it was normalised under. It does not carry the event payload.</skos:definition>
        <skos:definition xml:lang="fr">Observation qui renvoie à un événement de sécurité conservé dans un dépôt opérationnel, avec la source qui l&apos;a émis, le moment où il s&apos;est produit et a été enregistré, et le profil selon lequel il a été normalisé. Elle ne contient pas le contenu de l&apos;événement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (SecurityEventReference). The event itself is the existing security event (a process); this is the record of it.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001099 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001099">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">normalisation profile</rdfs:label>
        <rdfs:label xml:lang="fr">profil de normalisation</rdfs:label>
        <skos:altLabel xml:lang="en">normalization profile</skos:altLabel>
        <skos:definition xml:lang="en">A versioned specification of how the fields of a telemetry source are mapped to a common event schema, such as an OCSF event class, so that events from different sources can be compared.</skos:definition>
        <skos:definition xml:lang="fr">Spécification versionnée de la façon dont les champs d&apos;une source de télémétrie sont mis en correspondance avec un schéma d&apos;événements commun, comme une classe d&apos;événements OCSF, afin que les événements de sources différentes puissent être comparés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2; OCSF 1.9.0. Mapping to an OCSF class is a correspondence, not an equivalence of taxonomies (SIEM section 5).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Open Cybersecurity Schema Framework (OCSF) 1.9.0, categories and event classes (github.com/ocsf/ocsf-schema, Apache-2.0)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001100 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001100">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">définition d&apos;analyseur</rdfs:label>
        <rdfs:label xml:lang="en">parser definition</rdfs:label>
        <skos:altLabel xml:lang="fr">analyseur syntaxique</skos:altLabel>
        <skos:altLabel xml:lang="en">parser</skos:altLabel>
        <skos:definition xml:lang="en">A versioned specification of how raw records of a telemetry source are converted into structured events under a normalisation profile.</skos:definition>
        <skos:definition xml:lang="fr">Spécification versionnée de la façon dont les enregistrements bruts d&apos;une source de télémétrie sont convertis en événements structurés selon un profil de normalisation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (ParserDefinition).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001101 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001101">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0001102"/>
        <rdfs:label xml:lang="en">detection strategy</rdfs:label>
        <rdfs:label xml:lang="fr">stratégie de détection</rdfs:label>
        <skos:definition xml:lang="en">An organisation&apos;s documented approach to detecting a technique or behaviour, stating what to look for, in which data, and which analytics and rules carry it out; it may adapt a reference strategy such as an ATT&amp;CK detection strategy.</skos:definition>
        <skos:definition xml:lang="fr">Approche documentée d&apos;une organisation pour détecter une technique ou un comportement, qui précise ce qu&apos;il faut rechercher, dans quelles données, et quelles analyses et règles la mettent en œuvre; elle peut adapter une stratégie de référence comme une stratégie de détection ATT&amp;CK.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2. ATT&amp;CK detection strategies and analytics are reference concepts in vocab/attack-detection; this class is the organisation&apos;s own (decision S4).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">MITRE ATT&amp;CK Enterprise 19.2: detection strategies, analytics and data components (STIX bundle enterprise-attack.json)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001102 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001102">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">detection rule</rdfs:label>
        <rdfs:label xml:lang="fr">règle de détection</rdfs:label>
        <skos:definition xml:lang="en">A versioned, deployable specification of the conditions under which events should raise an alert, such as a Sigma rule or a rule in a product&apos;s native language, with its status and the telemetry it needs.</skos:definition>
        <skos:definition xml:lang="fr">Spécification versionnée et déployable des conditions dans lesquelles des événements doivent déclencher une alerte, comme une règle Sigma ou une règle dans le langage propre d&apos;un produit, avec son état et la télémétrie dont elle a besoin.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2; Sigma specification v2.1.0. The rule carries out a detective control measure (rule for measure); its effectiveness is shown by detection tests, never assumed.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Sigma rules specification v2.1.0 (SigmaHQ, 2025-09-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001103 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0001102"/>
        <rdfs:label xml:lang="en">correlation rule</rdfs:label>
        <rdfs:label xml:lang="fr">règle de corrélation</rdfs:label>
        <skos:definition xml:lang="en">A detection rule whose conditions combine several events or alerts, over a time window or by a shared attribute.</skos:definition>
        <skos:definition xml:lang="fr">Règle de détection dont les conditions combinent plusieurs événements ou alertes, sur une fenêtre de temps ou selon un attribut commun.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2; Sigma correlation rules.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">Sigma rules specification v2.1.0 (SigmaHQ, 2025-09-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001104 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001104">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">indicateur de menace</rdfs:label>
        <rdfs:label xml:lang="en">threat indicator</rdfs:label>
        <skos:altLabel xml:lang="fr">indicateur de compromission</skos:altLabel>
        <skos:altLabel xml:lang="en">indicator of compromise</skos:altLabel>
        <skos:definition xml:lang="en">A description of a pattern, such as a file hash, address, domain or behaviour, that a source states may indicate malicious activity, with its validity period, its confidence as given by the source and how that confidence is defined. A match with an indicator is not by itself an incident or an attribution.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;un motif, comme une empreinte de fichier, une adresse, un domaine ou un comportement, qu&apos;une source présente comme pouvant indiquer une activité malveillante, avec sa période de validité, la confiance indiquée par la source et la définition de cette confiance. Une correspondance avec un indicateur ne constitue pas à elle seule un incident ni une attribution.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM sections 1 and 2 (no confirmation or attribution from an indicator match); STIX 2.1 indicator.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001105 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001105">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000337"/>
        <rdfs:label xml:lang="fr">source de renseignement sur les menaces</rdfs:label>
        <rdfs:label xml:lang="en">threat intelligence source</rdfs:label>
        <skos:definition xml:lang="en">A source record for a provider or feed of threat intelligence, with its licence, its sharing marking and the reliability the organisation gives it.</skos:definition>
        <skos:definition xml:lang="fr">Notice de source d&apos;un fournisseur ou d&apos;un flux de renseignement sur les menaces, avec sa licence, son marquage de partage et la fiabilité que lui accorde l&apos;organisation.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (ThreatIntelligenceSource); reuses source record (licence, version, retrieval).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">FIRST Traffic Light Protocol (TLP) 2.0 (authoritative from August 2022)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001106 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001106">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">couverture de détection</rdfs:label>
        <rdfs:label xml:lang="en">detection coverage</rdfs:label>
        <skos:definition xml:lang="en">A dated statement that a detection strategy or rule covers a technique, a risk scenario or an asset, with its coverage status (untested, validated, degraded or missing) and the tests that support it. Coverage is a claim to be tested, not a guarantee of detection.</skos:definition>
        <skos:definition xml:lang="fr">Énoncé daté selon lequel une stratégie ou une règle de détection couvre une technique, un scénario de risque ou un actif, avec l&apos;état de couverture (non testée, validée, dégradée ou absente) et les essais qui l&apos;étayent. La couverture est une affirmation à vérifier, et non une garantie de détection.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM sections 2 and 5 (coverage needs a rule or strategy, a scenario or technique, and validation metadata).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001107 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001107">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000018"/>
        <rdfs:label xml:lang="en">detection gap</rdfs:label>
        <rdfs:label xml:lang="fr">lacune de détection</rdfs:label>
        <skos:definition xml:lang="en">A control gap finding that a technique, risk scenario or asset has no adequate detection, or that the telemetry a detection needs is missing or unhealthy.</skos:definition>
        <skos:definition xml:lang="fr">Constat de lacune de contrôle selon lequel une technique, un scénario de risque ou un actif n&apos;est pas adéquatement détecté, ou selon lequel la télémétrie nécessaire à une détection est absente ou défaillante.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (DetectionGap). Reuses control gap finding and &apos;has control gap&apos; (decision S3).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001108 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001108">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000347"/>
        <rdfs:label xml:lang="en">detection test</rdfs:label>
        <rdfs:label xml:lang="fr">essai de détection</rdfs:label>
        <skos:definition xml:lang="en">A control assessment in which a detection rule or strategy is exercised under controlled conditions, such as by replaying or simulating the technique, to check that it raises the expected alert.</skos:definition>
        <skos:definition xml:lang="fr">Évaluation de mesure dans laquelle une règle ou une stratégie de détection est mise à l&apos;épreuve dans des conditions contrôlées, par exemple en rejouant ou en simulant la technique, pour vérifier qu&apos;elle déclenche l&apos;alerte attendue.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (DetectionTest). Reuses control assessment: test result, assessor, date and evidence (decision S3). It tests one rule or strategy, not the whole control measure: consumers that report a measure&apos;s effectiveness leave detection tests out.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001109 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001109">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000338"/>
        <rdfs:label xml:lang="fr">observation de l&apos;état de la télémétrie</rdfs:label>
        <rdfs:label xml:lang="en">telemetry health observation</rdfs:label>
        <skos:definition xml:lang="en">An observation of whether a telemetry source was delivering the expected data at a stated time, such as healthy, degraded or silent.</skos:definition>
        <skos:definition xml:lang="fr">Observation indiquant si une source de télémétrie transmettait les données attendues à un moment donné, par exemple en bon état, dégradée ou silencieuse.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (TelemetryHealthObservation).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001110 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001110">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000475"/>
        <rdfs:label xml:lang="en">hunting hypothesis</rdfs:label>
        <rdfs:label xml:lang="fr">hypothèse de chasse</rdfs:label>
        <skos:definition xml:lang="en">An analytical hypothesis that a stated adversary behaviour may be present in the organisation&apos;s environment, put forward to direct a threat hunt.</skos:definition>
        <skos:definition xml:lang="fr">Hypothèse explicative selon laquelle un comportement adverse donné pourrait être présent dans l&apos;environnement de l&apos;organisation, avancée pour orienter une chasse aux menaces.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (HuntingHypothesis). Until tested it is not a finding (0.9.0 analytical hypothesis).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001111 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001111">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">behavioural baseline</rdfs:label>
        <rdfs:label xml:lang="fr">référence comportementale</rdfs:label>
        <skos:altLabel xml:lang="en">behavioral baseline</skos:altLabel>
        <skos:definition xml:lang="en">A description of the usual behaviour of a user, account, host or service over a stated period, against which deviations are measured. CRGO holds its metadata, not the profile data.</skos:definition>
        <skos:definition xml:lang="fr">Description du comportement habituel d&apos;un utilisateur, d&apos;un compte, d&apos;un hôte ou d&apos;un service pendant une période donnée, à partir de laquelle les écarts sont mesurés. CRGO en conserve les métadonnées, et non les données du profil.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SIEM section 2 (BehavioralBaseline).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 1 (&quot;go ahead&quot;, 02:42)</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001112 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001112">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
        <rdfs:label xml:lang="fr">enquête de sécurité</rdfs:label>
        <rdfs:label xml:lang="en">security investigation</rdfs:label>
        <skos:altLabel xml:lang="fr">dossier de sécurité</skos:altLabel>
        <skos:altLabel xml:lang="en">security case</skos:altLabel>
        <skos:definition xml:lang="en">A planned act in which analysts examine one or more alerts, events or reports to establish what happened, whether it is an incident and what its scope is, with its case status as last recorded.</skos:definition>
        <skos:definition xml:lang="fr">Acte planifié par lequel des analystes examinent une ou plusieurs alertes, événements ou signalements pour établir ce qui s&apos;est passé, s&apos;il s&apos;agit d&apos;un incident et quelle en est l&apos;étendue, avec l&apos;état du dossier selon le dernier enregistrement.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (SecurityInvestigation). The incident itself is the existing incident; its confirmation is the existing incident confirmation (decision S5).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001113 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001113">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000500"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0001117"/>
        <rdfs:label xml:lang="fr">guide de réponse</rdfs:label>
        <rdfs:label xml:lang="en">response playbook</rdfs:label>
        <skos:altLabel xml:lang="fr">guide d&apos;intervention</skos:altLabel>
        <skos:altLabel xml:lang="en">playbook</skos:altLabel>
        <skos:definition xml:lang="en">A procedure that sets the steps, conditions, actions and approvals by which a kind of alert or incident is to be handled, manually or by automation, such as a CACAO playbook.</skos:definition>
        <skos:definition xml:lang="fr">Procédure qui fixe les étapes, conditions, actions et approbations selon lesquelles un type d&apos;alerte ou d&apos;incident doit être traité, manuellement ou par automatisation, comme un guide CACAO.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2; CACAO 2.0 playbook. Versioned through playbook versions (directive versions, 0.10.0).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OASIS CACAO Security Playbooks Version 2.0, Committee Specification 01 (2023-11-27)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001114 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000886"/>
        <rdfs:label xml:lang="en">playbook version</rdfs:label>
        <rdfs:label xml:lang="fr">version de guide de réponse</rdfs:label>
        <skos:definition xml:lang="en">A directive version of a response playbook. Executions cite the exact version they ran.</skos:definition>
        <skos:definition xml:lang="fr">Version de directive d&apos;un guide de réponse. Les exécutions citent la version précise qu&apos;elles ont exécutée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (PlaybookVersion: immutable deployable version).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OASIS CACAO Security Playbooks Version 2.0, Committee Specification 01 (2023-11-27)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001115 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001115">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">playbook step</rdfs:label>
        <rdfs:label xml:lang="fr">étape de guide</rdfs:label>
        <skos:definition xml:lang="en">A directive that is one step of a playbook version, such as an action, a condition, a branch or a parallel block, with its order and what follows it.</skos:definition>
        <skos:definition xml:lang="fr">Directive qui constitue une étape d&apos;une version de guide, comme une action, une condition, un embranchement ou un bloc parallèle, avec son ordre et ce qui la suit.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2; CACAO 2.0 workflow steps (start, end, action, playbook-action, parallel, if-, while- and switch-condition).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OASIS CACAO Security Playbooks Version 2.0, Committee Specification 01 (2023-11-27)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001116 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001116">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">déclencheur de guide</rdfs:label>
        <rdfs:label xml:lang="en">playbook trigger</rdfs:label>
        <skos:definition xml:lang="en">A description of what starts a playbook: an alert or event matching stated conditions, a schedule, or a request by an analyst.</skos:definition>
        <skos:definition xml:lang="fr">Description de ce qui lance un guide : une alerte ou un événement répondant à des conditions données, un calendrier, ou une demande d&apos;un analyste.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (PlaybookTrigger).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001117 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001117">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="fr">action de réponse</rdfs:label>
        <rdfs:label xml:lang="en">response action</rdfs:label>
        <skos:definition xml:lang="en">A directive that defines a kind of action a playbook may take, such as disabling an account, isolating a host or blocking a domain, with its risk class and the approval it needs. It is the definition, not an execution.</skos:definition>
        <skos:definition xml:lang="fr">Directive qui définit un type d&apos;action qu&apos;un guide peut entreprendre, comme désactiver un compte, isoler un hôte ou bloquer un domaine, avec sa classe de risque et l&apos;approbation qu&apos;elle exige. C&apos;est la définition, et non une exécution.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (ResponseAction); may be related to a D3FEND defensive technique.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">OASIS CACAO Security Playbooks Version 2.0, Committee Specification 01 (2023-11-27)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001118 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001118">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <rdfs:label xml:lang="en">approval gate</rdfs:label>
        <rdfs:label xml:lang="fr">point d&apos;approbation</rdfs:label>
        <skos:definition xml:lang="en">A directive that an action, or a class of actions, may be executed only after a stated authority has approved it, or under a stated pre-authorisation, for example when it targets a critical asset.</skos:definition>
        <skos:definition xml:lang="fr">Directive selon laquelle une action, ou une classe d&apos;actions, ne peut être exécutée qu&apos;après l&apos;approbation d&apos;une autorité précisée, ou en vertu d&apos;une préautorisation précisée, par exemple lorsqu&apos;elle vise un actif critique.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR sections 2 and 5.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001119 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001119">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000504"/>
        <rdfs:label xml:lang="en">approval decision</rdfs:label>
        <rdfs:label xml:lang="fr">décision d&apos;approbation</rdfs:label>
        <skos:definition xml:lang="en">A decision record granting or denying the execution of a response action, or pre-authorising a stated class of actions for a stated scope and period, by an identified authority.</skos:definition>
        <skos:definition xml:lang="fr">Relevé de décision qui accorde ou refuse l&apos;exécution d&apos;une action de réponse, ou qui préautorise une classe d&apos;actions précisée pour un périmètre et une période donnés, par une autorité identifiée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (ApprovalDecision); reuses decision record (decision S3). An approval is about one execution or a narrowly scoped pre-authorisation.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001120 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001120">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <owl:disjointWith rdf:resource="https://w3id.org/crgo/CRGO_0001121"/>
        <rdfs:label xml:lang="en">automation execution record</rdfs:label>
        <rdfs:label xml:lang="fr">enregistrement d&apos;exécution automatisée</rdfs:label>
        <skos:definition xml:lang="en">A record of one run of a playbook version: what triggered it, when it started and ended, its status and the investigation or incident it served. The full execution history stays in the operational store.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement d&apos;une exécution d&apos;une version de guide : ce qui l&apos;a déclenchée, son début et sa fin, son état et l&apos;enquête ou l&apos;incident qu&apos;elle a servi. L&apos;historique complet reste dans le dépôt opérationnel.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (AutomationExecution).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001121 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001121">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">action execution record</rdfs:label>
        <rdfs:label xml:lang="fr">enregistrement d&apos;exécution d&apos;action</rdfs:label>
        <skos:definition xml:lang="en">A record of one attempt to carry out a response action on a target, with its time, status, the approval relied on and the evidence it produced.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement d&apos;une tentative d&apos;exécution d&apos;une action de réponse sur une cible, avec son moment, son état, l&apos;approbation invoquée et les preuves produites.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (ActionExecution).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001122 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001122">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="fr">preuve de réponse</rdfs:label>
        <rdfs:label xml:lang="en">response evidence</rdfs:label>
        <skos:definition xml:lang="en">An evidence item recording that a response action was carried out and with what result, such as a system log entry or a screenshot of the changed configuration.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve qui consigne qu&apos;une action de réponse a été effectuée et avec quel résultat, comme une entrée de journal système ou une capture de la configuration modifiée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (ResponseEvidence).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001123 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001123">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000036"/>
        <rdfs:label xml:lang="fr">artefact d&apos;investigation numérique</rdfs:label>
        <rdfs:label xml:lang="en">forensic artefact</rdfs:label>
        <skos:altLabel xml:lang="fr">artefact forensique</skos:altLabel>
        <skos:altLabel xml:lang="en">forensic artifact</skos:altLabel>
        <skos:definition xml:lang="en">An evidence item collected for forensic analysis, such as a disk or memory image, kept under recorded custody with its integrity hash.</skos:definition>
        <skos:definition xml:lang="fr">Élément de preuve recueilli pour une analyse forensique, comme une image de disque ou de mémoire, conservé sous une garde consignée avec son empreinte d&apos;intégrité.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (ForensicArtifact); reuses custodian, evidence hash and collection date.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001124 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001124">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">impact de l&apos;incident</rdfs:label>
        <rdfs:label xml:lang="en">incident impact</rdfs:label>
        <skos:definition xml:lang="en">A description of a consequence an incident had, or is estimated to have had, along one impact dimension, such as hours of service lost or the number of records exposed, with whether it is observed or estimated.</skos:definition>
        <skos:definition xml:lang="fr">Description d&apos;une conséquence qu&apos;un incident a eue, ou est estimé avoir eue, selon une dimension d&apos;impact, comme les heures de service perdues ou le nombre d&apos;enregistrements exposés, en précisant si elle est observée ou estimée.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (IncidentImpact). Distinct from a scenario&apos;s consequence description, which is what could happen.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001125 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001125">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="fr">communication relative à l&apos;incident</rdfs:label>
        <rdfs:label xml:lang="en">incident communication</rdfs:label>
        <skos:definition xml:lang="en">A record of a notification or escalation about an incident to a stated audience, such as management, affected persons, customers or a regulator, with when it was sent and what it covered.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement d&apos;un avis ou d&apos;une transmission à un niveau supérieur concernant un incident, adressé à un public précisé, comme la direction, les personnes concernées, des clients ou une autorité, avec la date d&apos;envoi et ce qu&apos;il couvrait.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (IncidentCommunication). A notice to a regulator is also recorded as a regulatory submission (0.10.0).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001126 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001126">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
        <rdfs:label xml:lang="en">recovery verification</rdfs:label>
        <rdfs:label xml:lang="fr">vérification du rétablissement</rdfs:label>
        <skos:definition xml:lang="en">A dated record that an asset or business process affected by an incident was checked to be restored to its expected operation, by whom and on what evidence.</skos:definition>
        <skos:definition xml:lang="fr">Enregistrement daté indiquant qu&apos;un actif ou un processus d&apos;affaires touché par un incident a été vérifié comme rétabli dans son fonctionnement attendu, par qui et sur quelles preuves.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (RecoveryVerification).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001127 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001127">
        <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001163"/>
        <rdfs:label xml:lang="fr">mesure de l&apos;efficacité de la réponse</rdfs:label>
        <rdfs:label xml:lang="en">response effectiveness measurement</rdfs:label>
        <skos:definition xml:lang="en">A measurement of how quickly or well an incident or a set of incidents was handled, such as time to contain, for a stated metric and under a stated method.</skos:definition>
        <skos:definition xml:lang="fr">Mesure de la rapidité ou de la qualité avec laquelle un incident ou un ensemble d&apos;incidents a été traité, comme le délai de confinement, pour un indicateur et selon une méthode précisés.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR section 2 (ResponseEffectiveness: measure under stated methodology).</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000286 xml:lang="en">NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001128 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001128">
        <rdfs:subClassOf rdf:resource="https://w3id.org/crgo/CRGO_0000347"/>
        <rdfs:label xml:lang="en">playbook simulation</rdfs:label>
        <rdfs:label xml:lang="fr">simulation de guide</rdfs:label>
        <skos:definition xml:lang="en">A control assessment in which a playbook version is run in a test environment or exercise to check that it behaves as intended.</skos:definition>
        <skos:definition xml:lang="fr">Évaluation de mesure dans laquelle une version de guide est exécutée dans un environnement d&apos;essai ou lors d&apos;un exercice pour vérifier qu&apos;elle se comporte comme prévu.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">SOAR CQ-SOAR-04 (playbooks that have not passed simulation); reuses control assessment (decision S3). It tests one playbook version, not the whole response capability: consumers that report a measure&apos;s effectiveness leave simulations out.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.10.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">0.10.0 final review group 2</crgo:CRGO_0000292>
    </owl:Class>
    


    <!-- https://w3id.org/crgo/CRGO_0001129 -->


    <owl:Class rdf:about="https://w3id.org/crgo/CRGO_0001129">

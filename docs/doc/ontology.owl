        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>
        <crgo:CRGO_0000288 rdf:resource="https://w3id.org/crgo/CRGO_0000181"/>
        <crgo:CRGO_0000289 rdf:resource="https://w3id.org/crgo/CRGO_0000182"/>
        <crgo:CRGO_0000290 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</crgo:CRGO_0000290>
        <crgo:CRGO_0000291>0.9.0</crgo:CRGO_0000291>
        <crgo:CRGO_0000292 xml:lang="en">GRCA review item 1</crgo:CRGO_0000292>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/crgo/CRGO_0000723 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/crgo/CRGO_0000723">
        <rdfs:label xml:lang="en">derived from requirement</rdfs:label>
        <rdfs:label xml:lang="fr">découle de l&apos;exigence</rdfs:label>
        <skos:definition xml:lang="en">Relates a policy statement or technical standard to an obligation, control or framework requirement it is written to meet.</skos:definition>
        <skos:definition xml:lang="fr">Relie un énoncé de politique ou une norme technique à une obligation, une mesure ou une exigence de référentiel qu&apos;il vise à respecter.</skos:definition>
        <crgo:CRGO_0000283 rdf:resource="https://w3id.org/crgo/CRGO_0000069"/>
        <crgo:CRGO_0000284 rdf:resource="https://w3id.org/crgo/CRGO_0000063"/>
        <crgo:CRGO_0000285 xml:lang="en">GAPS D01 chain: obligation, control objective, policy statement, procedure. Meeting a requirement in writing is not evidence of compliance.</crgo:CRGO_0000285>
        <crgo:CRGO_0000286 xml:lang="en">CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)</crgo:CRGO_0000286>

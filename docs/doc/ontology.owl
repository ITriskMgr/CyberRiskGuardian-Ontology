    <!-- https://w3id.org/crgo/CRGO_0001323 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/crgo/CRGO_0001323">
        <rdfs:domain rdf:resource="https://w3id.org/crgo/CRGO_0001127"/>

    sh:property [ sh:message "A framework adoption needs at least one value for what is adopted."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001029 ],
        [ sh:maxCount 1 ;
            sh:message "A framework adoption needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ] ;
    sh:targetClass crgo:CRGO_0000898 .

shape:Functional_allocatedTo a sh:NodeShape ;
    rdfs:comment "At most one 'allocated to' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'allocated to' takes at most one value."@en ;
            sh:path crgo:CRGO_0000226 ] ;

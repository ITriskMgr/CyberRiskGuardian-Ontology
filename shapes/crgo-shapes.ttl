            sh:path crgo:CRGO_0000196 ],
        [ sh:message "A linked library scenario needs a theme."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000246 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000335 .

shape:LibraryScenario a sh:NodeShape ;
    rdfs:comment "Library scenarios are themed or refine a family, and point to requirements or to the family they refine."@en ;
    sh:message "A library scenario needs at least one relevant requirement, or must refine a library family."@en ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000335 ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000204 ] ] ) ;
    sh:targetClass crgo:CRGO_0000024 .

shape:LinkAnnotation a sh:NodeShape ;
    rdfs:comment "Every annotated CRGO link records its confidence, status and proposer (axioms of imported W3C slices are not CRGO links)."@en ;
    sh:property [ sh:message "A link must record who proposed it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000288 ],
        [ sh:maxCount 1 ;
            sh:message "A link needs exactly one governance status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000283 ],
        [ sh:maxCount 1 ;
            sh:message "A link needs exactly one confidence level."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000284 ] ;
    sh:sparql [ sh:message "An approved link must record its approver and approval date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000283> <https://w3id.org/crgo/CRGO_0000069> .
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000289> ?who . $this <https://w3id.org/crgo/CRGO_0000290> ?when . }
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <http://www.w3.org/2002/07/owl#Axiom> ; <http://www.w3.org/2002/07/owl#annotatedSource> ?s . FILTER(STRSTARTS(STR(?s), \"https://w3id.org/crgo/\")) }" ] .

shape:ManagementResponse a sh:NodeShape ;
    rdfs:comment "Management responses name the finding, the stance and who responded."@en ;
    sh:property [ sh:message "A management response needs at least one value for who responded."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000805 ],
        [ sh:message "A management response needs at least one value for the finding or recommendation answered."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000803 ],
        [ sh:maxCount 1 ;
            sh:message "A management response needs exactly one value for the stance."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000804 ] ;
    sh:targetClass crgo:CRGO_0000545 .

shape:Nonconformity a sh:NodeShape ;
    rdfs:comment "Nonconformities: requirement, organisation, date."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A nonconformity needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ],
        [ sh:maxCount 1 ;
            sh:message "A nonconformity needs exactly one value for the date identified."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000846 ],
        [ sh:message "A nonconformity needs at least one value for the requirement."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000747 ] ;
    sh:targetClass crgo:CRGO_0000511 .

shape:Observation a sh:NodeShape ;
    rdfs:comment "Observations are dated and about one thing."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An observation needs exactly one date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000458 ],
        [ sh:message "An observation must name its source record."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000407 ],
        [ sh:maxCount 1 ;
            sh:message "An observation is about exactly one entity."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000408 ] ;
    sh:targetClass crgo:CRGO_0000338 .

shape:OperatingEffectiveness a sh:NodeShape ;
    rdfs:comment "Operating effectiveness is tested over a period and a population or sample (GAPS D05)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An operating effectiveness assessment needs exactly one value for the start of the period tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000849 ],
        [ sh:maxCount 1 ;
            sh:message "An operating effectiveness assessment needs exactly one value for the number of items tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000861 ],
        [ sh:maxCount 1 ;
            sh:message "An operating effectiveness assessment needs exactly one value for the end of the period tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000850 ] ;
    sh:sparql [ sh:message "Deviations found cannot exceed the items tested, and the period must end after it starts."@en ;
            sh:select """SELECT $this WHERE {
  { $this <https://w3id.org/crgo/CRGO_0000861> ?n ; <https://w3id.org/crgo/CRGO_0000862> ?d . FILTER(?d > ?n) } UNION { $this <https://w3id.org/crgo/CRGO_0000849> ?a ; <https://w3id.org/crgo/CRGO_0000850> ?b . FILTER(?b <= ?a) } }""" ] ;
    sh:targetClass crgo:CRGO_0000526 .

shape:Place_dataSubjectsIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'dataSubjectsIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000417> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000417 .

shape:Place_establishedIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'establishedIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000411> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000411 .

shape:Place_monitorsBehaviourIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'monitorsBehaviourIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000413> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000413 .

shape:Place_offersServicesIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'offersServicesIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000412> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000412 .

shape:Place_transfersDataTo a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'transfersDataTo'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000418> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000418 .

shape:PolicyException a sh:NodeShape ;
    rdfs:comment "Exceptions are scoped, justified, approved by an authority and expire (GAPS D01)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A policy exception needs exactly one value for its start date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ],
        [ sh:maxCount 1 ;
            sh:message "A policy exception needs exactly one value for its expiry date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000838 ],
        [ sh:message "A policy exception needs at least one value for its justification."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000842 ],
        [ sh:message "A policy exception needs at least one value for its scope."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000727 ],
        [ sh:message "A policy exception needs at least one value for what it deviates from."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000726 ],
        [ sh:message "A policy exception needs at least one value for its approving authority."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000728 ] ;
    sh:sparql [ sh:message "A policy exception expires after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b <= ?a) }" ],
        [ sh:message "A policy exception cannot waive a legal provision; only internal rules and controls can be excepted."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000726> ?t . { ?t <https://w3id.org/crgo/CRGO_0000422> ?i } UNION { ?t a <https://w3id.org/crgo/CRGO_0000022> } UNION { ?t a <https://w3id.org/crgo/CRGO_0000343> } }""" ] ;
    sh:targetClass crgo:CRGO_0000502 .

shape:Range_CVSS a sh:NodeShape ;
    rdfs:comment "CVSS base scores are between 0 and 10."@en ;
    sh:property [ sh:maxInclusive 10.0 ;
            sh:message "CVSS score must be between 0 and 10."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000049 .

shape:Range_Criticality a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000046 .

shape:Range_EstimatedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ] ;
    sh:targetClass crgo:CRGO_0000051 .

shape:Range_ExpectedDamage a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000043 .

shape:Range_ExploitationProbability a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000042 .

shape:Range_ImpactReduction a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000048 .

shape:Range_MaximumDamage a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000044 .

shape:Range_MitigatedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ] ;
    sh:targetClass crgo:CRGO_0000053 .

shape:Range_PreTreatmentRatio a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000301 .

shape:Range_ProbabilityReduction a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000047 .

shape:Range_ResidualRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000054 .

shape:Range_Resilience a sh:NodeShape ;
    rdfs:comment "Resilience is in (0, 1]: CRG divides by it."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Resilience must be greater than 0 and at most 1."@en ;
            sh:minExclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000045 .

shape:Range_RiskToToleranceRatio a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:Range_ThreatPresence a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000041 .

shape:Range_ToleratedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000052 .

shape:ReassessmentTrigger a sh:NodeShape ;
    rdfs:comment "Triggers name their cause and what must be reviewed."@en ;
    sh:property [ sh:message "A reassessment trigger needs at least one value for the cause."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000745 ],
        [ sh:message "A reassessment trigger needs at least one value for what must be reviewed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000746 ] ;
    sh:targetClass crgo:CRGO_0000510 .

shape:RegulatoryChange a sh:NodeShape ;
    rdfs:comment "Regulatory changes: what changed, how, when identified."@en ;
    sh:property [ sh:message "A regulatory change needs at least one value for what changed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000743 ],
        [ sh:maxCount 1 ;
            sh:message "A regulatory change needs exactly one value for the date identified."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000846 ],
        [ sh:maxCount 1 ;
            sh:message "A regulatory change needs exactly one value for the change type."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000744 ] ;
    sh:targetClass crgo:CRGO_0000509 .

shape:RiskAssessment a sh:NodeShape ;
    rdfs:comment "Assessments that compute tolerance state their appetite once."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An assessment has at most one risk appetite statement."@en ;
            sh:path crgo:CRGO_0000217 ] ;
    sh:targetClass crgo:CRGO_0000028 .

shape:RiskScenario a sh:NodeShape ;
    rdfs:comment "Scenarios are named."@en ;
    sh:property [ sh:message "A scenario needs a label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass crgo:CRGO_0000023 .

shape:RoleAssignment a sh:NodeShape ;
    rdfs:comment "Role assignments: role, agent and period (GRCA section 4)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A role assignment needs exactly one value for the start date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ],
        [ sh:maxCount 1 ;
            sh:message "A role assignment needs exactly one value for the role."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000714 ],
        [ sh:maxCount 1 ;
            sh:message "A role assignment needs exactly one value for the agent."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000715 ] ;
    sh:sparql [ sh:message "A role assignment ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b <= ?a) }" ] ;
    sh:targetClass crgo:CRGO_0000493 .

shape:RoleConflict a sh:NodeShape ;
    rdfs:comment "Warning, not violation: the same agent operates a control and assesses it as an independent line (GRCA section 4)."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "Possible role conflict: the assessor also operates the control it assesses as second line, internal audit or external assurer."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000436> ?m ; <https://w3id.org/crgo/CRGO_0000435> ?who ; <https://w3id.org/crgo/CRGO_0000737> ?line . FILTER(?line IN (<https://w3id.org/crgo/CRGO_0000605>, <https://w3id.org/crgo/CRGO_0000606>, <https://w3id.org/crgo/CRGO_0000607>)) ?who <https://w3id.org/crgo/CRGO_0000712> ?m .
}""" ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:SampleItem a sh:NodeShape ;
    rdfs:comment "Sample items: plan and result."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A sample item needs exactly one value for the sampling plan."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000758 ],
        [ sh:maxCount 1 ;
            sh:message "A sample item needs exactly one value for the result."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000759 ] ;
    sh:targetClass crgo:CRGO_0000530 .

shape:SamplingPlan a sh:NodeShape ;
    rdfs:comment "Sampling plans: population, size, method, rationale."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A sampling plan needs exactly one value for the method."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000757 ],
        [ sh:maxCount 1 ;
            sh:message "A sampling plan needs exactly one value for the sample size."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000857 ],
        [ sh:maxCount 1 ;
            sh:message "A sampling plan needs exactly one value for the population."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000755 ],
        [ sh:message "A sampling plan needs at least one value for the rationale."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000860 ] ;
    sh:targetClass crgo:CRGO_0000529 .

shape:ScenarioStep a sh:NodeShape ;
    rdfs:comment "Steps are ordered."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A scenario step needs exactly one positive order number."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path crgo:CRGO_0000254 ] ;
    sh:targetClass crgo:CRGO_0000026 .

shape:SourceAccess a sh:NodeShape ;
    rdfs:comment "Source records state whether CRGO holds and may use the source (GRCA section 3)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one value for the access status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000699 ] ;
    sh:targetClass crgo:CRGO_0000337 .

shape:SourceRecord a sh:NodeShape ;
    rdfs:comment "Source records carry the fields of specification section 7."@en ;
    sh:property [ sh:message "A source record needs a title."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000250 ],
        [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000450 ],
        [ sh:message "A source record must state its licence or terms."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000453 ],
        [ sh:maxCount 1 ;
            sh:message "A source record has at most one retrieval date."@en ;
            sh:path crgo:CRGO_0000449 ],
        [ sh:message "A source record must name its issuer."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000452 ] ;
    sh:targetClass crgo:CRGO_0000337 .

shape:StaleEvidence a sh:NodeShape ;
    rdfs:comment "Warning: evidence relied on is out of date or does not cover the period assessed (CQ-GRCA-11)."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "Evidence relied on had expired, or its period ended before the period assessed began."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000213> ?e .
  { $this <https://w3id.org/crgo/CRGO_0000464> ?on . ?e <https://w3id.org/crgo/CRGO_0000838> ?until . FILTER(?until < ?on) } UNION { $this <https://w3id.org/crgo/CRGO_0000849> ?ps . ?e <https://w3id.org/crgo/CRGO_0000850> ?pe . FILTER(?pe < ?ps) }
}""" ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:Target_0000228 a sh:NodeShape ;
    rdfs:comment "Obligations are concepts of the Loi 25 vocabulary."@en ;
    sh:property [ sh:class skos:Concept ;
            sh:message "Obligations are concepts of the Loi 25 vocabulary."@en ;
            sh:path crgo:CRGO_0000228 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000228 .

shape:Target_0000335 a sh:NodeShape ;
    rdfs:comment "Relevant requirements are framework concepts."@en ;
    sh:property [ sh:class skos:Concept ;
            sh:message "Relevant requirements are framework concepts."@en ;
            sh:path crgo:CRGO_0000335 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000335 .

shape:ToleranceClass a sh:NodeShape ;
    rdfs:comment "A ratio carries its tolerance class."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A risk-to-tolerance ratio needs exactly one tolerance class."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000240 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:TypedMapping a sh:NodeShape ;
    rdfs:comment "Every correspondence between vocabulary concepts has a typed relation (decision D3)."@en ;
    sh:sparql [ sh:message "A correspondence needs a typed relation (a CRGO sub-property of the SKOS mapping relation) between the same concepts."@en ;
            sh:select """SELECT $this WHERE {
  $this <http://www.w3.org/2002/07/owl#annotatedProperty> ?p ; <http://www.w3.org/2002/07/owl#annotatedSource> ?s ; <http://www.w3.org/2002/07/owl#annotatedTarget> ?o .
  FILTER(?p IN (<http://www.w3.org/2004/02/skos/core#relatedMatch>, <http://www.w3.org/2004/02/skos/core#closeMatch>))
  FILTER NOT EXISTS { ?s ?tp ?o . ?tp <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?p . FILTER(?tp != ?p) }
}""" ] ;
    sh:targetClass owl:Axiom .

shape:VocabularySource a sh:NodeShape ;
    rdfs:comment "Every imported vocabulary names its source record."@en ;
    sh:sparql [ sh:message "A CRGO vocabulary must name its source record (has source record)."@en ;
            sh:select """SELECT $this WHERE {
  FILTER(STRSTARTS(STR($this), "https://w3id.org/crgo/vocab/") && STR($this) != "https://w3id.org/crgo/vocab/theme")
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000407> ?src }
}""" ] ;
    sh:targetClass skos:ConceptScheme .


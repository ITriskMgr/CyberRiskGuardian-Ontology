@prefix crgo: <https://w3id.org/crgo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://w3id.org/crgo/shapes/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

crgo:shapes a owl:Ontology ;
    rdfs:label "CRGO SHACL shapes"@en ;
    owl:versionInfo "0.10.0" .

shape:ActionApproval a sh:NodeShape ;
    rdfs:comment "Warning (audit signal): impactful actions need a granted approval valid when they started (SOAR section 5, decision S6). A record of an unapproved action is a correct record of a control failure, so this is a warning, not a violation."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "A containment or destructive action, or one behind an approval gate, was executed without a corresponding approval that was granted and valid when it started (an audit signal, never an authorisation)."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001289> ?act ; <https://w3id.org/crgo/CRGO_0001314> ?t .
  { ?act <https://w3id.org/crgo/CRGO_0001277> ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0001192>, <https://w3id.org/crgo/CRGO_0001193>)) } UNION { ?act <https://w3id.org/crgo/CRGO_0001279> ?gate }
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001291> ?d . ?d <https://w3id.org/crgo/CRGO_0000732> <https://w3id.org/crgo/CRGO_0000588> ; <https://w3id.org/crgo/CRGO_0000840> ?dd ; <https://w3id.org/crgo/CRGO_0000837> ?from . FILTER(?dd <= ?t && ?from <= ?t)
    FILTER NOT EXISTS { ?d <https://w3id.org/crgo/CRGO_0000838> ?until . FILTER(?until < ?t) } FILTER NOT EXISTS { ?d <https://w3id.org/crgo/CRGO_0001325> ?ro . FILTER(?ro <= ?t) }
    FILTER NOT EXISTS { ?d <https://w3id.org/crgo/CRGO_0001282> <https://w3id.org/crgo/CRGO_0001185> }
    FILTER (EXISTS { ?d <https://w3id.org/crgo/CRGO_0000730> $this } || EXISTS { ?d <https://w3id.org/crgo/CRGO_0000730> ?act } || EXISTS { ?d <https://w3id.org/crgo/CRGO_0001283> ?act } || EXISTS { ?d <https://w3id.org/crgo/CRGO_0001283> ?rcl . ?act <https://w3id.org/crgo/CRGO_0001277> ?rcl })
    FILTER (NOT EXISTS { ?act <https://w3id.org/crgo/CRGO_0001279> ?g1 . ?g1 <https://w3id.org/crgo/CRGO_0001281> ?a1 } || EXISTS { ?act <https://w3id.org/crgo/CRGO_0001279> ?g2 . ?g2 <https://w3id.org/crgo/CRGO_0001281> ?who . ?d <https://w3id.org/crgo/CRGO_0000731> ?who }) } }""" ] ;
    sh:targetClass crgo:CRGO_0001121 .

shape:ActionExecution a sh:NodeShape ;
    rdfs:comment "Action executions: action, target, status, start, attempt identifier; impactful actions need a valid approval (SOAR section 5)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An action execution record needs exactly one value for the execution status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001287 ],
        [ sh:message "An action execution record needs at least one value for the target."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001290 ],
        [ sh:maxCount 1 ;
            sh:message "An action execution record needs exactly one value for the start time."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001314 ],
        [ sh:maxCount 1 ;
            sh:message "An action execution record needs exactly one value for the attempt identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001316 ],
        [ sh:maxCount 1 ;
            sh:message "An action execution record needs exactly one value for the action."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001289 ] ;
    sh:sparql [ sh:message "An execution ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001314> ?a ; <https://w3id.org/crgo/CRGO_0001315> ?b . FILTER(?b < ?a) }" ] ;
    sh:targetClass crgo:CRGO_0001121 .

shape:AnalyticalResult a sh:NodeShape ;
    rdfs:comment "Results computed by an external model are traceable and stay risk estimates (ADR-007)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An analytical result needs exactly one governance status (proposed until a person approves it)."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000283 ],
        [ sh:maxCount 1 ;
            sh:message "An analytical result needs exactly one value for the model name."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000832 ],
        [ sh:maxCount 1 ;
            sh:message "An analytical result needs exactly one value for the model version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000833 ],
        [ sh:maxCount 1 ;
            sh:message "An analytical result needs exactly one value for the input document checksum."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000836 ],
        [ sh:message "An analytical result needs at least one value for what it is computed for."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000704 ],
        [ sh:maxCount 1 ;
            sh:message "An analytical result needs exactly one value for the computation time."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000834 ] ;
    sh:sparql [ sh:message "An approved analytical result must name the person who approved it and when; a write-back alone never approves it."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000283> <https://w3id.org/crgo/CRGO_0000069> . FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000289> ?who ; <https://w3id.org/crgo/CRGO_0000290> ?d } }""" ],
        [ sh:message "An analytical result computed outside CRGO is a risk estimate, never a fact, conclusion or decision."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000698> ?k . FILTER(?k != <https://w3id.org/crgo/CRGO_0000561>) }""" ] ;
    sh:targetClass crgo:CRGO_0000477 .

shape:ApplicabilityAssessment a sh:NodeShape ;
    rdfs:comment "Applicability assessments: what, for whom, when, by whom, with what result."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ],
        [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the state reached."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000428 ],
        [ sh:message "An applicability assessment must name who made it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the instrument or provision assessed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000426 ],
        [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ] ;
    sh:targetClass crgo:CRGO_0000345 .

shape:ApplicabilityCondition a sh:NodeShape ;
    rdfs:comment "Conditions belong to an instrument and have one test."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A condition needs exactly one machine-readable test."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000469 ;
            sh:pattern "^(required|anyof|exception)\\|[^|]+\\|(plain|interpretive)$" ],
        [ sh:message "A condition must say what it is a condition of."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000424 ],
        [ sh:maxCount 1 ;
            sh:message "A condition needs exactly one kind."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000425 ] ;
    sh:targetClass crgo:CRGO_0000344 .

shape:ApprovalDecision a sh:NodeShape ;
    rdfs:comment "Approval decisions state their approval status."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An approval decision needs exactly one value for the approval status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001282 ] ;
    sh:targetClass crgo:CRGO_0001119 .

shape:ApprovalDecisionConsistent a sh:NodeShape ;
    rdfs:comment "Approval status and decision outcome agree."@en ;
    sh:sparql [ sh:message "An approval granted must have the outcome 'approved'; an approval denied must have the outcome 'rejected'."@en ;
            sh:select """SELECT $this WHERE {
  { $this <https://w3id.org/crgo/CRGO_0001282> <https://w3id.org/crgo/CRGO_0001184> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000732> <https://w3id.org/crgo/CRGO_0000588> } } UNION { $this <https://w3id.org/crgo/CRGO_0001282> <https://w3id.org/crgo/CRGO_0001185> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000732> <https://w3id.org/crgo/CRGO_0000589> } } }""" ] ;
    sh:targetClass crgo:CRGO_0001119 .

shape:Attestation a sh:NodeShape ;
    rdfs:comment "Attestations are management declarations (improvement I2)."@en ;
    sh:sparql [ sh:message "An attestation records a management declaration: its knowledge status, if stated, is a management decision."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000698> ?k . FILTER(?k != <https://w3id.org/crgo/CRGO_0000563>) }""" ] ;
    sh:targetClass crgo:CRGO_0000891 .

shape:AuditCharter a sh:NodeShape ;
    rdfs:comment "Charters govern an audit function."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An audit charter needs exactly one value for the audit function."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001046 ] ;
    sh:targetClass crgo:CRGO_0000906 .

shape:AuditFinding a sh:NodeShape ;
    rdfs:comment "A finding needs criterion, condition and evidence, within an engagement (GRCA WP3)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An audit finding needs exactly one value for the engagement it was raised in."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000788 ],
        [ sh:message "An audit finding needs at least one value for the criterion."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000779 ],
        [ sh:message "An audit finding needs at least one value for the evidence relied on."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000213 ],
        [ sh:message "An audit finding needs at least one value for the condition found."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000870 ],
        [ sh:maxCount 1 ;
            sh:message "An audit finding needs exactly one value for the date raised."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000869 ],
        [ sh:maxCount 1 ;
            sh:message "An audit finding needs exactly one value for the significance."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000793 ] ;
    sh:sparql [ sh:message "An audit finding cannot have the knowledge status of a reference fact or a verified outcome."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000698> ?k . FILTER(?k IN (<https://w3id.org/crgo/CRGO_0000558>, <https://w3id.org/crgo/CRGO_0000564>)) }""" ] ;
    sh:targetClass crgo:CRGO_0000541 .

shape:AuditObservation a sh:NodeShape ;
    rdfs:comment "Observations belong to an engagement and carry no audit conclusion (decision D8)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An audit observation needs exactly one value for the engagement."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000788 ] ;
    sh:sparql [ sh:message "An audit observation is preliminary: it cannot have the knowledge status of an audit conclusion, a reference fact or a verified outcome."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000698> ?k . FILTER(?k IN (<https://w3id.org/crgo/CRGO_0000562>, <https://w3id.org/crgo/CRGO_0000558>, <https://w3id.org/crgo/CRGO_0000564>)) }""" ] ;
    sh:targetClass crgo:CRGO_0000910 .

shape:AuditPlanEntry a sh:NodeShape ;
    rdfs:comment "Plan entries: plan, state; reason and authoriser when deferred or cancelled (AUD section 7)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An audit plan entry needs exactly one value for the state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001050 ],
        [ sh:maxCount 1 ;
            sh:message "An audit plan entry needs exactly one value for the plan."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001047 ] ;
    sh:sparql [ sh:message "A deferred or cancelled plan entry needs its reason and who authorised it."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001050> ?st . FILTER(?st IN (<https://w3id.org/crgo/CRGO_0000977>, <https://w3id.org/crgo/CRGO_0000978>)) FILTER (NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001085> ?r } || NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000728> ?a }) }""" ] ;
    sh:targetClass crgo:CRGO_0000908 .

shape:AuditProcedure a sh:NodeShape ;
    rdfs:comment "Each procedure states its method and cites the objectives it serves (GRCA section 8)."@en ;
    sh:property [ sh:message "An audit procedure needs at least one value for the assessment method."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000736 ],
        [ sh:message "An audit procedure needs at least one value for an objective it serves."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000783 ] ;
    sh:targetClass crgo:CRGO_0000535 .

shape:AuditProgramme a sh:NodeShape ;
    rdfs:comment "Work programmes contain procedures."@en ;
    sh:property [ sh:message "An audit work programme needs at least one value for a procedure."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000782 ] ;
    sh:targetClass crgo:CRGO_0000534 .

shape:AuditQualityReview a sh:NodeShape ;
    rdfs:comment "Quality reviews: subject, kind, reviewer, date."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An audit quality review needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:maxCount 1 ;
            sh:message "An audit quality review needs exactly one value for the kind."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001059 ],
        [ sh:message "An audit quality review needs at least one value for the reviewer."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:message "An audit quality review needs at least one value for what is reviewed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001058 ] ;
    sh:targetClass crgo:CRGO_0000911 .

shape:AuditWorkpaper a sh:NodeShape ;
    rdfs:comment "Workpapers: what they document, preparer, date; no sole self-review (AUD section 9)."@en ;
    sh:property [ sh:message "An audit workpaper needs at least one value for the preparer."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001056 ],
        [ sh:message "An audit workpaper needs at least one value for what it documents."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001055 ],
        [ sh:maxCount 1 ;
            sh:message "An audit workpaper needs exactly one value for the preparation date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001090 ] ;
    sh:sparql [ sh:message "Self-review: the only reviewer of a workpaper is its preparer."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001065> ?r . FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001065> ?r2 . FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001056> ?r2 } } }""" ] ;
    sh:targetClass crgo:CRGO_0000909 .

shape:AutomationExecution a sh:NodeShape ;
    rdfs:comment "Executions cite the exact playbook version and an attempt identifier (SOAR section 5)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An automation execution record needs exactly one value for the execution status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001287 ],
        [ sh:maxCount 1 ;
            sh:message "An automation execution record needs exactly one value for the start time."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001314 ],
        [ sh:maxCount 1 ;
            sh:message "An automation execution record needs exactly one value for the attempt identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001316 ],
        [ sh:maxCount 1 ;
            sh:message "An automation execution record needs exactly one value for the playbook version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001284 ] ;
    sh:sparql [ sh:message "An execution ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001314> ?a ; <https://w3id.org/crgo/CRGO_0001315> ?b . FILTER(?b < ?a) }" ] ;
    sh:targetClass crgo:CRGO_0001120 .

shape:BreachReportability a sh:NodeShape ;
    rdfs:comment "Reportability assessments: incident, provision, state, date, assessor."@en ;
    sh:property [ sh:message "A breach reportability assessment needs at least one value for the provision."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000818 ],
        [ sh:message "A breach reportability assessment needs at least one value for the assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:maxCount 1 ;
            sh:message "A breach reportability assessment needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:maxCount 1 ;
            sh:message "A breach reportability assessment needs exactly one value for the incident."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000817 ],
        [ sh:maxCount 1 ;
            sh:message "A breach reportability assessment needs exactly one value for the state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000819 ] ;
    sh:targetClass crgo:CRGO_0000553 .

shape:CalculationActivity a sh:NodeShape ;
    rdfs:comment "Calculations name their method."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A calculation needs exactly one method."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000239 ] ;
    sh:targetClass crgo:CRGO_0000058 .

shape:ComplianceAttestation a sh:NodeShape ;
    rdfs:comment "Compliance attestations: signatory, date, subject and scope."@en ;
    sh:property [ sh:message "A compliance attestation needs at least one value for the scope and basis."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001071 ],
        [ sh:message "A compliance attestation needs at least one value for what is attested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001022 ],
        [ sh:message "A compliance attestation needs at least one value for the signatory."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001021 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance attestation needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001070 ] ;
    sh:targetClass crgo:CRGO_0000904 .

shape:ComplianceDeadline a sh:NodeShape ;
    rdfs:comment "Deadlines: what sets them and how they are computed (CMP section 8)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A compliance deadline needs exactly one value for the trigger kind."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001035 ],
        [ sh:message "A compliance deadline needs at least one value for the obligation or provision."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001034 ] ;
    sh:sparql [ sh:message "An event-triggered deadline needs its offset in hours; a calendar deadline needs its due date."@en ;
            sh:select """SELECT $this WHERE {
  { $this <https://w3id.org/crgo/CRGO_0001035> <https://w3id.org/crgo/CRGO_0000950> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001077> ?h } } UNION { $this <https://w3id.org/crgo/CRGO_0001035> <https://w3id.org/crgo/CRGO_0000949> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000868> ?d } } }""" ] ;
    sh:targetClass crgo:CRGO_0000901 .

shape:ComplianceDetermination a sh:NodeShape ;
    rdfs:comment "Compliance determinations: section 13 fields, and evidence or an explicit evidence gap."@en ;
    sh:message "A compliance determination needs evidence, or an explicit statement of the missing evidence."@en ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000213 ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000470 ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000433 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the provision."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000432 ],
        [ sh:message "A compliance determination must name its assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ] ;
    sh:sparql [ sh:message "A compliance determination about a legal provision or obligation needs its jurisdictional scope."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000432> ?t . { ?t <https://w3id.org/crgo/CRGO_0000422> ?i } UNION { ?t a <https://w3id.org/crgo/CRGO_0000022> } FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000420> ?j } }""" ],
        [ sh:message "A satisfied or partially satisfied compliance determination must cite evidence; an evidence gap alone is not enough."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000433> ?st . FILTER(?st IN (<https://w3id.org/crgo/CRGO_0000389>, <https://w3id.org/crgo/CRGO_0000390>)) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000213> ?e }
}""" ] ;
    sh:targetClass crgo:CRGO_0000346 .

shape:ConcludedIncidentConfirmed a sh:NodeShape ;
    rdfs:comment "Warning: an investigation's conclusion counts only with an incident confirmation (decision S5)."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "The incident this investigation concluded has no incident confirmation yet."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001268> ?i . FILTER NOT EXISTS { ?c <https://w3id.org/crgo/CRGO_0000815> ?i } }""" ] ;
    sh:targetClass crgo:CRGO_0001112 .

shape:ControlAssessment a sh:NodeShape ;
    rdfs:comment "Control assessments: measure, date, result, assessor; evidence unless not tested."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A control assessment needs exactly one value for the result."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000437 ],
        [ sh:maxCount 1 ;
            sh:message "A control assessment needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:maxCount 1 ;
            sh:message "A control assessment needs exactly one value for the control measure."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000436 ],
        [ sh:message "A control assessment must name its assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ] ;
    sh:sparql [ sh:message "A tested control assessment must link the evidence gathered."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000437> ?r . FILTER(?r != <https://w3id.org/crgo/CRGO_0000406>) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000213> ?e }
}""" ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:ControlDeficiency a sh:NodeShape ;
    rdfs:comment "Deficiencies: control measure, assessment, aspect, severity."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A control deficiency needs exactly one value for the severity."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000763 ],
        [ sh:message "A control deficiency needs at least one value for the assessment that found it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000761 ],
        [ sh:maxCount 1 ;
            sh:message "A control deficiency needs exactly one value for the aspect."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000762 ],
        [ sh:maxCount 1 ;
            sh:message "A control deficiency needs exactly one value for the control measure."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000760 ] ;
    sh:targetClass crgo:CRGO_0000527 .

shape:ControlMeasureNotControl a sh:NodeShape ;
    rdfs:comment "An implementation is never the same individual as an abstract control."@en ;
    sh:sparql [ sh:message "A control measure must not be owl:sameAs a control."@en ;
            sh:select """SELECT $this WHERE {
  { $this <http://www.w3.org/2002/07/owl#sameAs> ?c } UNION { ?c <http://www.w3.org/2002/07/owl#sameAs> $this }
  ?c a <https://w3id.org/crgo/CRGO_0000019> .
}""" ] ;
    sh:targetClass crgo:CRGO_0000020 .

shape:CorrectiveAction a sh:NodeShape ;
    rdfs:comment "Corrective actions have an owner, a due date and what they correct."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A corrective action needs exactly one value for the due date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000868 ],
        [ sh:message "A corrective action needs at least one value for its owner."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000185 ],
        [ sh:message "A corrective action needs at least one value for what it corrects."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000807 ] ;
    sh:targetClass crgo:CRGO_0000546 .

shape:DecisionRecord a sh:NodeShape ;
    rdfs:comment "Decision records: subject, decision maker, outcome, date; reasons when rejected or deferred (GAPS D07)."@en ;
    sh:property [ sh:message "A decision record needs at least one value for the subject."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000730 ],
        [ sh:maxCount 1 ;
            sh:message "A decision record needs exactly one value for the outcome."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000732 ],
        [ sh:maxCount 1 ;
            sh:message "A decision record needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000840 ],
        [ sh:message "A decision record needs at least one value for the decision maker."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000731 ] ;
    sh:sparql [ sh:message "A rejected or deferred decision must state its rationale."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000732> ?o . FILTER(?o IN (<https://w3id.org/crgo/CRGO_0000589>, <https://w3id.org/crgo/CRGO_0000590>)) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000841> ?r } }""" ] ;
    sh:targetClass crgo:CRGO_0000504 .

shape:DetectionCoverage a sh:NodeShape ;
    rdfs:comment "Coverage needs a strategy or rule, a scenario or technique, and its status (SIEM section 5)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A detection coverage statement needs exactly one value for the coverage status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001258 ],
        [ sh:message "A detection coverage statement needs at least one value for the strategy or rule."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001254 ] ;
    sh:sparql [ sh:message "A detection coverage statement must say what it covers: a risk scenario, a technique or an asset."@en ;
            sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001255> ?x } FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001256> ?y } FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001257> ?z } }""" ],
        [ sh:message "Validated coverage needs a supporting detection test, found effective, of a strategy or rule that provides the coverage."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001258> <https://w3id.org/crgo/CRGO_0001147> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001259> ?t ; <https://w3id.org/crgo/CRGO_0001254> ?r . ?t <https://w3id.org/crgo/CRGO_0000437> <https://w3id.org/crgo/CRGO_0000403> ; <https://w3id.org/crgo/CRGO_0001260> ?r } }""" ] ;
    sh:targetClass crgo:CRGO_0001106 .

shape:DetectionRule a sh:NodeShape ;
    rdfs:comment "Detection rules: status and version; enabled rules declare their telemetry (SIEM section 5)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A detection rule needs exactly one value for the version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000844 ],
        [ sh:maxCount 1 ;
            sh:message "A detection rule needs exactly one value for the detection status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001245 ] ;
    sh:sparql [ sh:message "An enabled detection rule must declare the telemetry sources or data components it needs."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001245> <https://w3id.org/crgo/CRGO_0001134> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001242> ?src } }""" ] ;
    sh:targetClass crgo:CRGO_0001102 .

shape:DetectionTest a sh:NodeShape ;
    rdfs:comment "Detection tests name the rule or strategy exercised."@en ;
    sh:property [ sh:message "A detection test needs at least one value for the rule or strategy tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001260 ] ;
    sh:targetClass crgo:CRGO_0001108 .

shape:DirectiveReview a sh:NodeShape ;
    rdfs:comment "Directive reviews: what, why and when."@en ;
    sh:property [ sh:message "A directive review needs at least one value for the trigger."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001019 ],
        [ sh:message "A directive review needs at least one value for what is reviewed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001018 ],
        [ sh:maxCount 1 ;
            sh:message "A directive review needs exactly one value for the review date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ] ;
    sh:targetClass crgo:CRGO_0000890 .

shape:DirectiveVersion a sh:NodeShape ;
    rdfs:comment "Directive versions: the directive, the lifecycle state, a version label (POL section 8)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A directive version needs exactly one value for the directive it is a version of."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001006 ],
        [ sh:maxCount 1 ;
            sh:message "A directive version needs exactly one value for the version label."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000844 ],
        [ sh:maxCount 1 ;
            sh:message "A directive version needs exactly one value for the lifecycle state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001012 ] ;
    sh:sparql [ sh:message "A retired or superseded directive version needs its retirement date, after its effective date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001012> ?st . FILTER(?st IN (<https://w3id.org/crgo/CRGO_0000925>, <https://w3id.org/crgo/CRGO_0000926>))
  FILTER (NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001067> ?r } || EXISTS { $this <https://w3id.org/crgo/CRGO_0001067> ?r2 ; <https://w3id.org/crgo/CRGO_0000845> ?e . FILTER(?r2 <= ?e) }) }""" ],
        [ sh:message "An approved or published directive version needs its effective date and an approval decision about this exact version."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001012> ?st . FILTER(?st IN (<https://w3id.org/crgo/CRGO_0000923>, <https://w3id.org/crgo/CRGO_0000924>))
  FILTER (NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000845> ?eff } || NOT EXISTS { ?d <https://w3id.org/crgo/CRGO_0000730> $this ; <https://w3id.org/crgo/CRGO_0000732> <https://w3id.org/crgo/CRGO_0000588> }) }""" ] ;
    sh:targetClass crgo:CRGO_0000886 .

shape:EPSSObservation a sh:NodeShape ;
    rdfs:comment "EPSS observations: one CVE, one date, one probability in 0..1, publisher, model version."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "An EPSS observation needs exactly one probability between 0 and 1."@en ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:maxCount 1 ;
            sh:message "An EPSS observation has at most one model version."@en ;
            sh:path crgo:CRGO_0000460 ],
        [ sh:class skos:Concept ;
            sh:message "An EPSS observation is about a vulnerability concept."@en ;
            sh:path crgo:CRGO_0000408 ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "An EPSS percentile is between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000461 ] ;
    sh:sparql [ sh:message "Contradictory EPSS observations: two different scores for the same vulnerability on the same date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000408> ?v ; <https://w3id.org/crgo/CRGO_0000458> ?d ; <https://w3id.org/crgo/CRGO_0000247> ?x .
  ?other a <https://w3id.org/crgo/CRGO_0000340> ; <https://w3id.org/crgo/CRGO_0000408> ?v ; <https://w3id.org/crgo/CRGO_0000458> ?d ; <https://w3id.org/crgo/CRGO_0000247> ?y . FILTER(?other != $this && ?x != ?y)
}""" ] ;
    sh:targetClass crgo:CRGO_0000340 .

shape:EngagementType a sh:NodeShape ;
    rdfs:comment "An engagement has one nature (assurance or advisory) and at most one focus (compliance or follow-up)."@en ;
    sh:sparql [ sh:message "An engagement can be either an assurance or an advisory engagement, not both, and has at most one focus."@en ;
            sh:select """SELECT $this WHERE {
  { $this <https://w3id.org/crgo/CRGO_0001052> <https://w3id.org/crgo/CRGO_0000962> , <https://w3id.org/crgo/CRGO_0000963> } UNION { $this <https://w3id.org/crgo/CRGO_0001052> <https://w3id.org/crgo/CRGO_0000964> , <https://w3id.org/crgo/CRGO_0000965> } }""" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001052 .

shape:Estimate a sh:NodeShape ;
    rdfs:comment "Every estimate has exactly one numeric value and is about something."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An estimate needs exactly one numeric value."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:message "An estimate must say what it is an estimate of."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000231 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:EvidenceItem a sh:NodeShape ;
    rdfs:comment "Evidence items are identified and typed."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An evidence item has at most one evidence basis."@en ;
            sh:path crgo:CRGO_0000214 ],
        [ sh:message "An evidence item needs an identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000250 ] ;
    sh:targetClass crgo:CRGO_0000036 .

shape:EvidenceSufficiency a sh:NodeShape ;
    rdfs:comment "Sufficiency assessments are explicit (GRCA section 9)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An evidence sufficiency assessment needs exactly one value for the conclusion."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000766 ],
        [ sh:message "An evidence sufficiency assessment needs at least one value for the objective."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000765 ],
        [ sh:message "An evidence sufficiency assessment needs at least one value for the evidence judged."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000764 ],
        [ sh:maxCount 1 ;
            sh:message "An evidence sufficiency assessment needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:message "An evidence sufficiency assessment needs at least one value for the assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ] ;
    sh:targetClass crgo:CRGO_0000525 .

shape:ExternalAssuranceReport a sh:NodeShape ;
    rdfs:comment "External assurance reports: type, assurer, service, and a period for type 2 reports."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An external assurance report needs exactly one value for the report type."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000767 ],
        [ sh:message "An external assurance report needs at least one value for the organisation covered."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000769 ],
        [ sh:message "An external assurance report needs at least one value for the assurer."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000770 ] ;
    sh:sparql [ sh:message "A type 2 report covers a period: it needs a period start and end."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000767> ?t . FILTER(?t IN (<https://w3id.org/crgo/CRGO_0000633>, <https://w3id.org/crgo/CRGO_0000635>)) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000849> ?a ; <https://w3id.org/crgo/CRGO_0000850> ?b } }""" ] ;
    sh:targetClass crgo:CRGO_0000522 .

shape:FindingClosure a sh:NodeShape ;
    rdfs:comment "Closure needs an independent verification found effective, or a recorded risk acceptance (GRCA WP3)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A finding closure needs exactly one value for the closure date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000875 ],
        [ sh:message "A finding closure needs at least one value for the verification or risk acceptance it relies on."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000812 ],
        [ sh:maxCount 1 ;
            sh:message "A finding closure needs exactly one value for the finding closed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000811 ] ;
    sh:sparql [ sh:message "Closure needs an independent verification: the verifier must not own, be accountable for, or have committed to the corrective action, nor own the control the finding is about."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000812> ?v . ?v <https://w3id.org/crgo/CRGO_0000809> ?a ; <https://w3id.org/crgo/CRGO_0000435> ?who .
  { ?a <https://w3id.org/crgo/CRGO_0000185> ?who } UNION { ?who <https://w3id.org/crgo/CRGO_0000706> ?a } UNION { ?r <https://w3id.org/crgo/CRGO_0000806> ?a ; <https://w3id.org/crgo/CRGO_0000805> ?who }
  UNION { $this <https://w3id.org/crgo/CRGO_0000811> ?f . ?f <https://w3id.org/crgo/CRGO_0000795> ?m . ?role <https://w3id.org/crgo/CRGO_0000882> ?m ; a <https://w3id.org/crgo/CRGO_0000491> . ?asg <https://w3id.org/crgo/CRGO_0000714> ?role ; <https://w3id.org/crgo/CRGO_0000715> ?who }
}""" ],
        [ sh:message "A finding can be closed only on a follow-up verification found effective, or on a recorded risk acceptance."@en ;
            sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000812> ?v . { ?v <https://w3id.org/crgo/CRGO_0000810> <https://w3id.org/crgo/CRGO_0000683> } UNION { ?v a <https://w3id.org/crgo/CRGO_0000031> } }
}""" ] ;
    sh:targetClass crgo:CRGO_0000548 .

shape:FindingClosureNonconformity a sh:NodeShape ;
    rdfs:comment "Independence of closure also covers nonconformities raised from a control assessment."@en ;
    sh:sparql [ sh:message "Closure of a nonconformity needs an independent verification: the verifier must not own the control whose assessment raised it."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000812> ?v ; <https://w3id.org/crgo/CRGO_0000811> ?f . ?v <https://w3id.org/crgo/CRGO_0000435> ?who . ?f a <https://w3id.org/crgo/CRGO_0000511> ; <https://w3id.org/crgo/CRGO_0000748> ?ca . ?ca <https://w3id.org/crgo/CRGO_0000436> ?m .
  { ?m <https://w3id.org/crgo/CRGO_0000185> ?who } UNION { ?who <https://w3id.org/crgo/CRGO_0000712> ?m } UNION { ?role <https://w3id.org/crgo/CRGO_0000882> ?m ; a <https://w3id.org/crgo/CRGO_0000491> . ?asg <https://w3id.org/crgo/CRGO_0000714> ?role ; <https://w3id.org/crgo/CRGO_0000715> ?who }
}""" ] ;
    sh:targetClass crgo:CRGO_0000548 .

shape:FollowUpVerification a sh:NodeShape ;
    rdfs:comment "Follow-up verifications: action, result, assessor, date."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A follow-up verification needs exactly one value for the result."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000810 ],
        [ sh:maxCount 1 ;
            sh:message "A follow-up verification needs exactly one value for the action verified."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000809 ],
        [ sh:maxCount 1 ;
            sh:message "A follow-up verification needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:message "A follow-up verification needs at least one value for the assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ] ;
    sh:targetClass crgo:CRGO_0000547 .

shape:ForensicArtifact a sh:NodeShape ;
    rdfs:comment "Forensic artefacts: custodian, integrity hash, collection date."@en ;
    sh:property [ sh:message "A forensic artefact needs at least one value for the custodian."@en ;
            sh:minCount 1 ;

    sh:targetClass crgo:CRGO_0000886 .

shape:Guideline a sh:NodeShape ;
    rdfs:comment "Guidelines are not binding (POL section 4)."@en ;
    sh:sparql [ sh:message "A guideline cannot carry a 'must' or 'must not' modality; a binding rule is a policy statement."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001011> ?m . FILTER(?m IN (<https://w3id.org/crgo/CRGO_0000915>, <https://w3id.org/crgo/CRGO_0000916>)) }""" ] ;
    sh:targetClass crgo:CRGO_0000889 .

shape:IncidentCommunication a sh:NodeShape ;
    rdfs:comment "Communications: incident, audience, date."@en ;
    sh:property [ sh:message "An incident communication needs at least one value for the audience."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001296 ],
        [ sh:maxCount 1 ;
            sh:message "An incident communication needs exactly one value for the time sent."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001320 ],
        [ sh:maxCount 1 ;
            sh:message "An incident communication needs exactly one value for the incident."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001295 ] ;
    sh:targetClass crgo:CRGO_0001125 .

shape:IncidentConfirmation a sh:NodeShape ;
    rdfs:comment "Incident confirmations: incident, date, who confirmed."@en ;
    sh:property [ sh:message "An incident confirmation needs at least one value for who confirmed it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:maxCount 1 ;
            sh:message "An incident confirmation needs exactly one value for the incident."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000815 ],
        [ sh:maxCount 1 ;
            sh:message "An incident confirmation needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000879 ] ;
    sh:targetClass crgo:CRGO_0000552 .

shape:KnowledgeStatus_AnalyticalResult a sh:NodeShape ;
    rdfs:comment "Findings, determinations and analytical results state their epistemic category (GRCA section 11)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A AnalyticalResult record needs exactly one value for the knowledge status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000698 ] ;
    sh:targetClass crgo:CRGO_0000477 .

shape:KnowledgeStatus_AuditFinding a sh:NodeShape ;
    rdfs:comment "Findings, determinations and analytical results state their epistemic category (GRCA section 11)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A AuditFinding record needs exactly one value for the knowledge status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000698 ] ;
    sh:targetClass crgo:CRGO_0000541 .

shape:KnowledgeStatus_ComplianceDetermination a sh:NodeShape ;
    rdfs:comment "Findings, determinations and analytical results state their epistemic category (GRCA section 11)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A ComplianceDetermination record needs exactly one value for the knowledge status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000698 ] ;
    sh:targetClass crgo:CRGO_0000346 .

shape:LegalInstrument a sh:NodeShape ;
    rdfs:comment "Legal instruments are cited, placed in a jurisdiction and sourced."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A legal instrument needs exactly one kind."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000421 ],
        [ sh:message "A legal instrument needs a jurisdiction."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000420 ],
        [ sh:maxCount 1 ;
            sh:message "A legal instrument needs exactly one official citation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000465 ],
        [ sh:message "A legal instrument must name its source record."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000407 ] ;
    sh:targetClass crgo:CRGO_0000343 .

shape:LibraryFamily a sh:NodeShape ;
    rdfs:comment "Linked scenarios have a theme and a threat event."@en ;
    sh:property [ sh:message "A linked library scenario needs a theme."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000246 ],
        [ sh:message "A linked library scenario needs a threat event description."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000196 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000335 .

shape:LibraryScenario a sh:NodeShape ;
    rdfs:comment "Library scenarios are themed or refine a family, and point to requirements or to the family they refine."@en ;
    sh:message "A library scenario needs at least one relevant requirement, or must refine a library family."@en ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000335 ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000204 ] ] ) ;
    sh:targetClass crgo:CRGO_0000024 .

shape:LinkAnnotation a sh:NodeShape ;
    rdfs:comment "Every annotated CRGO link records its confidence, status and proposer (axioms of imported W3C slices are not CRGO links)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A link needs exactly one governance status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000283 ],
        [ sh:message "A link must record who proposed it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000288 ],
        [ sh:maxCount 1 ;
            sh:message "A link needs exactly one confidence level."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000284 ] ;
    sh:sparql [ sh:message "An approved link must record its approver and approval date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000283> <https://w3id.org/crgo/CRGO_0000069> .
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000289> ?who . $this <https://w3id.org/crgo/CRGO_0000290> ?when . }
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <http://www.w3.org/2002/07/owl#Axiom> ; <http://www.w3.org/2002/07/owl#annotatedSource> ?s . FILTER(STRSTARTS(STR(?s), \"https://w3id.org/crgo/\")) }" ] .

shape:ManagementResponse a sh:NodeShape ;
    rdfs:comment "Management responses name the finding, the stance and who responded."@en ;
    sh:property [ sh:message "A management response needs at least one value for who responded."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000805 ],
        [ sh:maxCount 1 ;
            sh:message "A management response needs exactly one value for the stance."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000804 ],
        [ sh:message "A management response needs at least one value for the finding or recommendation answered."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000803 ] ;
    sh:targetClass crgo:CRGO_0000545 .

shape:MappingAssertion a sh:NodeShape ;
    rdfs:comment "Mapping assertions: source, target, type, review state and rationale (POL section 8, CMP section 10)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "Mapping confidence is between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0001091 ],
        [ sh:maxCount 1 ;
            sh:message "A mapping assertion needs exactly one value for the review state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001064 ],
        [ sh:maxCount 1 ;
            sh:message "A mapping assertion needs exactly one value for the mapping type."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001062 ],
        [ sh:maxCount 1 ;
            sh:message "A mapping assertion needs exactly one value for the source."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001060 ],
        [ sh:maxCount 1 ;
            sh:message "A mapping assertion needs exactly one value for the target."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001061 ],
        [ sh:message "A mapping assertion needs at least one value for the rationale."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000249 ] ;
    sh:sparql [ sh:message "An exact or full-coverage mapping needs a reviewer, a review date, the editions mapped and an approved review state."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001062> ?t . FILTER(?t IN (<https://w3id.org/crgo/CRGO_0000987>, <https://w3id.org/crgo/CRGO_0000988>))
  FILTER (NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001065> ?r } || NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001092> ?d } || NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001063> ?e } || NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001064> <https://w3id.org/crgo/CRGO_0000998> }) }""" ] ;
    sh:targetClass crgo:CRGO_0000912 .

shape:Nonconformity a sh:NodeShape ;
    rdfs:comment "Nonconformities: requirement, organisation, date."@en ;
    sh:property [ sh:message "A nonconformity needs at least one value for the requirement."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000747 ],
        [ sh:maxCount 1 ;
            sh:message "A nonconformity needs exactly one value for the date identified."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000846 ],
        [ sh:maxCount 1 ;
            sh:message "A nonconformity needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ] ;
    sh:targetClass crgo:CRGO_0000511 .

shape:NotApplicableNotAssessed a sh:NodeShape ;
    rdfs:comment "Decision D10: no compliance determination for a requirement assessed as not applicable at that date."@en ;
    sh:sparql [ sh:message "A compliance determination concerns a requirement that an applicability assessment for the same organisation found not applicable on or before this date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000432> ?req ; <https://w3id.org/crgo/CRGO_0000427> ?o ; <https://w3id.org/crgo/CRGO_0000464> ?d .
  ?a <https://w3id.org/crgo/CRGO_0000426> ?req ; <https://w3id.org/crgo/CRGO_0000427> ?o ; <https://w3id.org/crgo/CRGO_0000428> <https://w3id.org/crgo/CRGO_0000384> ; <https://w3id.org/crgo/CRGO_0000464> ?ad . FILTER(?ad <= ?d)
  FILTER NOT EXISTS { ?a2 <https://w3id.org/crgo/CRGO_0000426> ?req ; <https://w3id.org/crgo/CRGO_0000427> ?o ; <https://w3id.org/crgo/CRGO_0000428> ?s2 ; <https://w3id.org/crgo/CRGO_0000464> ?ad2 . FILTER(?ad2 > ?ad && ?ad2 <= ?d && ?s2 != <https://w3id.org/crgo/CRGO_0000384>) } }""" ] ;
    sh:targetClass crgo:CRGO_0000346 .

shape:Observation a sh:NodeShape ;
    rdfs:comment "Observations are dated and about one thing."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An observation needs exactly one date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000458 ],
        [ sh:maxCount 1 ;
            sh:message "An observation is about exactly one entity."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000408 ],
        [ sh:message "An observation must name its source record."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000407 ] ;
    sh:targetClass crgo:CRGO_0000338 .

shape:OperatingEffectiveness a sh:NodeShape ;
    rdfs:comment "Operating effectiveness is tested over a period and a population or sample (GAPS D05)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An operating effectiveness assessment needs exactly one value for the number of items tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000861 ],
        [ sh:maxCount 1 ;
            sh:message "An operating effectiveness assessment needs exactly one value for the start of the period tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000849 ],
        [ sh:maxCount 1 ;
            sh:message "An operating effectiveness assessment needs exactly one value for the end of the period tested."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000850 ] ;
    sh:sparql [ sh:message "Deviations found cannot exceed the items tested, and the period must end after it starts."@en ;
            sh:select """SELECT $this WHERE {
  { $this <https://w3id.org/crgo/CRGO_0000861> ?n ; <https://w3id.org/crgo/CRGO_0000862> ?d . FILTER(?d > ?n) } UNION { $this <https://w3id.org/crgo/CRGO_0000849> ?a ; <https://w3id.org/crgo/CRGO_0000850> ?b . FILTER(?b <= ?a) } }""" ] ;
    sh:targetClass crgo:CRGO_0000526 .

shape:Place_dataSubjectsIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'dataSubjectsIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000417> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000417 .

shape:Place_establishedIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'establishedIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000411> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000411 .

shape:Place_monitorsBehaviourIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'monitorsBehaviourIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000413> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000413 .

shape:Place_offersServicesIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'offersServicesIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000412> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000412 .

shape:Place_transfersDataTo a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'transfersDataTo'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000418> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000418 .

shape:PlaybookSimulation a sh:NodeShape ;
    rdfs:comment "Simulations name the playbook version run."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A playbook simulation needs exactly one value for the playbook version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001303 ] ;
    sh:targetClass crgo:CRGO_0001128 .

shape:PlaybookVersion a sh:NodeShape ;
    rdfs:comment "Playbook versions contain steps."@en ;
    sh:property [ sh:message "A playbook version needs at least one value for a step."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001271 ] ;
    sh:targetClass crgo:CRGO_0001114 .

shape:PolicyAcknowledgement a sh:NodeShape ;
    rdfs:comment "Acknowledgements name who, when and the exact policy version (POL section 4)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A policy acknowledgement needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001070 ],
        [ sh:message "A policy acknowledgement needs at least one value for who made it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001021 ],
        [ sh:message "A policy acknowledgement needs at least one value for the policy version acknowledged."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001022 ] ;
    sh:sparql [ sh:message "A policy acknowledgement must be about an exact directive version, not a policy in general."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001022> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000886>)) } }" ] ;
    sh:targetClass crgo:CRGO_0000892 .

shape:PolicyException a sh:NodeShape ;
    rdfs:comment "Exceptions are scoped, justified, approved by an authority and expire (GAPS D01)."@en ;
    sh:property [ sh:message "A policy exception needs at least one value for its justification."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000842 ],
        [ sh:message "A policy exception needs at least one value for its scope."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000727 ],
        [ sh:message "A policy exception needs at least one value for its approving authority."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000728 ],
        [ sh:message "A policy exception needs at least one value for what it deviates from."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000726 ],
        [ sh:maxCount 1 ;
            sh:message "A policy exception needs exactly one value for its start date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ],
        [ sh:maxCount 1 ;
            sh:message "A policy exception needs exactly one value for its expiry date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000838 ] ;
    sh:sparql [ sh:message "A policy exception cannot waive a legal provision; only internal rules and controls can be excepted."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000726> ?t . { ?t <https://w3id.org/crgo/CRGO_0000422> ?i } UNION { ?t a <https://w3id.org/crgo/CRGO_0000022> } UNION { ?t a <https://w3id.org/crgo/CRGO_0000343> } }""" ],
        [ sh:message "A policy exception expires after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b <= ?a) }" ] ;
    sh:targetClass crgo:CRGO_0000502 .

shape:PolicyStatementVersioned a sh:NodeShape ;
    rdfs:comment "Policy statements belong to an exact version and state how binding they are (POL section 8)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A policy statement needs exactly one value for the normative modality."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001011 ],
        [ sh:maxCount 1 ;
            sh:message "A policy statement needs exactly one value for the directive version it belongs to."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001007 ] ;
    sh:targetClass crgo:CRGO_0000498 .

shape:ProvisionVersion a sh:NodeShape ;
    rdfs:comment "Provision versions: the provision and the start of the wording."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A provision version needs exactly one value for the provision."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001031 ],
        [ sh:maxCount 1 ;
            sh:message "A provision version needs exactly one value for when the wording took effect."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ] ;
    sh:sparql [ sh:message "A provision version ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b < ?a) }" ] ;
    sh:targetClass crgo:CRGO_0000900 .

shape:Range_CVSS a sh:NodeShape ;
    rdfs:comment "CVSS base scores are between 0 and 10."@en ;
    sh:property [ sh:maxInclusive 10.0 ;
            sh:message "CVSS score must be between 0 and 10."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000049 .

shape:Range_Criticality a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000046 .

shape:Range_EstimatedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000051 .

shape:Range_ExpectedDamage a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000043 .

shape:Range_ExploitationProbability a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000042 .

shape:Range_ImpactReduction a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000048 .

shape:Range_MaximumDamage a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000044 .

shape:Range_MitigatedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ] ;
    sh:targetClass crgo:CRGO_0000053 .

shape:Range_PreTreatmentRatio a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000301 .

shape:Range_ProbabilityReduction a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000047 .

shape:Range_ResidualRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000054 .

shape:Range_Resilience a sh:NodeShape ;
    rdfs:comment "Resilience is in (0, 1]: CRG divides by it."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Resilience must be greater than 0 and at most 1."@en ;
            sh:minExclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000045 .

shape:Range_RiskToToleranceRatio a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:Range_ThreatPresence a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000041 .

shape:Range_ToleratedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000052 .

shape:ReassessmentTrigger a sh:NodeShape ;
    rdfs:comment "Triggers name their cause and what must be reviewed."@en ;
    sh:property [ sh:message "A reassessment trigger needs at least one value for what must be reviewed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000746 ],
        [ sh:message "A reassessment trigger needs at least one value for the cause."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000745 ] ;
    sh:targetClass crgo:CRGO_0000510 .

shape:RecoveryVerification a sh:NodeShape ;
    rdfs:comment "Recovery verifications: what, when, by whom, on what evidence."@en ;
    sh:property [ sh:message "A recovery verification needs at least one value for the evidence."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000213 ],
        [ sh:maxCount 1 ;
            sh:message "A recovery verification needs exactly one value for the time."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:message "A recovery verification needs at least one value for what was restored."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001299 ],
        [ sh:message "A recovery verification needs at least one value for who verified."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ] ;
    sh:targetClass crgo:CRGO_0001126 .

shape:RegulatorCommunication a sh:NodeShape ;
    rdfs:comment "Warning: a notice to a regulator should also be recorded as a regulatory submission."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "A communication to a regulator is not linked to a regulatory submission."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001296> <https://w3id.org/crgo/CRGO_0001222> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001297> ?sub } }""" ] ;
    sh:targetClass crgo:CRGO_0001125 .

shape:RegulatoryChange a sh:NodeShape ;
    rdfs:comment "Regulatory changes: what changed, how, when identified."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A regulatory change needs exactly one value for the change type."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000744 ],
        [ sh:message "A regulatory change needs at least one value for what changed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000743 ],
        [ sh:maxCount 1 ;
            sh:message "A regulatory change needs exactly one value for the date identified."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000846 ] ;
    sh:targetClass crgo:CRGO_0000509 .

shape:RegulatoryExemption a sh:NodeShape ;
    rdfs:comment "Exemptions come from an authority, on a legal basis, for an organisation and a period (CMP section 10)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A regulatory exemption needs exactly one value for the granting authority."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001043 ],
        [ sh:message "A regulatory exemption needs at least one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ],
        [ sh:maxCount 1 ;
            sh:message "A regulatory exemption needs exactly one value for the start date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ],
        [ sh:message "A regulatory exemption needs at least one value for what it relieves from."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001042 ],
        [ sh:message "A regulatory exemption needs at least one value for the legal basis."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001074 ] ;
    sh:sparql [ sh:message "A regulatory exemption ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b < ?a) }" ],
        [ sh:message "A regulatory exemption must be granted by a regulatory authority, not by an internal approver."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001043> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000897>)) } }" ] ;
    sh:targetClass crgo:CRGO_0000903 .

shape:RegulatorySubmission a sh:NodeShape ;
    rdfs:comment "Submissions: authority, obligation, state; date once sent; receipt once acknowledged (CMP section 10)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A regulatory submission needs exactly one value for the authority."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001037 ],
        [ sh:message "A regulatory submission needs at least one value for the obligation or provision."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001038 ],
        [ sh:maxCount 1 ;
            sh:message "A regulatory submission needs exactly one value for the state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001040 ] ;
    sh:sparql [ sh:message "A submitted or acknowledged submission needs its submission date; an acknowledged one needs its receipt evidence."@en ;
            sh:select """SELECT $this WHERE {
  { $this <https://w3id.org/crgo/CRGO_0001040> ?st . FILTER(?st IN (<https://w3id.org/crgo/CRGO_0000944>, <https://w3id.org/crgo/CRGO_0000945>, <https://w3id.org/crgo/CRGO_0000946>)) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001079> ?d } } UNION { $this <https://w3id.org/crgo/CRGO_0001040> <https://w3id.org/crgo/CRGO_0000945> FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001041> ?e } } }""" ] ;
    sh:targetClass crgo:CRGO_0000902 .

shape:RequirementInterpretation a sh:NodeShape ;
    rdfs:comment "Interpretations: what they interpret and their legal review state."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A requirement interpretation needs exactly one value for the legal review state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001026 ],
        [ sh:message "A requirement interpretation needs at least one value for what it interprets."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001025 ] ;
    sh:targetClass crgo:CRGO_0000896 .

shape:ResponseAction a sh:NodeShape ;
    rdfs:comment "Response actions state their risk class."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A response action needs exactly one value for the risk class."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001277 ] ;
    sh:targetClass crgo:CRGO_0001117 .

shape:ResponseMeasurement a sh:NodeShape ;
    rdfs:comment "Response measurements: metric, value in hours, method and what was measured (SOAR section 2)."@en ;
    sh:property [ sh:message "A response effectiveness measurement needs at least one value for what was measured."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001302 ],
        [ sh:maxCount 1 ;
            sh:message "A response effectiveness measurement needs exactly one non-negative value in hours."@en ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0001322 ],
        [ sh:maxCount 1 ;
            sh:message "A response effectiveness measurement needs exactly one value for the metric."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001301 ],
        [ sh:message "A response effectiveness measurement needs at least one value for the method."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001323 ] ;
    sh:targetClass crgo:CRGO_0001127 .

shape:RiskAssessment a sh:NodeShape ;
    rdfs:comment "Assessments that compute tolerance state their appetite once."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An assessment has at most one risk appetite statement."@en ;
            sh:path crgo:CRGO_0000217 ] ;
    sh:targetClass crgo:CRGO_0000028 .

shape:RiskScenario a sh:NodeShape ;
    rdfs:comment "Scenarios are named."@en ;
    sh:property [ sh:message "A scenario needs a label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass crgo:CRGO_0000023 .

shape:RoleAssignment a sh:NodeShape ;
    rdfs:comment "Role assignments: role, agent and period (GRCA section 4)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A role assignment needs exactly one value for the start date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ],
        [ sh:maxCount 1 ;
            sh:message "A role assignment needs exactly one value for the role."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000714 ],
        [ sh:maxCount 1 ;
            sh:message "A role assignment needs exactly one value for the agent."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000715 ] ;
    sh:sparql [ sh:message "A role assignment ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b <= ?a) }" ] ;
    sh:targetClass crgo:CRGO_0000493 .

shape:RoleConflict a sh:NodeShape ;
    rdfs:comment "Warning, not violation: the same agent operates a control and assesses it as an independent line (GRCA section 4)."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "Possible role conflict: the assessor also operates the control it assesses as second line, internal audit or external assurer."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000436> ?m ; <https://w3id.org/crgo/CRGO_0000435> ?who ; <https://w3id.org/crgo/CRGO_0000737> ?line . FILTER(?line IN (<https://w3id.org/crgo/CRGO_0000605>, <https://w3id.org/crgo/CRGO_0000606>, <https://w3id.org/crgo/CRGO_0000607>)) ?who <https://w3id.org/crgo/CRGO_0000712> ?m .
}""" ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:SampleItem a sh:NodeShape ;
    rdfs:comment "Sample items: plan and result."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A sample item needs exactly one value for the sampling plan."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000758 ],
        [ sh:maxCount 1 ;
            sh:message "A sample item needs exactly one value for the result."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000759 ] ;
    sh:targetClass crgo:CRGO_0000530 .

shape:SamplingPlan a sh:NodeShape ;
    rdfs:comment "Sampling plans: population, size, method, rationale."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A sampling plan needs exactly one value for the population."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000755 ],
        [ sh:maxCount 1 ;
            sh:message "A sampling plan needs exactly one value for the sample size."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000857 ],
        [ sh:message "A sampling plan needs at least one value for the rationale."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000860 ],
        [ sh:maxCount 1 ;
            sh:message "A sampling plan needs exactly one value for the method."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000757 ] ;
    sh:targetClass crgo:CRGO_0000529 .

shape:ScenarioStep a sh:NodeShape ;
    rdfs:comment "Steps are ordered."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A scenario step needs exactly one positive order number."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path crgo:CRGO_0000254 ] ;
    sh:targetClass crgo:CRGO_0000026 .

shape:SecurityEventRecord a sh:NodeShape ;
    rdfs:comment "Event records: emitting source and the time recorded, apart from the time observed (SIEM section 1)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A security event record needs exactly one value for the time recorded."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001305 ],
        [ sh:maxCount 1 ;
            sh:message "A security event record needs exactly one value for the emitting source."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001233 ] ;
    sh:targetClass crgo:CRGO_0001098 .

shape:SecurityInvestigation a sh:NodeShape ;
    rdfs:comment "Investigations: case status and opening time."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A security investigation needs exactly one value for the case status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001267 ],
        [ sh:maxCount 1 ;
            sh:message "A security investigation needs exactly one value for the opening time."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001313 ] ;
    sh:targetClass crgo:CRGO_0001112 .

shape:SourceAccess a sh:NodeShape ;
    rdfs:comment "Source records state whether CRGO holds and may use the source (GRCA section 3)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one value for the access status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000699 ] ;
    sh:targetClass crgo:CRGO_0000337 .

shape:SourceRecord a sh:NodeShape ;
    rdfs:comment "Source records carry the fields of specification section 7."@en ;
    sh:property [ sh:message "A source record must state its licence or terms."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000453 ],
        [ sh:maxCount 1 ;
            sh:message "A source record has at most one retrieval date."@en ;
            sh:path crgo:CRGO_0000449 ],
        [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000450 ],
        [ sh:message "A source record needs a title."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:message "A source record must name its issuer."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000452 ],
        [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000250 ] ;
    sh:targetClass crgo:CRGO_0000337 .

shape:StaleEvidence a sh:NodeShape ;
    rdfs:comment "Warning: evidence relied on is out of date or does not cover the period assessed (CQ-GRCA-11)."@en ;
    sh:severity sh:Warning ;
    sh:sparql [ sh:message "Evidence relied on had expired, or its period ended before the period assessed began."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000213> ?e .
  { $this <https://w3id.org/crgo/CRGO_0000464> ?on . ?e <https://w3id.org/crgo/CRGO_0000838> ?until . FILTER(?until < ?on) } UNION { $this <https://w3id.org/crgo/CRGO_0000849> ?ps . ?e <https://w3id.org/crgo/CRGO_0000850> ?pe . FILTER(?pe < ?ps) }
}""" ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:Subject_hasIncidentCategory a sh:NodeShape ;
    rdfs:comment "Only incidents are categorised, rated or given impacts (domains are left open to avoid classifying cases as incidents)."@en ;
    sh:sparql [ sh:message "Only an incident can carry 'hasIncidentCategory'; categorise the incident, not the investigation or alert."@en ;
            sh:select "SELECT $this WHERE { FILTER NOT EXISTS { $this a <https://w3id.org/crgo/CRGO_0000015> } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001269 .

shape:Subject_hasIncidentSeverity a sh:NodeShape ;
    rdfs:comment "Only incidents are categorised, rated or given impacts (domains are left open to avoid classifying cases as incidents)."@en ;
    sh:sparql [ sh:message "Only an incident can carry 'hasIncidentSeverity'; categorise the incident, not the investigation or alert."@en ;
            sh:select "SELECT $this WHERE { FILTER NOT EXISTS { $this a <https://w3id.org/crgo/CRGO_0000015> } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001270 .

shape:Subject_hasObservedImpact a sh:NodeShape ;
    rdfs:comment "Only incidents are categorised, rated or given impacts (domains are left open to avoid classifying cases as incidents)."@en ;
    sh:sparql [ sh:message "Only an incident can carry 'hasObservedImpact'; categorise the incident, not the investigation or alert."@en ;
            sh:select "SELECT $this WHERE { FILTER NOT EXISTS { $this a <https://w3id.org/crgo/CRGO_0000015> } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001293 .

shape:Target_0000228 a sh:NodeShape ;
    rdfs:comment "Obligations are concepts of the Loi 25 vocabulary."@en ;
    sh:property [ sh:class skos:Concept ;
            sh:message "Obligations are concepts of the Loi 25 vocabulary."@en ;
            sh:path crgo:CRGO_0000228 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000228 .

shape:Target_0000335 a sh:NodeShape ;
    rdfs:comment "Relevant requirements are framework concepts."@en ;
    sh:property [ sh:class skos:Concept ;
            sh:message "Relevant requirements are framework concepts."@en ;
            sh:path crgo:CRGO_0000335 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000335 .

shape:Target_FindingClosure_0100 a sh:NodeShape ;
    rdfs:comment "A closure or reopening concerns an audit finding or a nonconformity (decision D9)."@en ;
    sh:sparql [ sh:message "A finding closure or reopening must concern an audit finding or a nonconformity."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000811> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000541>, <https://w3id.org/crgo/CRGO_0000511>)) } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000811 .

shape:Target_FindingReopening_0100 a sh:NodeShape ;
    rdfs:comment "A closure or reopening concerns an audit finding or a nonconformity (decision D9)."@en ;
    sh:sparql [ sh:message "A finding closure or reopening must concern an audit finding or a nonconformity."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000813> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000541>, <https://w3id.org/crgo/CRGO_0000511>)) } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000813 .

shape:Target_communicationAbout a sh:NodeShape ;
    rdfs:comment "Incident links point to incidents (ranges are left open to avoid classifying records as incidents)."@en ;
    sh:sparql [ sh:message "'communicationAbout' must point to an incident."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001295> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000015>)) } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001295 .

shape:Target_concludedIncident a sh:NodeShape ;
    rdfs:comment "Incident links point to incidents (ranges are left open to avoid classifying records as incidents)."@en ;
    sh:sparql [ sh:message "'concludedIncident' must point to an incident."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001268> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000015>)) } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001268 .

shape:Target_openedInvestigation a sh:NodeShape ;
    rdfs:comment "Alerts open security investigations."@en ;
    sh:sparql [ sh:message "'opened investigation' must point to a security investigation."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001265> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0001112>)) } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001265 .

shape:Target_recoveryAfter a sh:NodeShape ;
    rdfs:comment "Incident links point to incidents (ranges are left open to avoid classifying records as incidents)."@en ;
    sh:sparql [ sh:message "'recoveryAfter' must point to an incident."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0001300> ?v . FILTER NOT EXISTS { ?v a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?c . FILTER(?c IN (<https://w3id.org/crgo/CRGO_0000015>)) } }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0001300 .

shape:TelemetryHealthObservation a sh:NodeShape ;
    rdfs:comment "Health observations give a state."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A telemetry health observation needs exactly one value for the health state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001263 ] ;
    sh:targetClass crgo:CRGO_0001109 .

shape:TelemetrySource a sh:NodeShape ;
    rdfs:comment "Telemetry sources name the asset they report from."@en ;
    sh:property [ sh:message "A telemetry source needs at least one value for the asset."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001231 ] ;
    sh:targetClass crgo:CRGO_0001097 .

shape:ThreatIndicator a sh:NodeShape ;
    rdfs:comment "Indicators: pattern, language, source, validity; confidence with its method (SIEM sections 2 and 4)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A threat indicator needs exactly one value for the pattern language."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001309 ],
        [ sh:message "A threat indicator needs at least one value for the source."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001252 ],
        [ sh:message "A threat indicator needs at least one value for the pattern."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0001308 ],
        [ sh:maxCount 1 ;
            sh:message "A threat indicator needs exactly one value for the start of validity."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000837 ] ;
    sh:sparql [ sh:message "A threat indicator's validity ends after it starts."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000837> ?a ; <https://w3id.org/crgo/CRGO_0000838> ?b . FILTER(?b < ?a) }" ],
        [ sh:message "A stated confidence needs its method (how it is defined and on which scale)."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0001310> ?c . FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0001311> ?m } }""" ] ;
    sh:targetClass crgo:CRGO_0001104 .

shape:ToleranceClass a sh:NodeShape ;
    rdfs:comment "A ratio carries its tolerance class."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A risk-to-tolerance ratio needs exactly one tolerance class."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000240 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:TypedMapping a sh:NodeShape ;
    rdfs:comment "Every correspondence between vocabulary concepts has a typed relation (decision D3)."@en ;
    sh:sparql [ sh:message "A correspondence needs a typed relation (a CRGO sub-property of the SKOS mapping relation) between the same concepts."@en ;
            sh:select """SELECT $this WHERE {
  $this <http://www.w3.org/2002/07/owl#annotatedProperty> ?p ; <http://www.w3.org/2002/07/owl#annotatedSource> ?s ; <http://www.w3.org/2002/07/owl#annotatedTarget> ?o .
  FILTER(?p IN (<http://www.w3.org/2004/02/skos/core#relatedMatch>, <http://www.w3.org/2004/02/skos/core#closeMatch>))
  FILTER NOT EXISTS { ?s ?tp ?o . ?tp <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?p . FILTER(?tp != ?p) }
}""" ] ;
    sh:targetClass owl:Axiom .

shape:VocabularySource a sh:NodeShape ;
    rdfs:comment "Every imported vocabulary names its source record."@en ;
    sh:sparql [ sh:message "A CRGO vocabulary must name its source record (has source record)."@en ;
            sh:select """SELECT $this WHERE {
  FILTER(STRSTARTS(STR($this), "https://w3id.org/crgo/vocab/") && STR($this) != "https://w3id.org/crgo/vocab/theme")
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000407> ?src }
}""" ] ;
    sh:targetClass skos:ConceptScheme .


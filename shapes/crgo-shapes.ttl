@prefix crgo: <https://w3id.org/crgo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://w3id.org/crgo/shapes/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

crgo:shapes a owl:Ontology ;
    rdfs:label "CRGO SHACL shapes"@en ;
    owl:versionInfo "0.9.0" .

shape:ApplicabilityAssessment a sh:NodeShape ;
    rdfs:comment "Applicability assessments: what, for whom, when, by whom, with what result."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ],
        [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the instrument or provision assessed."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000426 ],
        [ sh:maxCount 1 ;
            sh:message "An applicability assessment needs exactly one value for the state reached."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000428 ],
        [ sh:message "An applicability assessment must name who made it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ] ;
    sh:targetClass crgo:CRGO_0000345 .

shape:ApplicabilityCondition a sh:NodeShape ;
    rdfs:comment "Conditions belong to an instrument and have one test."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A condition needs exactly one kind."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000425 ],
        [ sh:maxCount 1 ;
            sh:message "A condition needs exactly one machine-readable test."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000469 ;
            sh:pattern "^(required|anyof|exception)\\|[^|]+\\|(plain|interpretive)$" ],
        [ sh:message "A condition must say what it is a condition of."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000424 ] ;
    sh:targetClass crgo:CRGO_0000344 .

shape:CalculationActivity a sh:NodeShape ;
    rdfs:comment "Calculations name their method."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A calculation needs exactly one method."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000239 ] ;
    sh:targetClass crgo:CRGO_0000058 .

shape:ComplianceDetermination a sh:NodeShape ;
    rdfs:comment "Compliance determinations: section 13 fields, and evidence or an explicit evidence gap."@en ;
    sh:message "A compliance determination needs evidence, or an explicit statement of the missing evidence."@en ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000213 ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000470 ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the organisation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000427 ],
        [ sh:message "A compliance determination must name its assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the provision."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000432 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ],
        [ sh:message "A compliance determination needs its jurisdictional scope."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000420 ],
        [ sh:maxCount 1 ;
            sh:message "A compliance determination needs exactly one value for the state."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000433 ] ;
    sh:sparql [ sh:message "A satisfied or partially satisfied compliance determination must cite evidence; an evidence gap alone is not enough."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000433> ?st . FILTER(?st IN (<https://w3id.org/crgo/CRGO_0000389>, <https://w3id.org/crgo/CRGO_0000390>)) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000213> ?e }
}""" ] ;
    sh:targetClass crgo:CRGO_0000346 .

shape:ControlAssessment a sh:NodeShape ;
    rdfs:comment "Control assessments: measure, date, result, assessor; evidence unless not tested."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A control assessment needs exactly one value for the result."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000437 ],
        [ sh:maxCount 1 ;
            sh:message "A control assessment needs exactly one value for the control measure."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000436 ],
        [ sh:message "A control assessment must name its assessor."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000435 ],
        [ sh:maxCount 1 ;
            sh:message "A control assessment needs exactly one value for the date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000464 ] ;
    sh:sparql [ sh:message "A tested control assessment must link the evidence gathered."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000437> ?r . FILTER(?r != <https://w3id.org/crgo/CRGO_0000406>) FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000213> ?e }
}""" ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:ControlMeasureNotControl a sh:NodeShape ;
    rdfs:comment "An implementation is never the same individual as an abstract control."@en ;
    sh:sparql [ sh:message "A control measure must not be owl:sameAs a control."@en ;
            sh:select """SELECT $this WHERE {
  { $this <http://www.w3.org/2002/07/owl#sameAs> ?c } UNION { ?c <http://www.w3.org/2002/07/owl#sameAs> $this }
  ?c a <https://w3id.org/crgo/CRGO_0000019> .
}""" ] ;
    sh:targetClass crgo:CRGO_0000020 .

shape:EPSSObservation a sh:NodeShape ;
    rdfs:comment "EPSS observations: one CVE, one date, one probability in 0..1, publisher, model version."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "An EPSS observation needs exactly one probability between 0 and 1."@en ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:maxCount 1 ;
            sh:message "An EPSS observation has at most one model version."@en ;
            sh:path crgo:CRGO_0000460 ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "An EPSS percentile is between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000461 ],
        [ sh:class skos:Concept ;
            sh:message "An EPSS observation is about a vulnerability concept."@en ;
            sh:path crgo:CRGO_0000408 ] ;
    sh:sparql [ sh:message "Contradictory EPSS observations: two different scores for the same vulnerability on the same date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000408> ?v ; <https://w3id.org/crgo/CRGO_0000458> ?d ; <https://w3id.org/crgo/CRGO_0000247> ?x .
  ?other a <https://w3id.org/crgo/CRGO_0000340> ; <https://w3id.org/crgo/CRGO_0000408> ?v ; <https://w3id.org/crgo/CRGO_0000458> ?d ; <https://w3id.org/crgo/CRGO_0000247> ?y . FILTER(?other != $this && ?x != ?y)
}""" ] ;
    sh:targetClass crgo:CRGO_0000340 .

shape:Estimate a sh:NodeShape ;
    rdfs:comment "Every estimate has exactly one numeric value and is about something."@en ;
    sh:property [ sh:message "An estimate must say what it is an estimate of."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000231 ],
        [ sh:maxCount 1 ;
            sh:message "An estimate needs exactly one numeric value."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:EvidenceItem a sh:NodeShape ;
    rdfs:comment "Evidence items are identified and typed."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An evidence item has at most one evidence basis."@en ;
            sh:path crgo:CRGO_0000214 ],
        [ sh:message "An evidence item needs an identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000250 ] ;
    sh:targetClass crgo:CRGO_0000036 .

shape:Functional_allocatedTo a sh:NodeShape ;
    rdfs:comment "At most one 'allocated to' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'allocated to' takes at most one value."@en ;
            sh:path crgo:CRGO_0000226 ] ;
    sh:targetClass crgo:CRGO_0000033 .

shape:Functional_allocationOf a sh:NodeShape ;
    rdfs:comment "At most one 'allocation of' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'allocation of' takes at most one value."@en ;
            sh:path crgo:CRGO_0000225 ] ;
    sh:targetClass crgo:CRGO_0000033 .

shape:Functional_applicabilityOf a sh:NodeShape ;
    rdfs:comment "At most one 'applicability of' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'applicability of' takes at most one value."@en ;
            sh:path crgo:CRGO_0000426 ] ;
    sh:targetClass crgo:CRGO_0000345 .

shape:Functional_assessedIn a sh:NodeShape ;
    rdfs:comment "At most one 'assessed in' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'assessed in' takes at most one value."@en ;
            sh:path crgo:CRGO_0000232 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:Functional_caseOf a sh:NodeShape ;
    rdfs:comment "At most one 'case of' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'case of' takes at most one value."@en ;
            sh:path crgo:CRGO_0000243 ] ;
    sh:targetClass crgo:CRGO_0000060 .

shape:Functional_complianceWith a sh:NodeShape ;
    rdfs:comment "At most one 'compliance with' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'compliance with' takes at most one value."@en ;
            sh:path crgo:CRGO_0000432 ] ;
    sh:targetClass crgo:CRGO_0000346 .

shape:Functional_evaluatesControlMeasure a sh:NodeShape ;
    rdfs:comment "At most one 'evaluates control measure' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'evaluates control measure' takes at most one value."@en ;
            sh:path crgo:CRGO_0000436 ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:Functional_forCriterion a sh:NodeShape ;
    rdfs:comment "At most one 'for criterion' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'for criterion' takes at most one value."@en ;
            sh:path crgo:CRGO_0000236 ] ;
    sh:targetClass crgo:CRGO_0000039 .

shape:Functional_generatedBy a sh:NodeShape ;
    rdfs:comment "At most one 'generated by' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'generated by' takes at most one value."@en ;
            sh:path crgo:CRGO_0000238 ] ;
    sh:targetClass crgo:CRGO_0000050 .

shape:Functional_hasApplicabilityState a sh:NodeShape ;
    rdfs:comment "At most one 'has applicability state' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has applicability state' takes at most one value."@en ;
            sh:path crgo:CRGO_0000428 ] ;
    sh:targetClass crgo:CRGO_0000345 .

shape:Functional_hasAvailabilityRequirement a sh:NodeShape ;
    rdfs:comment "At most one 'has availability requirement' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has availability requirement' takes at most one value."@en ;
            sh:path crgo:CRGO_0000188 ] ;
    sh:targetClass crgo:CRGO_0000011 .

shape:Functional_hasCaseType a sh:NodeShape ;
    rdfs:comment "At most one 'has case type' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has case type' takes at most one value."@en ;
            sh:path crgo:CRGO_0000242 ] ;
    sh:targetClass crgo:CRGO_0000060 .

shape:Functional_hasComplianceState a sh:NodeShape ;
    rdfs:comment "At most one 'has compliance state' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has compliance state' takes at most one value."@en ;
            sh:path crgo:CRGO_0000433 ] ;
    sh:targetClass crgo:CRGO_0000346 .

shape:Functional_hasConditionKind a sh:NodeShape ;
    rdfs:comment "At most one 'has condition kind' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has condition kind' takes at most one value."@en ;
            sh:path crgo:CRGO_0000425 ] ;
    sh:targetClass crgo:CRGO_0000344 .

shape:Functional_hasConfidence a sh:NodeShape ;
    rdfs:comment "At most one 'has confidence' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has confidence' takes at most one value."@en ;
            sh:path crgo:CRGO_0000234 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:Functional_hasConfidentialityRequirement a sh:NodeShape ;
    rdfs:comment "At most one 'has confidentiality requirement' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has confidentiality requirement' takes at most one value."@en ;
            sh:path crgo:CRGO_0000186 ] ;
    sh:targetClass crgo:CRGO_0000011 .

shape:Functional_hasControlStatus a sh:NodeShape ;
    rdfs:comment "At most one 'has control status' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has control status' takes at most one value."@en ;
            sh:path crgo:CRGO_0000210 ] ;
    sh:targetClass crgo:CRGO_0000020 .

shape:Functional_hasDisposition a sh:NodeShape ;
    rdfs:comment "At most one 'has selection disposition' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has selection disposition' takes at most one value."@en ;
            sh:path crgo:CRGO_0000244 ] ;
    sh:targetClass crgo:CRGO_0000025 .

shape:Functional_hasEvidenceBasis a sh:NodeShape ;
    rdfs:comment "At most one 'has evidence basis' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has evidence basis' takes at most one value."@en ;
            sh:path crgo:CRGO_0000214 ] ;
    sh:targetClass crgo:CRGO_0000036 .

shape:Functional_hasInForcePeriod a sh:NodeShape ;
    rdfs:comment "At most one 'has in-force period' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has in-force period' takes at most one value."@en ;
            sh:path crgo:CRGO_0000423 ] ;
    sh:targetClass crgo:CRGO_0000343 .

shape:Functional_hasInstrumentKind a sh:NodeShape ;
    rdfs:comment "At most one 'has instrument kind' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has instrument kind' takes at most one value."@en ;
            sh:path crgo:CRGO_0000421 ] ;
    sh:targetClass crgo:CRGO_0000343 .

shape:Functional_hasIntegrityRequirement a sh:NodeShape ;
    rdfs:comment "At most one 'has integrity requirement' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has integrity requirement' takes at most one value."@en ;
            sh:path crgo:CRGO_0000187 ] ;
    sh:targetClass crgo:CRGO_0000011 .

shape:Functional_hasPriority a sh:NodeShape ;
    rdfs:comment "At most one 'has priority' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has priority' takes at most one value."@en ;
            sh:path crgo:CRGO_0000224 ] ;
    sh:targetClass crgo:CRGO_0000032 .

shape:Functional_hasRiskStage a sh:NodeShape ;
    rdfs:comment "At most one 'has risk stage' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has risk stage' takes at most one value."@en ;
            sh:path crgo:CRGO_0000235 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:Functional_hasTestResult a sh:NodeShape ;
    rdfs:comment "At most one 'has test result' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has test result' takes at most one value."@en ;
            sh:path crgo:CRGO_0000437 ] ;
    sh:targetClass crgo:CRGO_0000347 .

shape:Functional_hasToleranceClassification a sh:NodeShape ;
    rdfs:comment "At most one 'has tolerance classification' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'has tolerance classification' takes at most one value."@en ;
            sh:path crgo:CRGO_0000240 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:Functional_inSensitivityCase a sh:NodeShape ;
    rdfs:comment "At most one 'in sensitivity case' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'in sensitivity case' takes at most one value."@en ;
            sh:path crgo:CRGO_0000241 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:Functional_observationOf a sh:NodeShape ;
    rdfs:comment "At most one 'observation of' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'observation of' takes at most one value."@en ;
            sh:path crgo:CRGO_0000408 ] ;
    sh:targetClass crgo:CRGO_0000338 .

shape:Functional_onScale a sh:NodeShape ;
    rdfs:comment "At most one 'on scale' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'on scale' takes at most one value."@en ;
            sh:path crgo:CRGO_0000233 ] ;
    sh:targetClass crgo:CRGO_0000037 .

shape:Functional_usesMethod a sh:NodeShape ;
    rdfs:comment "At most one 'uses method' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'uses method' takes at most one value."@en ;
            sh:path crgo:CRGO_0000239 ] ;
    sh:targetClass crgo:CRGO_0000058 .

shape:Functional_valuationOf a sh:NodeShape ;
    rdfs:comment "At most one 'valuation of' value (functional in the CRGO specification)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "'valuation of' takes at most one value."@en ;
            sh:path crgo:CRGO_0000183 ] ;
    sh:targetClass crgo:CRGO_0000011 .

shape:LegalInstrument a sh:NodeShape ;
    rdfs:comment "Legal instruments are cited, placed in a jurisdiction and sourced."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A legal instrument needs exactly one kind."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000421 ],
        [ sh:message "A legal instrument needs a jurisdiction."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000420 ],
        [ sh:maxCount 1 ;
            sh:message "A legal instrument needs exactly one official citation."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000465 ],
        [ sh:message "A legal instrument must name its source record."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000407 ] ;
    sh:targetClass crgo:CRGO_0000343 .

shape:LibraryFamily a sh:NodeShape ;
    rdfs:comment "Linked scenarios have a theme and a threat event."@en ;
    sh:property [ sh:message "A linked library scenario needs a threat event description."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000196 ],
        [ sh:message "A linked library scenario needs a theme."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000246 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000335 .

shape:LibraryScenario a sh:NodeShape ;
    rdfs:comment "Library scenarios are themed or refine a family, and point to requirements or to the family they refine."@en ;
    sh:message "A library scenario needs at least one relevant requirement, or must refine a library family."@en ;
    sh:or ( [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000335 ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path crgo:CRGO_0000204 ] ] ) ;
    sh:targetClass crgo:CRGO_0000024 .

shape:LinkAnnotation a sh:NodeShape ;
    rdfs:comment "Every annotated CRGO link records its confidence, status and proposer (axioms of imported W3C slices are not CRGO links)."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A link needs exactly one governance status."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000283 ],
        [ sh:maxCount 1 ;
            sh:message "A link needs exactly one confidence level."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000284 ],
        [ sh:message "A link must record who proposed it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000288 ] ;
    sh:sparql [ sh:message "An approved link must record its approver and approval date."@en ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/crgo/CRGO_0000283> <https://w3id.org/crgo/CRGO_0000069> .
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000289> ?who . $this <https://w3id.org/crgo/CRGO_0000290> ?when . }
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <http://www.w3.org/2002/07/owl#Axiom> ; <http://www.w3.org/2002/07/owl#annotatedSource> ?s . FILTER(STRSTARTS(STR(?s), \"https://w3id.org/crgo/\")) }" ] .

shape:Observation a sh:NodeShape ;
    rdfs:comment "Observations are dated and about one thing."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An observation needs exactly one date."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000458 ],
        [ sh:maxCount 1 ;
            sh:message "An observation is about exactly one entity."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000408 ],
        [ sh:message "An observation must name its source record."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000407 ] ;
    sh:targetClass crgo:CRGO_0000338 .

shape:Place_dataSubjectsIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'dataSubjectsIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000417> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000417 .

shape:Place_establishedIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'establishedIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000411> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000411 .

shape:Place_monitorsBehaviourIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'monitorsBehaviourIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000413> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000413 .

shape:Place_offersServicesIn a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'offersServicesIn'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000412> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000412 .

shape:Place_transfersDataTo a sh:NodeShape ;
    rdfs:comment "Places are provinces, territories or countries, not the federal legal order."@en ;
    sh:sparql [ sh:message "Use a province or territory, not 'Canada (federal legal order)', as the value of 'transfersDataTo'."@en ;
            sh:select "SELECT $this WHERE { $this <https://w3id.org/crgo/CRGO_0000418> <https://w3id.org/crgo/CRGO_0000351> }" ] ;
    sh:targetSubjectsOf crgo:CRGO_0000418 .

shape:Range_CVSS a sh:NodeShape ;
    rdfs:comment "CVSS base scores are between 0 and 10."@en ;
    sh:property [ sh:maxInclusive 10.0 ;
            sh:message "CVSS score must be between 0 and 10."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000049 .

shape:Range_Criticality a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000046 .

shape:Range_EstimatedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000051 .

shape:Range_ExpectedDamage a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000043 .

shape:Range_ExploitationProbability a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000042 .

shape:Range_ImpactReduction a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000048 .

shape:Range_MaximumDamage a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000044 .

shape:Range_MitigatedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000053 .

shape:Range_PreTreatmentRatio a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ],
        [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ] ;
    sh:targetClass crgo:CRGO_0000301 .

shape:Range_ProbabilityReduction a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000047 .

shape:Range_ResidualRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000054 .

shape:Range_Resilience a sh:NodeShape ;
    rdfs:comment "Resilience is in (0, 1]: CRG divides by it."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Resilience must be greater than 0 and at most 1."@en ;
            sh:minExclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000045 .

shape:Range_RiskToToleranceRatio a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:Range_ThreatPresence a sh:NodeShape ;
    rdfs:comment "Values on the unit interval."@en ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Value must be between 0 and 1."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000041 .

shape:Range_ToleratedRisk a sh:NodeShape ;
    rdfs:comment "Computed risk quantities are non-negative and come from a calculation."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A computed quantity must record the calculation that produced it."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000238 ],
        [ sh:message "Value must be non-negative."@en ;
            sh:minInclusive 0.0 ;
            sh:path crgo:CRGO_0000247 ] ;
    sh:targetClass crgo:CRGO_0000052 .

shape:RiskAssessment a sh:NodeShape ;
    rdfs:comment "Assessments that compute tolerance state their appetite once."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An assessment has at most one risk appetite statement."@en ;
            sh:path crgo:CRGO_0000217 ] ;
    sh:targetClass crgo:CRGO_0000028 .

shape:RiskScenario a sh:NodeShape ;
    rdfs:comment "Scenarios are named."@en ;
    sh:property [ sh:message "A scenario needs a label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass crgo:CRGO_0000023 .

shape:ScenarioStep a sh:NodeShape ;
    rdfs:comment "Steps are ordered."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A scenario step needs exactly one positive order number."@en ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path crgo:CRGO_0000254 ] ;
    sh:targetClass crgo:CRGO_0000026 .

shape:SourceRecord a sh:NodeShape ;
    rdfs:comment "Source records carry the fields of specification section 7."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one identifier."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000250 ],
        [ sh:maxCount 1 ;
            sh:message "A source record has at most one retrieval date."@en ;
            sh:path crgo:CRGO_0000449 ],
        [ sh:maxCount 1 ;
            sh:message "A source record needs exactly one version."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000450 ],
        [ sh:message "A source record needs a title."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:message "A source record must name its issuer."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000452 ],
        [ sh:message "A source record must state its licence or terms."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000453 ] ;
    sh:targetClass crgo:CRGO_0000337 .

shape:Target_0000228 a sh:NodeShape ;
    rdfs:comment "Obligations are concepts of the Loi 25 vocabulary."@en ;
    sh:property [ sh:class skos:Concept ;
            sh:message "Obligations are concepts of the Loi 25 vocabulary."@en ;
            sh:path crgo:CRGO_0000228 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000228 .

shape:Target_0000335 a sh:NodeShape ;
    rdfs:comment "Relevant requirements are framework concepts."@en ;
    sh:property [ sh:class skos:Concept ;
            sh:message "Relevant requirements are framework concepts."@en ;
            sh:path crgo:CRGO_0000335 ] ;
    sh:targetSubjectsOf crgo:CRGO_0000335 .

shape:ToleranceClass a sh:NodeShape ;
    rdfs:comment "A ratio carries its tolerance class."@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A risk-to-tolerance ratio needs exactly one tolerance class."@en ;
            sh:minCount 1 ;
            sh:path crgo:CRGO_0000240 ] ;
    sh:targetClass crgo:CRGO_0000055 .

shape:TypedMapping a sh:NodeShape ;
    rdfs:comment "Every correspondence between vocabulary concepts has a typed relation (decision D3)."@en ;
    sh:sparql [ sh:message "A correspondence needs a typed relation (a CRGO sub-property of the SKOS mapping relation) between the same concepts."@en ;
            sh:select """SELECT $this WHERE {
  $this <http://www.w3.org/2002/07/owl#annotatedProperty> ?p ; <http://www.w3.org/2002/07/owl#annotatedSource> ?s ; <http://www.w3.org/2002/07/owl#annotatedTarget> ?o .
  FILTER(?p IN (<http://www.w3.org/2004/02/skos/core#relatedMatch>, <http://www.w3.org/2004/02/skos/core#closeMatch>))
  FILTER NOT EXISTS { ?s ?tp ?o . ?tp <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?p . FILTER(?tp != ?p) }
}""" ] ;
    sh:targetClass owl:Axiom .

shape:VocabularySource a sh:NodeShape ;
    rdfs:comment "Every imported vocabulary names its source record."@en ;
    sh:sparql [ sh:message "A CRGO vocabulary must name its source record (has source record)."@en ;
            sh:select """SELECT $this WHERE {
  FILTER(STRSTARTS(STR($this), "https://w3id.org/crgo/vocab/") && STR($this) != "https://w3id.org/crgo/vocab/theme")
  FILTER NOT EXISTS { $this <https://w3id.org/crgo/CRGO_0000407> ?src }
}""" ] ;
    sh:targetClass skos:ConceptScheme .


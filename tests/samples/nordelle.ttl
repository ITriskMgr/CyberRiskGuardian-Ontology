@prefix crgo: <https://w3id.org/crgo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nordelle: <https://example.org/crgo-sample/nordelle/> .
@prefix ns1: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/crgo-sample/nordelle> a owl:Ontology ;
    rdfs:label "Nordelle Market inc. - SYNTHETIC test data for CRGO 0.9.0"@en ;
    dcterms:type "synthetic test data" ;
    rdfs:comment "Fictional organisation for the CRGO acceptance demonstration (specification section 22). All facts and values are invented; estimates are not empirically validated."@en ;
    owl:imports crgo:crgo .

<https://example.org/crgo-sample/nordelle/asset/kiosk> a owl:NamedIndividual,
        crgo:CRGO_0000004 ;
    rdfs:label "in-store price kiosk (no scenario affects it)"@en ;
    dcterms:type "synthetic test data" .

<https://example.org/crgo-sample/nordelle/assumption/no-eu-establishment> a owl:NamedIndividual,
        crgo:CRGO_0000339 ;
    rdfs:label "Nordelle has no establishment in the European Union"@en ;
    dcterms:type "synthetic test data" .

<https://example.org/crgo-sample/nordelle/compliance/gdpr-notification> a owl:NamedIndividual,
        crgo:CRGO_0000346 ;
    rdfs:label "Compliance with GDPR Art. 33(1) (fictional)"@en ;
    dcterms:type "synthetic test data" ;
    crgo:CRGO_0000420 crgo:CRGO_0000353 ;
    crgo:CRGO_0000427 nordelle:org ;
    crgo:CRGO_0000432 <https://w3id.org/crgo/vocab/gdpr/GDPR_Art._33_1> ;
    crgo:CRGO_0000433 crgo:CRGO_0000393 ;
    crgo:CRGO_0000435 <https://example.org/crgo-sample/nordelle/person/ciso> ;
    crgo:CRGO_0000464 "2026-10-01T00:00:00"^^xsd:dateTime ;
    crgo:CRGO_0000470 "No documented procedure to notify an EU supervisory authority within 72 hours; GDPR applicability under Art. 3(2) awaits qualified review." .


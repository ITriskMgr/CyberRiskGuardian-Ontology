@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix x: <https://example.org/crgo-test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

x:d a crgo:CRGO_0001377 ;
    crgo:CRGO_0000464 "2026-10-28T00:00:00"^^xsd:dateTime ;
    crgo:CRGO_0000846 "2026-07-01T00:00:00"^^xsd:dateTime ;
    crgo:CRGO_0001542 x:v ;
    crgo:CRGO_0001543 x:ci ;
    crgo:CRGO_0001545 crgo:CRGO_0001458 .

<https://example.org/crgo-test/fixture/neg-iam-compensated-without-exception> a owl:Ontology ;
    rdfs:comment "Negative fixture (0.11.0): must be rejected."@en ;
    skos:note "expect: A compensated deviation must be covered by a policy exception" .


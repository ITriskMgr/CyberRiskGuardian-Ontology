@prefix crgo: <https://w3id.org/crgo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix x: <https://example.org/crgo-test/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/crgo-test/fixture/neg-pca-retired-no-date> a owl:Ontology ;
    rdfs:comment "Negative fixture (0.10.0): must be rejected."@en ;
    skos:note "expect: retirement date" .

x:v a crgo:CRGO_0000887 ;
    crgo:CRGO_0000844 "1" ;
    crgo:CRGO_0000845 "2026-01-01T00:00:00"^^xsd:dateTime ;
    crgo:CRGO_0001006 x:pol ;
    crgo:CRGO_0001012 crgo:CRGO_0000925 .


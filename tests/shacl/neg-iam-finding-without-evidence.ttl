@prefix crgo: <https://w3id.org/crgo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix x: <https://example.org/crgo-test/> .

x:f a crgo:CRGO_0001364 ;
    rdfs:label "ownerless accounts" .

<https://example.org/crgo-test/fixture/neg-iam-finding-without-evidence> a owl:Ontology ;
    rdfs:comment "Negative fixture (0.11.0): must be rejected."@en ;
    skos:note "expect: An identity finding needs at least one value for its evidence" .


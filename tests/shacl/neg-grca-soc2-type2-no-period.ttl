@prefix crgo: <https://w3id.org/crgo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix x: <https://example.org/crgo-test/> .

<https://example.org/crgo-test/fixture/neg-grca-soc2-type2-no-period> a owl:Ontology ;
    rdfs:comment "Negative fixture (0.9.0 GRCA): must be rejected."@en ;
    skos:note "expect: covers a period" .

x:rep a crgo:CRGO_0000522 ;
    crgo:CRGO_0000250 "soc2" ;
    crgo:CRGO_0000767 crgo:CRGO_0000635 ;
    crgo:CRGO_0000769 x:vendor ;
    crgo:CRGO_0000770 x:cpa .


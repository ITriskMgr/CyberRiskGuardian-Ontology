@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix x: <https://example.org/crgo-test/> .

x:cu a crgo:CRGO_0001331 ;
    crgo:CRGO_0001489 x:app ;
    crgo:CRGO_0001552 "RSA-2048" .

<https://example.org/crgo-test/fixture/neg-context-crypto-without-status> a owl:Ontology ;
    rdfs:comment "Negative fixture (0.11.0): must be rejected."@en ;
    skos:note "expect: the quantum vulnerability status" .


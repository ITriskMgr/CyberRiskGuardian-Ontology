x:decision-S1 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "Phishing-resistant MFA and conditional access (I01) is the primary lever; PAM (I02) limits blast radius; MDR (I03) shortens dwell time; awareness and reporting (I12)."@en .

x:decision-S10 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-15 months" ;
    crgo:CRGO_0000327 "Integrity monitoring and reconciliation (I13), least-privilege write access (I09/I02), strong authentication (I01), backup-based verification (I04), MDR (I03), clinical playbook (I11)."@en .

x:decision-S11 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-9 months" ;
    crgo:CRGO_0000327 "Secret scanning in repositories and pipelines, central vault with short-lived tokens and rotation (I14); API anomaly monitoring (I03); scoped cloud keys (I08)."@en .

x:decision-S12 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "6-18 months" ;
    crgo:CRGO_0000327 "WPA3-Enterprise for staff, isolated internet-only guest Wi-Fi, rogue AP detection and NAC (I06); monitoring of clinic segments (I03)."@en .

x:decision-S13 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "Upstream DDoS mitigation, CDN and WAF for public services, separate egress for clinic cloud traffic (I15); provider escalation and communications playbook (I11)."@en .

x:decision-S14 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-3 months" ;
    crgo:CRGO_0000327 "Mandatory call-back verification on bank-detail changes and dual approval above threshold, DMARC enforcement, BEC detection (I16); finance-specific awareness (I12)."@en .

x:decision-S15 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-9 months" ;
    crgo:CRGO_0000327 "MDM with enforced encryption, PIN, session timeout, remote wipe and loss-reporting workflow (I17)."@en .

x:decision-S16 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "6-24 months" ;
    crgo:CRGO_0000327 "Dual carriers / SD-WAN, firewall high availability, cloud or secondary-site failover for EHR read access (I18); tested clinic downtime procedures (I11)."@en .

x:decision-S17 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-12 months" ;
    crgo:CRGO_0000327 "Data discovery, consolidation of local data into managed central stores, least-privilege shares, retention schedule (I19); encrypted and managed endpoints/storage (I17)."@en .

x:decision-S18 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-9 months" ;
    crgo:CRGO_0000327 "Annual application penetration testing and secure SDLC (I14), WAF with rate limiting (I15), scanning of web tier (I05), enumeration detection (I03)."@en .

x:decision-S19 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-12 months" ;
    crgo:CRGO_0000327 "Supplier assurance and staged updates for critical software (I10); egress control and behavioural detection (I03); rebuild playbook (I11). Prevention is largely outside MediBec's control - transfer and acceptance required."@en .

x:decision-S2 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-24 months" ;
    crgo:CRGO_0000327 "Layered: MDR/EDR (I03), PAM (I02), segmentation (I06), immutable backup (I04), patching (I05), IR and downtime procedures (I11), awareness (I12). Residual remains material - consider cyber-insurance transfer."@en .

x:decision-S20 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-9 months" ;
    crgo:CRGO_0000327 "Phishing-resistant MFA and token-binding conditional access (I01), JIT cloud admin roles and admin-consent workflow (I02), cloud posture baseline (I08), cloud audit logs to MDR (I03)."@en .

x:decision-S21 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-12 months" ;
    crgo:CRGO_0000327 "Outbound DLP and recipient warnings (I09), secure referral channel replacing fax/e-mail and data minimization (I19), role-based privacy training (I12)."@en .

x:decision-S22 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-6 months" ;
    crgo:CRGO_0000327 "Approved telehealth and messaging platform with authenticated entry, waiting rooms, encryption and configuration baseline; ban on consumer apps for PHI (I22)."@en .

x:decision-S23 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "External attack-surface management and removal of exposed interfaces (I05), MFA and PAM-brokered admin access (I01, I02), monitoring of admin logins (I03)."@en .

x:decision-S24 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-12 months" ;
    crgo:CRGO_0000327 "Media-scanning kiosk and device control, EDR where supported (I03), medical device hardening (I07), isolating imaging segments (I06), staff procedure (I12)."@en .

x:decision-S25 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "Certified sanitization with certificates of destruction, lease-return clauses, full-disk encryption on all devices (I17, I19)."@en .

x:decision-S26 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "AI acceptable-use policy, sanctioned privacy-assessed AI tool, web category controls and DLP for AI sites (I20, I09), training (I12)."@en .

x:decision-S27 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-3 months" ;
    crgo:CRGO_0000327 "Strong help-desk verification (call-back, manager approval, video ID) for resets (I21), phishing-resistant authenticators that cannot be re-enrolled by phone (I01), alerts on MFA changes and awareness (I12)."@en .

x:decision-S28 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "2-12 months" ;
    crgo:CRGO_0000327 "PAM with JIT and session recording, separation of duties (I02), monitoring of admin actions (I03), immutable backups outside admin reach (I04), HR-IT offboarding playbook (I11)."@en .

x:decision-S29 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "6-15 months" ;
    crgo:CRGO_0000327 "TLS/VPN for HL7 and DICOM, interface-engine hardening (I22), segmentation (I06), reconciliation of results (I13)."@en .

x:decision-S3 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-9 months" ;
    crgo:CRGO_0000327 "Immutable/offline copies with separate backup identity (I04), segmentation (I06), PAM (I02), backup-alert monitoring (I03), quarterly restore tests and IR integration (I11)."@en .

x:decision-S30 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "Look-alike domain monitoring and takedown, verified sender channels, patient communication standard and awareness notices (I23), DMARC enforcement (I16), staff reporting (I12)."@en .

x:decision-S4 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "Block public access and enforce expiring authenticated links (I08); DLP and data minimization in exports (I09); object-access logging to MDR (I03)."@en .

x:decision-S5 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-12 months" ;
    crgo:CRGO_0000327 "Least-privilege redesign and access recertification plus EHR access analytics and DLP (I09); vault and restrict service accounts (I02); MDR use-cases (I03); HR/awareness (I12)."@en .

x:decision-S6 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "1-9 months" ;
    crgo:CRGO_0000327 "Risk-based vulnerability and patch management with KEV SLAs and EOL retirement (I05); segmentation behind the edge (I06); MDR threat hunting (I03)."@en .

x:decision-S7 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "3-24 months" ;
    crgo:CRGO_0000327 "Medical device security programme (I07), segmentation and NAC including guest Wi-Fi isolation (I06), patch/compensating controls (I05). Residual depends on manufacturers."@en .

x:decision-S8 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "0-6 months" ;
    crgo:CRGO_0000327 "24/7 MDR with centralized logging and escalation criteria (I03); IR plan, playbooks, retainer and tabletop exercises across clinics (I11); governance reporting (I12)."@en .

x:decision-S9 a crgo:CRGO_0000030 ;
    crgo:CRGO_0000220 crgo:CRGO_0000143 ;
    crgo:CRGO_0000271 "2-12 months" ;
    crgo:CRGO_0000327 "Third-party risk programme and contract clauses (I10); vendor access only through PAM with MFA and recording (I01/I02); MDR monitoring of vendor sessions (I03); joint IR (I11). Residual largely outside MediBec's control - consider contractual and insurance transfer."@en .


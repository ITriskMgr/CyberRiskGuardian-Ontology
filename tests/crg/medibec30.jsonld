      "crgo:CRGO_0000219": {
        "@id": "x:decision-S26"
      },
      "crgo:CRGO_0000250": "S26",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "Clinicians and administrative staff use public generative-AI tools to summarize notes, draft letters or translate documents, pasting identifiable patient information into services whose data retention, training use and location MediBec has not assessed, resulting in uncontrolled disclosure of health information."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Clinicians use a free chatbot to turn dictated notes into referral letters. Over months, thousands of identifiable notes are submitted to a service that retains prompts outside Canada."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S26"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S26-1"
        },
        {
          "@id": "x:vuln-S26-2"
        },
        {
          "@id": "x:vuln-S26-3"
        },
        {
          "@id": "x:vuln-S26-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Health information is highly sensitive (E1) and privacy controls are a priority in the appetite statement (E5). No AI acceptable-use policy or approved tool is documented."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinicians; administrative staff; Privacy officer; CIO; Legal; AI service providers."
        },
        {
          "@language": "en",
          "@value": "Processes: Documentation, correspondence, translation."
        },
        {
          "@language": "en",
          "@value": "Owner: Privacy officer with CMO"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #141"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ1 clinical notes and letters."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Staff paste patient data into unapproved generative-AI tools"
      }
    },

    {
      "@id": "x:scenario-S8",
      "@type": "crgo:CRGO_0000025",
      "crgo:CRGO_0000196": {
        "@id": "x:event-S8"
      },
      "crgo:CRGO_0000198": [
        {
          "@id": "x:asset-CJ1"
        },
        {
          "@id": "x:asset-CJ5"
        }
      ],
      "crgo:CRGO_0000200": [
        {
          "@id": "x:consequence-S8-Confidentialityprivacy"
        },
        {
          "@id": "x:consequence-S8-Integrity"

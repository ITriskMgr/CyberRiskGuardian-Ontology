      },
      "crgo:CRGO_0000207": [
        {
          "@id": "x:control-S3-1"
        },
        {
          "@id": "x:control-S3-2"
        }
      ],
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S3"
      },
      "crgo:CRGO_0000250": "S3",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker holding administrative credentials reaches backup servers that share the production identity domain and network, deletes or encrypts backup sets and clinic storage copies, so that MediBec cannot restore EHR and clinic systems within clinically acceptable time after a destructive event."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Days before detonation, the attacker logs into the backup console with a domain administrator account, shortens retention, deletes restore points and corrupts clinic storage replicas. Failed backup jobs raise tickets that are treated as capacity issues. After encryption, restoration attempts fail or reach only stale copies."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S3"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S3-1"
        },
        {
          "@id": "x:vuln-S3-2"
        },
        {
          "@id": "x:vuln-S3-3"
        },
        {
          "@id": "x:vuln-S3-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec has on-site and off-site backups (E2) but isolation, immutability and restore testing are not evidenced. Exercise evidence shows unexplained backup failures on several clinic storage units before encryption (E6)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: CIO; Infrastructure team; Cybersecurity lead; Clinical Ops; clinic managers; off-site backup provider; Executive leadership."
        },
        {
          "@language": "en",
          "@value": "Processes: Disaster recovery for all clinical and administrative services."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-07"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ6 backup servers, off-site copies, local clinic storage."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Backup environment compromised, preventing recovery after a destructive attack"
      }
    },
    {
      "@id": "x:decision-S13",
      "@type": "crgo:CRGO_0000030",
      "crgo:CRGO_0000220": {
        "@id": "crgo:CRGO_0000143"
      },
      "crgo:CRGO_0000271": "0-6 months",
      "crgo:CRGO_0000327": {
        "@language": "en",
        "@value": "Upstream DDoS mitigation, CDN and WAF for public services, separate egress for clinic cloud traffic (I15); provider escalation and communications playbook (I11)."
      }
    },

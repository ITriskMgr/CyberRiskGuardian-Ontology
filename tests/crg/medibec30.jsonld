      ],
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S1"
      },
      "crgo:CRGO_0000250": "S1",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A financially motivated external actor phishes clinic administrators and billing staff with an EHR-themed lure, captures credentials and obtains approval of an MFA push prompt, gaining remote access to the EHR, billing and administrative systems, enabling unauthorized access to patient records and follow-on intrusion."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A newly registered look-alike domain sends 'Urgent: updated EHR access procedure' messages to clinic administrators. One user enters credentials on the fake portal; the attacker triggers repeated MFA pushes late at night until one is approved. With a valid clinical administrator session, the attacker browses EHR records, harvests address books for internal phishing and stages for privilege escalation."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S1"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S1-1"
        },
        {
          "@id": "x:vuln-S1-2"
        },
        {
          "@id": "x:vuln-S1-3"
        },
        {
          "@id": "x:vuln-S1-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec relies on remote and cloud access for staff and clinicians (E2). Exercise evidence shows an EHR-themed phishing lure with a macro attachment and a successful login from an unusual geography approved by MFA push (E6). Attack attempts are rising (E4)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinic administrators and billing staff; CIO; Cybersecurity lead; Privacy officer; Clinical Ops; patients; EHR vendor; Steering Committee."
        },
        {
          "@language": "en",
          "@value": "Processes: Scheduling, clinical documentation, billing."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-01 / 12"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ5 identity and remote access; CJ1 EHR; CJ4 billing."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Credential compromise of clinical administrator accounts through phishing and MFA fatigue"
      }
    },

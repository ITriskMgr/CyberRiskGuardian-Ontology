        "@id": "x:decision-S18"
      },
      "crgo:CRGO_0000250": "S18",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker, or a curious patient, exploits an authorization flaw (insecure direct object reference) or injection weakness in MediBec's online records-access or booking application, retrieving other patients' records at scale."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A patient notices the document URL contains a sequential number and changes it, seeing another patient's lab result. A script later downloads 40,000 documents over a weekend."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S18"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S18-1"
        },
        {
          "@id": "x:vuln-S18-2"
        },
        {
          "@id": "x:vuln-S18-3"
        },
        {
          "@id": "x:vuln-S18-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Online services are used for appointments, records access and communications (E8, MED-CYR-10). Secure development and application testing are auditable areas (E7); no penetration testing is documented."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Application owner; development team or vendor; Privacy officer; CIO; patients."
        },
        {
          "@language": "en",
          "@value": "Processes: Patient records access, booking."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO (Application owner)"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #171, #83"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ3 patient portal; CJ1 EHR data exposed through it."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Web application flaw in the patient portal exposes other patients' records"
      }
    },

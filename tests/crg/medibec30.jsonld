          "@id": "x:vuln-S21-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec handles high volumes of health information across 10 clinics (E1). Privacy controls expected (classification, DLP, breach assessment) are listed as areas to assess, not as existing controls (E5, E7)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: All clinical and administrative staff; Privacy officer; clinic managers; patients."
        },
        {
          "@language": "en",
          "@value": "Processes: Referrals, results communication, administration."
        },
        {
          "@language": "en",
          "@value": "Owner: Privacy officer"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #14, #54"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ1, CJ2 information in transit and in documents."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Accidental disclosure of patient information by staff"
      }

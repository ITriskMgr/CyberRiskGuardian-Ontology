      "crgo:CRGO_0000219": {
        "@id": "x:decision-S11"
      },
      "crgo:CRGO_0000250": "S11",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An opportunistic actor finds an API key, database connection string or cloud access token that a developer committed to a code repository, left in a log or embedded in a configuration file, and uses it to call MediBec's EHR integration or cloud storage APIs directly, extracting patient data without passing through user authentication."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A developer pushes a test script containing a storage access key to a public repository. Within hours automated scanners harvest it; an actor lists and downloads patient export files and queries an integration endpoint until the key is revoked weeks later."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S11"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S11-1"
        },
        {
          "@id": "x:vuln-S11-2"
        },
        {
          "@id": "x:vuln-S11-3"
        },
        {
          "@id": "x:vuln-S11-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec has in-house software/application development and database staff (E3). API key management and repository scanning are listed as an auditable area (E7) and as scenario MED-CYR-04 (E8). No secret-management tooling is evidenced."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Application development team; CIO; Cybersecurity lead; Privacy officer; cloud provider; integration partners."
        },
        {
          "@language": "en",
          "@value": "Processes: Application integration, data exchange with partners."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO (Application development)"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-04"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ1 EHR integration APIs; CJ7 cloud storage."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "API key or secret exposed in code, logs or configuration enables direct data access"
      }
    },

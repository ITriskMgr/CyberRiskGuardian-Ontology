      "crgo:CRGO_0000219": {
        "@id": "x:decision-S9"
      },
      "crgo:CRGO_0000250": "S9",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A threat actor compromises an EHR, diagnostic, device or IT support vendor and uses the vendor's standing remote access or software update channel to enter MediBec's environment, bypassing perimeter controls to access health data or deploy malware."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A remote-support tool used by a diagnostic-system vendor is compromised; the attacker uses the vendor's always-on connection to access the imaging server and pivot. The vendor notifies customers two weeks later."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S9"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S9-1"
        },
        {
          "@id": "x:vuln-S9-2"
        },
        {
          "@id": "x:vuln-S9-3"
        },
        {
          "@id": "x:vuln-S9-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec depends on EHR, cloud, device and support vendors (E2, E7). Vendor assurance, contract clauses and access restrictions are listed as areas to assess, not as existing controls (E5, E7)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Procurement; CIO; Cybersecurity lead; Vendor coordination lead; Privacy/Legal; Clinical Ops; affected vendors."
        },
        {
          "@language": "en",
          "@value": "Processes: EHR support, device maintenance, IT support."
        },
        {
          "@language": "en",
          "@value": "Owner: Procurement with CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-14"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ1, CJ2, CJ8 and vendor-managed components."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Compromise of a critical vendor with remote access to MediBec systems"
      }
    },

      "crgo:CRGO_0000250": "S21",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A staff member unintentionally discloses patient information - misdirected e-mail or fax, wrong attachment, record uploaded to a personal cloud, or document handed to the wrong patient - because data-handling controls and awareness are limited, resulting in privacy incidents and patient complaints."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A clerk sends a batch of lab results to an outside clinic with a similar name selected by e-mail auto-complete. The recipient reports it three days later."
      },

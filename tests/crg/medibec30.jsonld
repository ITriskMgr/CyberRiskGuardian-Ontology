        },
        {
          "@id": "x:step-S8-4"
        },
        {
          "@id": "x:step-S8-5"
        },
        {
          "@id": "x:step-S8-6"
        },
        {
          "@id": "x:step-S8-7"
        }
      ],
      "crgo:CRGO_0000204": {
        "@id": "x:candidate-C08"
      },
      "crgo:CRGO_0000207": [
        {
          "@id": "x:control-S8-1"
        },
        {
          "@id": "x:control-S8-2"
        },
        {
          "@id": "x:control-S8-3"
        }
      ],
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S8"
      },
      "crgo:CRGO_0000250": "S8",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An intrusion by any external actor goes unnoticed or is misclassified because alert triage, log coverage and after-hours monitoring are insufficient for a two-person cybersecurity team, and the untested incident response plan leads to slow, uncoordinated containment, turning a contained event into a major privacy and operational incident."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Across ten days, four weak signals (phishing, PowerShell, unusual login, cloud download) are visible in different consoles but no one correlates them. When encryption begins, roles, forensic engagement and clinical workarounds are improvised."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S8"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S8-1"
        },
        {
          "@id": "x:vuln-S8-2"
        },
        {
          "@id": "x:vuln-S8-3"
        },
        {
          "@id": "x:vuln-S8-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Two dedicated cybersecurity staff (E3); a PowerShell alert was closed as low severity; unusual logins, cloud downloads and service-account queries were not correlated (E6). The IR plan has not been tested across clinics (E8 MED-CYR-15)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Cybersecurity lead; CIO; Executive leadership; Clinical Ops; clinic managers; Privacy/Legal; Communications; MDR/forensic providers."
        },
        {
          "@language": "en",
          "@value": "Processes: Incident management, clinical continuity, privacy breach assessment."
        },
        {
          "@language": "en",
          "@value": "Owner: Cybersecurity lead"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-08 / 15"
        },
        {
          "@language": "en",
          "@value": "Assets: All crown jewels; especially CJ1, CJ5."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Detection and response gaps allow an intrusion to persist and escalate"
      }
    },
    {
      "@id": "x:candidate-C05",
      "@type": "crgo:CRGO_0000025",
      "crgo:CRGO_0000244": {
        "@id": "crgo:CRGO_0000112"
      },
      "crgo:CRGO_0000249": {
        "@language": "en",
        "@value": "Now retained: portfolio of 30 allows coverage of development-related exposure."
      },
      "crgo:CRGO_0000250": "C05",

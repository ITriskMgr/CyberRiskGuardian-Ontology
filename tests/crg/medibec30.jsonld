      },
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S29"
      },
      "crgo:CRGO_0000250": "S29",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker positioned on the clinic network or WAN captures or alters unencrypted HL7 lab/pharmacy messages or DICOM image transfers between clinical systems, exposing results or injecting false values that flow into the EHR."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "An attacker with a foothold in a clinic uses ARP spoofing to intercept lab result messages to the EHR, harvesting results and altering several potassium values."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S29"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S29-1"
        },
        {
          "@id": "x:vuln-S29-2"
        },
        {
          "@id": "x:vuln-S29-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "EHR, radiology, lab and pharmacy systems are integrated (E2); data integrity and application monitoring are to be assessed (E2). Encryption of interface traffic is not documented; legacy clinical protocols are often cleartext."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Laboratory and pharmacy leads; Radiology; integration team; CIO; Cybersecurity lead."
        },
        {
          "@language": "en",
          "@value": "Processes: Result reporting, medication orders, image transfer."
        },

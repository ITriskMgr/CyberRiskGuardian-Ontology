        },
        {
          "@id": "x:consequence-S30-Reputation"
        },
        {
          "@id": "x:consequence-S30-Safety"
        }
      ],
      "crgo:CRGO_0000202": [
        {
          "@id": "x:step-S30-1"
        },
        {
          "@id": "x:step-S30-2"
        },
        {
          "@id": "x:step-S30-3"
        },

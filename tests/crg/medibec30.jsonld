    {
      "@id": "x:evidence-E2",
      "@type": "crgo:CRGO_0000036",
      "crgo:CRGO_0000214": {
        "@id": "crgo:CRGO_0000118"
      },
      "crgo:CRGO_0000250": "E2",
      "crgo:CRGO_0000251": "Business case s.4 - Technology environment table",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Basis as stated: Documented (case)"
        },
        {
          "@language": "en",
          "@value": "Central network hub in Montreal, WAN fibre to clinics, firewalls, IDS/IPS, antivirus/antimalware; Montreal data centre, local clinic storage, on-site and off-site backups, encrypted storage; cloud-based remote access; interconnected medical equipment."
        }
      ]
    },
    {
      "@id": "x:source-S15",

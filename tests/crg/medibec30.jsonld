      "crgo:CRGO_0000219": {
        "@id": "x:decision-S24"
      },
      "crgo:CRGO_0000250": "S24",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "Malware on a patient-supplied imaging CD/USB or a staff USB drive executes on a radiology workstation or device console when the media is loaded, infecting systems that are poorly protected by endpoint security and connected to the clinical network."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A patient brings imaging from an outside clinic on a USB key infected with a worm. The import station, running an unsupported OS without EDR, is infected and spreads to a neighbouring modality console."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S24"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S24-1"
        },
        {
          "@id": "x:vuln-S24-2"
        },
        {
          "@id": "x:vuln-S24-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Radiology and interconnected medical equipment are part of the environment (E1, E2); device inventories and endpoint coverage are uncertain (E4). Imaging departments routinely import external media."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Radiology staff; Biomedical engineering; clinic managers; Cybersecurity lead."
        },
        {
          "@language": "en",
          "@value": "Processes: Image import for diagnosis and referral."
        },
        {
          "@language": "en",
          "@value": "Owner: Radiology lead with Cybersecurity lead"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #168"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ2 imaging workstations; CJ8 devices."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Malware introduced through patient-supplied imaging media or USB devices"
      }
    },

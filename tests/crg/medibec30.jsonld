      "crgo:CRGO_0000219": {
        "@id": "x:decision-S15"
      },
      "crgo:CRGO_0000250": "S15",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A clinician's tablet or handheld used for EHR access is lost or stolen; because device encryption, screen lock and remote wipe are not centrally enforced, patient data cached on the device or accessible through saved sessions is exposed."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A tablet is stolen from a car. It has no enforced PIN and holds downloaded referral letters; the EHR app remains logged in. Loss is reported two days later."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S15"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S15-1"
        },
        {
          "@id": "x:vuln-S15-2"
        },
        {
          "@id": "x:vuln-S15-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Workstations, tablets and handheld devices support EHR access (E2). Encrypted storage is documented for central stores, not for mobile devices; mobile device management is not evidenced."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinicians; clinic managers; Privacy officer; IT support; patients."
        },
        {
          "@language": "en",
          "@value": "Processes: Point-of-care documentation."
        },
        {

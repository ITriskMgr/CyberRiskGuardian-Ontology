      ],
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S2"
      },
      "crgo:CRGO_0000250": "S2",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A ransomware group gains a foothold through a macro-enabled phishing attachment or exposed service, moves laterally across an insufficiently segmented network, exfiltrates health data and encrypts EHR support servers, shared folders and scheduling systems, halting clinical and administrative operations at multiple clinics."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Following initial access (see S1/S6), the actor escalates to domain administrator within days, disables security tooling where possible, deletes or encrypts reachable backups, exfiltrates EHR exports and deploys ransomware at 07:00 on a weekday. Several clinics lose EHR and scheduling; staff revert to paper; imaging and lab results are delayed."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S2"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S2-1"
        },
        {
          "@id": "x:vuln-S2-2"
        },
        {
          "@id": "x:vuln-S2-3"
        },
        {
          "@id": "x:vuln-S2-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Clinics depend heavily on central services in Montreal (E1, E2). The exercise timeline shows the full chain - phishing, PowerShell alert closed as low, backup failures, ransom note (E6). Segmentation and backup isolation are listed as open questions (E2, E7)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Executive leadership; Board/ownership group; CIO; Cybersecurity lead; Clinical Ops; clinic managers; Privacy/Legal; Communications; EHR vendor; insurer; forensic provider; patients; media."
        },
        {
          "@language": "en",
          "@value": "Processes: Care delivery, appointments, diagnostics, billing, communications."
        },
        {
          "@language": "en",
          "@value": "Owner: Executive leadership (COO) with CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-02"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ1 EHR, CJ3 scheduling, CJ4 billing, CJ6 data centre and clinic storage."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Ransomware disrupting EHR access and clinic operations across the network"
      }
    },

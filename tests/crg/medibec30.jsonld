      "crgo:CRGO_0000219": {
        "@id": "x:decision-S27"
      },
      "crgo:CRGO_0000250": "S27",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker phones the IT help desk impersonating a clinician or manager, uses publicly available details to pass weak identity checks, and has the password and MFA device reset, taking over the account and accessing EHR and remote access."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Posing as a physician travelling to a conference, the caller gives employee number and date of hire found online and asks for an MFA reset. The attacker enrols their own phone and logs in within minutes."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S27"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S27-1"
        },
        {
          "@id": "x:vuln-S27-2"
        },
        {
          "@id": "x:vuln-S27-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "IT support is part of the 15-person IT team (E3). Help-desk identity verification is not documented. Remote access relies on MFA push (E6), which a reset defeats."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: IT support/help desk; Cybersecurity lead; clinicians; CIO."
        },
        {
          "@language": "en",
          "@value": "Processes: Account support."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO (Support)"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #96 (social engineering)"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ5 identity; CJ1 EHR."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Help-desk impersonation leads to MFA reset and account takeover"
      }
    },

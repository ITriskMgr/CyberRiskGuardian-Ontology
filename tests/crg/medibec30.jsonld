          "@id": "x:step-S30-4"
        },
        {
          "@id": "x:step-S30-5"
        },
        {
          "@id": "x:step-S30-6"
        }
      ],
      "crgo:CRGO_0000204": {
        "@id": "x:candidate-C33"
      },
      "crgo:CRGO_0000207": {
        "@id": "x:control-S30-1"
      },
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S30"
      },
      "crgo:CRGO_0000250": "S30",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "Fraudsters register look-alike domains and send SMS or e-mail messages posing as MediBec (appointment confirmations, billing notices, results available) to harvest patients' credentials, health-card details or payments, harming patients and eroding trust even though MediBec's systems are not breached."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Patients receive texts 'MediBec: your results are ready, confirm identity' linking to a copy of the portal. Hundreds enter credentials and health-card numbers; front desks receive angry calls."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S30"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S30-1"
        },
        {
          "@id": "x:vuln-S30-2"
        },
        {
          "@id": "x:vuln-S30-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "The exercise phishing used a newly registered look-alike domain (E6, Appendix A). Brand monitoring, DMARC and patient communication standards are not documented."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Patients; Communications; Privacy officer; Cybersecurity lead; clinic front desks; telecom and domain registrars."
        },
        {
          "@language": "en",
          "@value": "Processes: Patient communications, billing."
        },
        {
          "@language": "en",
          "@value": "Owner: Communications lead"
        },
        {
          "@language": "en",
          "@value": "Ref: Appendix A domain; Annex B #65, #71"
        },
        {
          "@language": "en",
          "@value": "Assets: Patient trust; CJ3 patient communications."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Criminals impersonate MediBec to defraud or phish patients"
      }
    },
    {
      "@id": "x:consequence-S29-Integrity",
      "@type": "crgo:CRGO_0000027",
      "crgo:CRGO_0000201": {
        "@id": "crgo:CRGO_0000075"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Integrity: False results or orders."
      }
    },
    {
      "@id": "x:S12-cvss",
      "@type": "crgo:CRGO_0000049",
      "crgo:CRGO_0000231": {
        "@id": "x:scenario-S12"
      },
      "crgo:CRGO_0000233": {
        "@id": "crgo:CRGO_0000175"
      },
      "crgo:CRGO_0000247": {
        "@type": "xsd:decimal",
        "@value": "6.4"
      },
      "crgo:CRGO_0000249": {
        "@language": "en",
        "@value": "Representative weakness: weak wireless authentication with guest-to-internal routing. AV:A adjacent (radio range); VC/VI:L on the WLAN itself; SC:H clinical systems reachable behind it."
      },
      "crgo:CRGO_0000257": "CVSS:4.0/AV:A/AC:L/AT:N/PR:N/UI:N/VC:L/VI:L/VA:N/SC:H/SI:L/SA:L",
      "crgo:CRGO_0000258": "4.0",
      "crgo:CRGO_0000259": "Medium"
    },
    {
      "@id": "x:S5-red_i",
      "@type": "crgo:CRGO_0000048",
      "crgo:CRGO_0000231": {

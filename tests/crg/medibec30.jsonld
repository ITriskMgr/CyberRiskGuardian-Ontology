      "crgo:CRGO_0000250": "S22",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An outsider joins or records a teleconsultation through an open meeting link, or intercepts clinical messages sent through unapproved or poorly configured communication tools, exposing sensitive consultations."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A recurring meeting link for psychiatry teleconsultations is shared in a patient e-mail and forwarded; an unknown participant joins silently. Separately, clinicians share images through a consumer messaging app."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S22"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S22-1"
        },
        {
          "@id": "x:vuln-S22-2"
        },
        {
          "@id": "x:vuln-S22-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Voice, video and messaging services connect clinics and clinicians; confidentiality and secure collaboration are flagged for assessment (E2)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinicians; patients; Communications systems owner; Privacy officer; communications vendor."
        },
        {
          "@language": "en",
          "@value": "Processes: Teleconsultation, clinician collaboration."
        },
        {
          "@language": "en",
          "@value": "Owner: Clinical Ops with CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #146, #105, #173"
        },
        {
          "@language": "en",
          "@value": "Assets: Communication systems; consultation content."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Interception or exposure of teleconsultations and clinical messaging"
      }
    },

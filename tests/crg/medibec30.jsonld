      "crgo:CRGO_0000219": {
        "@id": "x:decision-S28"
      },
      "crgo:CRGO_0000250": "S28",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A disgruntled or departing IT administrator with broad standing privileges deletes backups, disables accounts or plants logic bombs; with a 15-person IT team and concentrated knowledge, MediBec cannot quickly detect or reverse the actions, causing prolonged outages."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "An administrator dismissed on a Friday retains VPN access over the weekend, deletes the backup catalogue and schedules a script that wipes several servers on Monday morning."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S28"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S28-1"
        },
        {
          "@id": "x:vuln-S28-2"
        },
        {
          "@id": "x:vuln-S28-3"
        },
        {
          "@id": "x:vuln-S28-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "IT is a lean 15-person team with two security staff (E3). Privileged access management, admin monitoring and separation of duties are not evidenced (E7). Key-person dependency is implicit."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: CIO; HR; Executive leadership; Cybersecurity lead; Legal."
        },
        {
          "@language": "en",
          "@value": "Processes: All."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO with HR"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #15, #115"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ5, CJ6 and all hosted crown jewels."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Malicious or departing IT administrator sabotages systems"
      }
    },

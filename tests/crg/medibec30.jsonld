      "crgo:CRGO_0000219": {
        "@id": "x:decision-S19"
      },
      "crgo:CRGO_0000250": "S19",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A threat actor compromises the build or update infrastructure of software used by MediBec (EHR component, imaging viewer, remote-management tool) and distributes a signed malicious update, which MediBec installs automatically, giving the actor a foothold across many systems at once."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A widely used remote-monitoring agent receives a malicious update. It installs on 300 MediBec endpoints and servers within hours and beacons to attacker infrastructure. The supplier discloses the compromise a week later."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S19"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S19-1"
        },
        {
          "@id": "x:vuln-S19-2"
        },
        {
          "@id": "x:vuln-S19-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec runs many vendor applications (E2). Supply-chain verification is not evidenced (E7). Unlike S9 (vendor remote access), this path uses the software itself."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: CIO; Cybersecurity lead; Procurement; affected supplier; Clinical Ops."
        },
        {
          "@language": "en",
          "@value": "Processes: Any process relying on the affected product."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO with Procurement"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #40, #99"
        },
        {
          "@language": "en",
          "@value": "Assets: Servers and endpoints running the affected software; CJ1, CJ2."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Trojanized software update from a clinical or IT software supplier"
      }
    },

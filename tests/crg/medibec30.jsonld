        "@id": "x:decision-S17"
      },
      "crgo:CRGO_0000250": "S17",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "Patient exports, scanned documents and imaging copies accumulate on local clinic storage units outside central access control, retention and monitoring; an insider, intruder or misconfigured share exposes them, or they are lost without backup."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A shared folder 'Scans' on a clinic storage unit is readable by all domain users and contains eight years of referral letters. A compromised account indexes it; separately, a disk failure destroys files that were never backed up."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S17"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S17-1"
        },
        {
          "@id": "x:vuln-S17-2"
        },
        {
          "@id": "x:vuln-S17-3"
        },
        {
          "@id": "x:vuln-S17-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Local clinic storage units exist alongside the central data centre (E2); students are asked where copies, exports and local records are stored (E4). Backup jobs for clinic storage have failed in the exercise (E6)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinic managers; Privacy officer; CIO; Infrastructure; patients."
        },
        {
          "@language": "en",
          "@value": "Processes: Clinic administration, referrals, scanning."
        },
        {
          "@language": "en",
          "@value": "Owner: Privacy officer with CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #55, #111"
        },
        {
          "@language": "en",
          "@value": "Assets: Local clinic storage; copies of CJ1/CJ2 data."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Unmanaged patient data on local clinic storage is exposed or lost"
      }
    },

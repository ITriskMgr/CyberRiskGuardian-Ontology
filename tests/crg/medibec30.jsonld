      "crgo:CRGO_0000250": "S20",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker steals a session token or tricks a cloud administrator into granting consent to a malicious application, obtaining persistent control of MediBec's cloud tenant, from which they read mail and files, create backdoor accounts and disable logging."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "An adversary-in-the-middle phishing kit captures a cloud admin's session cookie, bypassing MFA. The attacker registers an application with mail and file read permissions, adds a global admin and turns off audit retention."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S20"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S20-1"
        },
        {
          "@id": "x:vuln-S20-2"
        },
        {
          "@id": "x:vuln-S20-3"
        },
        {
          "@id": "x:vuln-S20-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Cloud integration supports remote access and data retrieval (E2); cloud configuration, identity and logging are open questions (E4). Push MFA does not stop token theft (E6)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: CIO; Cybersecurity lead; cloud administrators; cloud provider; Privacy officer."
        },
        {
          "@language": "en",
          "@value": "Processes: Remote work, communications, image sharing."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #29, #144"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ5 cloud identity; CJ7 cloud storage; mail and collaboration."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Takeover of cloud tenant administration through token theft or malicious app consent"
      }
    },
    {
      "@id": "x:consequence-S28-Reputation",

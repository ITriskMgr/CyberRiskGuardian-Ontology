      },
      "crgo:CRGO_0000250": "S14",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A fraudster spoofs or compromises a supplier or executive mailbox and instructs MediBec finance staff to change bank details or pay a fraudulent invoice, because payment-change verification and e-mail authentication are weak, resulting in direct financial loss."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A look-alike supplier domain sends an updated banking form before a large equipment invoice. Accounts payable updates the vendor record by e-mail; CAD 180,000 is transferred before the real supplier chases payment."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S14"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S14-1"
        },
        {
          "@id": "x:vuln-S14-2"
        },
        {
          "@id": "x:vuln-S14-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Billing and administrative systems are central (E1); phishing lures already target billing staff (E6). E-mail authentication (DMARC) and payment verification procedures are not documented."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Finance lead; accounts payable; CFO; suppliers; Cybersecurity lead; bank."
        },
        {
          "@language": "en",
          "@value": "Processes: Supplier payments, patient refunds."
        },
        {
          "@language": "en",
          "@value": "Owner: Finance lead (CFO)"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #71"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ4 billing and accounts payable."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Business e-mail compromise diverts vendor or billing payments"
      }
    },

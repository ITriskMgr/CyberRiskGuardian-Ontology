      },
      "crgo:CRGO_0000250": "S23",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker finds management interfaces (remote desktop, hypervisor or firewall consoles, storage or out-of-band management) exposed to the internet or partner networks and gains access by credential stuffing or default passwords, obtaining administrative control of infrastructure."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "An external scan finds an out-of-band server management port reachable from the internet with the vendor default password. The attacker powers off hosts and later deploys ransomware directly on the hypervisor."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S23"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S23-1"
        },
        {
          "@id": "x:vuln-S23-2"
        },
        {
          "@id": "x:vuln-S23-3"
        },
        {
          "@id": "x:vuln-S23-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Exposure of services and inventory completeness are open questions (E4); remote access exists (E2). Exposed admin portals and remote management interfaces appear in the extended catalogue (E8)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Infrastructure team; Cybersecurity lead; CIO; managed service providers."
        },
        {
          "@language": "en",
          "@value": "Processes: All hosted services."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO (Infrastructure)"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #82, #90, #22"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ6 infrastructure; hypervisors, firewalls, storage."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Brute force or credential stuffing against exposed administrative interfaces"
      }
    },

      },
      "crgo:CRGO_0000250": "S13",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A hacktivist or extortion group floods MediBec's internet-facing services with traffic, making online appointment booking, patient records access and external communications unavailable for hours or days and pushing volume to clinic phone lines."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Following media coverage of healthcare, a hacktivist botnet targets MediBec's booking site. The shared internet link saturates, also degrading clinic access to cloud services routed through Montreal."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S13"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S13-1"
        },
        {
          "@id": "x:vuln-S13-2"
        },
        {
          "@id": "x:vuln-S13-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MED-CYR-10 identifies online services for appointments, records access and communications (E8). No DDoS protection, CDN or WAF is documented (E2)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinic managers; Communications; CIO; ISP and hosting providers; patients."
        },
        {
          "@language": "en",
          "@value": "Processes: Appointment booking, patient communications."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-10"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ3 online services; internet connectivity for clinics."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "DDoS attack disrupts online booking, patient portal and communications"
      }
    },

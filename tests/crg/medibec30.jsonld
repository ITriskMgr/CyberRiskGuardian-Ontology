      "crgo:CRGO_0000250": "S25",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "Workstations, drives, printers, storage units or medical equipment are returned to lessors, sold or recycled without certified data sanitization, and a third party recovers patient data from them."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "An ultrasound unit returned at lease end still holds 3,000 studies. It is resold; the buyer finds the data and contacts the media."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S25"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S25-1"
        },
        {
          "@id": "x:vuln-S25-2"
        },
        {
          "@id": "x:vuln-S25-3"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "MediBec operates many endpoints, local storage units and devices that store images (E2). Asset lifecycle and disposal controls are not documented."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Infrastructure; Biomedical engineering; Procurement; Privacy officer; disposal vendor."
        },
        {
          "@language": "en",
          "@value": "Processes: Asset disposal, lease returns."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO with Biomedical engineering"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #132, #138"
        },
        {
          "@language": "en",
          "@value": "Assets: Retired endpoints, storage and medical equipment."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Retired devices or medical equipment released with recoverable patient data"
      }
    },

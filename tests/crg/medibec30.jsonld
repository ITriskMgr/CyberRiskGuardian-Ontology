      },
      "crgo:CRGO_0000207": {
        "@id": "x:control-S12-1"
      },
      "crgo:CRGO_0000219": {
        "@id": "x:decision-S12"
      },
      "crgo:CRGO_0000250": "S12",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker in or near a clinic exploits weak wireless security, an unsegmented guest network or a rogue access point to join the clinic network, intercept credentials and reach EHR workstations and local storage."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A pre-shared Wi-Fi key posted in a staff room is reused on the guest network, which routes to the clinic LAN. An attacker in the waiting room scans the network, finds a file share on the local storage unit and a workstation with an open remote desktop service."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S12"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S12-1"
        },
        {
          "@id": "x:vuln-S12-2"
        },
        {
          "@id": "x:vuln-S12-3"
        },
        {
          "@id": "x:vuln-S12-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Wireless and guest networks are an auditable area; WPA settings, rogue AP scans and guest segmentation tests are expected evidence but none is documented (E7). Clinics are geographically dispersed (E1)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinic managers; Infrastructure team; Cybersecurity lead; patients and visitors; Clinical Ops."
        },
        {
          "@language": "en",
          "@value": "Processes: Clinic operations, EHR access at point of care."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO (Infrastructure)"
        },
        {

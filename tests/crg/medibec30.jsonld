      "crgo:CRGO_0000219": {
        "@id": "x:decision-S16"
      },
      "crgo:CRGO_0000250": "S16",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "A carrier failure, cyberattack on network devices or data-centre incident takes the Montreal hub or WAN offline; because clinics depend on a single hub without tested redundancy or local fallback, EHR, imaging, lab and pharmacy access is lost at all ten clinics simultaneously."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "A fibre cut and simultaneous failure of the primary firewall pair leave all clinics without EHR for 14 hours. Clinics switch to paper, cannot view prior imaging or medication history, and postpone non-urgent appointments."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S16"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S16-1"
        },
        {
          "@id": "x:vuln-S16-2"
        },
        {
          "@id": "x:vuln-S16-3"
        },
        {
          "@id": "x:vuln-S16-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "All clinics connect via WAN to the primary hub in Montreal where the main data centre is located (E2). Redundancy, alternate site and failover testing are not documented; data-centre outage was screened out in the 10-scenario assessment and is now included as a resilience scenario."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: CIO; Infrastructure; Clinical Ops; clinic managers; telecom carriers; Executive leadership."
        },
        {
          "@language": "en",
          "@value": "Processes: All clinical and administrative services."
        },
        {
          "@language": "en",
          "@value": "Owner: CIO (Infrastructure) with Clinical Ops"
        },
        {
          "@language": "en",
          "@value": "Ref: Annex B #5, #49"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ6 data centre and WAN; all crown jewels dependent on them."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Loss of the Montreal hub or WAN isolates clinics from central clinical systems"
      }
    },
    {
      "@id": "x:S28-ResidualRisk",

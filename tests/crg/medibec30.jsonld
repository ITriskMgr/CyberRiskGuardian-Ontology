      "crgo:CRGO_0000250": "S7",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker reaching a clinic network (through malware, a compromised clinic Wi-Fi or vendor access) exploits an unpatched or default-credential medical device on a network shared with EHR workstations, disrupting device operation and using it as a persistent foothold, with potential consequences for patient care."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Ransomware spreading in a clinic encrypts the Windows-based console of an imaging device; separately, an attacker on guest Wi-Fi reaches a device with default credentials and uses it as a pivot that endpoint tools do not cover."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S7"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S7-1"
        },
        {
          "@id": "x:vuln-S7-2"
        },
        {
          "@id": "x:vuln-S7-3"
        },
        {
          "@id": "x:vuln-S7-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Medical equipment is interconnected with the EHR environment; inventory, patch levels and segmentation are unknown (E2, E4). Patching is constrained by certification (E3)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Biomedical engineering; Clinical Ops; clinic managers; device manufacturers; CIO; Cybersecurity lead; patients."
        },
        {
          "@language": "en",
          "@value": "Processes: Diagnostic imaging, monitoring, device-to-EHR data flows."
        },
        {
          "@language": "en",
          "@value": "Owner: Clinical Ops with Biomedical engineering"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-09 (+ Wi-Fi path MED-CYR-05)"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ8 medical devices; CJ2 diagnostics; clinic LAN."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Connected medical device used as a foothold to disrupt clinical equipment and reach the EHR network"
      }
    },

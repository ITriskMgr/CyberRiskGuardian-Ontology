      "crgo:CRGO_0000219": {
        "@id": "x:decision-S10"
      },
      "crgo:CRGO_0000250": "S10",
      "crgo:CRGO_0000252": {
        "@language": "en",
        "@value": "An attacker with compromised clinical credentials, or a malicious insider, alters medication, allergy, laboratory or billing records in the EHR or pharmacy system without detection, leading to incorrect clinical decisions, patient harm and loss of confidence in the record."
      },
      "crgo:CRGO_0000253": {
        "@language": "en",
        "@value": "Following a credential compromise, an extortion group alters allergy entries for a sample of patients and then demands payment to reveal which records were changed. MediBec must verify thousands of records manually."
      },
      "crgo:CRGO_0000318": {
        "@id": "x:source-S10"
      },
      "crgo:CRGO_0000319": [
        {
          "@id": "x:vuln-S10-1"
        },
        {
          "@id": "x:vuln-S10-2"
        },
        {
          "@id": "x:vuln-S10-3"
        },
        {
          "@id": "x:vuln-S10-4"
        }
      ],
      "crgo:CRGO_0000326": {
        "@language": "en",
        "@value": "Clinical decisions rely on EHR, lab and pharmacy data (E1). Integrity controls are listed among expected controls but are not evidenced (E8). The appetite statement allows no residual risk that creates credible immediate threat to patient care (E5)."
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Stakeholders: Clinical Ops; Pharmacy lead; Laboratory lead; physicians; Privacy officer; CIO; Cybersecurity lead; patients; professional orders."
        },
        {
          "@language": "en",
          "@value": "Processes: Prescribing, dispensing, diagnosis, billing."
        },
        {
          "@language": "en",
          "@value": "Owner: Clinical Ops (CMO)"
        },
        {
          "@language": "en",
          "@value": "Ref: MED-CYR-13"
        },
        {
          "@language": "en",
          "@value": "Assets: CJ1 EHR; CJ2 pharmacy and laboratory systems; CJ4 billing."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Manipulation of patient, medication or billing records undermining clinical decisions"
      }
    },

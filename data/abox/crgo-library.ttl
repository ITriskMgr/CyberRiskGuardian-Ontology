lib:F1227 a crgo:CRGO_0000024 ;
    rdfs:label "Man-in-the-Middle (MitM) attack modifying patient treatment plans"@en ;
    crgo:CRGO_0000196 lib:F1227-event ;
    crgo:CRGO_0000200 lib:F1227-consequence ;
    crgo:CRGO_0000246 theme:ThemeNetwork ;
    crgo:CRGO_0000250 "LIB-F1227" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0247" ;
    crgo:CRGO_0000318 lib:F1227-source ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Conduct regular security awareness training: Educate employees about the risks of social engineering attacks and train them to identify and report suspicious activities or requests"@en,
        "Deploy intrusion detection and prevention systems (IDS/IPS): Monitor network traffic for any suspicious activity and block or alert on potential MitM attacks"@en,
        "Implement end-to-end encryption: Ensure that all communications concerning patient treatment plans are encrypted to prevent unauthorized interception and modification"@en,
        "Implement strong access controls and authentication mechanisms: Implement multi-factor authentication, strong passwords, and access control lists to prevent unauthorized access to patient treatment plans"@en,
        "Regularly update software and hardware: Keep all devices, software, and network equipment up to date with the latest security patches and firmware updates to mitigate known vulnerabilities"@en,
        "Use secure communication channels: Utilize secure protocols like HTTPS or VPNs to prevent data interception"@en .

lib:F1227-consequence a crgo:CRGO_0000027 ;
    crgo:CRGO_0000201 crgo:CRGO_0000075,
        crgo:CRGO_0000082 .


        crgo:CRGO_0000307,
        crgo:CRGO_0000308,
        crgo:CRGO_0000309,
        crgo:CRGO_0000313 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "conduct regular vulnerability assessments and penetration testing of the hospital's network and systems"@en,
        "deploy advanced threat detection and response tools that can identify and isolate malware and other security threats quickly"@en,
        "develop and test incident response and business continuity plans that can minimize the impact of cybersecurity incidents"@en,
        "implement a byod policy that mandates secure device management and access control"@en,
        "provide training and awareness programs for employees on the risks and best practices of using personal devices"@en .

lib:F1795 a crgo:CRGO_0000024 ;

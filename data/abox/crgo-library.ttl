lib:F0148 a crgo:CRGO_0000024 ;
    rdfs:label "Wi-Fi deauthentication attacks disrupting network access"@en ;
    crgo:CRGO_0000196 lib:F0148-event ;
    crgo:CRGO_0000200 lib:F0148-consequence ;
    crgo:CRGO_0000246 theme:ThemeAccess ;
    crgo:CRGO_0000250 "LIB-F0148" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R2141" ;
    crgo:CRGO_0000318 lib:F0148-source ;
    crgo:CRGO_0000322 crgo:CRGO_0000305,
        crgo:CRGO_0000309 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Deploy an Intrusion Detection System (IDS) or Intrusion Prevention System (IPS) to detect and block deauthentication attacks"@en,
        "Enable wireless network monitoring tools to identify abnormal network traffic and suspicious activities"@en,
        "Implement Wi-Fi security best practices, such as disabling SSID broadcasting and MAC address filtering"@en,
        "Implement strong authentication protocols such as WPA2 or WPA3 with strong passwords"@en,
        "Mitigation Measures"@en,
        "Regularly update Wi-Fi access points with the latest firmware patches"@en .


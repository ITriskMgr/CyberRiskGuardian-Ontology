lib:F1550 a crgo:CRGO_0000024 ;
    rdfs:label "Vishing attack on HR department to gain employee credentials"@en ;
    crgo:CRGO_0000196 lib:F1550-event ;
    crgo:CRGO_0000246 theme:ThemeSocialEng ;
    crgo:CRGO_0000250 "LIB-F1550" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R1061" ;
    crgo:CRGO_0000318 lib:F1550-source ;
    crgo:CRGO_0000322 crgo:CRGO_0000305,
        crgo:CRGO_0000313 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Call Screening and Filtering: Implement call filtering solutions to detect and block known malicious phone numbers used for vishing attacks"@en,
        "Employee Education and Awareness: Implement regular security awareness training programs to educate employees about the risks of vishing attacks and how to identify and report suspicious calls"@en,
        "Incident Response Plan: Develop and regularly test an incident response plan specifically addressing vishing attacks, ensuring swift response and mitigation in the event of an attack"@en,
        "Multi-Factor Authentication (MFA): Enable MFA for all sensitive systems and applications to add an extra layer of security, making it harder for attackers to gain unauthorized access"@en,
        "Phishing Simulation and Testing: Conduct regular phishing simulation exercises to assess employees' susceptibility to social engineering attacks and provide additional training where needed"@en,
        "without more information. However, I can provide you with a general outline of mitigation measures that can be explored to address the Vishing attack scenario: Mitigation Measures"@en .

lib:F1550-event a crgo:CRGO_0000014 ;
    rdfs:label "Vishing attack on HR department to gain employee credentials"@en .

lib:F1550-source a crgo:CRGO_0000294 ;
    crgo:CRGO_0000194 crgo:CRGO_0000092 .

lib:F1551 a crgo:CRGO_0000024 ;
    rdfs:label "Diversion fraud manipulating hospital workflows"@en ;
    crgo:CRGO_0000196 lib:F1551-event ;
    crgo:CRGO_0000200 lib:F1551-consequence ;
    crgo:CRGO_0000246 theme:ThemeSocialEng ;
    crgo:CRGO_0000250 "LIB-F1551" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R1062" ;
    crgo:CRGO_0000318 lib:F1551-source ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Conduct regular risk assessments and penetration testing to identify and address any vulnerabilities proactively"@en,
        "Deploy intrusion detection/prevention systems and firewalls to detect and block any unauthorized network traffic"@en,
        "Enable multi-factor authentication for critical systems and sensitive data access"@en,
        "Implement strong access controls and permission management to prevent unauthorized individuals from modifying or manipulating hospital workflows"@en,
        "Regularly patch and update all healthcare systems and software to minimize vulnerabilities"@en,
        "Train personnel on recognizing and reporting suspicious activities or attempts to manipulate workflows"@en .

lib:F1551-consequence a crgo:CRGO_0000027 ;
    crgo:CRGO_0000201 crgo:CRGO_0000075,
        crgo:CRGO_0000082 .


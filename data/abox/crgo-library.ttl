lib:F1538 a crgo:CRGO_0000024 ;
    rdfs:label "Insider facilitated social engineering attack to compromise ERP systems"@en ;
    crgo:CRGO_0000196 lib:F1538-event ;
    crgo:CRGO_0000246 theme:ThemeSocialEng ;
    crgo:CRGO_0000250 "LIB-F1538" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0818" ;
    crgo:CRGO_0000318 lib:F1538-source ;
    crgo:CRGO_0000322 crgo:CRGO_0000306 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Conduct Regular Security Awareness Training: Educate employees about the risks of social engineering and insider threats. Provide training on how to identify and report suspicious activities or attempts at manipulation"@en,
        "Conduct Regular Vulnerability Assessments: Continuously monitor and assess the ERP systems for potential vulnerabilities. Address any identified weaknesses promptly through patching or configuration changes"@en,
        "Implement Multi-Factor Authentication (MFA): Enable MFA for all user accounts accessing the ERP systems to add an extra layer of protection against unauthorized access"@en,
        "Implement Strong Access Controls: Enforce strict access controls based on the principle of least privilege to limit the ability of insiders to exploit vulnerabilities or facilitate social engineering attacks"@en,
        "Implement User Activity Monitoring: Deploy solutions that monitor and log user activities within the ERP systems. This will help identify any suspicious or abnormal behavior by insiders"@en,
        "Regularly Review User Access Rights: Conduct periodic reviews of user access rights and permissions to ensure that only authorized individuals have the necessary privileges"@en .


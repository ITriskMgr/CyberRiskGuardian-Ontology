    crgo:CRGO_0000250 "LIB-F1795" ;
    crgo:CRGO_0000252 "The hospital's customer relationship management (CRM) software has unpatched vulnerabilities. Attackers exploit these vulnerabilities to gain unauthorized access, manipulate patient records, or extract sensitive customer information."@en ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R1739" ;

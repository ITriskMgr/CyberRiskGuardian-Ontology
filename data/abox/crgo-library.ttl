    crgo:CRGO_0000322 crgo:CRGO_0000304 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Back up critical data and have a tested incident response plan in place"@en,
        "Conduct frequent vulnerability assessments and penetration testing"@en,
        "Enforce strong access controls and authentication mechanisms"@en,
        "Implement and regularly update secure post-quantum cryptographic algorithms"@en,
        "Implement intrusion detection and prevention systems"@en,
        "Regularly train and educate employees about cybersecurity best practices"@en .

lib:F0810 a crgo:CRGO_0000024 ;
    rdfs:label "Underfunding of critical cybersecurity initiatives"@en ;
    crgo:CRGO_0000196 lib:F0810-event ;
    crgo:CRGO_0000246 theme:ThemeITGov ;
    crgo:CRGO_0000250 "LIB-F0810" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0135" ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Allocate sufficient budget and resources for critical cybersecurity initiatives"@en,
        "Conduct regular risk assessments to identify and prioritize vulnerabilities"@en,
        "Continuously monitor and update security controls to address evolving threats"@en,
        "Enhance incident response capabilities by establishing a dedicated team and response plan"@en,
        "Implement a robust cybersecurity awareness and training program for staff"@en,
        "Regularly review and update policies and procedures to align with industry best practices"@en .

lib:F1737 a crgo:CRGO_0000024 ;
    rdfs:label "Inadequate patch management for endpoint devices"@en ;
    crgo:CRGO_0000196 lib:F1737-event ;

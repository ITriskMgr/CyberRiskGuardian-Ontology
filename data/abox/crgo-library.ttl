    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "conduct regular vulnerability scans and penetration testing"@en,
        "implement stricter access controls including multifactor authentication"@en,
        "limit the number of users who have access to patient data"@en,
        "patch the vulnerabilities in the crm software immediately"@en,
        "train employees on how to identify and report suspicious activity"@en .


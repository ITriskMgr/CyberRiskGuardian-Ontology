lib:F0476 a crgo:CRGO_0000024 ;
    rdfs:label "Inadequate full-disk encryption on mobile devices"@en ;
    crgo:CRGO_0000196 lib:F0476-event ;
    crgo:CRGO_0000246 theme:ThemeCrypto ;
    crgo:CRGO_0000250 "LIB-F0476" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0393" ;
    crgo:CRGO_0000322 crgo:CRGO_0000307 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Enable Remote Tracking and Wiping: Enable remote tracking and data wiping capabilities on mobile devices, allowing devices to be remotely located and data erased if lost or stolen"@en,
        "Enforce Strong Password Policies: Establish and enforce strong password requirements for accessing mobile devices, including regular password changes and unique, complex passwords"@en,
        "Implement Full-Disk Encryption: Ensure that all mobile devices used within the organization have full-disk encryption enabled, protecting data at rest"@en,
        "Implement Mobile Device Management (MDM) Solutions: By using MDM tools, enforce security policies, manage device encryption, and remotely wipe or lock devices in case of theft or loss"@en,
        "Regular Security Training and Awareness: Conduct regular cybersecurity training and awareness programs to educate employees about the importance of device security, data encryption, and safe mobile usage practices"@en,
        "for the scenario you mentioned. Please note that these measures may not be tailored to the organisation specifically. Mitigation Measures"@en .


    crgo:CRGO_0000330 "Diversify supplier sources"@en,
        "Establish relationships with alternative suppliers"@en,
        "Have backup plans for supplier disruptions"@en,
        "Implement redundancy measures for critical supplies"@en,
        "Regularly assess and monitor supplier performance"@en .

lib:F0766 a crgo:CRGO_0000024 ;
    rdfs:label "Insecure post-quantum cryptographic algorithms"@en ;

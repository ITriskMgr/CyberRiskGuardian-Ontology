lib:F0020 a crgo:CRGO_0000024 ;
    rdfs:label "Unauthorized account provisioning"@en ;
    crgo:CRGO_0000196 lib:F0020-event ;
    crgo:CRGO_0000246 theme:ThemeAccess ;
    crgo:CRGO_0000250 "LIB-F0020" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0018" ;
    crgo:CRGO_0000318 lib:F0020-source ;
    crgo:CRGO_0000322 crgo:CRGO_0000305 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Enforce the principle of least privilege, granting users only the permissions necessary to perform their assigned tasks"@en,
        "Establish a comprehensive user provisioning and deprovisioning process to manage user accounts efficiently, including regular reviews and audits"@en,
        "Implement multi-factor authentication to add an extra layer of security for account access"@en,
        "Implement strong access controls and segregation of duties to ensure that only authorized personnel can create or provision accounts"@en,
        "Regularly monitor and analyze user account activities for any suspicious or unauthorized actions"@en,
        "for the unauthorized account provisioning scenario: Mitigation Measures"@en .

lib:F0020-event a crgo:CRGO_0000014 ;
    rdfs:label "Unauthorized account provisioning"@en .

lib:F0020-source a crgo:CRGO_0000294 ;
    crgo:CRGO_0000194 crgo:CRGO_0000092 .

lib:F0021 a crgo:CRGO_0000024 ;
    rdfs:label "Unauthorized escalation of user privileges"@en ;
    crgo:CRGO_0000196 lib:F0021-event ;
    crgo:CRGO_0000246 theme:ThemeAccess ;
    crgo:CRGO_0000250 "LIB-F0021" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0019" ;
    crgo:CRGO_0000318 lib:F0021-source ;
    crgo:CRGO_0000322 crgo:CRGO_0000313 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Implement a strong authentication mechanism, such as multi-factor authentication, to prevent unauthorized access to user accounts"@en,
        "Implement principle of least privilege (PoLP), ensuring that users only have access to the resources necessary for their job functions"@en,
        "Implement strict access controls and monitoring mechanisms to detect and prevent unauthorized privilege escalations"@en,
        "Regularly conduct security awareness training for employees to educate them about the risks associated with providing sensitive information or credentials in phishing scams or social engineering attacks"@en,
        "Regularly update and patch all software and operating systems to fix known vulnerabilities that could be exploited for privilege escalation"@en,
        "Utilize intrusion detection and prevention systems (IDPS) to detect and block suspicious activities or attempts at privilege escalation"@en .


lib:F0015 a crgo:CRGO_0000024 ;
    rdfs:label "Abuse of administrative credentials"@en ;
    crgo:CRGO_0000196 lib:F0015-event ;
    crgo:CRGO_0000246 theme:ThemeAccess ;
    crgo:CRGO_0000250 "LIB-F0015" ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R0011" ;
    crgo:CRGO_0000322 crgo:CRGO_0000305 ;
    crgo:CRGO_0000329 "healthcare" ;
    crgo:CRGO_0000330 "Implement network segmentation: Separate critical systems and sensitive data from less critical areas to limit the impact of potential breaches"@en,
        "Implement strong access controls: Enforce strict password policies, require multi-factor authentication, and limit administrative access to authorized personnel"@en,
        "Monitor and log administrative activities: Implement logging mechanisms to track administrative actions and detect any unauthorized or suspicious activities"@en,
        "Provide security awareness training: Educate employees and administrators about potential phishing attacks, social engineering techniques, and the importance of safeguarding administrative credentials"@en,
        "Regularly review and update access privileges: Conduct periodic audits to ensure that administrative privileges are granted only to approved individuals and are regularly reviewed"@en,
        "Scenario: Abuse of Administrative Credentials Description: An attacker gains unauthorized access to administrative credentials within the organisation's network. Mitigation Measures"@en .


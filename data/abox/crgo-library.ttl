    crgo:CRGO_0000252 "An employee connects an infected personal device to the hospital's network, unknowingly introducing malware that spreads across the IT infrastructure, compromising sensitive data and systems."@en ;
    crgo:CRGO_0000287 "combined_file.xlsx rows R1656" ;
    crgo:CRGO_0000318 lib:F1794-source ;
    crgo:CRGO_0000322 crgo:CRGO_0000304,

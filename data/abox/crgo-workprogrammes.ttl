    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "GRCA specification section 8; NIST SP 800-53A Rev. 5 objectives (5.2.0 OSCAL catalogue)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000864 true .


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/crgo/contracts/dss/v1/assessment-result.schema.json",
  "title": "CyberRiskGuardian result written back to CRGO (write document, contract dss/v1)",
  "description": "A result computed by the DSS, submitted to CRGO. CRGO stores it as a proposed analytical result with the knowledge status 'risk estimate' in the organisation's own proposed graph; it never becomes an approved fact, a decision, an acceptance or a funding approval by being written back (ADR-007).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "organizationId",
    "subjectId",
    "assessmentKind",
    "modelId",
    "modelVersion",
    "computedAt",
    "inputs",
    "inputDocumentSha256",
    "result",
    "status",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "contract": {
      "const": "dss/v1"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^https?://",
      "not": {
        "pattern": "^https://w3id\\.org/crgo/"
      }
    },
    "subjectId": {
      "type": "string",
      "pattern": "^https?://",
      "not": {
        "pattern": "^https://w3id\\.org/crgo/"
      },
      "description": "The organisation's assessment scenario (or other subject) the result is for."
    },
    "assessmentKind": {
      "enum": [
        "estimated-risk",
        "tolerated-risk",
        "mitigated-risk",
        "residual-risk",
        "risk-to-tolerance-ratio",
        "budget-target",
        "sensitivity-case"
      ]
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^\\s*([Tt][Bb][Dd]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn]/?[Aa]|[Tt][Oo][Dd][Oo]|-|\\?)?\\s*$"
      },
      "description": "The model version actually used; placeholders such as TBD, unknown or n/a are refused."
    },
    "computedAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "inputDocumentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ontologyRelease": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "CRG risk units",
            "ratio",
            "currency"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "status": {
      "const": "proposed",
      "description": "The only status a write-back may carry. Approval is a separate act by the project or organisation owner."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer"
      ],
      "properties": {
        "producer": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "description": "Who ran the DSS (person or service account), for the audit trail."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "unit": {
                "const": "currency"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "required": [
              "currency"
            ]
          }
        }
      }
    }
  ]
}
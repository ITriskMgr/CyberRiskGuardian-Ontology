# --- risk appetite statement
crgo:CRGO_0000029 a owl:Class ;
    rdfs:label "risk appetite statement"@en,
        "énoncé d'appétit pour le risque"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "risk appetite"@en ;
    skos:definition "A prescription, approved by management, of how much cybersecurity risk the organisation is willing to accept, expressed in CRG on a 0-1 scale."@en,
        "Prescription, approuvée par la direction, du niveau de risque de cybersécurité que l'organisation est prête à accepter, exprimée dans CRG sur une échelle de 0 à 1."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CRG step 4 (0.1-0.9 bands)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, cyber-risk-assessment SKILL.md, workflow steps 1-19 (commit f0cd36e)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .


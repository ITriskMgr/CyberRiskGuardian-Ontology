    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- threat source description
crgo:CRGO_0000294 a owl:Class ;
    rdfs:label "threat source description"@en,
        "description de source de menace"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of a kind of threat source, such as a financially motivated cybercriminal, a negligent employee or a flood, with its type, used when the source is not an identified agent or process."@en,
        "Description d'un type de source de menace, comme un cybercriminel motivé par l'appât du gain, un employé négligent ou une inondation, avec son type, utilisée lorsque la source n'est pas un agent ou un processus identifié."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CRG 'threat_source' is text; library scenarios belong to no organisation (review H1)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)"@en,
        "NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .


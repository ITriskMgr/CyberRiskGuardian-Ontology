# --- has relevant requirement
crgo:CRGO_0000335 a owl:ObjectProperty ;
    rdfs:label "has relevant requirement"@en,
        "a pour exigence pertinente"@fr ;
    rdfs:domain crgo:CRGO_0000023 ;
    rdfs:range skos:Concept ;
    skos:definition "Relates a risk scenario to a requirement of a control framework, such as a NIST CSF 2.0 subcategory, a NIST SP 800-53 control or an ISO/IEC 27002 control, whose implementation would prevent, detect or limit the scenario."@en,
        "Relie un scénario de risque à une exigence d'un référentiel de mesures, comme une sous-catégorie du NIST CSF 2.0, une mesure du NIST SP 800-53 ou une mesure de l'ISO/IEC 27002, dont la mise en œuvre préviendrait, détecterait ou limiterait le scénario."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000285 "Links are proposed with a confidence on each assertion (OWL axiom annotation); used for threat, vulnerability and control identification (requirement R1)."@en ;
    crgo:CRGO_0000286 "Phase 3 repair of the 2023 scenario library (decision Q-E, option 3), data/library/REPAIR_REPORT.md"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-10"^^xsd:date ;
    crgo:CRGO_0000291 "0.3.0" .

crgo:crgo-core a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.10.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-13"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - core module"@en,
        "Ontologie CyberRiskGuardian - module central"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports obo:bfo.owl,
        crgo:crgo-gov,
        <https://w3id.org/crgo/imports/cco-slice> ;
    owl:priorVersion <https://w3id.org/crgo/0.9.0/crgo-core> ;
    owl:versionIRI <https://w3id.org/crgo/0.10.0/crgo-core> ;
    owl:versionInfo "0.10.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- facility asset
crgo:CRGO_0000008 a owl:Class ;
    rdfs:label "facility asset"@en,
        "actif d'installation"@fr ;
    rdfs:subClassOf crgo:CRGO_0000001,
        cco:ont00000192 ;
    skos:altLabel "salle des serveurs"@fr ;
    skos:definition "An asset that is a building, room or site housing other assets or activities, such as a server room, data centre, archive or clinic."@en,
        "Actif constitué d'un bâtiment, d'une salle ou d'un site qui abrite d'autres actifs ou activités, comme une salle des serveurs, un centre de données, des archives ou une clinique."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Server rooms and archives are central in Cigale and 2012 scenarios."@en ;
    crgo:CRGO_0000286 "Phase 1 scenario extraction (Drive folder 'scenarios'): corpora A-D, F"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- business objective
crgo:CRGO_0000010 a owl:Class ;
    rdfs:label "business objective"@en,
        "objectif d'affaires"@fr ;
    rdfs:subClassOf cco:ont00000476 ;
    skos:definition "An objective the organisation pursues that business processes support and that cybersecurity risk can threaten."@en,
        "Objectif poursuivi par l'organisation, soutenu par des processus d'affaires et que le risque de cybersécurité peut compromettre."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CRG traceability starts from objectives."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- incident
crgo:CRGO_0000015 a owl:Class ;
    rdfs:label "incident"@en,
        "incident"@fr ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:altLabel "incident de confidentialité"@fr ;
    skos:definition "An actual occurrence of an adverse event affecting the organisation's assets or information, including a confidentiality incident under Loi 25."@en,
        "Occurrence réelle d'un événement défavorable touchant les actifs ou l'information de l'organisation, y compris un incident de confidentialité au sens de la Loi 25."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Needed for the Loi 25 incident register and history."@en ;
    crgo:CRGO_0000286 "ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)"@en,
        "Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- legal obligation
crgo:CRGO_0000022 a owl:Class ;
    rdfs:label "legal obligation"@en,
        "obligation légale"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A prescription of a duty imposed by a statute or regulation, identified by its legal citation, such as keeping a register of confidentiality incidents under Loi 25."@en,
        "Prescription d'une obligation imposée par une loi ou un règlement, identifiée par sa référence juridique, comme la tenue d'un registre des incidents de confidentialité en vertu de la Loi 25."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Loi 25 obligations are in the first SKOS schemes."@en ;
    crgo:CRGO_0000286 "Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- assessment scenario
crgo:CRGO_0000025 a owl:Class ;
    rdfs:label "assessment scenario"@en,
        "scénario d'évaluation"@fr ;
    rdfs:subClassOf crgo:CRGO_0000023 ;
    skos:altLabel "candidate scenario"@en,
        "selected scenario"@en ;

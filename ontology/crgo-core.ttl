# --- vulnerability
crgo:CRGO_0000016 a owl:Class ;
    rdfs:label "vulnerability"@en,
        "vulnérabilité"@fr ;
    rdfs:subClassOf cco:ont00000548 ;
    skos:altLabel "weakness"@en,
        "faiblesse"@fr,
        "faille"@fr ;
    skos:definition "A disposition of a material asset, such as a device, storage medium or network equipment, or of an organisation, that a threat source can exploit to cause harm. Weaknesses of software, information or controls are recorded as vulnerability descriptions."@en,
        "Disposition d'un actif matériel, comme un appareil, un support de stockage ou un équipement réseau, ou d'une organisation, qu'une source de menace peut exploiter pour causer un préjudice. Les faiblesses des logiciels, de l'information ou des contrôles sont consignées comme descriptions de vulnérabilité."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Aligned to CCO Vulnerability; restricted to material bearers after HermiT finding and review H6."@en ;
    crgo:CRGO_0000286 "Common Core Ontologies 2.2 (2026-08-13), alignment target"@en,
        "ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)"@en,
        "MOACCO 1.2a (retired), Herzog et al. Security.owl concepts Threat, Vulnerability, Countermeasure"@en,
        "NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- predisposing condition
crgo:CRGO_0000017 a owl:Class ;
    rdfs:label "predisposing condition"@en,
        "condition prédisposante"@fr ;
    rdfs:subClassOf obo:BFO_0000016 ;
    skos:definition "A condition of the organisation, its environment or its systems that increases or decreases the likelihood that a threat event causes harm, without being a weakness of a specific control."@en,
        "Condition de l'organisation, de son environnement ou de ses systèmes qui augmente ou diminue la probabilité qu'un événement de menace cause un préjudice, sans être une faiblesse d'un contrôle précis."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000285 "SP 800-30 Appendix F; examples: single telecom link, ground-floor server room."@en ;
    crgo:CRGO_0000286 "NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)"@en,
        "Phase 1 scenario extraction (Drive folder 'scenarios'): corpora A-D, F"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

# --- connected device
crgo:CRGO_0000005 a owl:Class ;
    rdfs:label "connected device"@en,
        "appareil connecté"@fr ;
    rdfs:subClassOf crgo:CRGO_0000004 ;
    skos:altLabel "IoT device"@en,
        "objet connecté"@fr ;
    skos:definition "A hardware asset with embedded computing and network connectivity whose malfunction can affect physical processes, such as an IoT, OT or medical device."@en,
        "Actif matériel doté de capacités de calcul et de connectivité réseau intégrées dont le dysfonctionnement peut toucher des processus physiques, comme un objet connecté, un équipement de technologie opérationnelle ou un dispositif médical."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000285 "Recurring in corpora (IoT, medical devices); CRG coverage list names OT/IoT/medical."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)"@en,
        "Phase 1 scenario extraction (Drive folder 'scenarios'): corpora A-D, F"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- network asset
crgo:CRGO_0000006 a owl:Class ;
    rdfs:label "network asset"@en,
        "actif réseau"@fr ;
    rdfs:subClassOf crgo:CRGO_0000004 ;
    skos:altLabel "réseau"@fr ;
    skos:definition "A hardware asset, or an interconnected set of them, that carries communications between other assets, such as a local network, a WiFi network or an inter-establishment link."@en,
        "Actif matériel, ou ensemble interconnecté de tels actifs, qui achemine les communications entre d'autres actifs, comme un réseau local, un réseau sans fil ou un lien inter-établissement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000285 "RTSS, WiFi and telecom links recur; modelled as hardware for simplicity, see confidence note."@en ;
    crgo:CRGO_0000286 "Phase 1 scenario extraction (Drive folder 'scenarios'): corpora A-D, F"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- service asset
crgo:CRGO_0000007 a owl:Class ;
    rdfs:label "service asset"@en,
        "actif de service"@fr ;
    rdfs:subClassOf obo:BFO_0000017,
        crgo:CRGO_0000001 ;
    skos:altLabel "SaaS"@en,
        "cloud service"@en ;
    skos:definition "An asset that is a provider's capability to deliver a service to the organisation, internally or as a third party, such as a cloud application, hosting, telecommunications or a managed security service; the capability inheres in the provider's systems or organisation."@en,
        "Actif constitué de la capacité d'un fournisseur à offrir un service à l'organisation, à l'interne ou à titre de tiers, comme une application infonuagique, un hébergement, des télécommunications ou un service de sécurité géré; cette capacité réside dans les systèmes ou l'organisation du fournisseur."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000285 "Realizable entity (capability) rather than process, so a service can be owned, valued and depended on (review H3)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)"@en,
        "Phase 1 scenario extraction (Drive folder 'scenarios'): corpora A-D, F"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- threat source role
crgo:CRGO_0000012 a owl:Class ;
    rdfs:label "threat source role"@en,
        "rôle de source de menace"@fr ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:altLabel "threat actor"@en,
        "source de menace"@fr ;
    skos:definition "A role borne by an agent or artifact in virtue of which it may initiate a threat event, intentionally or not."@en,
        "Rôle porté par un agent ou un artefact en vertu duquel il peut déclencher un événement de menace, intentionnellement ou non."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000285 "Role keeps people and organisations rigid; environmental sources are described with ThreatSourceDescription (review M)."@en ;
    crgo:CRGO_0000286 "ISO/IEC 27005:2022, risk concepts (paraphrased; clause numbers to verify against the licensed text)"@en,
        "MOACCO 1.2a (retired), Herzog et al. Security.owl concepts Threat, Vulnerability, Countermeasure"@en,
        "NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

# --- software asset
crgo:CRGO_0000003 a owl:Class ;
    rdfs:label "software asset"@en,
        "actif logiciel"@fr ;
    rdfs:subClassOf crgo:CRGO_0000001,
        cco:ont00000965 ;
    skos:altLabel "application"@en ;
    skos:definition "An asset that is a computer program or application, including its configuration, considered independently of the hardware that runs it."@en,

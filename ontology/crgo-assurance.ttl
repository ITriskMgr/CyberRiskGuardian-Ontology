# --- evidence sufficiency assessment
crgo:CRGO_0000525 a owl:Class ;
    rdfs:label "evidence sufficiency assessment"@en,
        "évaluation du caractère suffisant des preuves"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record of an assessor's judgement of whether the evidence gathered is sufficient, relevant, current and in scope for a stated objective or criterion."@en,
        "Enregistrement daté du jugement d'un évaluateur sur le caractère suffisant, pertinent, actuel et conforme au périmètre des preuves recueillies pour un objectif ou un critère donné."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 9 (explicit sufficiency assessment); ITAF 1205; GIAS Standard 14.1."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 2"@en .


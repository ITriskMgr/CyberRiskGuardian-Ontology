    rdfs:label "mapped edition"@en,
        "édition mise en correspondance"@fr ;
    rdfs:domain crgo:CRGO_0000912 ;
    skos:definition "Relates a mapping assertion to the source record or version of each side that was mapped, so that a later edition does not silently change it."@en,

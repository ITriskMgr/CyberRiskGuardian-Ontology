# --- CRG normalised cross-check
crgo:CRGO_0000179 a owl:NamedIndividual,
        crgo:CRGO_0000059 ;
    rdfs:label "CRG normalised cross-check"@en,
        "contre-vérification normalisée CRG"@fr ;
    skos:definition "Secondary score T × E × I × (1 − C), with C proxied by resilience; post-treatment × (1 − P × Q)."@en,
        "Score secondaire T × E × I × (1 − C), où C est approché par la résilience; après traitement × (1 − P × Q)."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)"@en ;

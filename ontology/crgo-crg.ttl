# --- screening score
crgo:CRGO_0000039 a owl:Class ;
    rdfs:label "screening score"@en,
        "score de présélection"@fr ;
    rdfs:subClassOf crgo:CRGO_0000037 ;
    skos:definition "An estimate scoring a candidate scenario from 1 to 5 on one screening criterion."@en,
        "Estimation qui note un scénario candidat de 1 à 5 selon un critère de présélection."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "12 criteria, scored 1-5."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, scenario-selection-instructions.md, steps 9-12 and required output A-E (commit f0cd36e)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- risk-to-tolerance ratio
crgo:CRGO_0000055 a owl:Class ;
    rdfs:label "risk-to-tolerance ratio"@en,
        "ratio risque/tolérance"@fr ;
    rdfs:subClassOf crgo:CRGO_0000050 ;
    skos:definition "A computed risk quantity equal to residual risk divided by tolerated risk; below 0.90 is below tolerance and above 1.10 is above tolerance."@en,
        "Quantité de risque calculée égale au risque résiduel divisé par le risque toléré; sous 0,90 le risque est sous la tolérance et au-dessus de 1,10 il la dépasse."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- calculation activity
crgo:CRGO_0000058 a owl:Class ;
    rdfs:label "calculation activity"@en,
        "activité de calcul"@fr ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "A process in which software computes risk quantities from estimates using a stated method, such as a run of crg_calc.py."@en,
        "Processus par lequel un logiciel calcule des quantités de risque à partir d'estimations selon une méthode déclarée, comme une exécution de crg_calc.py."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Provenance of every KRIQuantity."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .

# --- CVSS input
crgo:CRGO_0000049 a owl:Class ;
    rdfs:label "CVSS input"@en,
        "donnée CVSS"@fr ;
    rdfs:subClassOf crgo:CRGO_0000037 ;
    skos:altLabel "CVSS"@en ;
    skos:definition "An estimate recording the CVSS version, vector, base score and severity of the representative weakness of a scenario, with a note when CVSS has limited applicability."@en,
        "Estimation qui consigne la version, le vecteur, le score de base et la sévérité CVSS de la faiblesse représentative d'un scénario, avec une note lorsque CVSS s'applique mal."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CRG keys cvss, cvss_note, cvss_score, cvss_sev; v4.0 by default."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian, crg-formulas-and-workbook.md (Excel Guide v1.0c s.11) and scripts/crg_calc.py (commit f0cd36e)"@en,
        "CyberRiskGuardian, plugins/cyberriskguardian/skills/cyber-risk-assessment/assets/scenario-template.json (commit f0cd36e)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-08"^^xsd:date ;
    crgo:CRGO_0000291 "0.1.0" .


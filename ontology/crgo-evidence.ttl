        crgo:CRGO_0000565 ;
    rdfs:label "verified source"@en,
        "source vérifiée"@fr ;
    skos:definition "The file is held, its version and terms are checked, and CRGO may reuse its content within those terms."@en,
        "Le fichier est détenu, sa version et ses conditions sont vérifiées, et CRGO peut en réutiliser le contenu dans ces limites."@fr ;
    skos:inScheme crgo:CRGO_0000566 ;
    skos:notation "1" ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;

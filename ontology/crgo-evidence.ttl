crgo:crgo-evidence a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.9.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - sources, observations and assumptions module"@en,
        "Ontologie CyberRiskGuardian - module des sources, observations et hypothèses"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-measure,
        <https://w3id.org/crgo/imports/prov-slice>,
        <https://w3id.org/crgo/imports/time-slice> ;
    owl:priorVersion <https://w3id.org/crgo/0.8.0/crgo-evidence> ;
    owl:versionIRI <https://w3id.org/crgo/0.9.0/crgo-evidence> ;
    owl:versionInfo "0.9.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- assumption
crgo:CRGO_0000339 a owl:Class ;
    rdfs:label "assumption"@en,
        "hypothèse"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "hypothesis"@en ;
    skos:definition "A statement taken as true without verification for an estimate, an assessment or a decision, recorded so that the result can be reviewed when the statement turns out to be false or changes."@en,
        "Énoncé tenu pour vrai sans vérification aux fins d'une estimation, d'une appréciation ou d'une décision, consigné afin que le résultat puisse être revu si l'énoncé se révèle faux ou change."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Specification sections 6, 7 and 11 (assessments depend on assumptions)."@en ;
    crgo:CRGO_0000286 "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- observation
crgo:CRGO_0000338 a owl:Class ;
    rdfs:label "observation"@en,
        "observation"@fr ;
    rdfs:subClassOf prov:Entity,
        cco:ont00001163 ;
    owl:disjointWith crgo:CRGO_0000037 ;
    skos:definition "A dated record that a stated source reported a value or category for an entity at a stated time, such as the EPSS score of a vulnerability on a given day. An observation reports what a source said; it is not an estimate made for an assessment."@en,
        "Enregistrement daté indiquant qu'une source donnée a rapporté une valeur ou une catégorie pour une entité à un moment donné, comme le score EPSS d'une vulnérabilité un jour donné. Une observation rapporte ce qu'une source a dit; ce n'est pas une estimation faite pour une appréciation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Disjoint from estimate (specification rule 3: separate source facts from model estimates); negative fixture tests it."@en ;
    crgo:CRGO_0000286 "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en,
        "W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- source record
crgo:CRGO_0000337 a owl:Class ;
    rdfs:label "source record"@en,
        "notice de source"@fr ;
    rdfs:subClassOf prov:Entity,
        cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000036 ;
    skos:definition "A description of a dataset, publication or legal text from which CRGO content was imported or derived, recording its issuer, official identifier, version, retrieval date, licence, what CRGO redistributes and the checksum of the file used."@en,
        "Description d'un jeu de données, d'une publication ou d'un texte juridique dont un contenu de CRGO est importé ou dérivé, indiquant son émetteur, son identifiant officiel, sa version, sa date d'obtention, sa licence, ce que CRGO en rediffuse et l'empreinte du fichier utilisé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Specification section 7 (SourceRecord fields); one per row of docs/baseline/source_registry.csv."@en ;
    crgo:CRGO_0000286 "CRGO Stage 0 gap analysis (docs/baseline/gap_analysis.md, 2026-10-11)"@en,
        "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en,
        "W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .


# --- observation
crgo:CRGO_0000338 a owl:Class ;
    rdfs:label "observation"@en,
        "observation"@fr ;
    rdfs:subClassOf prov:Entity,
        cco:ont00001163 ;
    owl:disjointWith crgo:CRGO_0000037 ;
    skos:definition "A dated record that a stated source reported a value or category for an entity at a stated time, such as the EPSS score of a vulnerability on a given day. An observation reports what a source said; it is not an estimate made for an assessment."@en,
        "Enregistrement daté indiquant qu'une source donnée a rapporté une valeur ou une catégorie pour une entité à un moment donné, comme le score EPSS d'une vulnérabilité un jour donné. Une observation rapporte ce qu'une source a dit; ce n'est pas une estimation faite pour une appréciation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Disjoint from estimate (specification rule 3: separate source facts from model estimates); negative fixture tests it."@en ;
    crgo:CRGO_0000286 "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en,
        "W3C PROV-O: The PROV Ontology, W3C Recommendation 30 April 2013 (slice: imports/prov-slice.ttl)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 5 (all terms, including the GRCA additions)"@en .

# --- analytical result
crgo:CRGO_0000477 a owl:Class ;
    rdfs:label "analytical result"@en,
        "résultat analytique"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000338 ;
    skos:definition "A record of a result computed outside CRGO by a named model and version, such as a CyberRiskGuardian risk calculation, with the inputs it used and when it was computed. CRGO stores it as a proposed risk estimate and never derives it by reasoning."@en,
        "Enregistrement d'un résultat calculé hors de CRGO par un modèle et une version nommés, comme un calcul de risque de CyberRiskGuardian, avec les données d'entrée utilisées et la date du calcul. CRGO le conserve comme estimation de risque proposée et ne le déduit jamais par raisonnement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS section 8 (write-back contract); ADR-007: scoring and optimisation stay in the DSS."@en ;
    crgo:CRGO_0000286 "CRGO ADR-007, boundary between CRGO and the CyberRiskGuardian decision-support system (2026-10-11)"@en,
        "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 5 (all terms, including the GRCA additions)"@en .

# --- source access status
crgo:CRGO_0000565 a owl:Class ;
    rdfs:label "source access status"@en,
        "statut d'accès à la source"@fr ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Whether CRGO holds and may use a source, and so what it can import from it."@en,
        "Indique si CRGO détient une source et peut l'utiliser, et donc ce qu'il peut en importer."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Value set; members listed below."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 5 (all terms, including the GRCA additions)"@en .


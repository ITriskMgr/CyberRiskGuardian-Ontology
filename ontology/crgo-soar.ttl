# --- response evidence
crgo:CRGO_0001122 a owl:Class ;
    rdfs:label "response evidence"@en,
        "preuve de réponse"@fr ;
    rdfs:subClassOf crgo:CRGO_0000036 ;
    skos:definition "An evidence item recording that a response action was carried out and with what result, such as a system log entry or a screenshot of the changed configuration."@en,

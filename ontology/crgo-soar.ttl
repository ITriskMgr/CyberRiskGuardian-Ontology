# --- approval gate
crgo:CRGO_0001118 a owl:Class ;
    rdfs:label "approval gate"@en,
        "point d'approbation"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive that an action, or a class of actions, may be executed only after a stated authority has approved it, or under a stated pre-authorisation, for example when it targets a critical asset."@en,
        "Directive selon laquelle une action, ou une classe d'actions, ne peut être exécutée qu'après l'approbation d'une autorité précisée, ou en vertu d'une préautorisation précisée, par exemple lorsqu'elle vise un actif critique."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR sections 2 and 5."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 2"@en .


crgo:CRGO_0001119 a owl:Class ;
    rdfs:label "approval decision"@en,
        "décision d'approbation"@fr ;
    rdfs:subClassOf crgo:CRGO_0000504 ;
    skos:definition "A decision record granting or denying the execution of a response action, or pre-authorising a stated class of actions for a stated scope and period, by an identified authority."@en,
        "Relevé de décision qui accorde ou refuse l'exécution d'une action de réponse, ou qui préautorise une classe d'actions précisée pour un périmètre et une période donnés, par une autorité identifiée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2 (ApprovalDecision); reuses decision record (decision S3). An approval is about one execution or a narrowly scoped pre-authorisation."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 2"@en .

# --- automation execution record
crgo:CRGO_0001120 a owl:Class ;
    rdfs:label "automation execution record"@en,
        "enregistrement d'exécution automatisée"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0001121 ;
    skos:definition "A record of one run of a playbook version: what triggered it, when it started and ended, its status and the investigation or incident it served. The full execution history stays in the operational store."@en,
        "Enregistrement d'une exécution d'une version de guide : ce qui l'a déclenchée, son début et sa fin, son état et l'enquête ou l'incident qu'elle a servi. L'historique complet reste dans le dépôt opérationnel."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2 (AutomationExecution)."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 2"@en .

# --- incident impact
crgo:CRGO_0001124 a owl:Class ;
    rdfs:label "incident impact"@en,
        "impact de l'incident"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of a consequence an incident had, or is estimated to have had, along one impact dimension, such as hours of service lost or the number of records exposed, with whether it is observed or estimated."@en,
        "Description d'une conséquence qu'un incident a eue, ou est estimé avoir eue, selon une dimension d'impact, comme les heures de service perdues ou le nombre d'enregistrements exposés, en précisant si elle est observée ou estimée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2 (IncidentImpact). Distinct from a scenario's consequence description, which is what could happen."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 2"@en .


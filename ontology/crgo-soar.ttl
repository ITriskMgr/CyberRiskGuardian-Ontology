# --- security investigation
crgo:CRGO_0001112 a owl:Class ;
    rdfs:label "security investigation"@en,
        "enquête de sécurité"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    owl:disjointWith crgo:CRGO_0000015 ;
    skos:altLabel "security case"@en,
        "dossier de sécurité"@fr ;
    skos:definition "A planned act in which analysts examine one or more alerts, events or reports to establish what happened, whether it is an incident and what its scope is, with its case status as last recorded."@en,
        "Acte planifié par lequel des analystes examinent une ou plusieurs alertes, événements ou signalements pour établir ce qui s'est passé, s'il s'agit d'un incident et quelle en est l'étendue, avec l'état du dossier selon le dernier enregistrement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2 (SecurityInvestigation). The incident itself is the existing incident; its confirmation is the existing incident confirmation (decision S5)."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;

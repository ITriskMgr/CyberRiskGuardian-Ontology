    rdfs:label "playbook trigger"@en,
        "déclencheur de guide"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of what starts a playbook: an alert or event matching stated conditions, a schedule, or a request by an analyst."@en,
        "Description de ce qui lance un guide : une alerte ou un événement répondant à des conditions données, un calendrier, ou une demande d'un analyste."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2 (PlaybookTrigger)."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;

# --- recovery verification
crgo:CRGO_0001126 a owl:Class ;
    rdfs:label "recovery verification"@en,
        "vérification du rétablissement"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record that an asset or business process affected by an incident was checked to be restored to its expected operation, by whom and on what evidence."@en,
        "Enregistrement daté indiquant qu'un actif ou un processus d'affaires touché par un incident a été vérifié comme rétabli dans son fonctionnement attendu, par qui et sur quelles preuves."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2 (RecoveryVerification)."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "NIST SP 800-61 Rev. 3, Incident Response Recommendations and Considerations for Cybersecurity Risk Management: A CSF 2.0 Community Profile (April 2025), doi:10.6028/NIST.SP.800-61r3"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

    rdfs:label "playbook step"@en,
        "étape de guide"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive that is one step of a playbook version, such as an action, a condition, a branch or a parallel block, with its order and what follows it."@en,
        "Directive qui constitue une étape d'une version de guide, comme une action, une condition, un embranchement ou un bloc parallèle, avec son ordre et ce qui la suit."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SOAR section 2; CACAO 2.0 workflow steps (start, end, action, playbook-action, parallel, if-, while- and switch-condition)."@en ;
    crgo:CRGO_0000286 "CRGO SOAR Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "OASIS CACAO Security Playbooks Version 2.0, Committee Specification 01 (2023-11-27)"@en ;

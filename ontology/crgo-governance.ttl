crgo:CRGO_0000482 a owl:Class ;
    rdfs:label "governance role"@en,
        "rôle de gouvernance"@fr ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A role that an agent bears within an organisation's governance, risk management, control or assurance arrangements, and that can be assigned and withdrawn without the agent changing."@en,
        "Rôle qu'un agent assume dans les dispositifs de gouvernance, de gestion des risques, de contrôle ou d'assurance d'une organisation, et qui peut être attribué ou retiré sans que l'agent change."@fr ;

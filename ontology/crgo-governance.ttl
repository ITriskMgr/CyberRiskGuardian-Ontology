crgo:CRGO_0000486 a owl:Class ;
    rdfs:label "third-line role"@en,
        "rôle de troisième ligne"@fr ;
    rdfs:subClassOf crgo:CRGO_0000482 ;
    skos:altLabel "internal audit role"@en ;
    skos:definition "The role of internal audit: independent and objective assurance and advice to the governing body and management on governance, risk management and control."@en,
        "Rôle de l'audit interne : assurance et conseil indépendants et objectifs donnés à l'organe de gouvernance et à la direction sur la gouvernance, la gestion des risques et le contrôle."@fr ;

# --- independence assessment
crgo:CRGO_0000496 a owl:Class ;
    rdfs:label "independence assessment"@en,
        "évaluation de l'indépendance"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record of whether an assessor or assurance function is independent and objective with respect to the activity it assesses, with the threats to independence considered."@en,
        "Enregistrement daté indiquant si un évaluateur ou une fonction d'assurance est indépendant et objectif à l'égard de l'activité qu'il évalue, avec les menaces à l'indépendance examinées."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Principles 2 (Maintain Objectivity) and 7 (Positioned Independently); ITAF 1002 and 1003."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"@en ;

# --- delegation of authority
crgo:CRGO_0000494 a owl:Class ;
    rdfs:label "delegation of authority"@en,
        "délégation de pouvoirs"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive by which an agent grants another agent authority to decide or act within a stated scope, limit and period."@en,
        "Directive par laquelle un agent accorde à un autre agent le pouvoir de décider ou d'agir dans une portée, une limite et une période données."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 4; GAPS D07."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;

# --- procedure
crgo:CRGO_0000500 a owl:Class ;
    rdfs:label "procedure"@en,
        "procédure"@fr ;
    rdfs:subClassOf cco:ont00000974 ;
    skos:definition "A plan that sets out the steps by which a policy statement or technical standard is carried out, by whom and when."@en,
        "Plan qui expose les étapes par lesquelles un énoncé de politique ou une norme technique est appliqué, par qui et quand."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D01."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- role assignment
crgo:CRGO_0000493 a owl:Class ;
    rdfs:label "role assignment"@en,
        "attribution de rôle"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A record that an agent bears a governance role over a stated period, so that who held the role on a given date can be answered."@en,
        "Enregistrement indiquant qu'un agent assume un rôle de gouvernance pendant une période donnée, afin de pouvoir dire qui occupait le rôle à une date donnée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 4 (temporal role assignment): roles change over time, so the period is on the assignment, not on the agent."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- oversight activity
crgo:CRGO_0000495 a owl:Class ;
    rdfs:label "oversight activity"@en,
        "activité de surveillance"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A planned act in which a governing body, committee or senior manager reviews and challenges a report, a risk, a decision or an assurance result."@en,
        "Acte planifié par lequel un organe de gouvernance, un comité ou un cadre supérieur examine et remet en question un rapport, un risque, une décision ou un résultat d'assurance."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 4 (oversight)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- policy statement
crgo:CRGO_0000498 a owl:Class ;
    rdfs:label "policy statement"@en,
        "énoncé de politique"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "policy requirement"@en,
        "exigence de politique"@fr ;
    skos:changeNote "0.10.0 (2026-10-12): alternative labels 'policy requirement' / 'exigence de politique' added (POL PolicyRequirement)."@en ;
    skos:definition "A single rule within a policy, stated so that compliance with it can be assessed, such as 'privileged access is reviewed every quarter'."@en,
        "Règle unique d'une politique, formulée de manière à pouvoir en évaluer le respect, comme « les accès privilégiés sont revus chaque trimestre »."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D01 (obligation, control objective, policy statement, procedure chain)."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- conflict-of-interest declaration
crgo:CRGO_0000506 a owl:Class ;
    rdfs:label "conflict-of-interest declaration"@en,
        "déclaration de conflit d'intérêts"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record in which an agent declares an interest that could impair, or appear to impair, its objectivity on a stated decision or assessment."@en,
        "Enregistrement daté par lequel un agent déclare un intérêt qui pourrait compromettre, ou sembler compromettre, son objectivité à l'égard d'une décision ou d'une évaluation donnée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D07; GIAS Standard 2.3 (Disclosing Impairments to Objectivity)."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- first-line role
crgo:CRGO_0000484 a owl:Class ;
    rdfs:label "first-line role"@en,
        "rôle de première ligne"@fr ;
    rdfs:subClassOf crgo:CRGO_0000482 ;
    owl:disjointWith crgo:CRGO_0000485,

    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- policy exception
crgo:CRGO_0000502 a owl:Class ;
    rdfs:label "policy exception"@en,
        "dérogation"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:disjointWith crgo:CRGO_0000030 ;
    skos:altLabel "waiver"@en,
        "exemption"@fr ;
    skos:definition "A directive that permits a stated deviation from a policy statement, technical standard or control for a stated scope (role, asset or process) and period, approved by an identified authority and usually with compensating controls. It does not waive a legal obligation."@en,
        "Directive qui autorise un écart déterminé par rapport à un énoncé de politique, une norme technique ou une mesure, pour une portée (rôle, actif ou processus) et une période données, approuvée par une autorité identifiée et généralement assortie de mesures compensatoires. Elle ne dispense d'aucune obligation légale."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D01; GRCA section 6 (waiver or exception). Distinct from risk acceptance, which retains a risk rather than permitting a deviation from a rule."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .


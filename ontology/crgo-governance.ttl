crgo:crgo-governance a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.10.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - corporate governance, policy and decision records module"@en,
        "Ontologie CyberRiskGuardian - module de gouvernance d'entreprise, des politiques et des décisions"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-grc ;
    owl:priorVersion <https://w3id.org/crgo/0.9.0/crgo-governance> ;
    owl:versionIRI <https://w3id.org/crgo/0.10.0/crgo-governance> ;
    owl:versionInfo "0.10.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- governing body
crgo:CRGO_0000478 a owl:Class ;
    rdfs:label "governing body"@en,
        "organe de gouvernance"@fr ;
    rdfs:subClassOf cco:ont00000300 ;
    owl:disjointWith crgo:CRGO_0000479 ;
    skos:altLabel "board"@en,
        "conseil d'administration"@fr ;
    skos:definition "A group of persons with ultimate accountability for directing and overseeing an organisation, such as a board of directors or a board of trustees."@en,
        "Groupe de personnes ayant la responsabilité ultime de diriger et de surveiller une organisation, comme un conseil d'administration ou un conseil des fiduciaires."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 4; GIAS Domain III (Governing the Internal Audit Function) addresses the board."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- policy
crgo:CRGO_0000497 a owl:Class ;
    rdfs:label "policy"@en,
        "politique"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive approved by an organisation's governing body or senior management that states its intentions and rules for a domain, such as information security or privacy."@en,
        "Directive approuvée par l'organe de gouvernance ou la haute direction d'une organisation qui énonce ses intentions et ses règles pour un domaine, comme la sécurité de l'information ou la protection des renseignements personnels."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D01; ISO 37301:2021 clause 5.2 (compliance policy)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en,
        "ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 1"@en .

# --- technical standard
crgo:CRGO_0000499 a owl:Class ;
    rdfs:label "technical standard"@en,
        "norme technique interne"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "An internal directive that specifies mandatory technical requirements implementing one or more policy statements, such as a password or encryption standard."@en,
        "Directive interne précisant les exigences techniques obligatoires qui mettent en œuvre un ou plusieurs énoncés de politique, comme une norme de mots de passe ou de chiffrement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D01. Not an external standard such as ISO/IEC 27002, which is a framework."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;

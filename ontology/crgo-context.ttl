    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- confidentiality horizon (years)
crgo:CRGO_0001553 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "confidentiality horizon (years)"@en,
        "durée de confidentialité (années)"@fr ;
    rdfs:domain crgo:CRGO_0001331 ;
    rdfs:range xsd:nonNegativeInteger ;

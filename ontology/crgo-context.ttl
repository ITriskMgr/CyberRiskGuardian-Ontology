# --- generative AI application
crgo:CRGO_0001327 a owl:Class ;
    rdfs:label "generative AI application"@en,
        "application d'IA générative"@fr ;
    rdfs:subClassOf crgo:CRGO_0001326 ;
    skos:altLabel "LLM application"@en,
        "application de grand modèle de langage"@fr ;
    skos:definition "An AI system that produces text, code, images or other content from prompts, usually through a large language model."@en,
        "Système d'IA qui produit du texte, du code, des images ou d'autres contenus à partir d'invites, généralement au moyen d'un grand modèle de langage."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "OWASP Top 10 for LLM Applications 2025 (OWASP GenAI Security Project, November 2024); identifiers cited, labels are CRGO paraphrases"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- digital certificate
crgo:CRGO_0001330 a owl:Class ;
    rdfs:label "digital certificate"@en,
        "certificat numérique"@fr ;
    rdfs:subClassOf crgo:CRGO_0000002 ;
    skos:altLabel "public-key certificate"@en,
        "certificat à clé publique"@fr ;
    skos:definition "An asset that is a public-key certificate binding a public key to a subject, issued by a certification authority for a validity period; services that rely on it fail or warn when it expires unless it is renewed in time."@en,
        "Actif qui est un certificat à clé publique liant une clé publique à un sujet, émis par une autorité de certification pour une période de validité; les services qui en dépendent échouent ou avertissent à son expiration s'il n'est pas renouvelé à temps."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "The validity end is given by 'valid until'; services that rely on the certificate use 'relies on asset'."@en ;
    crgo:CRGO_0000286 "CA/Browser Forum Ballot SC-081v3 (2025): staged reduction of the maximum validity of publicly trusted TLS certificates (cited)"@en,
        "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- harvest now, decrypt later
crgo:CRGO_0001389 a owl:NamedIndividual,
        crgo:CRGO_0001387 ;
    rdfs:label "harvest now, decrypt later"@en,
        "récolter maintenant, déchiffrer plus tard"@fr ;
    skos:definition "An adversary stores encrypted data today to decrypt it once quantum computers can break the public-key algorithms that protect it; at risk is data that must stay confidential for many years."@en,
        "Un adversaire conserve aujourd'hui des données chiffrées pour les déchiffrer lorsque des ordinateurs quantiques pourront casser les algorithmes à clé publique qui les protègent; sont visées les données qui doivent rester confidentielles pendant de nombreuses années."@fr ;
    skos:inScheme crgo:CRGO_0001388 ;
    skos:notation "1" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- crypto-agility failure
crgo:CRGO_0001390 a owl:NamedIndividual,
        crgo:CRGO_0001387 ;
    rdfs:label "crypto-agility failure"@en,
        "défaut d'agilité cryptographique"@fr ;
    skos:definition "The organisation cannot replace a weak or deprecated algorithm, protocol or key in time because it does not know where it is used or its systems cannot change it."@en,
        "L'organisation ne peut remplacer à temps un algorithme, un protocole ou une clé faibles ou dépréciés parce qu'elle ignore où ils sont utilisés ou que ses systèmes ne permettent pas de les changer."@fr ;
    skos:inScheme crgo:CRGO_0001388 ;
    skos:notation "2" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- certificate expiry outage
crgo:CRGO_0001391 a owl:NamedIndividual,
        crgo:CRGO_0001387 ;
    rdfs:label "certificate expiry outage"@en,
        "panne due à l'expiration d'un certificat"@fr ;
    skos:definition "A service fails or becomes untrusted because a certificate it relies on expired without being renewed, a risk that grows as maximum certificate lifetimes shorten."@en,
        "Un service tombe en panne ou n'est plus reconnu comme fiable parce qu'un certificat dont il dépend a expiré sans être renouvelé, un risque qui croît à mesure que la durée maximale des certificats diminue."@fr ;
    skos:inScheme crgo:CRGO_0001388 ;
    skos:notation "3" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- agentic AI misuse
crgo:CRGO_0001392 a owl:NamedIndividual,
        crgo:CRGO_0001387 ;
    rdfs:label "agentic AI misuse"@en,
        "utilisation abusive d'IA agentique"@fr ;
    skos:definition "An AI agent's tools, credentials or delegated authority are used beyond their purpose, by manipulation, error or compromise, to read, change or send data or trigger actions."@en,
        "Les outils, les identifiants ou l'autorité déléguée d'un agent d'IA sont utilisés au-delà de leur finalité, par manipulation, erreur ou compromission, pour lire, modifier ou transmettre des données ou déclencher des actions."@fr ;
    skos:inScheme crgo:CRGO_0001388 ;
    skos:notation "4" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- prompt injection in agent workflows
crgo:CRGO_0001393 a owl:NamedIndividual,
        crgo:CRGO_0001387 ;
    rdfs:label "prompt injection in agent workflows"@en,
        "injection d'invite dans des flux d'agents"@fr ;
    skos:definition "Instructions hidden in content that an AI system reads, such as a web page, document, e-mail or tool output, override its intended instructions and redirect its actions."@en,
        "Des instructions dissimulées dans un contenu que lit un système d'IA, comme une page Web, un document, un courriel ou la sortie d'un outil, supplantent ses instructions prévues et détournent ses actions."@fr ;
    skos:inScheme crgo:CRGO_0001388 ;
    skos:notation "5" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- AI supply chain compromise
crgo:CRGO_0001394 a owl:NamedIndividual,
        crgo:CRGO_0001387 ;
    rdfs:label "AI supply chain compromise"@en,
        "compromission de la chaîne d'approvisionnement de l'IA"@fr ;
    skos:definition "A model, dataset, plug-in, tool or agent component obtained from a third party is malicious, poisoned or vulnerable, and the organisation's AI systems inherit the flaw."@en,
        "Un modèle, un jeu de données, un module d'extension, un outil ou un composant d'agent obtenu d'un tiers est malveillant, empoisonné ou vulnérable, et les systèmes d'IA de l'organisation en héritent."@fr ;
    skos:inScheme crgo:CRGO_0001388 ;
    skos:notation "6" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

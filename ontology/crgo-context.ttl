    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Range left open: the values are the concepts of vocab/csf2 (GV, ID, PR, DE, RS, RC)."@en ;
    crgo:CRGO_0000286 "CIS Critical Security Controls v8.1 (Center for Internet Security, June 2024), https://www.cisecurity.org/controls/v8-1; identifiers, Implementation Groups, asset types and security functions cited as facts; labels are CRGO paraphrases; CC BY-NC-ND 4.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

crgo:crgo-context a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model with the risk indices computed from it, and key risk indicators for monitoring. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian avec les indices de risque qui en découlent, et indicateurs clés de risque pour la surveillance. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.11.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-11-02"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-11-02"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - technology and organisational context module"@en,
        "Ontologie CyberRiskGuardian - module du contexte technologique et organisationnel"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-grc ;
    owl:priorVersion <https://w3id.org/crgo/0.10.1/crgo-context> ;
    owl:versionIRI <https://w3id.org/crgo/0.11.0/crgo-context> ;
    owl:versionInfo "0.11.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- AI agent
crgo:CRGO_0001328 a owl:Class ;
    rdfs:label "AI agent"@en,
        "agent d'IA"@fr ;
    rdfs:subClassOf crgo:CRGO_0001326 ;
    skos:altLabel "agentic AI system"@en,
        "système d'IA agentique"@fr ;
    skos:definition "An AI system that plans and carries out several steps towards a goal by calling tools, other agents or services with credentials or authority delegated to it, with little or no human intervention between steps."@en,
        "Système d'IA qui planifie et exécute plusieurs étapes vers un but en faisant appel à des outils, à d'autres agents ou à des services au moyen d'identifiants ou d'une autorité qui lui sont délégués, avec peu ou pas d'intervention humaine entre les étapes."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "An asset (the software), not a CCO agent: accountability stays with the organisation that operates it."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "OWASP Top 10 for Agentic Applications 2026 (OWASP GenAI Security Project, 2025-12-09); identifiers cited, labels are CRGO paraphrases"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- AI model artefact
crgo:CRGO_0001329 a owl:Class ;
    rdfs:label "AI model artefact"@en,
        "artefact de modèle d'IA"@fr ;
    rdfs:subClassOf crgo:CRGO_0000002 ;
    skos:altLabel "AI model artifact"@en ;
    skos:definition "An asset that is a trained model, its weights, adapters or configuration, or a dataset used to train or tune it, as obtained from a supplier or repository or produced by the organisation."@en,
        "Actif qui est un modèle entraîné, ses poids, adaptateurs ou paramètres, ou un jeu de données servant à l'entraîner ou à l'ajuster, tel qu'obtenu d'un fournisseur ou d'un dépôt ou produit par l'organisation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Carries the AI supply-chain scenario pattern: provenance and integrity of models and datasets."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "OWASP Top 10 for Agentic Applications 2026 (OWASP GenAI Security Project, 2025-12-09); identifiers cited, labels are CRGO paraphrases"@en,
        "OWASP Top 10 for LLM Applications 2025 (OWASP GenAI Security Project, November 2024); identifiers cited, labels are CRGO paraphrases"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- AI system
crgo:CRGO_0001326 a owl:Class ;
    rdfs:label "AI system"@en,
        "système d'IA"@fr ;
    rdfs:subClassOf crgo:CRGO_0000003 ;
    skos:altLabel "artificial intelligence system"@en,
        "système d'intelligence artificielle"@fr ;
    skos:definition "An asset that is a software system which, for given objectives, infers from its inputs how to produce outputs such as predictions, content, recommendations or decisions, together with the models, instructions, retrieval data and tools it relies on."@en,
        "Actif qui est un système logiciel qui, pour des objectifs donnés, déduit de ses entrées la façon de produire des sorties comme des prédictions, du contenu, des recommandations ou des décisions, avec les modèles, les instructions, les données de recherche et les outils sur lesquels il s'appuie."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CRGO wording; close in scope to the AI system of NIST AI 100-1 and ISO/IEC 42001, which are not quoted."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "ISO/IEC 42001:2023, Artificial intelligence: management system (identifier cited, no text reproduced)"@en,
        "NIST AI 100-1, Artificial Intelligence Risk Management Framework (AI RMF 1.0, January 2023) (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


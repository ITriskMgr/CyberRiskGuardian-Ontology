# --- quantum-vulnerable
crgo:CRGO_0001404 a owl:NamedIndividual,
        crgo:CRGO_0001402 ;
    rdfs:label "quantum-vulnerable"@en,
        "vulnérable aux attaques quantiques"@fr ;
    skos:definition "Public-key cryptography based on factoring or discrete logarithms, such as RSA, Diffie-Hellman or elliptic curves, which a quantum computer could break."@en,
        "Cryptographie à clé publique fondée sur la factorisation ou le logarithme discret, comme RSA, Diffie-Hellman ou les courbes elliptiques, qu'un ordinateur quantique pourrait casser."@fr ;
    skos:inScheme crgo:CRGO_0001403 ;
    skos:notation "1" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "NIST FIPS 203 (ML-KEM), FIPS 204 (ML-DSA) and FIPS 205 (SLH-DSA), August 2024; NIST IR 8547 (initial public draft, November 2024) on the transition to post-quantum cryptography (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- post-quantum
crgo:CRGO_0001405 a owl:NamedIndividual,
        crgo:CRGO_0001402 ;
    rdfs:label "post-quantum"@en,
        "post-quantique"@fr ;
    skos:definition "An algorithm standardised to resist quantum attack, such as ML-KEM, ML-DSA or SLH-DSA, or a hybrid that includes one."@en,
        "Algorithme normalisé pour résister aux attaques quantiques, comme ML-KEM, ML-DSA ou SLH-DSA, ou combinaison hybride qui en comprend un."@fr ;
    skos:inScheme crgo:CRGO_0001403 ;
    skos:notation "2" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "NIST FIPS 203 (ML-KEM), FIPS 204 (ML-DSA) and FIPS 205 (SLH-DSA), August 2024; NIST IR 8547 (initial public draft, November 2024) on the transition to post-quantum cryptography (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


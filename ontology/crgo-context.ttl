# --- designated operator (critical cyber systems)
crgo:CRGO_0001477 a owl:NamedIndividual,
        crgo:CRGO_0000355 ;
    rdfs:label "designated operator (critical cyber systems)"@en,
        "exploitant désigné (cybersystèmes essentiels)"@fr ;
    skos:definition "An operator designated under the federal Critical Cyber Systems Protection Act, in a class of operators carrying on a work, undertaking or business in a vital service or system it lists, such as telecommunications, interprovincial pipelines or power lines, nuclear energy, federally regulated transportation, banking, or clearing and settlement."@en,
        "Exploitant désigné en vertu de la loi fédérale sur la protection des cybersystèmes essentiels, dans une catégorie d'exploitants qui exploitent une entreprise ou une activité relevant d'un service ou d'un système critique qu'elle énumère, comme les télécommunications, les pipelines ou lignes électriques interprovinciaux, l'énergie nucléaire, le transport sous réglementation fédérale, les banques ou la compensation et le règlement."@fr ;
    skos:inScheme crgo:CRGO_0000356 ;
    skos:notation "6" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Critical Cyber Systems Protection Act, enacted by Bill C-8 (45th Parliament, 1st session); Royal Assent announced by Public Safety Canada on 2026-06-16; coming into force in phases (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


# --- cryptographic inventory entry
crgo:CRGO_0001331 a owl:Class ;
    rdfs:label "cryptographic inventory entry"@en,
        "entrée d'inventaire cryptographique"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "CBOM entry"@en,
        "cryptographic bill of materials entry"@en ;
    skos:definition "A description of where an asset uses a cryptographic algorithm, protocol or key, with its purpose, key length and quantum vulnerability, kept to plan the migration to post-quantum cryptography and to show crypto-agility."@en,
        "Description de l'endroit où un actif utilise un algorithme, un protocole ou une clé cryptographiques, avec sa finalité, la longueur de clé et la vulnérabilité quantique, tenue pour planifier la migration vers la cryptographie post-quantique et démontrer l'agilité cryptographique."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "NIST FIPS 203 (ML-KEM), FIPS 204 (ML-DSA) and FIPS 205 (SLH-DSA), August 2024; NIST IR 8547 (initial public draft, November 2024) on the transition to post-quantum cryptography (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


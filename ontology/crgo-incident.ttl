# --- breach reportability assessment
crgo:CRGO_0000553 a owl:Class ;
    rdfs:label "breach reportability assessment"@en,
        "évaluation du caractère déclarable d'un incident"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record of whether an incident must be reported to a regulator or to affected persons under a stated provision, such as a confidentiality incident presenting a risk of serious injury under Loi 25 or a personal data breach under the GDPR."@en,
        "Enregistrement daté indiquant si un incident doit être déclaré à une autorité ou aux personnes concernées en vertu d'une disposition donnée, comme un incident de confidentialité présentant un risque de préjudice sérieux selon la Loi 25 ou une violation de données à caractère personnel selon le RGPD."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D06 (reportable breach); Loi 25 s. 3.5; GDPR Arts. 33-34."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en,
        "Loi 25 (L.Q. 2021, c. 25); CAI guidance on confidentiality incidents"@en,
        "Regulation (EU) 2016/679, Arts. 3, 4, 24, 28, 30 (OJ L 119, 4.5.2016)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 4 (module kept)"@en .


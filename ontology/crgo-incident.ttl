crgo:crgo-incident a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model with the risk indices computed from it, and key risk indicators for monitoring. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian avec les indices de risque qui en découlent, et indicateurs clés de risque pour la surveillance. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.10.1. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-23"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-23"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - security events and incidents module"@en,
        "Ontologie CyberRiskGuardian - module des événements et incidents de sécurité"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-evidence ;
    owl:priorVersion <https://w3id.org/crgo/0.10.0/crgo-incident> ;
    owl:versionIRI <https://w3id.org/crgo/0.10.1/crgo-incident> ;
    owl:versionInfo "0.10.1" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- security event
crgo:CRGO_0000550 a owl:Class ;
    rdfs:label "security event"@en,
        "événement de sécurité"@fr ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "An observable occurrence in an information system or network that may be relevant to security, such as a failed login or a malware detection. An event can be part of an incident; most events are not."@en,
        "Occurrence observable dans un système d'information ou un réseau qui peut intéresser la sécurité, comme un échec d'ouverture de session ou une détection de logiciel malveillant. Un événement peut faire partie d'un incident; la plupart n'en font pas partie."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D06. Not disjoint from incident: an incident consists of one or more events (independent review, 2026-10-11)."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 4 (module kept)"@en .

# --- security alert
crgo:CRGO_0000551 a owl:Class ;
    rdfs:label "security alert"@en,
        "alerte de sécurité"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A notification, generated by a monitoring tool or a person, that one or more security events may indicate an incident and need triage."@en,
        "Notification, produite par un outil de surveillance ou une personne, indiquant qu'un ou plusieurs événements de sécurité pourraient signaler un incident et doivent être triés."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D06."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 4 (module kept)"@en .

# --- lesson learned
crgo:CRGO_0000555 a owl:Class ;
    rdfs:label "lesson learned"@en,
        "leçon apprise"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A record of what an incident or exercise showed should change, such as a control, procedure or scenario estimate."@en,
        "Enregistrement de ce qu'un incident ou un exercice a montré devoir changer, comme une mesure, une procédure ou l'estimation d'un scénario."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 4 (module kept)"@en .

# --- incident confirmation
crgo:CRGO_0000552 a owl:Class ;
    rdfs:label "incident confirmation"@en,
        "confirmation d'incident"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record, made by an identified agent, that an incident has occurred, citing the alerts or events it is based on."@en,
        "Enregistrement daté, établi par un agent identifié, indiquant qu'un incident s'est produit, en citant les alertes ou événements sur lesquels il s'appuie."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GAPS D06 (confirmed incident versus event). Modelled as a record because being confirmed is a status, not a kind of incident."@en ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" ;
    crgo:CRGO_0000292 "GRCA review item 4 (module kept)"@en .

# --- incident timeline entry
crgo:CRGO_0000554 a owl:Class ;
    rdfs:label "incident timeline entry"@en,
        "entrée de chronologie d'incident"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated entry in the timeline of an incident, recording what happened or was done and in which response phase."@en,
        "Entrée datée de la chronologie d'un incident, indiquant ce qui s'est passé ou a été fait et dans quelle phase de réponse."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO Knowledge Expansion: Remaining GRC, Cybersecurity and Operational Knowledge Domains (project owner, draft v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

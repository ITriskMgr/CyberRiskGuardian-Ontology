# --- answers deadline
crgo:CRGO_0001095 a owl:ObjectProperty ;
    rdfs:label "answers deadline"@en,
        "répond à l'échéance"@fr ;
    rdfs:domain crgo:CRGO_0000902 ;
    rdfs:range crgo:CRGO_0000901 ;
    skos:definition "Relates a regulatory submission to the compliance deadline it answers. Whether it was on time is computed from the dates, not stated."@en,
        "Relie une transmission réglementaire à l'échéance de conformité à laquelle elle répond. Le respect du délai se calcule à partir des dates; il n'est pas affirmé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;

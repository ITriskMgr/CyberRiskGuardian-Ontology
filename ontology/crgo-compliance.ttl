    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- fact relied on
crgo:CRGO_0001082 a owl:DatatypeProperty ;
    rdfs:label "fact relied on"@en,
        "fait retenu"@fr ;
    rdfs:domain crgo:CRGO_0000345 ;
    skos:definition "States a fact about the organisation that an applicability assessment relied on."@en,

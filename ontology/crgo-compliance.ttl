        "transmission réglementaire"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "regulatory filing"@en,
        "déclaration à l'autorité"@fr ;
    skos:definition "A record of a notice, filing or report sent to an authority under an obligation, with when it was submitted, its state and the receipt or acknowledgement obtained."@en,
        "Enregistrement d'un avis, d'un dépôt ou d'un rapport transmis à une autorité en vertu d'une obligation, avec sa date de transmission, son état et l'accusé de réception obtenu."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP section 4 (RegulatorySubmission); links to breach reportability assessments for incident notices."@en ;

crgo:CRGO_0001035 a owl:ObjectProperty ;
    rdfs:label "has deadline trigger kind"@en,
        "a pour type de déclenchement"@fr ;
    rdfs:domain crgo:CRGO_0000901 ;
    rdfs:range crgo:CRGO_0000947 ;
    skos:definition "Gives whether a compliance deadline is a calendar date or counted from an event."@en,

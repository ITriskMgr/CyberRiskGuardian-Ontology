# --- compliance deadline
crgo:CRGO_0000901 a owl:Class ;
    rdfs:label "compliance deadline"@en,
        "échéance de conformité"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A record of when an obligation must be met, either on a calendar date or within a period counted from a triggering event, such as 72 hours after becoming aware of a breach, with how the date is computed."@en,
        "Enregistrement du moment où une obligation doit être respectée, soit à une date fixe, soit dans un délai compté à partir d'un événement déclencheur, comme 72 heures après la prise de connaissance d'une atteinte, avec le mode de calcul de la date."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP sections 4 and 8; generalises the incident-specific 'notification due by'."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


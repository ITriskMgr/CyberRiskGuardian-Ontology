crgo:crgo-compliance a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.10.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - compliance management module"@en,
        "Ontologie CyberRiskGuardian - module de gestion de la conformité"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-grc,
        crgo:crgo-policy ;
    owl:priorVersion <https://w3id.org/crgo/0.9.0/crgo-compliance> ;
    owl:versionIRI <https://w3id.org/crgo/0.10.0/crgo-compliance> ;
    owl:versionInfo "0.10.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- compliance objective
crgo:CRGO_0000895 a owl:Class ;
    rdfs:label "compliance objective"@en,
        "objectif de conformité"@fr ;
    rdfs:subClassOf crgo:CRGO_0000010 ;
    skos:definition "A measurable objective that a compliance programme sets itself, such as reviewing every obligation of the register once a year."@en,
        "Objectif mesurable que se fixe un programme de conformité, comme revoir chaque obligation du registre une fois par année."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP section 4; ISO 37301:2021 clause 6.2."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- compliance assessment campaign
crgo:CRGO_0000899 a owl:Class ;
    rdfs:label "compliance assessment campaign"@en,
        "campagne d'évaluation de la conformité"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A planned act in which an organisation assesses compliance with a stated set of obligations or requirements, for a stated scope, period and method, producing compliance determinations."@en,
        "Acte planifié par lequel une organisation évalue sa conformité à un ensemble précisé d'obligations ou d'exigences, pour un périmètre, une période et une méthode donnés, et qui produit des constats de conformité."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP section 4 (ComplianceAssessment as a campaign); conflict C3: the per-requirement result stays the compliance determination."@en ;
    crgo:CRGO_0000286 "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"@en,
        "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- issued by authority
crgo:CRGO_0001027 a owl:ObjectProperty ;
    rdfs:label "issued by authority"@en,
        "émis par l'autorité"@fr ;
    rdfs:range crgo:CRGO_0000897 ;
    skos:definition "Relates a legal instrument, guidance or exemption to the regulatory authority that issued it."@en,
        "Relie un instrument juridique, une orientation ou une dispense à l'autorité de réglementation qui l'a émis."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- compliance programme
crgo:CRGO_0000894 a owl:Class ;
    rdfs:label "compliance programme"@en,
        "programme de conformité"@fr ;
    rdfs:subClassOf cco:ont00000974 ;
    skos:definition "The plan by which an organisation operates its compliance management system: its scope, the obligations and commitments it covers, its objectives, the roles involved and its review cycle."@en,
        "Plan par lequel une organisation exploite son système de management de la conformité : son périmètre, les obligations et engagements qu'il couvre, ses objectifs, les rôles en cause et son cycle de revue."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP section 4 (ComplianceProgram); ISO 37301:2021 clauses 4.3-4.4 and 6.2 (cited by number)."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "ISO 37301:2021, Compliance management systems: requirements with guidance for use (1st edition, 2021-04); clause identifiers cited"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- requirement interpretation
crgo:CRGO_0000896 a owl:Class ;
    rdfs:label "requirement interpretation"@en,
        "interprétation d'exigence"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A statement, subject to legal review, of how an organisation reads an obligation, provision or framework requirement for its own situation, with the assumptions made and its legal review state. It is the organisation's reading, not the text and not legal advice."@en,
        "Énoncé, soumis à une revue juridique, de la façon dont une organisation lit une obligation, une disposition ou une exigence de référentiel au regard de sa propre situation, avec les hypothèses retenues et l'état de sa revue juridique. C'est la lecture de l'organisation, et non le texte ni un avis juridique."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP sections 4 and 9 (privilege flag)."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- framework adoption
crgo:CRGO_0000898 a owl:Class ;
    rdfs:label "framework adoption"@en,
        "adoption de référentiel"@fr ;
    rdfs:subClassOf crgo:CRGO_0000504 ;
    skos:definition "A decision record by which an organisation has committed to meet a framework, or a stated part of it, for a stated scope, which makes its requirements commitments of that organisation. It records the commitment, not conformity."@en,
        "Relevé de décision par lequel une organisation s'engage à respecter un référentiel, ou une partie précisée de celui-ci, pour un périmètre donné, ce qui fait de ses exigences des engagements de cette organisation. Il consigne l'engagement, et non la conformité."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Improvement I4; CMP section 7 (source kind 'voluntary standard', 'internal commitment'). A decision record, so it reuses decided on, decision made by and decision outcome."@en ;
    crgo:CRGO_0000286 "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"@en,
        "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- deadline trigger kind scheme
crgo:CRGO_0000948 a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "deadline trigger kind scheme"@en,
        "schéma : type de déclenchement d'échéance"@fr ;
    skos:definition "Concept scheme of the deadline trigger kind value set."@en,
        "Schéma de concepts de l'ensemble de valeurs « type de déclenchement d'échéance »."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- regulatory exemption
crgo:CRGO_0000903 a owl:Class ;
    rdfs:label "regulatory exemption"@en,
        "dispense réglementaire"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:disjointWith crgo:CRGO_0000502 ;
    skos:definition "A directive issued by an authority that relieves an organisation, for a stated scope and period, from an obligation or part of it, on a stated legal basis. Only an authority with power over the obligation can grant it; an internal approval cannot."@en,
        "Directive émise par une autorité qui dispense une organisation, pour un périmètre et une période donnés, de tout ou partie d'une obligation, sur un fondement juridique précisé. Seule une autorité compétente à l'égard de l'obligation peut l'accorder; une approbation interne ne le peut pas."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP sections 4 and 9 (ComplianceException: internal approval does not remove a binding duty). Distinct from policy exception, which cannot waive law."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


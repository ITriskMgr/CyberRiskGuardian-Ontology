crgo:CRGO_0001073 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "legally privileged"@en,
        "protégé par le secret professionnel"@fr ;
    rdfs:range xsd:boolean ;
    skos:definition "States that a record contains or summarises legally privileged advice and must not be passed to general reasoning, reporting or AI services."@en,
        "Indique qu'un enregistrement contient ou résume un avis protégé par le secret professionnel et ne doit pas être transmis à des services généraux de raisonnement, de rapport ou d'IA."@fr ;

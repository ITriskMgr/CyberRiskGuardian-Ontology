crgo:CRGO_0000937 a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "legal review state scheme"@en,
        "schéma : état de la revue juridique"@fr ;
    skos:definition "Concept scheme of the legal review state value set."@en,
        "Schéma de concepts de l'ensemble de valeurs « état de la revue juridique »."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- regulatory authority
crgo:CRGO_0000897 a owl:Class ;
    rdfs:label "regulatory authority"@en,
        "autorité de réglementation"@fr ;
    rdfs:subClassOf cco:ont00001180 ;
    skos:altLabel "regulator"@en,
        "organisme de réglementation"@fr ;
    skos:definition "An organisation with legal power to issue, supervise or enforce legal instruments in a jurisdiction, such as a data protection authority."@en,
        "Organisation ayant le pouvoir légal d'édicter, de surveiller ou de faire appliquer des instruments juridiques dans une juridiction, comme une autorité de protection des données."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "CMP section 4 (RegulatoryAuthority). Until now CRGO recorded issuers only as text on source records."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- provision version
crgo:CRGO_0000900 a owl:Class ;
    rdfs:label "provision version"@en,
        "version de disposition"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A record of the wording of a provision as in force over a stated period, kept when an amendment changes that wording, so that earlier assessments can be reproduced against the text that applied then."@en,
        "Enregistrement du libellé d'une disposition tel qu'il était en vigueur pendant une période donnée, conservé lorsqu'une modification change ce libellé, afin que les évaluations antérieures puissent être reproduites au regard du texte alors applicable."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Decision D5 (a): versions stay at instrument level; a provision version is recorded only when an amendment changes the wording."@en ;
    crgo:CRGO_0000286 "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"@en,
        "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


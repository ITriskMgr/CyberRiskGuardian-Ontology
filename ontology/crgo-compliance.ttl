    rdfs:label "due offset (hours)"@en,
        "délai (heures)"@fr ;
    rdfs:domain crgo:CRGO_0000901 ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Gives the number of hours, counted from the triggering event, within which an event-triggered deadline falls."@en,
        "Indique le nombre d'heures, comptées à partir de l'événement déclencheur, dans lequel tombe une échéance déclenchée par un événement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Integer hours rather than xsd:duration, which is outside the OWL 2 datatype map (conflict C4); hours cover the 72-hour notices."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


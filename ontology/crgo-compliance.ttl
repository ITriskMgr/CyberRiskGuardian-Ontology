    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- deadline for
crgo:CRGO_0001034 a owl:ObjectProperty ;
    rdfs:label "deadline for"@en,
        "échéance de"@fr ;
    rdfs:domain crgo:CRGO_0000901 ;
    skos:definition "Relates a compliance deadline to the obligation or provision that sets it."@en,
        "Relie une échéance de conformité à l'obligation ou à la disposition qui la fixe."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


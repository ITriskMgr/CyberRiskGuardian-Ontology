crgo:CRGO_0001040 a owl:ObjectProperty ;
    rdfs:label "has submission state"@en,
        "a pour état de transmission"@fr ;
    rdfs:domain crgo:CRGO_0000902 ;
    rdfs:range crgo:CRGO_0000941 ;

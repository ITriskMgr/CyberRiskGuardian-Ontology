        "Indique la version des règles d'applicabilité utilisée par une évaluation de l'applicabilité, pour qu'elle puisse être reproduite."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

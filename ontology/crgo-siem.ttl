    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2; Sigma specification v2.1.0. The rule carries out a detective control measure (rule for measure); its effectiveness is shown by detection tests, never assumed."@en ;

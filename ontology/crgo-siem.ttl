# --- detection coverage
crgo:CRGO_0001106 a owl:Class ;
    rdfs:label "detection coverage"@en,
        "couverture de détection"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated statement that a detection strategy or rule covers a technique, a risk scenario or an asset, with its coverage status (untested, validated, degraded or missing) and the tests that support it. Coverage is a claim to be tested, not a guarantee of detection."@en,
        "Énoncé daté selon lequel une stratégie ou une règle de détection couvre une technique, un scénario de risque ou un actif, avec l'état de couverture (non testée, validée, dégradée ou absente) et les essais qui l'étayent. La couverture est une affirmation à vérifier, et non une garantie de détection."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM sections 2 and 5 (coverage needs a rule or strategy, a scenario or technique, and validation metadata)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .


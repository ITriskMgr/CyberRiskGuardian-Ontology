    crgo:CRGO_0000285 "SIEM section 4 (confidence includes its definition and source)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- confidence method
crgo:CRGO_0001311 a owl:DatatypeProperty ;
    rdfs:label "confidence method"@en,
        "méthode de confiance"@fr ;
    skos:definition "States how a stated confidence is defined and on which scale, such as 'STIX 2.1 confidence, 0-100'."@en,
        "Indique comment une confiance indiquée est définie et selon quelle échelle, comme « confiance STIX 2.1, de 0 à 100 »."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- reference version
crgo:CRGO_0001324 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reference version"@en,
        "version de référence"@fr ;
    rdfs:range xsd:string ;
    skos:definition "Gives the version of the reference vocabulary, such as ATT&CK, that a detection strategy or rule was mapped against, so that historical alerts can be read against it."@en,
        "Indique la version du vocabulaire de référence, comme ATT&CK, selon laquelle une stratégie ou une règle de détection a été mise en correspondance, afin que les alertes passées puissent être lues en conséquence."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 5 (temporal snapshots: historical queries reproduce the ATT&CK version)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "MITRE ATT&CK Enterprise 19.2: detection strategies, analytics and data components (STIX bundle enterprise-attack.json)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

crgo:crgo-siem a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.10.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-13"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - security monitoring and detection (SIEM) module"@en,
        "Ontologie CyberRiskGuardian - module de surveillance et de détection de sécurité (SIEM)"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-grc,
        crgo:crgo-incident ;
    owl:priorVersion <https://w3id.org/crgo/0.9.0/crgo-siem> ;
    owl:versionIRI <https://w3id.org/crgo/0.10.0/crgo-siem> ;
    owl:versionInfo "0.10.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- normalisation profile
crgo:CRGO_0001099 a owl:Class ;
    rdfs:label "normalisation profile"@en,
        "profil de normalisation"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "normalization profile"@en ;
    skos:definition "A versioned specification of how the fields of a telemetry source are mapped to a common event schema, such as an OCSF event class, so that events from different sources can be compared."@en,
        "Spécification versionnée de la façon dont les champs d'une source de télémétrie sont mis en correspondance avec un schéma d'événements commun, comme une classe d'événements OCSF, afin que les événements de sources différentes puissent être comparés."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2; OCSF 1.9.0. Mapping to an OCSF class is a correspondence, not an equivalence of taxonomies (SIEM section 5)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "Open Cybersecurity Schema Framework (OCSF) 1.9.0, categories and event classes (github.com/ocsf/ocsf-schema, Apache-2.0)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- parser definition
crgo:CRGO_0001100 a owl:Class ;
    rdfs:label "parser definition"@en,
        "définition d'analyseur"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "parser"@en,
        "analyseur syntaxique"@fr ;
    skos:definition "A versioned specification of how raw records of a telemetry source are converted into structured events under a normalisation profile."@en,
        "Spécification versionnée de la façon dont les enregistrements bruts d'une source de télémétrie sont convertis en événements structurés selon un profil de normalisation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (ParserDefinition)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- threat intelligence source
crgo:CRGO_0001105 a owl:Class ;
    rdfs:label "threat intelligence source"@en,
        "source de renseignement sur les menaces"@fr ;
    rdfs:subClassOf crgo:CRGO_0000337 ;
    skos:definition "A source record for a provider or feed of threat intelligence, with its licence, its sharing marking and the reliability the organisation gives it."@en,
        "Notice de source d'un fournisseur ou d'un flux de renseignement sur les menaces, avec sa licence, son marquage de partage et la fiabilité que lui accorde l'organisation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (ThreatIntelligenceSource); reuses source record (licence, version, retrieval)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "FIRST Traffic Light Protocol (TLP) 2.0 (authoritative from August 2022)"@en,
        "OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- behavioural baseline
crgo:CRGO_0001111 a owl:Class ;
    rdfs:label "behavioural baseline"@en,
        "référence comportementale"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "behavioral baseline"@en ;
    skos:definition "A description of the usual behaviour of a user, account, host or service over a stated period, against which deviations are measured. CRGO holds its metadata, not the profile data."@en,
        "Description du comportement habituel d'un utilisateur, d'un compte, d'un hôte ou d'un service pendant une période donnée, à partir de laquelle les écarts sont mesurés. CRGO en conserve les métadonnées, et non les données du profil."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (BehavioralBaseline)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- detection gap
crgo:CRGO_0001107 a owl:Class ;
    rdfs:label "detection gap"@en,
        "lacune de détection"@fr ;
    rdfs:subClassOf crgo:CRGO_0000018 ;
    skos:definition "A control gap finding that a technique, risk scenario or asset has no adequate detection, or that the telemetry a detection needs is missing or unhealthy."@en,
        "Constat de lacune de contrôle selon lequel une technique, un scénario de risque ou un actif n'est pas adéquatement détecté, ou selon lequel la télémétrie nécessaire à une détection est absente ou défaillante."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (DetectionGap). Reuses control gap finding and 'has control gap' (decision S3)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- detection test
crgo:CRGO_0001108 a owl:Class ;
    rdfs:label "detection test"@en,
        "essai de détection"@fr ;
    rdfs:subClassOf crgo:CRGO_0000347 ;
    skos:definition "A control assessment in which a detection rule or strategy is exercised under controlled conditions, such as by replaying or simulating the technique, to check that it raises the expected alert."@en,
        "Évaluation de mesure dans laquelle une règle ou une stratégie de détection est mise à l'épreuve dans des conditions contrôlées, par exemple en rejouant ou en simulant la technique, pour vérifier qu'elle déclenche l'alerte attendue."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (DetectionTest). Reuses control assessment: test result, assessor, date and evidence (decision S3). It tests one rule or strategy, not the whole control measure: consumers that report a measure's effectiveness leave detection tests out."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- telemetry health observation
crgo:CRGO_0001109 a owl:Class ;
    rdfs:label "telemetry health observation"@en,
        "observation de l'état de la télémétrie"@fr ;
    rdfs:subClassOf crgo:CRGO_0000338 ;
    skos:definition "An observation of whether a telemetry source was delivering the expected data at a stated time, such as healthy, degraded or silent."@en,
        "Observation indiquant si une source de télémétrie transmettait les données attendues à un moment donné, par exemple en bon état, dégradée ou silencieuse."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (TelemetryHealthObservation)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- security event record
crgo:CRGO_0001098 a owl:Class ;
    rdfs:label "security event record"@en,
        "enregistrement d'événement de sécurité"@fr ;
    rdfs:subClassOf crgo:CRGO_0000338 ;
    owl:disjointWith crgo:CRGO_0001109 ;
    skos:definition "An observation that points to one security event held in an operational store, with the source that emitted it, when it occurred and was recorded, and the profile it was normalised under. It does not carry the event payload."@en,
        "Observation qui renvoie à un événement de sécurité conservé dans un dépôt opérationnel, avec la source qui l'a émis, le moment où il s'est produit et a été enregistré, et le profil selon lequel il a été normalisé. Elle ne contient pas le contenu de l'événement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (SecurityEventReference). The event itself is the existing security event (a process); this is the record of it."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- detection strategy
crgo:CRGO_0001101 a owl:Class ;
    rdfs:label "detection strategy"@en,
        "stratégie de détection"@fr ;
    rdfs:subClassOf cco:ont00000974 ;
    skos:definition "An organisation's documented approach to detecting a technique or behaviour, stating what to look for, in which data, and which analytics and rules carry it out; it may adapt a reference strategy such as an ATT&CK detection strategy."@en,
        "Approche documentée d'une organisation pour détecter une technique ou un comportement, qui précise ce qu'il faut rechercher, dans quelles données, et quelles analyses et règles la mettent en œuvre; elle peut adapter une stratégie de référence comme une stratégie de détection ATT&CK."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2. ATT&CK detection strategies and analytics are reference concepts in vocab/attack-detection; this class is the organisation's own (decision S4)."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "MITRE ATT&CK Enterprise 19.2: detection strategies, analytics and data components (STIX bundle enterprise-attack.json)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- telemetry source
crgo:CRGO_0001097 a owl:Class ;
    rdfs:label "telemetry source"@en,
        "source de télémétrie"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "log source"@en,
        "source de journaux"@fr ;
    skos:definition "A description of a product, service or device configured to send security logs or events to an organisation's monitoring, with the asset it runs on, the kinds of data it sends and how they are collected."@en,
        "Description d'un produit, d'un service ou d'un appareil configuré pour transmettre des journaux ou des événements de sécurité à la surveillance d'une organisation, avec l'actif sur lequel il fonctionne, les types de données qu'il transmet et leur mode de collecte."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM section 2 (TelemetrySource). A record about the source, not the asset itself, so that a log-producing asset is not reclassified."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "MITRE ATT&CK Enterprise 19.2: detection strategies, analytics and data components (STIX bundle enterprise-attack.json)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .

# --- threat indicator
crgo:CRGO_0001104 a owl:Class ;
    rdfs:label "threat indicator"@en,
        "indicateur de menace"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000552 ;
    skos:altLabel "indicator of compromise"@en,
        "indicateur de compromission"@fr ;
    skos:definition "A description of a pattern, such as a file hash, address, domain or behaviour, that a source states may indicate malicious activity, with its validity period, its confidence as given by the source and how that confidence is defined. A match with an indicator is not by itself an incident or an attribution."@en,
        "Description d'un motif, comme une empreinte de fichier, une adresse, un domaine ou un comportement, qu'une source présente comme pouvant indiquer une activité malveillante, avec sa période de validité, la confiance indiquée par la source et la définition de cette confiance. Une correspondance avec un indicateur ne constitue pas à elle seule un incident ni une attribution."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "SIEM sections 1 and 2 (no confirmation or attribution from an indicator match); STIX 2.1 indicator."@en ;
    crgo:CRGO_0000286 "CRGO SIEM Ontology Extension Specification v1.0 (project owner, 2026-10-12)"@en,
        "OASIS STIX Version 2.1 (with Errata 01, 2025-04-02): indicator, confidence 0-100"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0000292 "0.10.0 final review group 1 (\"go ahead\", 02:42)"@en .


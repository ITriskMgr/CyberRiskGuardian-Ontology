# --- attestation
crgo:CRGO_0000891 a owl:Class ;
    rdfs:label "attestation"@en,
        "attestation"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000346 ;
    skos:definition "A dated declaration by an identified agent about a stated subject and scope, such as having read a policy version or that a requirement is met. It records what the agent declares, not what was verified."@en,
        "Déclaration datée d'un agent identifié portant sur un objet et un périmètre précisés, comme le fait d'avoir lu une version de politique ou le fait qu'une exigence soit respectée. Elle consigne ce que l'agent déclare, et non ce qui a été vérifié."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Improvement I2: common parent of policy acknowledgement and compliance attestation; disjoint from compliance determination and audit conclusion."@en ;
    crgo:CRGO_0000286 "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"@en,
        "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- directive version
crgo:CRGO_0000886 a owl:Class ;
    rdfs:label "directive version"@en,
        "version de directive"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:disjointWith crgo:CRGO_0000507 ;
    skos:definition "A fixed release of a policy, technical standard, procedure, guideline, audit charter or methodology, identified by a version label, with its approval, effective and retirement dates. Once effective its content does not change; a change makes a new version."@en,
        "Diffusion figée d'une politique, d'une norme technique, d'une procédure, d'une ligne directrice, d'une charte ou d'une méthodologie d'audit, désignée par un libellé de version, avec ses dates d'approbation, d'entrée en vigueur et de retrait. Une fois en vigueur, son contenu ne change plus; toute modification crée une nouvelle version."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Decision D4: one version class for all directives (POL PolicyVersion generalised). Distinct from instrument version, which is a version of a legal instrument."@en ;
    crgo:CRGO_0000286 "CRGO 0.10.0 Phase 0 analysis and decisions D1-D14 (docs/baseline/policy_compliance_audit_phase0.md, approved 2026-10-12)"@en,
        "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


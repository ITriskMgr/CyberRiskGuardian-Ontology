crgo:CRGO_0001011 a owl:ObjectProperty ;
    rdfs:label "has normative modality"@en,
        "a pour modalité normative"@fr ;
    rdfs:domain crgo:CRGO_0000498 ;
    rdfs:range crgo:CRGO_0000913 ;
    skos:definition "Gives how binding a policy statement is."@en,
        "Indique le degré de contrainte d'un énoncé de politique."@fr ;
    skos:scopeNote "At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL."@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- has lifecycle state
crgo:CRGO_0001012 a owl:ObjectProperty ;
    rdfs:label "has lifecycle state"@en,
        "a pour état de cycle de vie"@fr ;
    rdfs:domain crgo:CRGO_0000886 ;
    rdfs:range crgo:CRGO_0000919 ;
    skos:definition "Gives the lifecycle state of a directive version, as last recorded."@en,
        "Indique l'état du cycle de vie d'une version de directive, selon le dernier enregistrement."@fr ;
    skos:scopeNote "At most one value per subject; enforced by SHACL (Phase 4), not by an OWL functional axiom, to keep the module in OWL 2 EL."@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- statement implemented by
crgo:CRGO_0001013 a owl:ObjectProperty ;
    rdfs:label "statement implemented by"@en,
        "énoncé appliqué par"@fr ;
    rdfs:domain crgo:CRGO_0000498 ;
    rdfs:range crgo:CRGO_0000020 ;
    skos:definition "Relates a policy statement to a control measure the organisation relies on to meet it. Implementation is not evidence that the measure is effective."@en,
        "Relie un énoncé de politique à une mesure appliquée sur laquelle l'organisation s'appuie pour le respecter. L'application ne prouve pas que la mesure est efficace."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Conflict C7: separate from 'implemented by procedure'."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- intended to mitigate
crgo:CRGO_0001014 a owl:ObjectProperty ;
    rdfs:label "intended to mitigate"@en,
        "vise à atténuer"@fr ;
    rdfs:domain crgo:CRGO_0000498 ;
    rdfs:range crgo:CRGO_0000023 ;
    skos:definition "Relates a policy statement to a risk scenario it is meant to reduce. States intent only; it does not say that the risk is reduced."@en,
        "Relie un énoncé de politique à un scénario de risque qu'il vise à réduire. N'indique que l'intention; il n'affirme pas que le risque est réduit."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Conflict C6: deliberately not a sub-property of 'mitigated by'."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- applies to scope
crgo:CRGO_0001015 a owl:ObjectProperty ;
    rdfs:label "applies to scope"@en,
        "s'applique au périmètre"@fr ;
    skos:definition "Relates a policy statement, guideline or directive to an asset, process, role, organisational unit or jurisdiction it explicitly applies to."@en,
        "Relie un énoncé de politique, une ligne directrice ou une directive à un actif, un processus, un rôle, une unité organisationnelle ou une juridiction auquel il s'applique explicitement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL scopedToAsset generalised. Conditional applicability goes through applicability conditions."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- requires training
crgo:CRGO_0001016 a owl:ObjectProperty ;
    rdfs:label "requires training"@en,
        "exige la formation"@fr ;
    rdfs:domain crgo:CRGO_0000498 ;
    rdfs:range crgo:CRGO_0000893 ;
    skos:definition "Relates a policy statement to a training requirement for those it applies to."@en,
        "Relie un énoncé de politique à une exigence de formation pour les personnes visées."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- authorised by risk acceptance
crgo:CRGO_0001017 a owl:ObjectProperty ;
    rdfs:label "authorised by risk acceptance"@en,
        "autorisée par l'acceptation du risque"@fr ;
    rdfs:domain crgo:CRGO_0000502 ;
    rdfs:range crgo:CRGO_0000031 ;
    skos:definition "Relates a policy exception to the risk acceptance decision that accepts the risk it leaves. A policy exception does not imply a risk acceptance; the link is stated when one was made."@en,
        "Relie une dérogation à la décision d'acceptation du risque qui accepte le risque qu'elle laisse subsister. Une dérogation n'implique pas une acceptation du risque; le lien est indiqué lorsqu'il y en a une."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL section 7 (no implied risk acceptance)."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- review of
crgo:CRGO_0001018 a owl:ObjectProperty ;
    rdfs:label "review of"@en,
        "revue de"@fr ;
    rdfs:domain crgo:CRGO_0000890 ;
    skos:definition "Relates a directive review to the directive, directive version or policy statement reviewed."@en,
        "Relie une revue de directive à la directive, la version de directive ou l'énoncé de politique revu."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- has review trigger
crgo:CRGO_0001019 a owl:ObjectProperty ;
    rdfs:label "has review trigger"@en,
        "a pour déclencheur de revue"@fr ;
    rdfs:domain crgo:CRGO_0000890 ;
    rdfs:range crgo:CRGO_0000927 ;
    skos:definition "Gives what caused a directive review."@en,
        "Indique ce qui a provoqué une revue de directive."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- review triggered by
crgo:CRGO_0001020 a owl:ObjectProperty ;
    rdfs:label "review triggered by"@en,
        "revue déclenchée par"@fr ;
    rdfs:domain crgo:CRGO_0000890 ;
    skos:definition "Relates a directive review to the regulatory change, incident, finding or other record that caused it."@en,
        "Relie une revue de directive au changement réglementaire, à l'incident, à la constatation ou à tout autre enregistrement qui l'a provoquée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL raisedBy (PolicyChangeEvent)."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- attested by
crgo:CRGO_0001021 a owl:ObjectProperty ;
    rdfs:label "attested by"@en,
        "attestée par"@fr ;
    rdfs:domain crgo:CRGO_0000891 ;
    skos:definition "Relates an attestation to the agent who made it."@en,
        "Relie une attestation à l'agent qui l'a faite."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Not functional: an attestation may have joint signatories."@en ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- attestation about
crgo:CRGO_0001022 a owl:ObjectProperty ;
    rdfs:label "attestation about"@en,
        "attestation portant sur"@fr ;
    rdfs:domain crgo:CRGO_0000891 ;
    skos:definition "Relates an attestation to what it declares about, such as an exact policy version or a set of obligations."@en,
        "Relie une attestation à ce sur quoi porte la déclaration, comme une version précise de politique ou un ensemble d'obligations."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- statement text
crgo:CRGO_0001066 a owl:DatatypeProperty ;
    rdfs:label "statement text"@en,
        "texte de l'énoncé"@fr ;
    rdfs:domain crgo:CRGO_0000498 ;
    skos:definition "Gives the wording of an organisation's own policy statement. Never used for the text of a licensed standard."@en,
        "Indique le libellé d'un énoncé de politique de l'organisation. N'est jamais utilisé pour le texte d'une norme sous licence."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Conflict C5; rule R-d."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- retired on
crgo:CRGO_0001067 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "retired on"@en,
        "retirée le"@fr ;
    rdfs:domain crgo:CRGO_0000886 ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives when a directive version ceased to be in effect."@en,
        "Indique quand une version de directive a cessé d'être en vigueur."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- review due on
crgo:CRGO_0001068 a owl:DatatypeProperty ;
    rdfs:label "review due on"@en,
        "revue due le"@fr ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the date by which a directive or directive version must next be reviewed, as last recorded."@en,
        "Indique la date à laquelle une directive ou une version de directive doit faire l'objet de sa prochaine revue, selon le dernier enregistrement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "xsd:dateTime rather than xsd:date (conflict C4, ADR-006). Not functional in OWL, so that a moved date does not make data inconsistent; the latest value is selected by queries."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en,
        "NIST SP 800-53 Rev. 5, control PL-1 (Policy and Procedures) and the -1 controls of each family"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- review interval (months)
crgo:CRGO_0001069 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "review interval (months)"@en,
        "intervalle de revue (mois)"@fr ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Gives the number of months between scheduled reviews of a directive."@en,
        "Indique le nombre de mois entre les revues planifiées d'une directive."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en,
        "NIST SP 800-53 Rev. 5, control PL-1 (Policy and Procedures) and the -1 controls of each family"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- attested on
crgo:CRGO_0001070 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "attested on"@en,
        "attestée le"@fr ;
    rdfs:domain crgo:CRGO_0000891 ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives when an attestation was made."@en,
        "Indique quand une attestation a été faite."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- attestation scope
crgo:CRGO_0001071 a owl:DatatypeProperty ;
    rdfs:label "attestation scope"@en,
        "périmètre de l'attestation"@fr ;
    rdfs:domain crgo:CRGO_0000891 ;
    skos:definition "States the scope and period an attestation covers and what it is based on."@en,
        "Indique le périmètre et la période que couvre une attestation et ce sur quoi elle se fonde."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "Compliance management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

crgo:crgo-policy a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.10.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - policy management module"@en,
        "Ontologie CyberRiskGuardian - module de gestion des politiques"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-governance,
        crgo:crgo-mapping ;
    owl:priorVersion <https://w3id.org/crgo/0.9.0/crgo-policy> ;
    owl:versionIRI <https://w3id.org/crgo/0.10.0/crgo-policy> ;
    owl:versionInfo "0.10.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- policy family
crgo:CRGO_0000885 a owl:Class ;
    rdfs:label "policy family"@en,
        "famille de politiques"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A named grouping of related directives, such as all the documents on access control, used to find the policies, standards and procedures that cover the same subject."@en,
        "Regroupement nommé de directives apparentées, comme l'ensemble des documents sur le contrôle d'accès, servant à repérer les politiques, normes et procédures qui portent sur un même sujet."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL section 4 (PolicyFamily); needed by POL CQ03 and CQ08."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- training requirement
crgo:CRGO_0000893 a owl:Class ;
    rdfs:label "training requirement"@en,
        "exigence de formation"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive that persons in a stated role or scope complete stated training, usually because a policy statement applies to them. Completing training is not the same as acknowledging or complying."@en,
        "Directive exigeant que les personnes d'un rôle ou d'un périmètre précisés suivent une formation donnée, généralement parce qu'un énoncé de politique s'applique à elles. Suivre la formation ne revient ni à prendre connaissance de la politique ni à la respecter."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL sections 4-5 (TrainingRequirement, requiresTraining); decision D7."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- policy clause
crgo:CRGO_0000888 a owl:Class ;
    rdfs:label "policy clause"@en,
        "article de politique"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A numbered or titled part of a directive version that contains one or more policy statements, used to cite where a statement appears."@en,
        "Partie numérotée ou titrée d'une version de directive qui contient un ou plusieurs énoncés de politique, servant à citer l'emplacement d'un énoncé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL section 4 (PolicyClause). Optional in data: a statement may be cited by its own identifier."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- directive review
crgo:CRGO_0000890 a owl:Class ;
    rdfs:label "directive review"@en,
        "revue de directive"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "policy review"@en ;
    skos:definition "A planned act in which a directive or some of its statements are reviewed, on schedule or after a trigger such as a regulatory change, an incident or an audit finding, ending in a decision to keep, revise or retire them."@en,
        "Acte planifié par lequel une directive ou certains de ses énoncés sont revus, selon le calendrier ou à la suite d'un déclencheur comme un changement réglementaire, un incident ou une constatation d'audit, et qui aboutit à la décision de les maintenir, de les réviser ou de les retirer."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL section 4 (PolicyReview, PolicyChangeEvent); CSF 2.0 GV.PO-02; SP 800-53 PL-1 (review and update frequency); ISO/IEC 27002:2022 control 5.1 (cited by number)."@en ;
    crgo:CRGO_0000286 "ISO/IEC 27002:2022, control 5.1 (Policies for information security); identifier cited"@en,
        "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en,
        "NIST CSF 2.0 (CSWP 29), category GV.PO (Policy), subcategories GV.PO-01 and GV.PO-02"@en,
        "NIST SP 800-53 Rev. 5, control PL-1 (Policy and Procedures) and the -1 controls of each family"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- normative modality scheme
crgo:CRGO_0000914 a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "normative modality scheme"@en,

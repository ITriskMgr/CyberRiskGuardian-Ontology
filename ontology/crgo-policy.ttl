# --- guideline
crgo:CRGO_0000889 a owl:Class ;
    rdfs:label "guideline"@en,
        "ligne directrice interne"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:disjointWith crgo:CRGO_0000498 ;
    skos:altLabel "policy guideline"@en ;
    skos:definition "A directive, issued as guidance separate from any policy, that recommends a practice without making it mandatory. Departing from a guideline needs no exception. A 'should' or 'may' statement written inside a policy is a policy statement, not a guideline."@en,
        "Directive, publiée à titre d'orientation distincte de toute politique, qui recommande une pratique sans la rendre obligatoire. S'en écarter n'exige aucune dérogation. Un énoncé « devrait » ou « peut » rédigé dans une politique est un énoncé de politique, et non une ligne directrice."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL section 4 (PolicyGuideline). Disjoint from policy statement, so that a guidance document is never read as a binding requirement; modality distinguishes binding from non-binding statements within a policy."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- policy acknowledgement
crgo:CRGO_0000892 a owl:Class ;
    rdfs:label "policy acknowledgement"@en,
        "accusé de lecture de politique"@fr ;
    rdfs:subClassOf crgo:CRGO_0000891 ;
    skos:definition "An attestation by a person that they have received and read an exact policy version that applies to them. Acknowledging a policy is not understanding or complying with it."@en,
        "Attestation par laquelle une personne déclare avoir reçu et lu une version précise d'une politique qui s'applique à elle. Prendre connaissance d'une politique n'équivaut ni à la comprendre ni à la respecter."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "POL sections 4 and 7 (acknowledged is not understood or compliant). Instances belong in organisation graphs or the application (POL section 1: no employee PII in CRGO)."@en ;
    crgo:CRGO_0000286 "Information Security Policy Governance, Compliance Traceability and Assurance, specification O-ISPMS-001 v1.0 (project owner, 2026-10-12)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .


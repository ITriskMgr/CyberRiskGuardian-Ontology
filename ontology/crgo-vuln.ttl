# --- EPSS percentile
crgo:CRGO_0000461 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "EPSS percentile"@en,
        "centile EPSS"@fr ;
    rdfs:domain crgo:CRGO_0000340 ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the share of scored vulnerabilities whose EPSS score is at or below that of the observed vulnerability on that day, from 0 to 1."@en,
        "Indique la proportion des vulnérabilités évaluées dont le score EPSS est inférieur ou égal à celui de la vulnérabilité observée ce jour-là, de 0 à 1."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "FIRST, Exploit Prediction Scoring System: model documentation and data (first.org/epss)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

# --- added to KEV on

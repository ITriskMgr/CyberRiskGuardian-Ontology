    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- credential dependency
crgo:CRGO_0001361 a owl:Class ;
    rdfs:label "credential dependency"@en,
        "dépendance à un identifiant"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of a service or configuration item that uses a credential, with how a change or rotation of the credential must be propagated and checked so that the service does not fail."@en,
        "Description d'un service ou d'un élément de configuration qui utilise un identifiant, avec la façon dont une modification ou une rotation de cet identifiant doit être propagée et vérifiée pour que le service ne tombe pas en panne."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (CredentialDependency)."@en ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- authoritative for attribute
crgo:CRGO_0001583 a owl:DatatypeProperty ;
    rdfs:label "authoritative for attribute"@en,
        "fait autorité pour l'attribut"@fr ;
    rdfs:domain crgo:CRGO_0001351 ;
    rdfs:range xsd:string ;
    skos:definition "Names the identity or account attribute for which an authoritative source policy designates its source."@en,
        "Nomme l'attribut d'identité ou de compte pour lequel une politique de source faisant autorité désigne la source."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 isAuthoritativeForAttribute."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;

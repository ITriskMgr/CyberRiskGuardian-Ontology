        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- change verified
crgo:CRGO_0001580 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "change verified"@en,
        "changement vérifié"@fr ;
    rdfs:domain crgo:CRGO_0001378 ;
    rdfs:range xsd:boolean ;
    skos:definition "States whether the result of a configuration change was verified after implementation."@en,
        "Indique si le résultat d'un changement de configuration a été vérifié après sa mise en œuvre."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- vault reference
crgo:CRGO_0001581 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "vault reference"@en,
        "référence dans le coffre"@fr ;
    rdfs:domain crgo:CRGO_0001360 ;
    rdfs:range xsd:string ;
    skos:definition "Gives the opaque identifier of a secret in its vault. Never the secret itself."@en,
        "Indique l'identifiant opaque d'un secret dans son coffre. Jamais le secret lui-même."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 10.1."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- last rotated on
crgo:CRGO_0001582 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "last rotated on"@en,
        "dernière rotation le"@fr ;
    rdfs:domain crgo:CRGO_0001360 ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives when a credential was last rotated."@en,
        "Indique quand un identifiant a fait l'objet de sa dernière rotation."@fr ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

crgo:crgo-iam a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model with the risk indices computed from it, and key risk indicators for monitoring. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian avec les indices de risque qui en découlent, et indicateurs clés de risque pour la surveillance. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.11.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-11-02"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-11-02"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - identity, privilege and configuration module"@en,
        "Ontologie CyberRiskGuardian - module des identités, des privilèges et des configurations"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-context,
        crgo:crgo-soar ;
    owl:priorVersion <https://w3id.org/crgo/0.10.1/crgo-iam> ;
    owl:versionIRI <https://w3id.org/crgo/0.11.0/crgo-iam> ;
    owl:versionInfo "0.11.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- privileged account
crgo:CRGO_0001338 a owl:Class ;
    rdfs:label "privileged account"@en,
        "compte privilégié"@fr ;
    rdfs:subClassOf crgo:CRGO_0001337 ;
    skos:altLabel "administrative account"@en,
        "compte d'administration"@fr ;
    skos:definition "An account that can change security settings, other accounts or critical systems and data beyond what an ordinary user can, such as an administrator or root account."@en,
        "Compte qui peut modifier des paramètres de sécurité, d'autres comptes, ou des systèmes et des données critiques au-delà de ce que peut un utilisateur ordinaire, comme un compte d'administrateur ou racine."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2; SP 800-53 AC-6."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-53 Rev. 5 controls AC-2, AC-5, AC-6, CM-2, CM-3, CM-6, CM-8, IA-2, IA-5 (cited by identifier)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- emergency access account
crgo:CRGO_0001340 a owl:Class ;
    rdfs:label "emergency access account"@en,
        "compte d'accès d'urgence"@fr ;
    rdfs:subClassOf crgo:CRGO_0001338 ;
    skos:altLabel "break-glass account"@en,
        "compte de dernier recours"@fr ;
    skos:definition "A privileged account kept for exceptional use when normal administration is unavailable, protected by specific controls, tested periodically and reviewed after each use."@en,
        "Compte privilégié réservé à un usage exceptionnel lorsque l'administration normale est indisponible, protégé par des mesures particulières, testé périodiquement et examiné après chaque utilisation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (EmergencyAccessAccount)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- credential vault
crgo:CRGO_0001343 a owl:Class ;
    rdfs:label "credential vault"@en,
        "coffre d'identifiants"@fr ;
    rdfs:subClassOf crgo:CRGO_0000003 ;
    skos:altLabel "secrets manager"@en,
        "gestionnaire de secrets"@fr ;
    skos:definition "An asset that is a system storing secrets such as passwords, keys and tokens, controlling their release and rotation and recording their use."@en,
        "Actif qui est un système conservant des secrets comme des mots de passe, des clés et des jetons, qui en contrôle la remise et la rotation et en consigne l'utilisation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (managedByVault)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- access group
crgo:CRGO_0001344 a owl:Class ;
    rdfs:label "access group"@en,
        "groupe d'accès"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "security group"@en,
        "groupe de sécurité"@fr ;
    skos:definition "A description of a named set of accounts or identities, held in an identity source, to which entitlements are granted together."@en,
        "Description d'un ensemble nommé de comptes ou d'identités, tenu dans une source d'identités, auquel des droits d'accès sont accordés ensemble."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (Group); label avoids the CCO 'group of agents'."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privileged role
crgo:CRGO_0001346 a owl:Class ;
    rdfs:label "privileged role"@en,
        "rôle privilégié"@fr ;
    rdfs:subClassOf crgo:CRGO_0001345 ;
    skos:definition "An access role whose entitlements allow changes to security settings, identities or critical systems, placed in a privilege tier."@en,
        "Rôle d'accès dont les droits permettent de modifier des paramètres de sécurité, des identités ou des systèmes critiques, classé dans un niveau de privilège."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 sections 5.1 and 9.2."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- permission
crgo:CRGO_0001348 a owl:Class ;
    rdfs:label "permission"@en,
        "permission"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive allowing one action, such as read, write, approve or administer, on one kind of resource; entitlements and roles group permissions."@en,
        "Directive permettant une action, comme lire, écrire, approuver ou administrer, sur un type de ressource; les droits d'accès et les rôles regroupent des permissions."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- access policy
crgo:CRGO_0001349 a owl:Class ;
    rdfs:label "access policy"@en,
        "politique d'accès"@fr ;
    rdfs:subClassOf crgo:CRGO_0000499 ;
    skos:definition "A technical standard stating who may receive which entitlements, under which conditions such as authentication strength, approval, location or duration."@en,
        "Norme technique précisant qui peut recevoir quels droits d'accès, et à quelles conditions, comme la robustesse de l'authentification, une approbation, le lieu ou la durée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (AccessPolicy)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- access request
crgo:CRGO_0001352 a owl:Class ;
    rdfs:label "access request"@en,
        "demande d'accès"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A record of a request that an identity receive or keep an entitlement or role, with the requester, the justification and the period asked for."@en,
        "Enregistrement d'une demande visant à ce qu'une identité reçoive ou conserve un droit d'accès ou un rôle, avec le demandeur, la justification et la période demandée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- access review
crgo:CRGO_0001353 a owl:Class ;
    rdfs:label "access review"@en,
        "revue des accès"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "access recertification"@en,
        "recertification des accès"@fr ;
    skos:definition "A planned act in which a reviewer confirms or revokes the entitlements of identities in a stated scope."@en,
        "Acte planifié par lequel un réviseur confirme ou révoque les droits d'accès des identités d'un périmètre donné."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2; SP 800-53 AC-2(j)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-53 Rev. 5 controls AC-2, AC-5, AC-6, CM-2, CM-3, CM-6, CM-8, IA-2, IA-5 (cited by identifier)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- access decision
crgo:CRGO_0001355 a owl:Class ;
    rdfs:label "access decision"@en,
        "décision d'accès"@fr ;
    rdfs:subClassOf crgo:CRGO_0000504 ;
    skos:definition "A decision record granting, refusing, keeping or revoking an entitlement or role for an identity, with the authority who decided."@en,
        "Relevé de décision qui accorde, refuse, maintient ou révoque un droit d'accès ou un rôle pour une identité, avec l'autorité qui a décidé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (AccessDecision; grantsOrRevokes is 'decision on')."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privilege elevation
crgo:CRGO_0001357 a owl:Class ;
    rdfs:label "privilege elevation"@en,
        "élévation de privilège"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "just-in-time elevation"@en,
        "élévation juste-à-temps"@fr ;
    skos:definition "A planned act by which an account temporarily receives a privileged role or entitlement for a stated purpose, after the approvals and checks required by policy."@en,
        "Acte planifié par lequel un compte reçoit temporairement un rôle ou un droit d'accès privilégié pour une fin précisée, après les approbations et vérifications exigées par la politique."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 sections 5.2 and 9.2. Records the act; the resulting time-limited grant is the privilege lease."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privilege lease
crgo:CRGO_0001358 a owl:Class ;
    rdfs:label "privilege lease"@en,
        "bail de privilège"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:disjointWith crgo:CRGO_0001355 ;
    skos:altLabel "time-bound privilege grant"@en,
        "octroi de privilège à durée limitée"@fr ;
    skos:definition "A directive granting an account a privilege until an absolute expiry, after which the privilege must be revoked and the revocation verified."@en,
        "Directive accordant un privilège à un compte jusqu'à une échéance absolue, après laquelle le privilège doit être révoqué et la révocation vérifiée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 5.2 invariants (absolute expiry, verified revocation)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- credential rotation
crgo:CRGO_0001362 a owl:Class ;
    rdfs:label "credential rotation"@en,
        "rotation d'identifiant"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:altLabel "rotation operation"@en,
        "opération de rotation"@fr ;
    skos:definition "A planned act replacing a credential within an approved window, propagating it to its dependants and verifying independently that they work."@en,
        "Acte planifié qui remplace un identifiant dans une plage approuvée, le propage aux éléments qui en dépendent et vérifie de façon indépendante qu'ils fonctionnent."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (RotationOperation)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- reconciliation conflict
crgo:CRGO_0001368 a owl:Class ;
    rdfs:label "reconciliation conflict"@en,
        "conflit de rapprochement"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of a disagreement between identity or configuration sources about the same entity or attribute, with its resolution and who resolved it."@en,
        "Description d'un désaccord entre sources d'identités ou de configuration sur une même entité ou un même attribut, avec sa résolution et la personne qui l'a résolu."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (ReconciliationConflict, reconciliation_exception, ci_reconciliation_record)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- deployment gate
crgo:CRGO_0001379 a owl:Class ;
    rdfs:label "deployment gate"@en,
        "point de contrôle de déploiement"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive stating the authorisation and health conditions a change must meet before it proceeds to the next stage of deployment, and when it must be reverted."@en,
        "Directive qui précise les conditions d'autorisation et d'état qu'un changement doit remplir avant de passer à l'étape suivante du déploiement, et quand il doit être annulé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (DeploymentGate)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- outcome metric
crgo:CRGO_0001382 a owl:Class ;
    rdfs:label "outcome metric"@en,
        "indicateur de résultat"@fr ;
    rdfs:subClassOf crgo:CRGO_0000034 ;
    skos:definition "A key risk indicator measuring an outcome of identity, privilege or configuration management, defined by its numerator, denominator, population, exclusions and unit."@en,
        "Indicateur clé de risque qui mesure un résultat de la gestion des identités, des privilèges ou des configurations, défini par son numérateur, son dénominateur, sa population, ses exclusions et son unité."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (OutcomeMetric); the starter KRIs of the decision record are its indicator kinds."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- account population
crgo:CRGO_0001384 a owl:Class ;
    rdfs:label "account population"@en,
        "population de comptes"@fr ;
    rdfs:subClassOf crgo:CRGO_0000528 ;
    owl:disjointWith crgo:CRGO_0001386 ;
    skos:definition "A population of accounts of one type in a stated scope, recorded by counts only (total, with multi-factor authentication, with phishing-resistant multi-factor authentication, dormant, without an owner), with its owner, source and last reconciliation date. No account is named."@en,
        "Population de comptes d'un même type dans un périmètre donné, consignée par dénombrements seulement (total, avec authentification multifacteur, avec authentification multifacteur résistante à l'hameçonnage, inactifs, sans responsable), avec son responsable, sa source et la date du dernier rapprochement. Aucun compte n'est nommé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Register 1 of the CyberRiskGuardian module (decision record). The total is 'population size'."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- identity source
crgo:CRGO_0001341 a owl:Class ;
    rdfs:label "identity source"@en,
        "source d'identités"@fr ;
    rdfs:subClassOf crgo:CRGO_0000003 ;
    skos:definition "An asset that is a system holding authoritative or observed records of identities or accounts, such as a directory, a human-resources system or a cloud platform's identity service."@en,
        "Actif qui est un système détenant des enregistrements faisant autorité ou observés sur des identités ou des comptes, comme un annuaire, un système de ressources humaines ou le service d'identités d'une plateforme infonuagique."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (IdentitySource)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- entitlement
crgo:CRGO_0001347 a owl:Class ;
    rdfs:label "entitlement"@en,
        "droit d'accès"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "access grant"@en,
        "autorisation d'accès"@fr ;
    skos:definition "A directive granting an account, group or role the right to use a resource in a stated way, as recorded in a target system."@en,
        "Directive accordant à un compte, à un groupe ou à un rôle le droit d'utiliser une ressource d'une façon précisée, telle qu'enregistrée dans un système cible."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- segregation-of-duties rule
crgo:CRGO_0001350 a owl:Class ;
    rdfs:label "segregation-of-duties rule"@en,
        "règle de séparation des tâches"@fr ;
    rdfs:subClassOf crgo:CRGO_0000019 ;
    skos:altLabel "SoD rule"@en,
        "règle SdT"@fr ;
    skos:definition "A control prescribing that stated entitlements or roles must not be held by the same identity, because together they let one person both carry out and conceal an error or fraud."@en,
        "Mesure prescrivant que des droits d'accès ou des rôles précisés ne doivent pas être détenus par une même identité, parce qu'ensemble ils permettent à une seule personne de commettre et de dissimuler une erreur ou une fraude."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (SegregationRule); SP 800-53 AC-5."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-53 Rev. 5 controls AC-2, AC-5, AC-6, CM-2, CM-3, CM-6, CM-8, IA-2, IA-5 (cited by identifier)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- authoritative source policy
crgo:CRGO_0001351 a owl:Class ;
    rdfs:label "authoritative source policy"@en,
        "politique de source faisant autorité"@fr ;
    rdfs:subClassOf crgo:CRGO_0000499 ;
    skos:definition "A technical standard stating which identity source is authoritative for which attribute of an identity or account, and how conflicts between sources are resolved."@en,
        "Norme technique précisant quelle source d'identités fait autorité pour quel attribut d'une identité ou d'un compte, et comment les conflits entre sources sont résolus."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (AuthoritativeSourcePolicy)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privilege path
crgo:CRGO_0001356 a owl:Class ;
    rdfs:label "privilege path"@en,
        "chemin de privilège"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "escalation path"@en,
        "chemin d'escalade"@fr ;
    skos:definition "A description of a chain of group memberships, role inheritance, delegations or credentials by which an identity can obtain a privilege that it was not granted directly."@en,
        "Description d'une chaîne d'appartenances à des groupes, d'héritages de rôles, de délégations ou d'identifiants par laquelle une identité peut obtenir un privilège qui ne lui a pas été accordé directement."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 sections 9.2 and 9.4 (effective administration including inherited roles)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privileged session
crgo:CRGO_0001359 a owl:Class ;
    rdfs:label "privileged session"@en,
        "session privilégiée"@fr ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "A process in which a privileged account is used on a target system, from sign-in to sign-out."@en,
        "Processus au cours duquel un compte privilégié est utilisé sur un système cible, de l'ouverture à la fermeture de session."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2; session content stays in the operational store."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- emergency access use
crgo:CRGO_0001363 a owl:Class ;
    rdfs:label "emergency access use"@en,
        "utilisation d'un accès d'urgence"@fr ;
    rdfs:subClassOf crgo:CRGO_0000550 ;
    skos:altLabel "break-glass use"@en,
        "utilisation de dernier recours"@fr ;
    skos:definition "A security event in which an emergency access account is used, which must be justified and reviewed afterwards."@en,
        "Événement de sécurité au cours duquel un compte d'accès d'urgence est utilisé, ce qui doit être justifié et examiné par la suite."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (EmergencyUseEvent)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- identity finding
crgo:CRGO_0001364 a owl:Class ;
    rdfs:label "identity finding"@en,
        "constat d'identité"@fr ;
    rdfs:subClassOf crgo:CRGO_0000018 ;
    skos:definition "A control gap finding about identities or accounts, backed by evidence, such as accounts without an owner, dormant accounts or missing multi-factor authentication."@en,
        "Constat de lacune de contrôle portant sur des identités ou des comptes, appuyé par des preuves, comme des comptes sans responsable, des comptes inactifs ou une authentification multifacteur absente."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (IdentityFinding); hung under control gap finding (decision record). The missing control is given by 'missing control'."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- configuration attribute
crgo:CRGO_0001372 a owl:Class ;
    rdfs:label "configuration attribute"@en,
        "attribut de configuration"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "configuration setting"@en,
        "paramètre de configuration"@fr ;
    skos:definition "A description of one named setting of a configuration item, normalised across sources, with its sensitivity."@en,
        "Description d'un paramètre nommé d'un élément de configuration, normalisé d'une source à l'autre, avec sa sensibilité."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.3."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- configuration snapshot
crgo:CRGO_0001373 a owl:Class ;
    rdfs:label "configuration snapshot"@en,
        "instantané de configuration"@fr ;
    rdfs:subClassOf crgo:CRGO_0000338 ;
    skos:definition "An observation of the settings of a configuration item at a point in time, from a stated source, with an integrity hash; secret values are excluded or redacted."@en,
        "Observation des paramètres d'un élément de configuration à un moment donné, provenant d'une source précisée, avec une empreinte d'intégrité; les valeurs secrètes sont exclues ou masquées."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 sections 9.3 and 10.1."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- configuration assessment
crgo:CRGO_0001376 a owl:Class ;
    rdfs:label "configuration assessment"@en,
        "évaluation de configuration"@fr ;
    rdfs:subClassOf crgo:CRGO_0000347 ;
    skos:definition "A control assessment comparing a configuration snapshot with the requirements of a baseline version, with its result and evidence."@en,
        "Évaluation de mesure qui compare un instantané de configuration aux exigences d'une version de configuration de référence, avec son résultat et ses preuves."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.3 (ConfigurationAssessment)."@en ;

    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- snapshot hash
crgo:CRGO_0001578 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "snapshot hash"@en,
        "empreinte de l'instantané"@fr ;
    rdfs:domain crgo:CRGO_0001373 ;
    rdfs:range xsd:string ;
    skos:definition "Gives the SHA-256 checksum of the sanitised content of a configuration snapshot."@en,
        "Indique l'empreinte SHA-256 du contenu épuré d'un instantané de configuration."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- change ticket
crgo:CRGO_0001579 a owl:DatatypeProperty ;
    rdfs:label "change ticket"@en,
        "billet de changement"@fr ;
    rdfs:domain crgo:CRGO_0001378 ;
    rdfs:range xsd:string ;
    skos:definition "Gives the identifier of the change ticket or request that authorised a configuration change."@en,
        "Indique l'identifiant du billet ou de la demande de changement qui a autorisé un changement de configuration."@fr ;

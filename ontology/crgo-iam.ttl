# --- human identity
crgo:CRGO_0001333 a owl:Class ;
    rdfs:label "human identity"@en,
        "identité humaine"@fr ;
    rdfs:subClassOf crgo:CRGO_0001332 ;
    owl:disjointWith crgo:CRGO_0001334 ;
    skos:definition "A digital identity that represents a person, such as an employee, contractor or vendor representative."@en,

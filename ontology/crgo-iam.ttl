# --- access review campaign
crgo:CRGO_0001354 a owl:Class ;
    rdfs:label "access review campaign"@en,
        "campagne de revue des accès"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A planned set of access reviews over a stated scope and period, summarised by counts: items due and completed, revocations requested and verified, and reviewers in conflict."@en,
        "Ensemble planifié de revues des accès sur un périmètre et une période donnés, résumé par des dénombrements : éléments à examiner et examinés, révocations demandées et vérifiées, et réviseurs en conflit."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Register 4 of the CyberRiskGuardian module (decision record): summary counts only."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- baseline deviation
crgo:CRGO_0001377 a owl:Class ;
    rdfs:label "baseline deviation"@en,
        "écart par rapport à la référence"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0001378 ;
    skos:altLabel "configuration drift"@en,
        "dérive de configuration"@fr ;
    skos:definition "A description of a difference between observed configuration and an approved baseline version for a stated configuration item or population, with its drift class, when it was first detected and whether an unexpired exception covers it."@en,
        "Description d'une différence entre la configuration observée et une version approuvée de configuration de référence pour un élément de configuration ou une population donnés, avec sa classe de dérive, la date de sa première détection et l'indication qu'une dérogation non expirée la couvre ou non."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Deviation register of the CyberRiskGuardian module with the drift classes of spec v1.1 section 6.4. Not every deviation is a deficiency (transitional, compensated, strengthening, unknown)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privilege tier
crgo:CRGO_0001441 a owl:Class ;
    rdfs:label "privilege tier"@en,
        "niveau de privilège"@fr ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A risk label for privileged roles by what they control. These are configurable labels, not vendor definitions; lowering the tier of a critical privilege needs justification and approval."@en,
        "Étiquette de risque des rôles privilégiés selon ce qu'ils contrôlent. Ce sont des étiquettes configurables, et non des définitions de fournisseurs; abaisser le niveau d'un privilège critique exige une justification et une approbation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Value set; members listed below."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


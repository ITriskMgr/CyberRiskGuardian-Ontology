# --- artefact digest
crgo:CRGO_0001584 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "artefact digest"@en,
        "empreinte de l'artefact"@fr ;
    rdfs:domain crgo:CRGO_0001380 ;
    rdfs:range xsd:string ;
    skos:definition "Gives the cryptographic digest of the artefact a build attestation is about."@en,
        "Indique l'empreinte cryptographique de l'artefact visé par une attestation de build."@fr ;

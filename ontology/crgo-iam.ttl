    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- unexpected strengthening
crgo:CRGO_0001459 a owl:NamedIndividual,
        crgo:CRGO_0001453 ;
    rdfs:label "unexpected strengthening"@en,
        "renforcement imprévu"@fr ;
    skos:definition "More restrictive than the baseline, which may impair availability; reviewed rather than treated as compliant."@en,
        "Plus restrictif que la référence, ce qui peut nuire à la disponibilité; examiné plutôt que réputé conforme."@fr ;
    skos:inScheme crgo:CRGO_0001454 ;
    skos:notation "5" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

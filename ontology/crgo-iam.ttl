    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (representsWorkload)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- AI agent identity
crgo:CRGO_0001336 a owl:Class ;
    rdfs:label "AI agent identity"@en,
        "identité d'agent d'IA"@fr ;
    rdfs:subClassOf crgo:CRGO_0001334 ;
    skos:definition "A non-human identity that represents an AI agent, with the person or unit accountable for it and the authority delegated to it."@en,
        "Identité non humaine qui représente un agent d'IA, avec la personne ou l'unité qui en répond et l'autorité qui lui est déléguée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (AIAgentIdentity); OWASP agentic ASI03 (identity and privilege abuse)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "OWASP Top 10 for Agentic Applications 2026 (OWASP GenAI Security Project, 2025-12-09); identifiers cited, labels are CRGO paraphrases"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- functional deviation
crgo:CRGO_0001456 a owl:NamedIndividual,
        crgo:CRGO_0001453 ;
    rdfs:label "functional deviation"@en,
        "écart fonctionnel"@fr ;
    skos:definition "The setting changed but is not necessarily weaker; its impact must be assessed."@en,
        "Le paramètre a changé mais n'est pas nécessairement plus faible; son incidence doit être évaluée."@fr ;
    skos:inScheme crgo:CRGO_0001454 ;
    skos:notation "2" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- authorised transitional state
crgo:CRGO_0001457 a owl:NamedIndividual,
        crgo:CRGO_0001453 ;
    rdfs:label "authorised transitional state"@en,
        "état transitoire autorisé"@fr ;
    skos:definition "Part of an approved change still within its implementation window."@en,
        "Fait partie d'un changement approuvé encore dans sa période de mise en œuvre."@fr ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- identity security case
crgo:CRGO_0001369 a owl:Class ;
    rdfs:label "identity security case"@en,
        "dossier de sécurité des identités"@fr ;
    rdfs:subClassOf crgo:CRGO_0001112 ;
    skos:definition "A security investigation of suspicious use of an identity or account, such as impossible travel, credential stuffing or abnormal privilege use."@en,
        "Enquête de sécurité sur une utilisation suspecte d'une identité ou d'un compte, comme un déplacement impossible, du bourrage d'identifiants ou une utilisation anormale de privilèges."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (IdentitySecurityCase); links to SIEM/SOAR through the investigation."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


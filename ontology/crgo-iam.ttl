# --- account
crgo:CRGO_0001337 a owl:Class ;
    rdfs:label "account"@en,
        "compte"@fr ;
    rdfs:subClassOf crgo:CRGO_0000002 ;
    skos:altLabel "user account"@en,
        "compte utilisateur"@fr ;
    skos:definition "An asset that is an account held in an identity source or target system, through which a digital identity authenticates and receives entitlements, with its status and the identifier given by its source."@en,
        "Actif qui est un compte détenu dans une source d'identités ou un système cible, par lequel une identité numérique s'authentifie et reçoit des droits d'accès, avec son état et l'identifiant attribué par sa source."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (Account). CyberRiskGuardian registers count accounts by population and never store usernames (decision record)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,

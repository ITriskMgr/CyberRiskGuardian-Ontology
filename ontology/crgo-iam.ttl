    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- workload identity
crgo:CRGO_0001335 a owl:Class ;
    rdfs:label "workload identity"@en,
        "identité de charge de travail"@fr ;
    rdfs:subClassOf crgo:CRGO_0001334 ;
    skos:definition "A non-human identity that represents an application, service, script, container or pipeline acting on its own behalf."@en,
        "Identité non humaine qui représente une application, un service, un script, un conteneur ou un pipeline agissant pour son propre compte."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;

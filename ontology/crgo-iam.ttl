    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- build attestation
crgo:CRGO_0001380 a owl:Class ;
    rdfs:label "build attestation"@en,
        "attestation de build"@fr ;
    rdfs:subClassOf crgo:CRGO_0000036 ;
    skos:altLabel "build provenance attestation"@en,
        "attestation de provenance de build"@fr ;
    skos:definition "Evidence that a deployed artefact was built from a stated source revision by a stated pipeline, with its digest and signature status."@en,
        "Preuve qu'un artefact déployé a été produit à partir d'une révision de source précisée par un pipeline précisé, avec son empreinte et l'état de sa signature."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 23.7 (BuildAttestation)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- coverage observation
crgo:CRGO_0001383 a owl:Class ;
    rdfs:label "coverage observation"@en,
        "observation de couverture"@fr ;
    rdfs:subClassOf crgo:CRGO_0000338 ;
    skos:definition "An observation of a coverage indicator at a date, giving its numerator, its denominator and how many items could not be determined; unknown items are counted, never dropped from the denominator."@en,
        "Observation d'un indicateur de couverture à une date donnée, avec son numérateur, son dénominateur et le nombre d'éléments qui n'ont pu être déterminés; les éléments inconnus sont comptés et jamais retirés du dénominateur."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Decision record KRI rule: each indicator shows its denominator; zero denominator = not applicable; never green by excluding unknowns."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- non-human identity
crgo:CRGO_0001334 a owl:Class ;
    rdfs:label "non-human identity"@en,
        "identité non humaine"@fr ;
    rdfs:subClassOf crgo:CRGO_0001332 ;
    skos:altLabel "machine identity"@en,
        "identité machine"@fr ;

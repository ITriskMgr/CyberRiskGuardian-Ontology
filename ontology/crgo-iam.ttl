    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- segregation-of-duties conflict
crgo:CRGO_0001366 a owl:Class ;
    rdfs:label "segregation-of-duties conflict"@en,
        "conflit de séparation des tâches"@fr ;
    rdfs:subClassOf crgo:CRGO_0001364 ;
    skos:altLabel "SoD conflict"@en,
        "conflit SdT"@fr ;
    skos:definition "An identity finding that a number of identities hold a combination of entitlements or roles that a segregation-of-duties rule prohibits, with its owner and any mitigating control."@en,
        "Constat d'identité selon lequel un certain nombre d'identités détiennent une combinaison de droits d'accès ou de rôles qu'interdit une règle de séparation des tâches, avec son responsable et toute mesure d'atténuation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Register 6 of the CyberRiskGuardian module (decision record): rule, conflict count, owner, mitigation."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- digital identity
crgo:CRGO_0001332 a owl:Class ;
    rdfs:label "digital identity"@en,
        "identité numérique"@fr ;
    rdfs:subClassOf crgo:CRGO_0000002 ;
    owl:disjointWith crgo:CRGO_0001337 ;
    skos:altLabel "identity"@en,
        "identité"@fr ;
    skos:definition "An asset that is the set of attributes by which an organisation's systems recognise one person, workload or AI agent, independent of any single account and of mutable values such as a name or e-mail address."@en,
        "Actif qui est l'ensemble des attributs par lesquels les systèmes d'une organisation reconnaissent une personne, une charge de travail ou un agent d'IA, indépendamment d'un compte particulier et de valeurs changeantes comme un nom ou une adresse courriel."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (DigitalIdentity). An information asset: identity data is protected like other information."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-63-4, Digital Identity Guidelines (2025): identity, authenticator and federation assurance (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- access role
crgo:CRGO_0001345 a owl:Class ;
    rdfs:label "access role"@en,
        "rôle d'accès"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    owl:disjointWith crgo:CRGO_0001347 ;
    skos:altLabel "RBAC role"@en,
        "rôle RBAC"@fr ;
    skos:definition "A directive that bundles entitlements needed for a job function, so that holders of the role may perform its actions."@en,
        "Directive qui regroupe les droits d'accès nécessaires à une fonction, de sorte que les titulaires du rôle puissent en accomplir les actions."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (AccessRole). A directive, not a BFO role: it prescribes what holders may do."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-53 Rev. 5 controls AC-2, AC-5, AC-6, CM-2, CM-3, CM-6, CM-8, IA-2, IA-5 (cited by identifier)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- configuration item
crgo:CRGO_0001371 a owl:Class ;
    rdfs:label "configuration item"@en,
        "élément de configuration"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0001372 ;
    skos:altLabel "CI"@en,
        "élément de configuration (EC)"@fr ;
    skos:definition "A description, in a configuration management database or register, of an asset or service component placed under configuration control, with its environment, owner and the baseline assigned to it."@en,
        "Description, dans une base de données ou un registre de gestion des configurations, d'un actif ou d'un composant de service placé sous contrôle de configuration, avec son environnement, son responsable et la configuration de référence qui lui est attribuée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.3 (ConfigurationItem). A record about an asset rather than the asset, so that an asset is not reclassified when placed under control. MOACCO held a configuration item class only through the third-party ITSM ontology it imported, so nothing is derived from it."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-128, Guide for Security-Focused Configuration Management of Information Systems (2011, updated 2019) (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- baseline version
crgo:CRGO_0001374 a owl:Class ;
    rdfs:label "baseline version"@en,
        "version de configuration de référence"@fr ;
    rdfs:subClassOf crgo:CRGO_0000886 ;
    skos:altLabel "security baseline version"@en,
        "version de référence de sécurité"@fr ;
    skos:definition "A directive version of a configuration baseline that, once approved, is not changed: a new version supersedes it. It states the platforms it applies to, its owner, its review date and the licence of the source it adapts, if any."@en,
        "Version de directive d'une configuration de référence qui, une fois approuvée, n'est plus modifiée : une nouvelle version la remplace. Elle précise les plateformes visées, son responsable, sa date de revue et, le cas échéant, la licence de la source qu'elle adapte."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Register 5 of the CyberRiskGuardian module: baselines promoted to versioned objects (decision record). The baseline itself is 'configuration baseline' (CRGO_0000501), linked by 'version of directive'."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- baseline requirement
crgo:CRGO_0001375 a owl:Class ;
    rdfs:label "baseline requirement"@en,
        "exigence de configuration de référence"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:altLabel "baseline rule"@en,
        "règle de référence"@fr ;
    skos:definition "A directive stating one testable expected setting within a baseline version, with the control or safeguard it implements."@en,
        "Directive qui énonce un paramètre attendu et vérifiable dans une version de configuration de référence, avec la mesure ou la protection qu'il met en œuvre."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.3 (BaselineRequirement)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en,
        "NIST SP 800-128, Guide for Security-Focused Configuration Management of Information Systems (2011, updated 2019) (cited)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- privileged role holder population
crgo:CRGO_0001386 a owl:Class ;
    rdfs:label "privileged role holder population"@en,
        "population de titulaires d'un rôle privilégié"@fr ;
    rdfs:subClassOf crgo:CRGO_0000528 ;
    skos:definition "A population of the holders of one privileged role, recorded by counts (holders, standing, just-in-time, with multi-factor authentication) with the role's privilege tier, owner and last review date. No holder is named."@en,
        "Population des titulaires d'un rôle privilégié, consignée par dénombrements (titulaires, permanents, juste-à-temps, avec authentification multifacteur) avec le niveau de privilège du rôle, son responsable et la date de la dernière revue. Aucun titulaire n'est nommé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Register 2 of the CyberRiskGuardian module: privileged roles by tier (spec v1.1 section 5.1)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian 1.9.0 decision record (project owner, 2026-11-02), sections 'IAM/PAM and Configuration Management' and 'CRGO 0.11'"@en,
        "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


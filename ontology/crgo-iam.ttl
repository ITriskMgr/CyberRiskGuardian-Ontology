    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- compensated deviation
crgo:CRGO_0001458 a owl:NamedIndividual,
        crgo:CRGO_0001453 ;
    rdfs:label "compensated deviation"@en,
        "écart compensé"@fr ;
    skos:definition "Covered by an unexpired exception with validated compensating controls; an expired exception never counts."@en,
        "Couvert par une dérogation non expirée assortie de mesures compensatoires validées; une dérogation expirée ne compte jamais."@fr ;
    skos:inScheme crgo:CRGO_0001454 ;
    skos:notation "4" ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

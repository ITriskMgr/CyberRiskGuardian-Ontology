# --- credential reference
crgo:CRGO_0001360 a owl:Class ;
    rdfs:label "credential reference"@en,
        "référence d'identifiant"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "secret metadata"@en,
        "métadonnées de secret"@fr ;
    skos:definition "A description of a secret such as a password, key or token by its metadata only (an opaque reference in a vault, its owner, type, creation and rotation dates), never the secret value itself."@en,
        "Description d'un secret, comme un mot de passe, une clé ou un jeton, par ses seules métadonnées (une référence opaque dans un coffre, son responsable, son type, ses dates de création et de rotation), jamais la valeur du secret."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 sections 9.2 (CredentialReference, SecretMetadata) and 10.1 (no secret values)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .


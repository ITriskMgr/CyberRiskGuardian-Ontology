# --- privilege finding
crgo:CRGO_0001365 a owl:Class ;
    rdfs:label "privilege finding"@en,
        "constat de privilège"@fr ;
    rdfs:subClassOf crgo:CRGO_0001364 ;
    skos:definition "An identity finding about privileged access, such as standing privilege that should be just-in-time, unreviewed emergency use or an unapproved privilege path."@en,
        "Constat d'identité portant sur l'accès privilégié, comme un privilège permanent qui devrait être juste-à-temps, une utilisation d'urgence non examinée ou un chemin de privilège non approuvé."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.2 (PrivilegeFinding)."@en ;
    crgo:CRGO_0000286 "CyberRiskGuardian IAM, PAM and Configuration Management Specification v1.1 (project owner), sections 5.1 (privilege tiers), 6.4 (drift classes), 9.2-9.3 (ontology classes) and 23.7 (additional concepts)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.11.0" .

# --- configuration finding
crgo:CRGO_0001367 a owl:Class ;
    rdfs:label "configuration finding"@en,
        "constat de configuration"@fr ;
    rdfs:subClassOf crgo:CRGO_0000018 ;
    skos:definition "A control gap finding about configuration management, such as assets without an assigned baseline, unverified changes or unknown configuration state."@en,
        "Constat de lacune de contrôle portant sur la gestion des configurations, comme des actifs sans configuration de référence attribuée, des changements non vérifiés ou un état de configuration inconnu."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Spec v1.1 section 9.3; hung under control gap finding (decision record)."@en ;

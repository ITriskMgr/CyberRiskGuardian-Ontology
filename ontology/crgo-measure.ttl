crgo:crgo-measure a owl:Ontology ;
    dcterms:created "2026-10-08" ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. All elements are proposed (version 0.1.0) until approved by the domain expert."@en ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:title "CyberRiskGuardian Ontology - measurement module"@en,
        "Ontologie CyberRiskGuardian - module de mesure"@fr ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-core ;
    owl:versionIRI <https://w3id.org/crgo/0.1.0/crgo-measure> ;
    owl:versionInfo "0.1.0" .


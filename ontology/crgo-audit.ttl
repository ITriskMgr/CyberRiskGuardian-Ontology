# --- audit plan entry
crgo:CRGO_0000908 a owl:Class ;
    rdfs:label "audit plan entry"@en,
        "entrée du plan d'audit"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "An entry of an audit plan for one candidate or planned engagement, with its priority rationale, its state (proposed, approved, deferred, cancelled or completed) and, when deferred or cancelled, the reason and who authorised it."@en,
        "Entrée d'un plan d'audit pour une mission envisagée ou prévue, avec la justification de sa priorité, son état (proposée, approuvée, reportée, annulée ou réalisée) et, en cas de report ou d'annulation, le motif et l'auteur de l'autorisation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "AUD sections 5 and 7; needed by AUD CQ-09 (changes between plan versions and who authorised deferrals)."@en ;
    crgo:CRGO_0000286 "Audit management ontology extension: implementation specification v1.0 (project owner, 2026-10-12)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

# --- audit finding
crgo:CRGO_0000541 a owl:Class ;
    rdfs:label "audit finding"@en,
        "constatation d'audit"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000346 ;
    skos:changeNote "0.10.0 (decision D8, 2026-10-12): alternative label 'audit observation' removed; audit observation is now a separate class, disjoint from audit finding."@en ;
    skos:definition "A record, made in an audit engagement, of the difference between a criterion and the condition found, with its observed or hypothesised cause, its effect, its significance and the evidence relied on."@en,
        "Enregistrement, établi dans une mission d'audit, de l'écart entre un critère et la situation constatée, avec sa cause observée ou présumée, son effet, son importance et les preuves retenues."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standards 14.2-14.3; ISO 19011:2018 clause 6.4."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .


# --- audit workpaper
crgo:CRGO_0000909 a owl:Class ;
    rdfs:label "audit workpaper"@en,
        "feuille de travail d'audit"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:altLabel "working paper"@en,
        "dossier de travail"@fr ;
    skos:definition "A record prepared by an auditor that documents work performed, evidence examined and conclusions reached in an engagement, with who prepared it and who reviewed it. CRGO holds its metadata, not its content."@en,
        "Document établi par un auditeur qui consigne les travaux effectués, les preuves examinées et les conclusions tirées dans une mission, avec son auteur et son réviseur. CRGO en conserve les métadonnées, et non le contenu."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "AUD sections 5 and 9 (self-review check); GIAS Standard 14.6 (Engagement Documentation); ITAF 1204 (Performance and Supervision); cited by number."@en ;

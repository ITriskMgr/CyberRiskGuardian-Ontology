# --- audit engagement
crgo:CRGO_0000536 a owl:Class ;
    rdfs:label "audit engagement"@en,
        "mission d'audit"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A planned act of assurance or advice on an auditable entity, with stated objectives, scope, criteria and period, performed by an audit team."@en,
        "Acte planifié d'assurance ou de conseil sur une entité auditable, avec des objectifs, un périmètre, des critères et une période donnés, réalisé par une équipe d'audit."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Principle 13 (Plan Engagements Effectively); ISO 19011:2018 clause 6 (conducting an audit)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

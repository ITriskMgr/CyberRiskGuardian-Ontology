    crgo:CRGO_0000291 "0.9.0" .

# --- corrective action
crgo:CRGO_0000546 a owl:Class ;
    rdfs:label "corrective action"@en,
        "action corrective"@fr ;
    rdfs:subClassOf cco:ont00000974 ;
    skos:altLabel "action plan"@en,
        "plan d'action"@fr ;
    skos:definition "A plan of action by an owner, with a due date, to eliminate the cause of a finding or nonconformity and prevent its recurrence."@en,
        "Plan d'action confié à un responsable, avec une échéance, pour éliminer la cause d'une constatation ou d'une non-conformité et en empêcher la répétition."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "ISO 37301:2021 clause 10.2."@en ;

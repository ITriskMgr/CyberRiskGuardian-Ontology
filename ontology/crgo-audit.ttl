# --- management response
crgo:CRGO_0000545 a owl:Class ;
    rdfs:label "management response"@en,
        "réponse de la direction"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A dated record of management's position on a finding or recommendation, such as agreeing and committing to action, disagreeing, or accepting the risk."@en,
        "Enregistrement daté de la position de la direction sur une constatation ou une recommandation, comme l'accord et l'engagement à agir, le désaccord ou l'acceptation du risque."@fr ;

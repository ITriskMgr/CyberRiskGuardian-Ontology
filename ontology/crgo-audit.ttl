crgo:crgo-audit a owl:Ontology ;
    dcterms:abstract "The CyberRiskGuardian Ontology (CRGO) gives a formal, reasoner-checked meaning to cybersecurity risk assessment data: assets, threat sources and events, vulnerabilities, risk scenarios, controls, frameworks and legal obligations, the CyberRiskGuardian quantitative model and the key risk indicators computed from it. It is published with SKOS vocabularies for NIST CSF 2.0, NIST SP 800-53, ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, Québec Law 25 and the Québec health-information act, and with a library of about 1,900 generic risk scenarios linked to them."@en,
        "L'ontologie CyberRiskGuardian (CRGO) donne un sens formel, vérifié par raisonneur, aux données d'appréciation du risque de cybersécurité : actifs, sources et événements de menace, vulnérabilités, scénarios de risque, mesures de sécurité, référentiels et obligations légales, modèle quantitatif CyberRiskGuardian et indicateurs clés de risque qui en découlent. Elle est publiée avec des vocabulaires SKOS pour le NIST CSF 2.0, le NIST SP 800-53, l'ISO/IEC 27002:2022, COBIT 2019, MITRE ATT&CK, la Loi 25 et la loi québécoise sur les renseignements de santé, et avec une bibliothèque d'environ 1 900 scénarios de risque génériques liés à ces vocabulaires."@fr ;
    dcterms:bibliographicCitation "Léger, Marc-André (2026). CyberRiskGuardian Ontology (CRGO), version 0.9.0. https://github.com/ITriskMgr/cyberriskguardian-ontology" ;
    dcterms:contributor "Claude (Anthropic), AI drafting assistant; every element approved by the creator" ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator "Marc-André Léger" ;
    dcterms:description "Formal OWL 2 DL ontology for identifying, analysing and treating cybersecurity risk with risk scenarios, aligned to BFO-2020 (ISO/IEC 21838-2) and Common Core Ontologies, and to the CyberRiskGuardian method. Each element carries its own governance status; new elements stay proposed until the domain expert approves them."@en,
        "Ontologie formelle OWL 2 DL pour identifier, analyser et traiter le risque de cybersécurité à l'aide de scénarios de risque, alignée sur BFO-2020 (ISO/IEC 21838-2), les Common Core Ontologies et la méthode CyberRiskGuardian. Chaque élément porte son propre statut de gouvernance; les nouveaux éléments restent proposés jusqu'à leur approbation par l'expert du domaine."@fr ;
    dcterms:issued "2026-10-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:publisher "ITriskMgr" ;
    dcterms:source <https://github.com/ITriskMgr/CyberRiskGuardian> ;
    dcterms:title "CyberRiskGuardian Ontology - audit lifecycle and remediation module"@en,
        "Ontologie CyberRiskGuardian - module du cycle d'audit et de la remédiation"@fr ;
    bibo:status "released" ;
    vann:preferredNamespacePrefix "crgo" ;
    vann:preferredNamespaceUri "https://w3id.org/crgo/" ;
    owl:imports crgo:crgo-assurance ;
    owl:priorVersion <https://w3id.org/crgo/0.8.0/crgo-audit> ;
    owl:versionIRI <https://w3id.org/crgo/0.9.0/crgo-audit> ;
    owl:versionInfo "0.9.0" ;
    foaf:homepage crgo:crgo ;
    schema:codeRepository <https://github.com/ITriskMgr/cyberriskguardian-ontology> .

# --- audit universe
crgo:CRGO_0000531 a owl:Class ;
    rdfs:label "audit universe"@en,
        "univers d'audit"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of all the auditable entities of an organisation from which the internal audit plan is drawn."@en,
        "Description de toutes les entités auditables d'une organisation dans laquelle est puisé le plan d'audit interne."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 9.4 (Internal Audit Plan)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- audit plan
crgo:CRGO_0000533 a owl:Class ;
    rdfs:label "audit plan"@en,
        "plan d'audit"@fr ;
    rdfs:subClassOf cco:ont00000974 ;
    skos:definition "A plan, usually approved by the governing body, that sets out the audit engagements to be performed over a stated period and why."@en,
        "Plan, généralement approuvé par l'organe de gouvernance, qui énumère les missions d'audit à réaliser pendant une période donnée et leur justification."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 9.4; ITAF 1202 (Audit Scheduling)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- audit objective
crgo:CRGO_0000537 a owl:Class ;
    rdfs:label "audit objective"@en,
        "objectif d'audit"@fr ;
    rdfs:subClassOf cco:ont00000476 ;
    skos:definition "An objective stating what an audit engagement is to establish, such as whether access to a system is restricted to authorised users."@en,
        "Objectif précisant ce qu'une mission d'audit doit établir, par exemple si l'accès à un système est réservé aux utilisateurs autorisés."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 13.3 (Engagement Objectives and Scope)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- audit work programme
crgo:CRGO_0000534 a owl:Class ;
    rdfs:label "audit work programme"@en,
        "programme de travail d'audit"@fr ;
    rdfs:subClassOf cco:ont00000974 ;
    skos:altLabel "work program"@en ;
    skos:definition "A reusable plan of audit procedures for a domain, giving objectives, criteria, control references, methods, expected evidence, population and sampling rationale."@en,
        "Plan réutilisable de procédures d'audit pour un domaine, indiquant les objectifs, les critères, les références de mesures, les méthodes, les preuves attendues, la population et la justification de l'échantillonnage."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 8; GIAS Standard 13.6 (Work Program). Not the ISO 19011 'audit programme', which is a set of audits: that is the audit plan here."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- audit criterion
crgo:CRGO_0000538 a owl:Class ;
    rdfs:label "audit criterion"@en,
        "critère d'audit"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A requirement used as the reference against which the condition found is compared, such as a provision, a control objective, a policy statement or an assessment objective."@en,
        "Exigence servant de référence à laquelle la situation constatée est comparée, comme une disposition, un objectif de mesure, un énoncé de politique ou un objectif d'évaluation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 13.4 (Evaluation Criteria); ITAF 1008 (Criteria)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- monitoring exception
crgo:CRGO_0000540 a owl:Class ;
    rdfs:label "monitoring exception"@en,
        "exception de surveillance"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000541 ;
    skos:definition "A record that continuous monitoring, such as a key risk indicator or automated control check, flagged a deviation. It is not an audit finding; it becomes the basis of one only if an audit engagement evaluates it against criteria."@en,
        "Enregistrement indiquant qu'une surveillance continue, comme un indicateur clé de risque ou une vérification automatisée, a signalé un écart. Ce n'est pas une constatation d'audit; il n'en devient le fondement que si une mission d'audit l'évalue au regard de critères."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GRCA section 10 (monitoring exception differs from audit finding)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- audit conclusion
crgo:CRGO_0000542 a owl:Class ;
    rdfs:label "audit conclusion"@en,
        "conclusion d'audit"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A record of the overall result of an audit engagement against its objectives, based on its findings."@en,
        "Enregistrement du résultat global d'une mission d'audit au regard de ses objectifs, fondé sur ses constatations."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 14.5 (Engagement Conclusions)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- audit report
crgo:CRGO_0000543 a owl:Class ;
    rdfs:label "audit report"@en,
        "rapport d'audit"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A document that communicates an audit engagement's objectives, scope, findings, conclusions, recommendations and management responses."@en,
        "Document qui communique les objectifs, le périmètre, les constatations, les conclusions, les recommandations et les réponses de la direction d'une mission d'audit."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 15.1 (Final Engagement Communication); ITAF 1401 (Reporting)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- recommendation
crgo:CRGO_0000544 a owl:Class ;
    rdfs:label "recommendation"@en,
        "recommandation"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A directive proposed by an assessor to address the cause or effect of a finding."@en,
        "Directive proposée par un évaluateur pour remédier à la cause ou à l'effet d'une constatation."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 14.4 (Recommendations and Action Plans)."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- follow-up verification
crgo:CRGO_0000547 a owl:Class ;
    rdfs:label "follow-up verification"@en,
        "vérification de suivi"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A planned act in which an assessor independent of the action owner checks whether a corrective action was implemented and is effective."@en,
        "Acte planifié par lequel un évaluateur indépendant du responsable de l'action vérifie si une action corrective a été mise en œuvre et si elle est efficace."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "GIAS Standard 15.2; ITAF 1402 (Follow-up Activities); ISO 19011:2018 clause 6.7."@en ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en,
        "IIA Global Internal Audit Standards (published 2024-01-09); identifiers and titles cited, text not reproduced"@en,
        "ISACA IT Audit Framework (ITAF), 5th edition (copyright 2026 ISACA); identifiers and titles cited, text not reproduced"@en,
        "ISO 19011:2018, Guidelines for auditing management systems (3rd edition, 2018-07); clause identifiers cited"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- auditable entity
crgo:CRGO_0000532 a owl:Class ;
    rdfs:label "auditable entity"@en,
        "entité auditable"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A description of a unit, process, system, programme or third party that can be the subject of an audit engagement."@en,
        "Description d'une unité, d'un processus, d'un système, d'un programme ou d'un tiers qui peut faire l'objet d'une mission d'audit."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- evidence request
crgo:CRGO_0000539 a owl:Class ;
    rdfs:label "evidence request"@en,
        "demande de preuves"@fr ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A request from an assessor to an identified agent for stated evidence by a stated date."@en,
        "Demande adressée par un évaluateur à un agent identifié pour obtenir des preuves déterminées à une date donnée."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .

# --- finding closure
crgo:CRGO_0000548 a owl:Class ;
    rdfs:label "finding closure"@en,
        "clôture de constatation"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000549 ;
    skos:definition "A dated record that a finding is closed, citing the follow-up verification or the risk acceptance it relies on."@en,
        "Enregistrement daté indiquant qu'une constatation est close, en citant la vérification de suivi ou l'acceptation du risque sur laquelle il s'appuie."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO Governance, Risk, Compliance and Assurance (GRCA) Audit: Claude Implementation Specification (project owner, v1.0, 2026-10-11)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .


    rdfs:label "control test result scheme"@en,
        "schéma : résultat d'évaluation d'une mesure"@fr ;
    skos:definition "Concept scheme of the control test result value set."@en,
        "Schéma de concepts de l'ensemble de valeurs « résultat d'évaluation d'une mesure »."@fr ;

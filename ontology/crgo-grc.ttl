# --- control assessment
crgo:CRGO_0000347 a owl:Class ;
    rdfs:label "control assessment"@en,
        "évaluation d'une mesure de sécurité"@fr ;
    rdfs:subClassOf cco:ont00000228 ;
    owl:disjointWith crgo:CRGO_0000028 ;
    skos:altLabel "control test"@en ;
    skos:definition "A planned act in which an assessor tests or reviews a control measure of an organisation at a stated date, over a stated scope and by a stated procedure, and records its result and the evidence gathered."@en,
        "Acte planifié par lequel un évaluateur teste ou examine une mesure de sécurité d'une organisation à une date, sur un périmètre et selon une procédure donnés, et en consigne le résultat et les preuves recueillies."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Specification section 5 (separate objective, implementation and assessment result): control = objective, control measure = implementation, control assessment = test."@en ;
    crgo:CRGO_0000286 "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en,
        "NIST SP 800-30 Rev. 1 (2012), Appendices D-I (threat sources, events, vulnerabilities and predisposing conditions, likelihood, impact, risk)"@en ;

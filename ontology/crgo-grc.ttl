# --- applicability assessment
crgo:CRGO_0000345 a owl:Class ;
    rdfs:label "applicability assessment"@en,
        "évaluation de l'applicabilité"@fr ;
    rdfs:subClassOf cco:ont00000853 ;
    owl:disjointWith crgo:CRGO_0000346 ;
    skos:definition "A dated record (not the act of assessing) of whether a legal instrument or provision applies to a given organisation, giving the state reached (applicable, not applicable, potentially applicable or unknown) and the conditions found met, not met or undetermined."@en,
        "Enregistrement daté indiquant si un instrument juridique ou une disposition s'applique à une organisation donnée, avec l'état retenu (applicable, non applicable, potentiellement applicable ou inconnu) et les conditions jugées remplies, non remplies ou indéterminées."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000285 "Specification section 9 states; 'unknown' when a needed fact is absent, so missing data never yields 'not applicable'."@en ;
    crgo:CRGO_0000286 "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

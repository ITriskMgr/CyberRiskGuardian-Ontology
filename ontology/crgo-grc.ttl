crgo:CRGO_0000382 a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "applicability state scheme"@en,
        "schéma : état d'applicabilité"@fr ;
    skos:definition "Concept scheme of the applicability state value set."@en,
        "Schéma de concepts de l'ensemble de valeurs « état d'applicabilité »."@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "CRGO v0.8 to v1.0 Claude Implementation Specification (project owner, 2026-10-11), sections 3-13"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.9.0" .


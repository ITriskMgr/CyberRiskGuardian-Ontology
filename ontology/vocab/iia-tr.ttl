    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-THIRD-PARTY-GOV-D a skos:Concept ;
    skos:broader iia-tr:TR-THIRD-PARTY-GOV ;
    skos:definition "Defined protocols give stakeholders timely reports on the performance, risk and legal compliance of risk-prioritized third parties."@en,
        "Des protocoles définis fournissent aux parties prenantes des rapports opportuns sur la performance, les risques et la conformité légale des tiers prioritaires."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;

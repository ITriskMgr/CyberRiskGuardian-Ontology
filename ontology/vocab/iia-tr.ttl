        "Politiques et procédures relatives aux tiers"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-THIRD-PARTY-GOV-B (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-THIRD-PARTY-GOV-C a skos:Concept ;
    skos:broader iia-tr:TR-THIRD-PARTY-GOV ;
    skos:definition "Duties for choosing, managing and overseeing outside parties are assigned, and the competence of assignees is ensured."@en,
        "Les tâches de sélection, de gestion et de surveillance des tiers sont attribuées et la compétence des titulaires est assurée."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-THIRD-PARTY-GOV-C" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;

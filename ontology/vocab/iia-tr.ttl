    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-THIRD-PARTY-GOV-D (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-THIRD-PARTY-RM-A a skos:Concept ;
    skos:broader iia-tr:TR-THIRD-PARTY-RM ;
    skos:definition "Comprehensive, standardized third-party risk processes with clear roles address key risk categories, and deviations are corrected."@en,
        "Des processus complets et normalisés, aux rôles clairs, couvrent les principales catégories de risques liés aux tiers et les écarts sont corrigés."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-THIRD-PARTY-RM-A" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;

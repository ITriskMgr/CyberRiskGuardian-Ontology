    skos:broader iia-tr:TR-THIRD-PARTY-GOV ;
    skos:definition "A formal, periodically reviewed method decides whether to use an outside party, based on criteria about required and available resources."@en,
        "Une méthode formelle, revue périodiquement, détermine le recours à un tiers selon des critères relatifs aux ressources requises et disponibles."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-THIRD-PARTY-GOV-A" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Sourcing decision approach"@en,
        "Démarche de décision d'impartition"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-THIRD-PARTY-GOV-A (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-THIRD-PARTY-GOV-B a skos:Concept ;
    skos:broader iia-tr:TR-THIRD-PARTY-GOV ;
    skos:definition "Policies govern third-party relationships and risks across the life cycle, comply with regulation and are refreshed regularly."@en,
        "Des politiques encadrent les relations et risques liés aux tiers sur tout le cycle de vie, respectent la réglementation et sont mises à jour régulièrement."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-THIRD-PARTY-GOV-B" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;

iia-tr:TR-CYBER-CTL-A a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "Internal and supplier safeguards protect confidentiality, integrity and availability, and their effectiveness is evaluated periodically."@en,
        "Des mesures internes et fournisseurs protègent la confidentialité, l'intégrité et la disponibilité, et leur efficacité est évaluée périodiquement."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-A" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Internal and vendor controls"@en,
        "Contrôles internes et des fournisseurs"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-A (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-CYBER-CTL-B a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "Training and talent processes build and sustain technical cybersecurity skills and are reviewed periodically."@en,
        "Des processus de formation et de gestion des talents développent et maintiennent les compétences techniques en cybersécurité et sont revus périodiquement."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-B" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Cybersecurity talent management"@en,
        "Gestion des talents en cybersécurité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-B (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-CYBER-CTL-C a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "New threats and vulnerabilities are watched and reported on an ongoing basis, and improvements are prioritized and implemented."@en,
        "Les nouvelles menaces et vulnérabilités sont surveillées et signalées en continu, et les améliorations sont priorisées et mises en œuvre."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-C" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Threat and vulnerability monitoring"@en,
        "Surveillance des menaces et vulnérabilités"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-C (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-CYBER-CTL-D a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "Cybersecurity is embedded throughout acquisition, use, upkeep and disposal of hardware, software and vendor services."@en,
        "La cybersécurité est intégrée à l'acquisition, l'utilisation, l'entretien et l'élimination du matériel, des logiciels et des services fournisseurs."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-D" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "IT asset life cycle security"@en,
        "Sécurité du cycle de vie des actifs TI"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-D (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-CYBER-CTL-E a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "Processes cover configuration, device management, encryption, patching, access management and availability monitoring, with security built into development."@en,
        "Des processus couvrent configuration, gestion des appareils, chiffrement, correctifs, gestion des accès et surveillance de disponibilité, la sécurité étant intégrée au développement."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-E" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Security hardening processes"@en,
        "Processus de renforcement de la sécurité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-E (page 4)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-CYBER-CTL-F a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "Network protections such as segmentation, firewalls, restricted external links, VPN or zero trust, IoT safeguards and intrusion detection are in place."@en,
        "Des protections réseau comme la segmentation, les pare-feu, les liens externes restreints, le RPV ou zéro confiance, l'IdO et la détection d'intrusion sont en place."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-F" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Network controls"@en,
        "Contrôles réseau"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-F (page 5)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-tr:TR-CYBER-CTL-G a skos:Concept ;
    skos:broader iia-tr:TR-CYBER-CTL ;
    skos:definition "Channels such as email, browsers, conferencing, messaging, social platforms, cloud services and file sharing are secured."@en,
        "Les canaux tels que courriel, navigateurs, visioconférence, messagerie, médias sociaux, infonuagique et partage de fichiers sont sécurisés."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-tr> ;
    skos:notation "TR-CYBER-CTL-G" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Endpoint communication security"@en,
        "Sécurité des communications des terminaux"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA Topical Requirements, requirement TR-CYBER-CTL-G (page 5)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;

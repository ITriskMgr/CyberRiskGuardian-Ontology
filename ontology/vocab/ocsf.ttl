ocsf:1001 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "File System Activity events report when a process performs an action on a file or folder."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1001" ;
    skos:note "OCSF class name: file_activity"@en ;
    skos:prefLabel "File System Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/file_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1002 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Kernel Extension events report when a driver/extension is loaded or unloaded into the kernel"@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1002" ;
    skos:note "OCSF class name: kernel_extension_activity"@en ;
    skos:prefLabel "Kernel Extension Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/kernel_extension_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1003 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Kernel Activity events report when an process creates, reads, or deletes a kernel resource."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1003" ;
    skos:note "OCSF class name: kernel_activity"@en ;
    skos:prefLabel "Kernel Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/kernel_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1004 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Memory Activity events report when a process has memory allocated, read/modified, or other manipulation activities - such as a buffer overflow or turning off data execution protection (DEP)."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1004" ;
    skos:note "OCSF class name: memory_activity"@en ;
    skos:prefLabel "Memory Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/memory_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1005 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Module Activity events report when an endpoint process acts on a module."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1005" ;
    skos:note "OCSF class name: module_activity"@en ;
    skos:prefLabel "Module Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/module_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1006 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Scheduled Job Activity events report activities related to scheduled jobs or tasks."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1006" ;
    skos:note "OCSF class name: scheduled_job_activity"@en ;
    skos:prefLabel "Scheduled Job Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/scheduled_job_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1007 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Process Activity events report when a process launches, injects, opens or terminates another process, successful or otherwise."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1007" ;
    skos:note "OCSF class name: process_activity"@en ;
    skos:prefLabel "Process Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/process_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1008 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Event Log Activity events report actions pertaining to the system's event logging service(s), such as disabling logging or clearing the log data."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1008" ;
    skos:note "OCSF class name: event_log_actvity"@en ;
    skos:prefLabel "Event Log Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/event_log_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1009 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Script Activity events report when a process executes a script."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1009" ;
    skos:note "OCSF class name: script_activity"@en ;
    skos:prefLabel "Script Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/script_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1010 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Peripheral Activity events log a system's interactions with external, connectable, and detachable hardware. These events provide visibility into the external devices connected to and used by a system."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1010" ;
    skos:note "OCSF class name: peripheral_activity"@en ;
    skos:prefLabel "Peripheral Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/peripheral_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1011 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Device Power State Activity events report activities related to power state changes of a system."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1011" ;
    skos:note "OCSF class name: device_power_state_activity"@en ;
    skos:prefLabel "Device Power State Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/device_power_state_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:1012 a skos:Concept ;
    skos:broader ocsf:1 ;
    skos:definition "Clipboard Activity events report when a process performs an action on a clipboard."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "1012" ;
    skos:note "OCSF class name: clipboard_activity"@en ;
    skos:prefLabel "Clipboard Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/system/clipboard_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2001 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "Security Finding events describe findings, detections, anomalies, alerts and/or actions performed by security products"@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2001" ;
    skos:note "OCSF class name: security_finding"@en ;
    skos:prefLabel "Security Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/security_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2002 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "The Vulnerability Finding event is a notification about weakness in an information system, system security procedures, internal controls, or implementation that could be exploited or triggered by a threat source. Note: if the event producer is a security control, the security_control profile should be applied and its attacks information, if present, should be duplicated into the finding_info object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the incident profile  or aggregate this finding into an Incident Finding."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2002" ;
    skos:note "OCSF class name: vulnerability_finding"@en ;
    skos:prefLabel "Vulnerability Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/vulnerability_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2003 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "Compliance Finding events describe results of evaluations performed against resources, to check compliance with various Industry Frameworks or Security Standards such as NIST SP 800-53, CIS AWS Foundations Benchmark v1.4.0, ISO/IEC 27001 etc. Note: if the event producer is a security control, the security_control profile should be applied and its attacks information, if present, should be duplicated into the finding_info object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the incident profile or aggregate this finding into an Incident Finding."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2003" ;
    skos:note "OCSF class name: compliance_finding"@en ;
    skos:prefLabel "Compliance Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/compliance_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2004 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "A Detection Finding describes detections or alerts generated by security products using correlation engines, detection engines or other methodologies.<br><strong>Note: </strong>If the event producer is a security control, the Security Control profile should be applied and its attacks information, if present, should be duplicated into the finding_info object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the Incident profile or aggregate the finding into an Incident Finding.<p><strong>Note: </strong>Findings are mutable and as such have a lifecycle, via Update activities. When modeling atomic alerts, you are encouraged to consider using the Security Control profile with the activity event associated with the alert. See the referenced article below."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2004" ;
    skos:note "OCSF class name: detection_finding"@en ;
    skos:prefLabel "Detection Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/detection_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2005 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "An Incident Finding reports the creation, update, or closure of security incidents as a result of detections and/or analytics. <br><strong>Note: </strong>Incident Finding implicitly includes the incident profile and it should be added to the metadata.profiles[] array."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2005" ;
    skos:note "OCSF class name: incident_finding"@en ;
    skos:prefLabel "Incident Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/incident_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2006 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "A Data Security Finding describes detections or alerts generated by various data security products such as Data Loss Prevention (DLP), Data Classification, Secrets Management, Digital Rights Management (DRM), Data Security Posture Management (DSPM), and similar tools. These detections or alerts can be created using fingerprinting, statistical analysis, machine learning or other methodologies. The finding describes the actors and endpoints who accessed or own the sensitive data, as well as the resources which store the sensitive data. Note: if the event producer is a security control, the security_control profile should be applied and its attacks information, if present, should be duplicated into the finding_info object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the incident profile  or aggregate this finding into an Incident Finding."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2006" ;
    skos:note "OCSF class name: data_security_finding"@en ;
    skos:prefLabel "Data Security Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/data_security_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2007 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "The Application Security Posture Finding event is a notification about any bug, defect, deficiency, exploit, vulnerability, weakness or any other issue with software and related systems. Application Security Posture Findings typically involve reporting on the greater context including compliance, impacted resources, remediation guidance, specific code defects, and/or vulnerability metadata. Application Security Posture Findings can be reported by Threat & Vulnerability Management (TVM) tools, Application Security Posture Management (ASPM) tools, or other similar tools. Note: if the event producer is a security control, the security_control profile should be applied and its attacks information, if present, should be duplicated into the finding_info object. <br><strong>Note: </strong>If the Finding is an incident, i.e. requires incident workflow, also apply the incident profile or aggregate this finding into an Incident Finding."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2007" ;
    skos:note "OCSF class name: application_security_posture_finding"@en ;
    skos:prefLabel "Application Security Posture Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/application_security_posture_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2008 a skos:Concept ;
    skos:broader ocsf:2 ;
    skos:definition "This finding represents an IAM analysis result, which evaluates IAM policies, access patterns, and IAM configurations for potential security risks. The analysis can focus on either an identity (user, role, service account) or a resource to assess permissions, access patterns, and security posture within the IAM domain. <br><strong>Note:</strong> Use permission_analysis_results for identity-centric analysis (evaluating what an identity can do) and access_analysis_result for resource-centric analysis (evaluating who can access a resource). These complement each other for comprehensive IAM security assessment.<br><strong>Note:</strong> If the Finding is an incident, i.e. requires incident workflow, also apply the incident profile or aggregate this finding into an Incident Finding."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2008" ;
    skos:note "OCSF class name: iam_analysis_finding"@en ;
    skos:prefLabel "IAM Analysis Finding"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/findings/iam_analysis_finding.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3001 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "Account Change events report when specific user account management tasks are performed, such as a user/role being created or role assigned, changed, deleted, renamed, disabled, enabled, locked out or unlocked."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3001" ;
    skos:note "OCSF class name: account_change"@en ;
    skos:prefLabel "Account Change"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/account_change.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3002 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "Authentication events report authentication session activities, including user attempts to log on or log off, regardless of success, as well as other key stages within the authentication process. These events are typically generated by authentication services, such as Kerberos, OIDC, or SAML, and may include information about the user, the authentication method used, and the status of the authentication attempt."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3002" ;
    skos:note "OCSF class name: authentication"@en ;
    skos:prefLabel "Authentication"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/authentication.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3003 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "Authorize Session events report privileges, groups or roles assigned to a new user session, usually at login time."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3003" ;
    skos:note "OCSF class name: authorize_session"@en ;
    skos:prefLabel "Authorize Session"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/authorize_session.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3004 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "Entity Management events report activity by a managed client, a micro service, or a user at a management console. The activity can be a create, read, update, and delete operation on a managed entity."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3004" ;
    skos:note "OCSF class name: entity_management"@en ;
    skos:prefLabel "Entity Management"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/entity_management.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3005 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "User Access Management events report management updates to a user's privileges."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3005" ;
    skos:note "OCSF class name: user_access"@en ;
    skos:prefLabel "User Access Management"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/user_access.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3006 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "Group Management events report lifecycle management of a group, as well as privileges, roles, and resources associated with the group. There are two ways updates to the state of a group may be expressed: Using the Update activity, for example when updating multiple items at one time, the updated_group reflects the changes made to group. Using discrete activities, such as Assign Privileges the state change is expressed by the privileges attribute. Optionally, on success, the updated_group reflects the new state of the group."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3006" ;
    skos:note "OCSF class name: group_management"@en ;
    skos:prefLabel "Group Management"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/group_management.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3007 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "User Management events report lifecycle management of a user and account management tasks that are performed, such as a password change or reset, a user being created, updated, deleted, disabled, enabled, locked out or unlocked. There are two ways updates to the state of a user may be expressed: Using the Update activity, for example when updating multiple items at one time, the updated_user reflects the changes made to user. Using discrete activities, such as Assign Privileges the state change is expressed by the privileges attribute. Optionally, on successful changes, the updated_user reflects the new state of the user."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3007" ;
    skos:note "OCSF class name: user_management"@en ;
    skos:prefLabel "User Management"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/iam/user_management.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:3008 a skos:Concept ;
    skos:broader ocsf:3 ;
    skos:definition "Role Management events report lifecycle management of a role, as well as privileges, policies, credentials, and resources associated with the role. There are two ways updates to the state of a role may be expressed: Using the Update activity, for example when updating multiple items at one time, the updated_role reflects the changes made to iam_role. Using discrete activities, such as Assign Privileges the state change is expressed by the privileges attribute. Optionally, on success, the updated_role reflects the new state of the role. Roles assigned or removed from users and groups are expressed by the User Management and Group Management classes."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "3008" ;
    skos:note "OCSF class name: role_management"@en ;
    skos:prefLabel "Role Management"@en ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6 a skos:Concept ;
    skos:definition "Application Activity events report detailed information about the behavior of applications and services."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;

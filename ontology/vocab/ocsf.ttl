    crgo:CRGO_0000291 "0.10.0" .

ocsf:5021 a skos:Concept ;
    skos:broader ocsf:5 ;
    skos:definition "OSINT Inventory Info events report open source intelligence or threat intelligence inventory data that is either logged or proactively collected. For example, when collecting OSINT information from Threat Intelligence Platforms (TIPs) or Extended Detection and Response (XDR) platforms, or collecting data from OSINT or other generic threat intelligence and enrichment feeds such as APIs and datastores."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "5021" ;
    skos:note "OCSF class name: osint_inventory_info"@en ;
    skos:prefLabel "OSINT Inventory Info"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/discovery/osint_inventory_info.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:5022 a skos:Concept ;
    skos:broader ocsf:5 ;
    skos:definition "Startup Item Query events report information about discovered items, e.g., application components that are generally configured to run automatically."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "5022" ;
    skos:note "OCSF class name: startup_item_query"@en ;
    skos:prefLabel "Startup Item Query"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/discovery/startup_item_query.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:5023 a skos:Concept ;
    skos:broader ocsf:5 ;
    skos:definition "Cloud Resources Inventory Info events report cloud asset inventory data. This data can be either logged or proactively collected. For example, use this event class when creating an inventory of cloud resource information from a Configuration Management Database (CMDB), Cyber Asset Attack Surface Management (CAASM), direct public cloud service provider APIs, Software-as-a-Service (SaaS) APIs, or otherwise."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "5023" ;
    skos:note "OCSF class name: cloud_resources_inventory_info"@en ;
    skos:prefLabel "Cloud Resources Inventory Info"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/discovery/cloud_resources_inventory_info.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:5040 a skos:Concept ;
    skos:broader ocsf:5 ;
    skos:definition "Data collected directly from devices that represents forensic information pulled, queried, or discovered from devices that may indicate malicious activity. It contains a number of child objects, each representing a distinct evidence domain (network connections, file artifacts, registry entries, etc.). When mapping raw telemetry data users should select Query Evidence and then the appropriate child object that best matches the evidence type."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "5040" ;
    skos:note "OCSF class name: evidence_info"@en ;
    skos:prefLabel "Live Evidence Info"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/discovery/evidence_info.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6001 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "Web Resources Activity events describe actions executed on a set of Web Resources."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6001" ;
    skos:note "OCSF class name: web_resources_activity"@en ;
    skos:prefLabel "Web Resources Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/web_resources_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6002 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "Application Lifecycle events report installation, removal, start, stop of an application or service."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6002" ;
    skos:note "OCSF class name: application_lifecycle"@en ;
    skos:prefLabel "Application Lifecycle"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/application_lifecycle.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6003 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "API events describe general CRUD (Create, Read, Update, Delete) API activities, e.g. (AWS Cloudtrail)"@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6003" ;
    skos:note "OCSF class name: api_activity"@en ;
    skos:prefLabel "API Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/api_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6004 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "Web Resource Access Activity events describe successful/failed attempts to access a web resource over HTTP."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6004" ;
    skos:note "OCSF class name: web_resource_access_activity"@en ;
    skos:prefLabel "Web Resource Access Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

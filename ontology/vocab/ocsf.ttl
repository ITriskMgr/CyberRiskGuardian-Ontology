    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/file_hosting.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6007 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "Scan events report the start, completion, and results of a scan job. The scan event includes the number of items that were scanned and the number of detections that were resolved."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6007" ;
    skos:note "OCSF class name: scan_activity"@en ;
    skos:prefLabel "Scan Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/scan_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6008 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "Application Error events describe issues with an applications. The error message should be put in the event's message attribute. The metadata.product attribute can be used to capture the originating application information. The host profile can used to include the generating device information. This class is helpful for applications that generate or handle OCSF events and can also be used for errors in upstream products and services."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6008" ;
    skos:note "OCSF class name: application_error"@en ;
    skos:prefLabel "Application Error"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/application_error.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:7001 a skos:Concept ;
    skos:broader ocsf:7 ;
    skos:definition "Remediation Activity events report on attempts at remediating a compromised device or computer network."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "7001" ;
    skos:note "OCSF class name: remediation_activity"@en ;
    skos:prefLabel "Remediation Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/remediation/remediation_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:7002 a skos:Concept ;
    skos:broader ocsf:7 ;
    skos:definition "File Remediation Activity events report on attempts at remediating files. Sub-techniques of countermeasures will include File, such as File Removal or Restore File."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "7002" ;
    skos:note "OCSF class name: file_remediation_activity"@en ;
    skos:prefLabel "File Remediation Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/remediation/file_remediation_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:7003 a skos:Concept ;
    skos:broader ocsf:7 ;
    skos:definition "Process Remediation Activity events report on attempts at remediating processes. Sub-techniques of countermeasures will include Process Eviction, such as Process Termination or Kernel-based Process Isolation."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "7003" ;
    skos:note "OCSF class name: process_remediation_activity"@en ;
    skos:prefLabel "Process Remediation Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/remediation/process_remediation_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:7004 a skos:Concept ;
    skos:broader ocsf:7 ;
    skos:definition "Network Remediation Activity events report on attempts at remediating computer networks. Techniques and Sub-techniques of countermeasures will include Network, such as Network Isolation or Network Traffic Filtering."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "7004" ;
    skos:note "OCSF class name: network_remediation_activity"@en ;
    skos:prefLabel "Network Remediation Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/remediation/network_remediation_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:8001 a skos:Concept ;
    skos:broader ocsf:8 ;
    skos:definition "Drone Flights Activity events report the activity of Unmanned Aerial Systems (UAS), their Operators, and mission-planning and authorization metadata as reported by the UAS platforms themselves, by Counter-UAS (CUAS) systems, or other remote monitoring or sensing infrastructure. Based on the Remote ID defined in Standard Specification for Remote ID and Tracking (ASTM Designation: F3411-22a)."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "8001" ;
    skos:note "OCSF class name: drone_flights_activity"@en ;
    skos:prefLabel "Drone Flights Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/unmanned_systems/drone_flights_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:8002 a skos:Concept ;
    skos:broader ocsf:8 ;
    skos:definition "Airborne Broadcast Activity events report the activity of any aircraft or unmanned system as reported and tracked by Automatic Dependent Surveillance - Broadcast (ADS-B) receivers. Based on the ADS-B standards described in Code of Federal Regulations (CFR) Title 14 Chapter I Subchapter F Part 91 and in other general Federal Aviation Administration (FAA) supplemental orders and guidance."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "8002" ;
    skos:note "OCSF class name: airborne_broadcast_activity"@en ;
    skos:prefLabel "Airborne Broadcast Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/unmanned_systems/airborne_broadcast_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:8 a skos:Concept ;
    skos:definition "Unmanned Systems events report the activity, existence, and/or state of unmanned systems for tracking, mission planning, and other related activities."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "8" ;
    skos:note "OCSF category name: unmanned_systems"@en ;
    skos:prefLabel "Unmanned Systems"@en ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/ocsf> ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:7 a skos:Concept ;
    skos:definition "Remediation events report the results of remediation commands targeting files, processes, and other objects."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "7" ;
    skos:note "OCSF category name: remediation"@en ;
    skos:prefLabel "Remediation"@en ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6005 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "Datastore events describe general activities (Read, Update, Query, Delete, etc.) which affect datastores or data within those datastores, e.g. (AWS RDS, AWS S3)."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6005" ;
    skos:note "OCSF class name: datastore_activity"@en ;
    skos:prefLabel "Datastore Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "OCSF 1.9.0 events/application/datastore_activity.json"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:6006 a skos:Concept ;
    skos:broader ocsf:6 ;
    skos:definition "File Hosting Activity events report the actions taken by file management applications, including file sharing servers like Sharepoint and services such as Box, MS OneDrive, Google Drive, or network file share services."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "6006" ;
    skos:note "OCSF class name: file_hosting"@en ;
    skos:prefLabel "File Hosting Activity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000068 ;

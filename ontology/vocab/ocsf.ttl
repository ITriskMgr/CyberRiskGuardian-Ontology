    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000291 "0.10.0" .

ocsf:2 a skos:Concept ;
    skos:definition "Findings events report findings, detections, and possible resolutions of malware, anomalies, or other actions performed by security products."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;
    skos:notation "2" ;

    crgo:CRGO_0000291 "0.10.0" .

ocsf:3 a skos:Concept ;
    skos:definition "Identity & Access Management (IAM) events relate to the supervision of the system's authentication and access control model. Examples of such events are the success or failure of authentication, granting of authority, password change, entity change, privileged use etc."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/ocsf> ;

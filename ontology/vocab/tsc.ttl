    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC3.3 a skos:Concept ;
    skos:broader tsc:TSC-CC3 ;
    skos:definition "Fraud potential is taken into account when assessing risks to objectives; aligned with COSO 2013 principle 8."@en,

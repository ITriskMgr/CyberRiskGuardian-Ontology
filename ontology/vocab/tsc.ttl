    crgo:CRGO_0000286 "AICPA 2017 TSC, criterion TSC-CC1.3 (page 16)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC1.4 a skos:Concept ;
    skos:broader tsc:TSC-CC1 ;
    skos:definition "The entity attracts, develops and keeps capable people consistent with its objectives; aligned with COSO 2013 principle 4."@en,
        "L'entité attire, développe et fidélise des personnes compétentes en cohérence avec ses objectifs; correspond au principe 4 du COSO 2013."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;

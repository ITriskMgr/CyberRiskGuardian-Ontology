    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC6.5 a skos:Concept ;
    skos:broader tsc:TSC-CC6 ;
    skos:definition "Protections on physical assets are removed only after data on them can no longer be read or recovered."@en,

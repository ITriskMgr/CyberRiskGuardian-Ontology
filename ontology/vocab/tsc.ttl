    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC6.3 a skos:Concept ;
    skos:broader tsc:TSC-CC6 ;
    skos:definition "Access to protected assets is granted, changed or withdrawn according to roles, applying least privilege and separation of duties."@en,
        "L'accès aux actifs protégés est accordé, modifié ou retiré selon les rôles, en appliquant le moindre privilège et la séparation des tâches."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-CC6.3" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Role-based access authorization"@en,
        "Autorisation des accès selon les rôles"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC1.1 a skos:Concept ;
    skos:broader tsc:TSC-CC1 ;
    skos:definition "The entity shows through conduct and standards that it values integrity and ethical behaviour; aligned with COSO 2013 principle 1."@en,
        "L'entité montre par sa conduite et ses normes qu'elle valorise l'intégrité et un comportement éthique; correspond au principe 1 du COSO 2013."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-CC1.1" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Integrity and ethics commitment"@en,
        "Engagement envers l'intégrité et l'éthique"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "AICPA 2017 TSC, criterion TSC-CC1.1 (page 14)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC1.2 a skos:Concept ;
    skos:broader tsc:TSC-CC1 ;
    skos:definition "The board stays independent of management and oversees how internal control is designed and performs; aligned with COSO 2013 principle 2."@en,
        "Le conseil demeure indépendant de la direction et surveille la conception et le fonctionnement du contrôle interne; correspond au principe 2 du COSO 2013."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-CC1.2" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Board independence and oversight"@en,
        "Indépendance et surveillance du conseil"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "AICPA 2017 TSC, criterion TSC-CC1.2 (page 15)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC1.3 a skos:Concept ;
    skos:broader tsc:TSC-CC1 ;
    skos:definition "Management, overseen by the board, sets up organizational structures, reporting lines and delegated authority to pursue objectives; aligned with COSO 2013 principle 3."@en,
        "Sous la surveillance du conseil, la direction établit les structures, les liens hiérarchiques et les délégations de pouvoir nécessaires aux objectifs; correspond au principe 3 du COSO 2013."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;

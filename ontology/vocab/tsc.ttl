<https://w3id.org/crgo/vocab/tsc> a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:date "2026-10-08"^^xsd:date ;
    dcterms:publisher "AICPA" ;
    dcterms:rights "Identifiers and headings (c) AICPA, cited for reference and mapping only under the project owner's licence to use the document; definitions are CRGO paraphrases. No text is reproduced."@en ;
    dcterms:source "AICPA TSP section 100 (data/frameworks/grca/tsc.tsv)" ;
    dcterms:title "AICPA 2017 Trust Services Criteria (revised points of focus, 2022)"@en,
        "Critères des services de confiance 2017 de l'AICPA (points d'attention révisés, 2022)"@fr ;
    owl:versionIRI <https://w3id.org/crgo/vocab/0.9.0/tsc> ;
    owl:versionInfo "2017 (points of focus revised 2022)" ;
    skos:hasTopConcept tsc:TSC-AVL,
        tsc:TSC-CONF,
        tsc:TSC-PI,
        tsc:TSC-PRIV,
        tsc:TSC-SEC ;
    skos:scopeNote "Categories and criterion groups carry official headings; criteria carry CRGO labels. CC1-CC5 definitions name the COSO 2013 principle each criterion states it relates to. The common criteria (CC1-CC9) are placed under Security although they apply to every category. Definitions are CRGO paraphrases written for this vocabulary; no text of the standard is reproduced. Obtain the standard from its publisher."@en .


tsc:TSC-A1.1 a skos:Concept ;
    skos:broader tsc:TSC-A1 ;
    skos:definition "Current capacity and component usage are tracked and evaluated so demand can be met and capacity expanded when needed."@en,
        "La capacité actuelle et l'utilisation des composants sont suivies et évaluées afin de répondre à la demande et d'accroître la capacité au besoin."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-A1.1" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Capacity management"@en,
        "Gestion de la capacité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "AICPA 2017 TSC, criterion TSC-A1.1 (page 50)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-A1.2 a skos:Concept ;
    skos:broader tsc:TSC-A1 ;
    skos:definition "Environmental safeguards, backup processes and recovery infrastructure are established, operated and monitored to sustain availability."@en,
        "Les protections environnementales, les processus de sauvegarde et l'infrastructure de reprise sont mis en place, exploités et surveillés pour assurer la disponibilité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-A1.2" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Environmental protection, backup and recovery infrastructure"@en,
        "Protection environnementale, sauvegarde et infrastructure de reprise"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "AICPA 2017 TSC, criterion TSC-A1.2 (page 50)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-A1.3 a skos:Concept ;
    skos:broader tsc:TSC-A1 ;
    skos:definition "Procedures in the recovery plan are tested to confirm the system can be restored."@en,
        "Les procédures du plan de reprise sont mises à l'essai pour confirmer que le système peut être rétabli."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-A1.3" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "Recovery plan testing"@en,
        "Essais du plan de reprise"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "AICPA 2017 TSC, criterion TSC-A1.3 (page 52)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-C1.1 a skos:Concept ;
    skos:broader tsc:TSC-C1 ;
    skos:definition "Information deemed confidential is identified and safeguarded according to confidentiality objectives."@en,
        "L'information jugée confidentielle est repérée et protégée selon les objectifs de confidentialité."@fr ;

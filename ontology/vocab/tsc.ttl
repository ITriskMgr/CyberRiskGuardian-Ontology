    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-C1.2 a skos:Concept ;
    skos:broader tsc:TSC-C1 ;
    skos:definition "Confidential information is destroyed or discarded in line with confidentiality objectives."@en,
        "L'information confidentielle est détruite ou éliminée conformément aux objectifs de confidentialité."@fr ;

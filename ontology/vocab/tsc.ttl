    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC6.2 a skos:Concept ;
    skos:broader tsc:TSC-CC6 ;
    skos:definition "Users are registered and authorized before receiving credentials, and their credentials are revoked once access is no longer justified."@en,
        "Les utilisateurs sont inscrits et autorisés avant de recevoir des identifiants, lesquels sont révoqués dès que l'accès n'est plus justifié."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;
    skos:notation "TSC-CC6.2" ;
    skos:note "Label written by CRGO: the source gives no heading for this item."@en ;
    skos:prefLabel "User registration and credential lifecycle"@en,
        "Inscription des utilisateurs et cycle de vie des identifiants"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC6.4 a skos:Concept ;
    skos:broader tsc:TSC-CC6 ;
    skos:definition "Physical entry to facilities and sensitive asset locations is limited to authorized staff."@en,
        "L'entrée physique dans les installations et les lieux abritant des actifs sensibles est réservée au personnel autorisé."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/tsc> ;

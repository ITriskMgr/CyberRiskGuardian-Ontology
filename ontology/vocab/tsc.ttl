    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

tsc:TSC-CC1.5 a skos:Concept ;
    skos:broader tsc:TSC-CC1 ;
    skos:definition "Individuals are held answerable for their internal control duties in pursuing objectives; aligned with COSO 2013 principle 5."@en,
        "Chaque personne répond de ses obligations en matière de contrôle interne dans la poursuite des objectifs; correspond au principe 5 du COSO 2013."@fr ;

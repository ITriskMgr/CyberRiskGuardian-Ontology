<https://w3id.org/crgo/vocab/pattern-links> a owl:Ontology ;
    dcterms:description "Links from the crgo-context scenario patterns to ATT&CK, CWE, SP 800-53 Rev. 5, CIS v8.1 and the scenario themes. Each link is a CRGO judgement with its confidence and status (approved by the project owner on 2026-11-02, group pattern-links); a control link never shows that the control is in place."@en ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:title "CRGO scenario patterns: techniques, weaknesses, controls and themes"@en,
        "Patrons de scénario de CRGO : techniques, faiblesses, mesures et thèmes"@fr ;
    owl:imports crgo:crgo-context ;
    owl:versionIRI <https://w3id.org/crgo/vocab/0.11.0/pattern-links> ;
    owl:versionInfo "0.11.0" .


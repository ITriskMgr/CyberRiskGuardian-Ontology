    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-356 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/356.html> ;
    skos:broader cwe:CWE-221 ;
    skos:definition "The product's user interface does not warn the user before undertaking an unsafe action on behalf of that user. This makes it easier for attackers to trick users into inflicting damage to their system."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-356" ;
    skos:prefLabel "Product UI does not Warn User of Unsafe Actions"@en ;

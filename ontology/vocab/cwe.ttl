    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/426.html> ;
    skos:broader cwe:CWE-642 ;
    skos:definition "The product searches for critical resources using an externally-supplied search path that can point to resources that are not under the product's direct control."@en ;

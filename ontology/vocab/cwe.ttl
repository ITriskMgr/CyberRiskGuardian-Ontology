cwe:CWE-1209 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1209.html> ;
    skos:broader cwe:CWE-710 ;
    skos:definition "The reserved bits in a hardware design are not disabled prior to production. Typically, reserved bits are used for future capabilities and should not support any functional logic in the design. However, designers might covertly use these bits to debug or further develop new capabilities in production hardware. Adversaries with access to these bits will write to them in hopes of compromising hardware state."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1209" ;
    skos:prefLabel "Failure to Disable Reserved Bits"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

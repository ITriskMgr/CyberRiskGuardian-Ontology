cwe:CWE-510 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/510.html> ;
    skos:broader cwe:CWE-506 ;
    skos:definition "A trapdoor is a hidden piece of code that responds to a special input, allowing its user access to resources without passing through the normal security enforcement mechanism."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-510" ;
    skos:prefLabel "Trapdoor"@en ;

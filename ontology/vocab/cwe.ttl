cwe:CWE-1047 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1047.html> ;
    skos:broader cwe:CWE-1120 ;
    skos:definition "The product contains modules in which one module has references that cycle back to itself, i.e., there are circular dependencies."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1047" ;
    skos:prefLabel "Modules with Circular Dependencies"@en ;

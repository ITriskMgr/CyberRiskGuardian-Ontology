    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/297.html> ;
    skos:broader cwe:CWE-295 ;
    skos:definition "The product communicates with a host that provides a certificate, but the product does not properly ensure that the certificate is actually associated with that host."@en ;

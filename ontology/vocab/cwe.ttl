    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1233.html> ;
    skos:broader cwe:CWE-284 ;
    skos:definition "The product uses a register lock bit protection mechanism, but it does not ensure that the lock bit prevents modification of system registers or controls that perform changes to important hardware system configuration."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1233" ;
    skos:prefLabel "Security-Sensitive Hardware Controls with Missing Lock Bit Protection"@en ;

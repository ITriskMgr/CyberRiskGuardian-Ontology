    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/37.html> ;
    skos:broader cwe:CWE-36 ;
    skos:definition "The product accepts input in the form of a slash absolute path ('/absolute/pathname/here') without appropriate validation, which can allow an attacker to traverse the file system to unintended locations or access arbitrary files."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

cwe:CWE-1254 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1254.html> ;
    skos:broader cwe:CWE-208 ;
    skos:definition "The product's comparison logic is performed over a series of steps rather than across the entire string in one operation. If there is a comparison logic failure on one of these steps, the operation may be vulnerable to a timing attack that can result in the interception of the process for nefarious purposes."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1254" ;
    skos:prefLabel "Incorrect Comparison Logic Granularity"@en ;

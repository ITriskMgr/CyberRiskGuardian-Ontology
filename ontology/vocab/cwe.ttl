cwe:CWE-372 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/372.html> ;
    skos:broader cwe:CWE-664 ;
    skos:definition "The product does not properly determine which state it is in, causing it to assume it is in state X when in fact it is in state Y, causing it to perform incorrect operations in a security-relevant manner."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-372" ;
    skos:prefLabel "Incomplete Internal State Distinction"@en ;

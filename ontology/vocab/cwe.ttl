    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-774 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/774.html> ;
    skos:broader cwe:CWE-770 ;
    skos:definition "The product allocates file descriptors or handles on behalf of an actor without imposing any restrictions on how many descriptors can be allocated, in violation of the intended security policy for that actor."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-774" ;
    skos:prefLabel "Allocation of File Descriptors or Handles Without Limits or Throttling"@en ;

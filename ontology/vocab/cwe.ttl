    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/118.html> ;
    skos:broader cwe:CWE-664 ;
    skos:definition "The product does not restrict or incorrectly restricts operations within the boundaries of a resource that is accessed using an index or pointer, such as memory or files."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-118" ;

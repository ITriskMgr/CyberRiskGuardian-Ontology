    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1257.html> ;
    skos:broader cwe:CWE-284 ;
    skos:definition "Aliased or mirrored memory regions in hardware designs may have inconsistent read/write permissions enforced by the hardware. A possible result is that an untrusted agent is blocked from accessing a memory region but is not blocked from accessing the corresponding aliased memory region. "@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1257" ;
    skos:prefLabel "Improper Access Control Applied to Mirrored or Aliased Memory Regions"@en ;

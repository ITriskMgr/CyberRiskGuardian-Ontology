    skos:broader cwe:CWE-20 ;
    skos:definition "The product receives input that is expected to specify a quantity (such as size or length), but it does not validate or incorrectly validates that the quantity has the required properties."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1284" ;
    skos:prefLabel "Improper Validation of Specified Quantity in Input"@en ;

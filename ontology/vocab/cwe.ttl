    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/509.html> ;
    skos:broader cwe:CWE-507 ;
    skos:definition "Replicating malicious code, including viruses and worms, will attempt to attack other systems once it has successfully compromised the target system or the product."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-509" ;
    skos:prefLabel "Replicating Malicious Code (Virus or Worm)"@en ;

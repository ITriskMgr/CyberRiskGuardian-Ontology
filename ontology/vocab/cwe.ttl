cwe:CWE-775 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/775.html> ;
    skos:broader cwe:CWE-772 ;
    skos:definition "The product does not release a file descriptor or handle after its effective lifetime has ended, i.e., after the file descriptor/handle is no longer needed."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-775" ;
    skos:prefLabel "Missing Release of File Descriptor or Handle after Effective Lifetime"@en ;

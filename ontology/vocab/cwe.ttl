    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-353 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/353.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The product uses a transmission protocol that does not include a mechanism for verifying the integrity of the data during transmission, such as a checksum."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-353" ;
    skos:prefLabel "Missing Support for Integrity Check"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

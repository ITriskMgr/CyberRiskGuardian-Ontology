cwe:CWE-435 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/435.html> ;
    skos:definition "An interaction error occurs when two entities have correct behavior when running independently of each other, but when they are integrated as components in a larger system or process, they introduce incorrect behaviors that may cause resultant weaknesses."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-435" ;

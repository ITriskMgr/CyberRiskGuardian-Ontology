    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/28.html> ;
    skos:broader cwe:CWE-23 ;
    skos:definition "The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize \"..\\\" sequences that can resolve to a location that is outside of that directory."@en ;

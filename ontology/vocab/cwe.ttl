    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1253.html> ;
    skos:broader cwe:CWE-693 ;
    skos:definition "The logic level used to set a system to a secure state relies on a fuse being unblown. An attacker can set the system to an insecure state merely by blowing the fuse."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1253" ;
    skos:prefLabel "Incorrect Selection of Fuse Values"@en ;

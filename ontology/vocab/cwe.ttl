cwe:CWE-521 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/521.html> ;
    skos:broader cwe:CWE-1391 ;
    skos:definition "The product does not require that users should have strong passwords, which makes it easier for attackers to compromise user accounts."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-521" ;
    skos:prefLabel "Weak Password Requirements"@en ;

    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-773 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/773.html> ;
    skos:broader cwe:CWE-771 ;
    skos:definition "The product does not properly maintain references to a file descriptor or handle, which prevents that file descriptor/handle from being reclaimed."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-773" ;
    skos:prefLabel "Missing Reference to Active File Descriptor or Handle"@en ;

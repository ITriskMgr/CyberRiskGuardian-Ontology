cwe:CWE-1188 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1188.html> ;
    skos:broader cwe:CWE-665 ;
    skos:definition "The product initializes or sets a resource with a default that is intended to be changed by the administrator, but the default is not secure."@en ;

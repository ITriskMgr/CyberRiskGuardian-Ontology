cwe:CWE-367 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/367.html> ;
    skos:broader cwe:CWE-362 ;
    skos:definition "The product checks the state of a resource before using that resource, but the resource's state can change between the check and the use in a way that invalidates the results of the check. This can cause the product to perform invalid actions when the resource is in an unexpected state."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-367" ;
    skos:prefLabel "Time-of-check Time-of-use (TOCTOU) Race Condition"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-407 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/407.html> ;
    skos:broader cwe:CWE-405 ;
    skos:definition "An algorithm in a product has an inefficient worst-case computational complexity that may be detrimental to system performance and can be triggered by an attacker, typically using crafted manipulations that ensure that the worst case is being reached."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-407" ;
    skos:prefLabel "Inefficient Algorithmic Complexity"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;

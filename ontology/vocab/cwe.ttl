cwe:CWE-565 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/565.html> ;
    skos:broader cwe:CWE-602 ;
    skos:definition "The product relies on the existence or values of cookies when performing security-critical operations, but it does not properly ensure that the setting is valid for the associated user."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-565" ;
    skos:prefLabel "Reliance on Cookies without Validation and Integrity Checking"@en ;

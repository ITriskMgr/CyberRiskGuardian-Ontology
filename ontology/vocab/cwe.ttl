    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/645.html> ;
    skos:broader cwe:CWE-287 ;
    skos:definition "The product contains an account lockout protection mechanism, but the mechanism is too restrictive and can be triggered too easily, which allows attackers to deny service to legitimate users by causing their accounts to be locked out."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-645" ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/301.html> ;
    skos:broader cwe:CWE-1390 ;
    skos:definition "Simple authentication protocols are subject to reflection attacks if a malicious user can use the target machine to impersonate a trusted user."@en ;

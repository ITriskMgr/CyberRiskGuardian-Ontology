cwe:CWE-689 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/689.html> ;
    skos:broader cwe:CWE-362 ;
    skos:definition "The product, while copying or cloning a resource, does not set the resource's permissions or access control until the copy is complete, leaving the resource exposed to other spheres while the copy is taking place."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-689" ;
    skos:prefLabel "Permission Race Condition During Resource Copy"@en ;

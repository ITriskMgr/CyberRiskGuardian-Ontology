cwe:CWE-508 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/508.html> ;
    skos:broader cwe:CWE-507 ;
    skos:definition "Non-replicating malicious code only resides on the target system or product that is attacked; it does not attempt to spread to other systems."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-508" ;
    skos:prefLabel "Non-Replicating Malicious Code"@en ;

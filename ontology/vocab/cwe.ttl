cwe:CWE-360 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/360.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "Security based on event locations are insecure and can be spoofed."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-360" ;
    skos:prefLabel "Trust of System Event Data"@en ;

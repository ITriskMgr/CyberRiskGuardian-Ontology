    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1256.html> ;
    skos:broader cwe:CWE-285 ;
    skos:definition "The product provides software-controllable device functionality for capabilities such as power and clock management, but it does not properly limit functionality that can lead to modification of hardware memory or register bits, or the ability to observe physical side channels."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

cwe:CWE-680 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/680.html> ;
    skos:broader cwe:CWE-119 ;
    skos:definition "The product performs a calculation to determine how much memory to allocate, but an integer overflow can occur that causes less memory to be allocated than expected, leading to a buffer overflow."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-680" ;
    skos:prefLabel "Integer Overflow to Buffer Overflow"@en ;

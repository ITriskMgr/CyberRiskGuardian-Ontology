    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/649.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The product uses obfuscation or encryption of inputs that should not be mutable by an external actor, but the product does not use integrity checks to detect if those inputs have been modified."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-649" ;
    skos:prefLabel "Reliance on Obfuscation or Encryption of Security-Relevant Inputs without Integrity Checking"@en ;

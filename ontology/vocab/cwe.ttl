cwe:CWE-206 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/206.html> ;
    skos:broader cwe:CWE-205 ;
    skos:definition "The product performs multiple behaviors that are combined to produce a single result, but the individual behaviors are observable separately in a way that allows attackers to reveal internal state or internal decision points."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-206" ;
    skos:prefLabel "Observable Internal Behavioral Discrepancy"@en ;

cwe:CWE-491 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/491.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "A class has a cloneable() method that is not declared final, which allows an object to be created without calling the constructor. This can cause the object to be in an unexpected state."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-491" ;
    skos:prefLabel "Public cloneable() Method Without Final ('Object Hijack')"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-492 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/492.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "Inner classes are translated into classes that are accessible at package scope and may expose code that the programmer intended to keep private to attackers."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-492" ;
    skos:prefLabel "Use of Inner Class Containing Sensitive Data"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-494 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/494.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The product downloads source code or an executable from a remote location and executes the code without sufficiently verifying the origin and integrity of the code."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-494" ;
    skos:prefLabel "Download of Code Without Integrity Check"@en ;

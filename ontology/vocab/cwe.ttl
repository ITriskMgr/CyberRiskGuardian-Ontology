cwe:CWE-500 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/500.html> ;
    skos:broader cwe:CWE-493 ;
    skos:definition "An object contains a public static field that is not marked final, which might allow it to be modified in unexpected ways."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-500" ;

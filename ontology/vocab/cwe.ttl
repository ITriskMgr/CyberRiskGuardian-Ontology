cwe:CWE-51 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/51.html> ;
    skos:broader cwe:CWE-41 ;
    skos:definition "The product accepts path input in the form of multiple internal slash ('/multiple//internal/slash/') without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-51" ;

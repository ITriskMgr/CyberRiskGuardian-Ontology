    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/427.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The product uses a fixed or controlled search path to find resources, but one or more locations in that path can be under the control of unintended actors."@en ;

cwe:CWE-105 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/105.html> ;
    skos:broader cwe:CWE-1173 ;
    skos:definition "The product has a form field that is not validated by a corresponding validation form, which can introduce other weaknesses related to insufficient input validation."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-105" ;
    skos:prefLabel "Struts: Form Field Without Validator"@en ;

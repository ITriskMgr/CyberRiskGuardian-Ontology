    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/378.html> ;
    skos:broader cwe:CWE-377 ;
    skos:definition "Opening temporary files without appropriate measures or controls can leave the file, its contents and any function that it impacts vulnerable to attack."@en ;

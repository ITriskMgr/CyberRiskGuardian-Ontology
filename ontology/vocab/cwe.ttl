    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/5.html> ;
    skos:broader cwe:CWE-319 ;
    skos:definition "Information sent over a network can be compromised while in transit. An attacker may be able to read or modify the contents if the data are sent in plaintext or are weakly encrypted."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-5" ;
    skos:prefLabel "J2EE Misconfiguration: Data Transmission Without Encryption"@en ;

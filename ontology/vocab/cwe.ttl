    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-499 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/499.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The code contains a class with sensitive data, but the class does not explicitly deny serialization. The data can be accessed by serializing the class through another class."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-499" ;
    skos:prefLabel "Serializable Class Containing Sensitive Data"@en ;

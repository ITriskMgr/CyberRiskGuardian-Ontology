    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/50.html> ;
    skos:broader cwe:CWE-41 ;
    skos:definition "The product accepts path input in the form of multiple leading slash ('//multiple/leading/slash') without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-50" ;
    skos:prefLabel "Path Equivalence: '//multiple/leading/slash'"@en ;

cwe:CWE-616 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/616.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The PHP application uses an old method for processing uploaded files by referencing the four global variables that are set for each file (e.g. $varname, $varname_size, $varname_name, $varname_type). These variables could be overwritten by attackers, causing the application to process unauthorized files."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

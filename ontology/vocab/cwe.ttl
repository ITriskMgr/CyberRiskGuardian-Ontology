cwe:CWE-194 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/194.html> ;
    skos:broader cwe:CWE-681 ;
    skos:definition "The product performs an operation on a number that causes it to be sign extended when it is transformed into a larger data type. When the original number is negative, this can produce unexpected values that lead to resultant weaknesses."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-194" ;
    skos:prefLabel "Unexpected Sign Extension"@en ;

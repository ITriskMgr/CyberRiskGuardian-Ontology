    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1223.html> ;
    skos:broader cwe:CWE-362 ;
    skos:definition "A write-once register in hardware design is programmable by an untrusted software component earlier than the trusted software component, resulting in a race condition issue."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1223" ;
    skos:prefLabel "Race Condition for Write-Once Attributes"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/641.html> ;
    skos:broader cwe:CWE-99 ;
    skos:definition "The product constructs the name of a file or other resource using input from an upstream component, but it does not restrict or incorrectly restricts the resulting name."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-641" ;

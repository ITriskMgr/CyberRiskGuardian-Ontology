    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/767.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The product defines a public method that reads or modifies a private variable."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-767" ;
    skos:prefLabel "Access to Critical Private Variable via Public Method"@en ;

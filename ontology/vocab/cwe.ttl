    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1049 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1049.html> ;
    skos:broader cwe:CWE-1176 ;
    skos:definition "The product performs a data query with a large number of joins and sub-queries on a large data table."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1049" ;
    skos:prefLabel "Excessive Data Query Operations in a Large Data Table"@en ;

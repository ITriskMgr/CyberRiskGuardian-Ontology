cwe:CWE-1004 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1004.html> ;
    skos:broader cwe:CWE-732 ;
    skos:definition "The product uses a cookie to store sensitive information, but the cookie is not marked with the HttpOnly flag."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1004" ;
    skos:prefLabel "Sensitive Cookie Without 'HttpOnly' Flag"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1007 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1007.html> ;
    skos:broader cwe:CWE-451 ;
    skos:definition "The product displays information or identifiers to a user, but the display mechanism does not make it easy for the user to distinguish between visually similar or identical glyphs (homoglyphs), which may cause the user to misinterpret a glyph and perform an unintended, insecure action."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1007" ;
    skos:prefLabel "Insufficient Visual Distinction of Homoglyphs Presented to User"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-102 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/102.html> ;
    skos:broader cwe:CWE-694 ;
    skos:definition "The product uses multiple validation forms with the same name, which might cause the Struts Validator to validate a form that the programmer does not expect."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-102" ;
    skos:prefLabel "Struts: Duplicate Validation Forms"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1021 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1021.html> ;
    skos:broader cwe:CWE-441 ;
    skos:definition "The web application does not restrict or incorrectly restricts frame objects or UI layers that belong to another application or domain, which can lead to user confusion about which interface the user is interacting with."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1021" ;
    skos:prefLabel "Improper Restriction of Rendered UI Layers or Frames"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1022 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1022.html> ;
    skos:broader cwe:CWE-266 ;
    skos:definition "The web application produces links to untrusted external sites outside of its sphere of control, but it does not properly prevent the external site from modifying security-critical properties of the window.opener object, such as the location property."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1022" ;
    skos:prefLabel "Use of Web Link to Untrusted Target with window.opener Access"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1024 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1024.html> ;
    skos:broader cwe:CWE-697 ;
    skos:definition "The product performs a comparison between two entities, but the entities are of different, incompatible types that cannot be guaranteed to provide correct results when they are directly compared."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1024" ;
    skos:prefLabel "Comparison of Incompatible Types"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-103 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/103.html> ;
    skos:broader cwe:CWE-573 ;
    skos:definition "The product has a validator form that either does not define a validate() method, or defines a validate() method but does not call super.validate()."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-103" ;
    skos:prefLabel "Struts: Incomplete validate() Method Definition"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1037 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1037.html> ;
    skos:broader cwe:CWE-1038 ;
    skos:definition "The developer builds a security-critical protection mechanism into the software, but the processor optimizes the execution of the program such that the mechanism is removed or modified."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1037" ;
    skos:prefLabel "Processor Optimization Removal or Modification of Security-critical Code"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1039 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1039.html> ;
    skos:broader cwe:CWE-693 ;
    skos:definition "The product uses an automated mechanism such as machine learning to recognize complex data inputs (e.g. image or audio) as a particular concept or category, but it does not properly detect or handle inputs that have been modified or constructed in a way that causes the mechanism to detect a different, incorrect concept."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1039" ;
    skos:prefLabel "Automated Recognition Mechanism with Inadequate Detection or Handling of Adversarial Input Perturbations"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-104 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/104.html> ;
    skos:broader cwe:CWE-573 ;
    skos:definition "If a form bean does not extend an ActionForm subclass of the Validator framework, it can expose the application to other weaknesses related to insufficient input validation."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-104" ;
    skos:prefLabel "Struts: Form Bean Does Not Extend Validation Class"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1041 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1041.html> ;
    skos:broader cwe:CWE-710 ;
    skos:definition "The product has multiple functions, methods, procedures, macros, etc. that contain the same code."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1041" ;
    skos:prefLabel "Use of Redundant Code"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1042 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1042.html> ;
    skos:broader cwe:CWE-1176 ;
    skos:definition "The code contains a member element that is declared as static (but not final), in which its parent class element is not a singleton class - that is, a class element that can be used only once in the 'to' association of a Create action."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1042" ;
    skos:prefLabel "Static Member Data Element outside of a Singleton Class Element"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1043 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1043.html> ;
    skos:broader cwe:CWE-1093 ;
    skos:definition "The product uses a data element that has an excessively large number of sub-elements with non-primitive data types such as structures or aggregated objects."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1043" ;
    skos:prefLabel "Data Element Aggregating an Excessively Large Number of Non-Primitive Elements"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1044 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1044.html> ;
    skos:broader cwe:CWE-710 ;
    skos:definition "The product's architecture contains too many - or too few - horizontal layers."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1044" ;
    skos:prefLabel "Architecture with Number of Horizontal Layers Outside of Expected Range"@en ;

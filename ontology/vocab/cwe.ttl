    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/686.html> ;
    skos:broader cwe:CWE-628 ;
    skos:definition "The product calls a function, procedure, or routine, but the caller specifies an argument that is the wrong data type, which may lead to resultant weaknesses."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-686" ;

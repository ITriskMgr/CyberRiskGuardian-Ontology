cwe:CWE-760 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/760.html> ;
    skos:broader cwe:CWE-916 ;
    skos:definition "The product uses a one-way cryptographic hash against an input that should not be reversible, such as a password, but the product uses a predictable salt as part of the input."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-760" ;

    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-495 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/495.html> ;
    skos:broader cwe:CWE-664 ;
    skos:definition "The product has a method that is declared public, but returns a reference to a private data structure, which could then be modified in unexpected ways."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-495" ;
    skos:prefLabel "Private Data Structure Returned From A Public Method"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-496 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/496.html> ;
    skos:broader cwe:CWE-664 ;
    skos:definition "Assigning public data to a private array is equivalent to giving public access to the array."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-496" ;
    skos:prefLabel "Public Data Assigned to Private Array-Typed Field"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;

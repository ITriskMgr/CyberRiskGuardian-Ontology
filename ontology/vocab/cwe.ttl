    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/527.html> ;
    skos:broader cwe:CWE-552 ;
    skos:definition "The product stores a CVS, git, or other repository in a directory, archive, or other resource that is stored, transferred, or otherwise made accessible to unauthorized actors."@en ;

cwe:CWE-299 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/299.html> ;
    skos:broader cwe:CWE-295 ;
    skos:definition "The product does not check or incorrectly checks the revocation status of a certificate, which may cause it to use a certificate that has been compromised."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-299" ;
    skos:prefLabel "Improper Check for Certificate Revocation"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/643.html> ;
    skos:broader cwe:CWE-91 ;
    skos:definition "The product uses external input to dynamically construct an XPath expression used to retrieve data from an XML database, but it does not neutralize or incorrectly neutralizes that input. This allows an attacker to control the structure of the query."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-643" ;

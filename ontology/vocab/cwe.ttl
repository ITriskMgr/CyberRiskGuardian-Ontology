    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/520.html> ;
    skos:broader cwe:CWE-266 ;
    skos:definition "Allowing a .NET application to run at potentially escalated levels of access to the underlying operating and file systems can be dangerous and result in various forms of attacks."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-1051 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1051.html> ;
    skos:broader cwe:CWE-665 ;
    skos:definition "The product initializes data using hard-coded values that act as network resource identifiers."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1051" ;
    skos:prefLabel "Initialization with Hard-Coded Network Resource Configuration Data"@en ;

cwe:CWE-8 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/8.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "When an application exposes a remote interface for an entity bean, it might also expose methods that get or set the bean's data. These methods could be leveraged to read sensitive information, or to change data in ways that violate the application's expectations, potentially leading to other vulnerabilities."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

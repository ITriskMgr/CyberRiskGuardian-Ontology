    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-350 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/350.html> ;
    skos:broader cwe:CWE-290 ;
    skos:definition "The product performs reverse DNS resolution on an IP address to obtain the hostname and make a security decision, but it does not properly ensure that the IP address is truly associated with the hostname."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-350" ;
    skos:prefLabel "Reliance on Reverse DNS Resolution for a Security-Critical Action"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-351 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/351.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The product does not properly distinguish between different types of elements in a way that leads to insecure behavior."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-351" ;
    skos:prefLabel "Insufficient Type Distinction"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

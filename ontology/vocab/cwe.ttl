    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/298.html> ;
    skos:broader cwe:CWE-295 ;
    skos:definition "A certificate expiration is not validated or is incorrectly validated, so trust may be assigned to certificates that have been abandoned due to age."@en ;

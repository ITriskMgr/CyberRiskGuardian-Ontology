    skos:broader cwe:CWE-787 ;
    skos:definition "Any condition where the attacker has the ability to write an arbitrary value to an arbitrary location, often as the result of a buffer overflow."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-123" ;
    skos:prefLabel "Write-what-where Condition"@en ;

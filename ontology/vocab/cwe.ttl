    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-195 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/195.html> ;
    skos:broader cwe:CWE-681 ;
    skos:definition "The product uses a signed primitive and performs a cast to an unsigned primitive, which can produce an unexpected value if the value of the signed primitive can not be represented using an unsigned primitive."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-195" ;
    skos:prefLabel "Signed to Unsigned Conversion Error"@en ;

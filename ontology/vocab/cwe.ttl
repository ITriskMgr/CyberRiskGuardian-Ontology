    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1224.html> ;
    skos:broader cwe:CWE-284 ;
    skos:definition "The hardware design control register \"sticky bits\" or write-once bit fields are improperly implemented, such that they can be reprogrammed by software."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1224" ;

cwe:CWE-685 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/685.html> ;
    skos:broader cwe:CWE-628 ;
    skos:definition "The product calls a function, procedure, or routine, but the caller specifies too many arguments, or too few arguments, which may lead to undefined behavior and resultant weaknesses."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

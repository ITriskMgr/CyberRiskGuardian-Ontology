cwe:CWE-511 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/511.html> ;
    skos:broader cwe:CWE-506 ;
    skos:definition "The product contains code that is designed to disrupt the legitimate operation of the product (or its environment) when a certain time passes, or when a certain logical condition is met."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-511" ;
    skos:prefLabel "Logic/Time Bomb"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;

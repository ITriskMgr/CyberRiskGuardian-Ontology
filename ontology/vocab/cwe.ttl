cwe:CWE-35 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/35.html> ;
    skos:broader cwe:CWE-23 ;
    skos:definition "The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize '.../...//' (doubled triple dot slash) sequences that can resolve to a location that is outside of that directory."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-35" ;
    skos:prefLabel "Path Traversal: '.../...//'"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/204.html> ;
    skos:broader cwe:CWE-203 ;
    skos:definition "The product provides different responses to incoming requests in a way that reveals internal state information to an unauthorized actor outside of the intended control sphere."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/777.html> ;
    skos:broader cwe:CWE-625 ;
    skos:definition "The product uses a regular expression to perform neutralization, but the regular expression is not anchored and may allow malicious or malformed data to slip through."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-777" ;
    skos:prefLabel "Regular Expression without Anchors"@en ;

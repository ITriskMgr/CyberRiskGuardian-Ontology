cwe:CWE-359 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/359.html> ;
    skos:broader cwe:CWE-200 ;
    skos:definition "The product does not properly prevent a person's private, personal information from being accessed by actors who either (1) are not explicitly authorized to access the information or (2) do not have the implicit consent of the person about whom the information is collected."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-359" ;
    skos:prefLabel "Exposure of Private Personal Information to an Unauthorized Actor"@en ;

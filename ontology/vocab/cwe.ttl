    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/474.html> ;
    skos:broader cwe:CWE-758 ;
    skos:definition "The code uses a function that has inconsistent implementations across operating systems and versions."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-474" ;
    skos:prefLabel "Use of Function with Inconsistent Implementations"@en ;

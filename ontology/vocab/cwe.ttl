cwe:CWE-303 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/303.html> ;
    skos:broader cwe:CWE-1390 ;
    skos:definition "The requirements for the product dictate the use of an established authentication algorithm, but the implementation of the algorithm is incorrect."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-303" ;
    skos:prefLabel "Incorrect Implementation of Authentication Algorithm"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/375.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "Sending non-cloned mutable data as a return value may result in that data being altered or deleted by the calling function."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

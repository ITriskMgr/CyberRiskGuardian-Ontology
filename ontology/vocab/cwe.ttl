    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-368 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/368.html> ;
    skos:broader cwe:CWE-362 ;
    skos:definition "A product performs a series of non-atomic actions to switch between contexts that cross privilege or other security boundaries, but a race condition allows an attacker to modify or misrepresent the product's behavior during the switch."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-368" ;
    skos:prefLabel "Context Switching Race Condition"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/357.html> ;
    skos:broader cwe:CWE-693 ;
    skos:definition "The user interface provides a warning to a user regarding dangerous or sensitive operations, but the warning is not noticeable enough to warrant attention."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-357" ;
    skos:prefLabel "Insufficient UI Warning of Dangerous Operations"@en ;

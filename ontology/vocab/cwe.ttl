    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1053.html> ;
    skos:broader cwe:CWE-1059 ;
    skos:definition "The product does not have documentation that represents how it is designed."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1053" ;
    skos:prefLabel "Missing Documentation for Design"@en ;

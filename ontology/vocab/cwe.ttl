    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/273.html> ;
    skos:broader cwe:CWE-271 ;
    skos:definition "The product attempts to drop privileges but does not check or incorrectly checks to see if the drop succeeded."@en ;

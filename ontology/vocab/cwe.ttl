    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/207.html> ;
    skos:broader cwe:CWE-205 ;
    skos:definition "The product operates in an environment in which its existence or specific identity should not be known, but it behaves differently than other products with equivalent functionality, in a way that is observable to an attacker."@en ;

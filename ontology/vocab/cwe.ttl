cwe:CWE-370 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/370.html> ;
    skos:broader cwe:CWE-299 ;
    skos:definition "The product does not check the revocation status of a certificate after its initial revocation check, which can cause the product to perform privileged actions even after the certificate is revoked at a later time."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-370" ;
    skos:prefLabel "Missing Check for Certificate Revocation after Initial Check"@en ;

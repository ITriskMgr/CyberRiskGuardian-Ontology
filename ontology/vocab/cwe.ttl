    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1052.html> ;
    skos:broader cwe:CWE-665 ;
    skos:definition "The product initializes a data element using a hard-coded literal that is not a simple integer or static constant element."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1052" ;

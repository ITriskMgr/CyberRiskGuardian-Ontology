    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/776.html> ;
    skos:broader cwe:CWE-405 ;
    skos:definition "The product uses XML documents and allows their structure to be defined with a Document Type Definition (DTD), but it does not properly control the number of recursive definitions of entities."@en ;

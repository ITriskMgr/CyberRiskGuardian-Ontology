    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/213.html> ;
    skos:broader cwe:CWE-200 ;
    skos:definition "The product's intended functionality exposes information to certain actors in accordance with the developer's security policy, but this information is regarded as sensitive according to the intended security policies of other stakeholders such as the product's administrator, users, or others whose information is being processed."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-213" ;
    skos:prefLabel "Exposure of Sensitive Information Due to Incompatible Policies"@en ;

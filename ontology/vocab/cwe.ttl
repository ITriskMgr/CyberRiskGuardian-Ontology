    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-363 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/363.html> ;
    skos:broader cwe:CWE-367 ;
    skos:definition "The product checks the status of a file or directory before accessing it, which produces a race condition in which the file can be replaced with a link before the access is performed, causing the product to access the wrong file."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-363" ;
    skos:prefLabel "Race Condition Enabling Link Following"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-366 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/366.html> ;
    skos:broader cwe:CWE-362 ;
    skos:definition "If two threads of execution use a resource simultaneously, there exists the possibility that resources may be used while invalid, in turn making the state of execution undefined."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-366" ;
    skos:prefLabel "Race Condition within a Thread"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/646.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The product allows a file to be uploaded, but it relies on the file name or extension of the file to determine the appropriate behaviors. This could be used by attackers to cause the file to be misclassified and processed in a dangerous fashion."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-646" ;
    skos:prefLabel "Reliance on File Name or Extension of Externally-Supplied File"@en ;

cwe:CWE-676 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/676.html> ;
    skos:broader cwe:CWE-1177 ;
    skos:definition "The product invokes a potentially dangerous function that could introduce a vulnerability if it is used incorrectly, but the function can also be used safely."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-676" ;
    skos:prefLabel "Use of Potentially Dangerous Function"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/662.html> ;
    skos:broader cwe:CWE-664 ;
    skos:definition "The product utilizes multiple threads or processes to allow temporary access to a shared resource that can only be exclusive to one process at a time, but it does not properly synchronize these actions, which might cause simultaneous accesses of this resource by multiple threads or processes."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-662" ;
    skos:prefLabel "Improper Synchronization"@en ;

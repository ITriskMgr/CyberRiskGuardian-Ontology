    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-498 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/498.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The code contains a class with sensitive data, but the class is cloneable. The data can then be accessed by cloning the class."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-498" ;
    skos:prefLabel "Cloneable Class Containing Sensitive Information"@en ;

cwe:CWE-625 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/625.html> ;
    skos:broader cwe:CWE-185 ;
    skos:definition "The product uses a regular expression that does not sufficiently restrict the set of allowed values."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-625" ;
    skos:prefLabel "Permissive Regular Expression"@en ;

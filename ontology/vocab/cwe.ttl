    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/794.html> ;
    skos:broader cwe:CWE-792 ;
    skos:definition "The product receives data from an upstream component, but does not filter all instances of a special element before sending it to a downstream component."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

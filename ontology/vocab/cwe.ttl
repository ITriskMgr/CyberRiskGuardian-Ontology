    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/302.html> ;
    skos:broader cwe:CWE-807 ;
    skos:definition "The authentication scheme or implementation uses key data elements that are assumed to be immutable, but can be controlled or modified by the attacker."@en ;

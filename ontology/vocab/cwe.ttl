cwe:CWE-252 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/252.html> ;
    skos:broader cwe:CWE-754 ;
    skos:definition "The product does not check the return value from a method or function, which can prevent it from detecting unexpected states and conditions."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-252" ;
    skos:prefLabel "Unchecked Return Value"@en ;

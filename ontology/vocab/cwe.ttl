    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1263.html> ;
    skos:broader cwe:CWE-284 ;
    skos:definition "The product is designed with access restricted to certain information, but it does not sufficiently protect against an unauthorized actor with physical access to these areas."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1263" ;
    skos:prefLabel "Improper Physical Access Control"@en ;

cwe:CWE-1222 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1222.html> ;
    skos:broader cwe:CWE-1220 ;
    skos:definition "The product defines a large address region protected from modification by the same register lock control bit. This results in a conflict between the functional requirement that some addresses need to be writable by software during operation and the security requirement that the system configuration lock bit must be set during the boot process."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1222" ;
    skos:prefLabel "Insufficient Granularity of Address Regions Protected by Register Locks"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

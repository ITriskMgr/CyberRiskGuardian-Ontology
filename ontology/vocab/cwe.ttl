    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/243.html> ;
    skos:broader cwe:CWE-573 ;
    skos:definition "The product uses the chroot() system call to create a jail, but does not change the working directory afterward. This does not prevent access to files outside of the jail."@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/358.html> ;
    skos:broader cwe:CWE-573 ;
    skos:definition "The product does not implement or incorrectly implements one or more security-relevant checks as specified by the design of a standardized algorithm, protocol, or technique."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-358" ;
    skos:prefLabel "Improperly Implemented Security Check for Standard"@en ;

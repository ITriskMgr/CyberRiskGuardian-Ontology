    skos:definition "The PHP application receives input from an upstream component, but it does not restrict or incorrectly restricts the input before its usage in \"require,\" \"include,\" or similar functions."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-98" ;
    skos:prefLabel "Improper Control of Filename for Include/Require Statement in PHP Program ('PHP Remote File Inclusion')"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/22.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The product uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the product does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

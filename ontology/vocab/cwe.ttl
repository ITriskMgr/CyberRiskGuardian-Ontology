    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/267.html> ;
    skos:broader cwe:CWE-269 ;
    skos:definition "A particular privilege, role, capability, or right can be used to perform unsafe actions that were not intended, even when it is assigned to the correct entity."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-267" ;
    skos:prefLabel "Privilege Defined With Unsafe Actions"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1231.html> ;
    skos:broader cwe:CWE-284 ;
    skos:definition "The product uses a trusted lock bit for restricting access to registers, address regions, or other resources, but the product does not prevent the value of the lock bit from being modified after it has been set."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1231" ;
    skos:prefLabel "Improper Prevention of Lock Bit Modification"@en ;

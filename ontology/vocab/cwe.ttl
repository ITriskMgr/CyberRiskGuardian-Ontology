    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/647.html> ;
    skos:broader cwe:CWE-863 ;
    skos:definition "The product defines policy namespaces and makes authorization decisions based on the assumption that a URL is canonical. This can allow a non-canonical URL to bypass the authorization."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/761.html> ;
    skos:broader cwe:CWE-763 ;
    skos:definition "The product calls free() on a pointer to a memory resource that was allocated on the heap, but the pointer is not at the start of the buffer."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-761" ;

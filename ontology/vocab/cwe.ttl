    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/648.html> ;
    skos:broader cwe:CWE-269 ;
    skos:definition "The product does not conform to the API requirements for a function call that requires extra privileges. This could allow attackers to gain privileges by causing the function to be called incorrectly."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-648" ;
    skos:prefLabel "Incorrect Use of Privileged APIs"@en ;

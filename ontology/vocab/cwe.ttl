    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/489.html> ;
    skos:broader cwe:CWE-710 ;
    skos:definition "The product is deployed to unauthorized actors with debugging code still enabled or active, which can create unintended entry points or expose sensitive information."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-489" ;
    skos:prefLabel "Active Debug Code"@en ;

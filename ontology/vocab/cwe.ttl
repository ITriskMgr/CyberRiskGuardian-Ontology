    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-674 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/674.html> ;
    skos:broader cwe:CWE-834 ;
    skos:definition "The product does not properly control the amount of recursion that takes place, consuming excessive resources, such as allocated memory or the program stack."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-674" ;
    skos:prefLabel "Uncontrolled Recursion"@en ;

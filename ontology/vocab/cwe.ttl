    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/69.html> ;
    skos:broader cwe:CWE-66 ;
    skos:definition "The product does not properly prevent access to, or detect usage of, alternate data streams (ADS)."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

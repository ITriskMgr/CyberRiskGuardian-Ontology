cwe:CWE-524 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/524.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The code uses a cache that contains sensitive information, but the cache can be read by an actor outside of the intended control sphere."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-524" ;
    skos:prefLabel "Use of Cache Containing Sensitive Information"@en ;

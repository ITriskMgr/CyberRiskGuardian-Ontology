cwe:CWE-501 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/501.html> ;
    skos:broader cwe:CWE-664 ;
    skos:definition "The product mixes trusted and untrusted data in the same data structure or structured message."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-501" ;

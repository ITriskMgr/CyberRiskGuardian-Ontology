    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/644.html> ;
    skos:broader cwe:CWE-116 ;
    skos:definition "The product does not neutralize or incorrectly neutralizes web scripting syntax in HTTP headers that can be used by web browser components that can process raw headers, such as Flash."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-644" ;

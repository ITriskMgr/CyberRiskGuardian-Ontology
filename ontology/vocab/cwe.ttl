    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/502.html> ;
    skos:broader cwe:CWE-913 ;
    skos:definition "The product deserializes untrusted data without sufficiently ensuring that the resulting data will be valid."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-502" ;
    skos:prefLabel "Deserialization of Untrusted Data"@en ;

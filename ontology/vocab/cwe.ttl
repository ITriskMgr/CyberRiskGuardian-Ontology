cwe:CWE-683 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/683.html> ;
    skos:broader cwe:CWE-628 ;
    skos:definition "The product calls a function, procedure, or routine, but the caller specifies the arguments in an incorrect order, leading to resultant weaknesses."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-683" ;
    skos:prefLabel "Function Call With Incorrect Order of Arguments"@en ;

cwe:CWE-1048 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1048.html> ;
    skos:broader cwe:CWE-710 ;
    skos:definition "The code contains callable control elements that contain an excessively large number of references to other application objects external to the context of the callable, i.e. a Fan-Out value that is excessively large."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-1048" ;
    skos:prefLabel "Invokable Control Element with Large Number of Outward Calls"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE CWE via D3FEND 1.6.0"@en ;

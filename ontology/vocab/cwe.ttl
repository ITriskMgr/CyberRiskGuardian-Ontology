    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/692.html> ;
    skos:broader cwe:CWE-79 ;
    skos:definition "The product uses a denylist-based protection mechanism to defend against XSS attacks, but the denylist is incomplete, allowing XSS variants to succeed."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;

cwe:CWE-120 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/120.html> ;
    skos:broader cwe:CWE-119 ;
    skos:definition "The product copies an input buffer to an output buffer without verifying that the size of the input buffer is less than the size of the output buffer, leading to a buffer overflow."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-120" ;
    skos:prefLabel "Buffer Copy without Checking Size of Input ('Classic Buffer Overflow')"@en ;

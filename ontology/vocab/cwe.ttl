    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/270.html> ;
    skos:broader cwe:CWE-269 ;
    skos:definition "The product does not properly manage privileges while it is switching between different contexts that have different privileges or spheres of control."@en ;

    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-451 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/451.html> ;
    skos:broader cwe:CWE-221 ;
    skos:definition "The user interface (UI) does not properly represent critical information to the user, allowing the information - or its source - to be obscured or spoofed. This is often a component in phishing attacks."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-451" ;
    skos:prefLabel "User Interface (UI) Misrepresentation of Critical Information"@en ;

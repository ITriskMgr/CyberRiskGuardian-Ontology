    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1286.html> ;
    skos:broader cwe:CWE-20 ;
    skos:definition "The product receives input that is expected to be well-formed - i.e., to comply with a certain syntax - but it does not validate or incorrectly validates that the input complies with the syntax."@en ;

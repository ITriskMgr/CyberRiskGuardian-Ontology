    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1258.html> ;
    skos:broader cwe:CWE-200 ;
    skos:definition "The hardware does not fully clear security-sensitive values, such as keys and intermediate values in cryptographic operations, when debug mode is entered."@en ;

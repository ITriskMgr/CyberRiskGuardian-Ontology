cwe:CWE-768 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/768.html> ;
    skos:broader cwe:CWE-691 ;
    skos:definition "The product contains a conditional statement with multiple logical expressions in which one of the non-leading expressions may produce side effects. This may lead to an unexpected state in the program after the execution of the conditional, because short-circuiting logic may prevent the side effects from occurring."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-768" ;
    skos:prefLabel "Incorrect Short Circuit Evaluation"@en ;

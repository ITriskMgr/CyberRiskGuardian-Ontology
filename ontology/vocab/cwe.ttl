    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/1252.html> ;
    skos:broader cwe:CWE-284 ;
    skos:definition "The CPU is not configured to provide hardware support for exclusivity of write and execute operations on memory. This allows an attacker to execute data from all of memory."@en ;

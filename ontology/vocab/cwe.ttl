    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

cwe:CWE-493 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/493.html> ;
    skos:broader cwe:CWE-668 ;
    skos:definition "The product has a critical public variable that is not final, which allows the variable to be modified to contain unexpected values."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-493" ;
    skos:prefLabel "Critical Public Variable Without Final Modifier"@en ;

    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/690.html> ;
    skos:broader cwe:CWE-252 ;
    skos:definition "The product does not check for an error after calling a function that can return with a NULL pointer if the function fails, which leads to a resultant NULL pointer dereference."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-690" ;

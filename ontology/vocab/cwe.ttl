cwe:CWE-352 a skos:Concept ;
    rdfs:seeAlso <https://cwe.mitre.org/data/definitions/352.html> ;
    skos:broader cwe:CWE-345 ;
    skos:definition "The web application does not, or cannot, sufficiently verify whether a request was intentionally provided by the user who sent the request, which could have originated from an unauthorized actor. "@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/cwe> ;
    skos:notation "CWE-352" ;
    skos:prefLabel "Cross-Site Request Forgery (CSRF)"@en ;

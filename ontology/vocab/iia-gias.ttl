iia-gias:14.4 a skos:Concept ;
    skos:broader iia-gias:14 ;
    skos:definition "Auditors must propose recommendations or agree management action plans that address findings and their causes."@en,
        "Les auditeurs doivent proposer des recommandations ou convenir de plans d'action de la direction qui traitent les constats et leurs causes."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14.4" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Recommendations and Action Plans"@en,
        "Recommandations et plans d'action"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 14.4 (page 109)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:14.5 a skos:Concept ;
    skos:broader iia-gias:14 ;
    skos:definition "Auditors must form an overall conclusion summarizing the significance of findings for the activity reviewed."@en,
        "Les auditeurs doivent formuler une conclusion globale résumant l'importance des constats pour l'activité examinée."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14.5" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Conclusions"@en,
        "Conclusions de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 14.5 (page 110)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:14.6 a skos:Concept ;
    skos:broader iia-gias:14 ;
    skos:definition "Auditors must document information and analyses sufficient to support findings and conclusions, retaining records according to policy."@en,
        "Les auditeurs doivent documenter l'information et les analyses étayant constats et conclusions, et conserver les dossiers selon la politique établie."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14.6" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Documentation"@en,
        "Documentation de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 14.6 (page 111)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:15.1 a skos:Concept ;
    skos:broader iia-gias:15 ;
    skos:definition "Auditors must issue a final communication presenting objectives, scope, findings, conclusions and action plans."@en,
        "Les auditeurs doivent émettre une communication finale présentant objectifs, périmètre, constats, conclusions et plans d'action."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "15.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Final Engagement Communication"@en,
        "Communication finale de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 15.1 (page 113)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:15.2 a skos:Concept ;
    skos:broader iia-gias:15 ;
    skos:definition "Auditors must track and confirm that management has implemented recommendations or action plans, escalating when it has not."@en,
        "Les auditeurs doivent suivre et confirmer la mise en œuvre par la direction des recommandations ou plans d'action, et escalader en cas de défaut."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "15.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Confirming the Implementation of Recommendations or Action Plans"@en,
        "Confirmation de la mise en œuvre des recommandations ou des plans d'action"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 15.2 (page 114)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:2.1 a skos:Concept ;
    skos:broader iia-gias:2 ;
    skos:definition "Auditors must keep their judgment unbiased and avoid conflicts that could compromise impartiality."@en,
        "Les auditeurs doivent garder un jugement sans parti pris et éviter les conflits susceptibles de compromettre leur impartialité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "2.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Individual Objectivity"@en,
        "Objectivité individuelle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 2.1 (page 20)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:2.2 a skos:Concept ;
    skos:broader iia-gias:2 ;
    skos:definition "Auditors and the chief audit executive must recognize threats to objectivity and apply safeguards such as rotation or reassignment."@en,
        "Les auditeurs et le responsable doivent reconnaître les menaces à l'objectivité et appliquer des mesures de sauvegarde, comme la rotation ou la réaffectation."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "2.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Safeguarding Objectivity"@en,
        "Protection de l'objectivité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 2.2 (page 22)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:2.3 a skos:Concept ;
    skos:broader iia-gias:2 ;
    skos:definition "Real or apparent impairments to objectivity must be reported promptly, with details, to the appropriate parties."@en,
        "Toute atteinte réelle ou apparente à l'objectivité doit être signalée rapidement, avec précisions, aux parties concernées."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "2.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Disclosing Impairments to Objectivity"@en,
        "Divulgation des atteintes à l'objectivité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 2.3 (page 24)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:3.1 a skos:Concept ;
    skos:broader iia-gias:3 ;
    skos:definition "Auditors must have or acquire the knowledge, skills and abilities that their responsibilities and assignments require."@en,
        "Les auditeurs doivent posséder ou acquérir les connaissances, aptitudes et habiletés exigées par leurs responsabilités et affectations."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "3.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Competency"@en,
        "Compétence"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 3.1 (page 26)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:3.2 a skos:Concept ;
    skos:broader iia-gias:3 ;
    skos:definition "Auditors must keep improving their competencies through ongoing learning, including any certification obligations."@en,
        "Les auditeurs doivent améliorer constamment leurs compétences par la formation continue, y compris les exigences de certification."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "3.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Continuing Professional Development"@en,
        "Perfectionnement professionnel continu"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 3.2 (page 28)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:4.1 a skos:Concept ;
    skos:broader iia-gias:4 ;
    skos:definition "Auditors must plan and perform services in line with the Standards and disclose any nonconformance."@en,
        "Les auditeurs doivent planifier et réaliser les services conformément aux Normes et divulguer toute non-conformité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "4.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Conformance with the Global Internal Audit Standards"@en,
        "Conformité aux Normes internationales d'audit interne"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 4.1 (page 29)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:4.2 a skos:Concept ;
    skos:broader iia-gias:4 ;
    skos:definition "Auditors must apply the care and skill of a prudent professional, weighing scope, complexity, risk and cost."@en,
        "Les auditeurs doivent faire preuve du soin et de la compétence d'un professionnel prudent, en tenant compte du périmètre, de la complexité, du risque et du coût."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "4.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Due Professional Care"@en,
        "Diligence professionnelle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 4.2 (page 31)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:4.3 a skos:Concept ;
    skos:broader iia-gias:4 ;
    skos:definition "Auditors must maintain a questioning attitude, critically weighing evidence and staying alert to inconsistencies."@en,
        "Les auditeurs doivent conserver une attitude interrogative, évaluer les preuves de façon critique et rester attentifs aux incohérences."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "4.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Professional Skepticism"@en,
        "Scepticisme professionnel"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 4.3 (page 33)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:5.1 a skos:Concept ;
    skos:broader iia-gias:5 ;
    skos:definition "Auditors must use information only for professional purposes and never for personal gain or improper ends."@en,
        "Les auditeurs doivent utiliser l'information uniquement à des fins professionnelles, jamais pour un gain personnel ou des fins indues."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "5.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Use of Information"@en,
        "Utilisation de l'information"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 5.1 (page 34)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:5.2 a skos:Concept ;
    skos:broader iia-gias:5 ;
    skos:definition "Auditors must safeguard information and follow the policies governing its handling, retention and disclosure."@en,
        "Les auditeurs doivent protéger l'information et suivre les politiques encadrant son traitement, sa conservation et sa divulgation."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "5.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Protection of Information"@en,
        "Protection de l'information"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 5.2 (page 35)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:6.1 a skos:Concept ;
    skos:broader iia-gias:6 ;
    skos:definition "The board, working with the chief audit executive and management, establishes the function's authority, role and responsibilities."@en,
        "Le conseil, avec le responsable de l'audit interne et la direction, établit l'autorité, le rôle et les responsabilités de la fonction."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "6.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Internal Audit Mandate"@en,
        "Mandat de l'audit interne"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 6.1 (page 39)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:6.2 a skos:Concept ;
    skos:broader iia-gias:6 ;
    skos:definition "The chief audit executive must record the mandate and key arrangements in a charter approved by the board and reviewed periodically."@en,
        "Le responsable doit consigner le mandat et les modalités clés dans une charte approuvée par le conseil et revue périodiquement."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "6.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Internal Audit Charter"@en,
        "Charte d'audit interne"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 6.2 (page 42)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:6.3 a skos:Concept ;
    skos:broader iia-gias:6 ;
    skos:definition "The board and senior management must champion the function so it can fulfil its mandate."@en,
        "Le conseil et la direction générale doivent soutenir activement la fonction afin qu'elle remplisse son mandat."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "6.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Board and Senior Management Support"@en,
        "Soutien du conseil et de la direction générale"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 6.3 (page 44)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:7.1 a skos:Concept ;
    skos:broader iia-gias:7 ;
    skos:definition "The chief audit executive must report directly to the board, and the function must set scope, perform work and report without interference."@en,
        "Le responsable doit relever directement du conseil et la fonction doit définir son périmètre, travailler et rendre compte sans ingérence."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "7.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Organizational Independence"@en,
        "Indépendance organisationnelle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 7.1 (page 46)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:7.2 a skos:Concept ;
    skos:broader iia-gias:7 ;
    skos:definition "The board ensures the chief audit executive has the qualifications and competencies to lead the function and conform to the Standards."@en,
        "Le conseil s'assure que le responsable possède les qualifications et compétences pour diriger la fonction et respecter les Normes."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "7.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Chief Audit Executive Qualifications"@en,
        "Qualifications du responsable de l'audit interne"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 7.2 (page 50)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:8.1 a skos:Concept ;
    skos:broader iia-gias:8 ;
    skos:definition "The chief audit executive must communicate regularly with the board so it can oversee the function and gain needed insight."@en,
        "Le responsable doit communiquer régulièrement avec le conseil afin qu'il supervise la fonction et obtienne l'éclairage nécessaire."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "8.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Board Interaction"@en,
        "Interaction avec le conseil"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 8.1 (page 52)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:8.2 a skos:Concept ;
    skos:broader iia-gias:8 ;
    skos:definition "The chief audit executive must judge whether resources suffice for the mandate and tell the board about the impact of any shortfall."@en,
        "Le responsable doit juger si les ressources suffisent au mandat et informer le conseil de l'incidence de toute insuffisance."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "8.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Resources"@en,
        "Ressources"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 8.2 (page 54)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:8.3 a skos:Concept ;
    skos:broader iia-gias:8 ;
    skos:definition "The chief audit executive maintains a quality assurance and improvement program and reports its results to the board."@en,
        "Le responsable maintient un programme d'assurance et d'amélioration de la qualité et en communique les résultats au conseil."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "8.3" ;

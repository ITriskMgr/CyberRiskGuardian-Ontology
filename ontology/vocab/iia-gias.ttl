iia-gias:1 a skos:Concept ;
    skos:broader iia-gias:II ;
    skos:definition "Internal auditors act honestly and courageously, in line with ethical expectations, in all of their work."@en,
        "Les auditeurs internes agissent avec honnêteté et courage, conformément aux attentes éthiques, dans l'ensemble de leurs travaux."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Demonstrate Integrity"@en,
        "Faire preuve d'intégrité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 1 (page 16)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:10 a skos:Concept ;
    skos:broader iia-gias:IV ;
    skos:definition "The chief audit executive obtains and deploys financial, human and technological resources to deliver the plan."@en,
        "Le responsable de l'audit interne obtient et déploie les ressources financières, humaines et technologiques nécessaires au plan."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;

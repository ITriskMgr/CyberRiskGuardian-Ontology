    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:3 a skos:Concept ;
    skos:broader iia-gias:II ;
    skos:definition "Internal auditors apply, and keep developing, the knowledge, skills and abilities their roles require."@en,
        "Les auditeurs internes mettent en œuvre et développent les connaissances, aptitudes et habiletés requises par leurs fonctions."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Demonstrate Competency"@en,
        "Faire preuve de compétence"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 3 (page 25)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:5 a skos:Concept ;
    skos:broader iia-gias:II ;
    skos:definition "Internal auditors use and safeguard information appropriately, respecting its sensitivity."@en,
        "Les auditeurs internes utilisent et protègent l'information de manière appropriée, en respectant sa sensibilité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "5" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Maintain Confidentiality"@en,
        "Préserver la confidentialité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 5 (page 34)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:7 a skos:Concept ;
    skos:broader iia-gias:III ;
    skos:definition "The function is placed so it can work without interference, led by a qualified chief audit executive reporting to the board."@en,
        "La fonction est positionnée pour travailler sans ingérence, sous la direction d'un responsable qualifié relevant du conseil."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "7" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Positioned Independently"@en,
        "Positionné de façon indépendante"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 7 (page 45)"@en ;

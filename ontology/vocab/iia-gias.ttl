    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:V a skos:Concept ;
    skos:definition "Groups the principles on planning engagements, conducting the work, communicating results and following up on agreed actions."@en,
        "Regroupe les principes relatifs à la planification des missions, à la réalisation des travaux, à la communication des résultats et au suivi des actions convenues."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "V" ;

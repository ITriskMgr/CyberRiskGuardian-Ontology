iia-gias:11 a skos:Concept ;
    skos:broader iia-gias:IV ;
    skos:definition "The function builds stakeholder relationships and delivers clear, timely and accurate communication of its results."@en,
        "La fonction établit des relations avec les parties prenantes et communique ses résultats de façon claire, exacte et opportune."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "11" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Communicate Effectively"@en,
        "Communiquer efficacement"@fr ;

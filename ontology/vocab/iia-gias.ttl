    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:9.5 a skos:Concept ;
    skos:broader iia-gias:9 ;
    skos:definition "The CAE must coordinate with other assurance providers and judge whether their work can be relied upon."@en,
        "Le responsable doit se coordonner avec les autres prestataires d'assurance et juger s'il peut s'appuyer sur leurs travaux."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "9.5" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Coordination and Reliance"@en,
        "Coordination et recours aux travaux d'autres prestataires"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 9.5 (page 69)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:I a skos:Concept ;
    skos:definition "Explains why internal auditing exists: helping the organization generate, safeguard and sustain value via independent, risk-based assurance and advice."@en,
        "Explique la raison d'être de l'audit interne : aider l'organisation à créer, préserver et pérenniser de la valeur par une assurance et des conseils indépendants."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "I" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Purpose of Internal Auditing"@en,
        "Raison d'être de l'audit interne"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/iia-gias> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

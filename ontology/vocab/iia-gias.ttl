        "Gérer les ressources"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 10 (page 71)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:12 a skos:Concept ;
    skos:broader iia-gias:IV ;
    skos:definition "The function assesses itself, measures its performance and supervises engagements in order to improve continuously."@en,
        "La fonction s'autoévalue, mesure sa performance et supervise les missions afin de s'améliorer en continu."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "12" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Enhance Quality"@en,
        "Améliorer la qualité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 12 (page 85)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:2 a skos:Concept ;
    skos:broader iia-gias:II ;
    skos:definition "Internal auditors keep an impartial, unbiased mindset and form judgments free from interference."@en,
        "Les auditeurs internes conservent un état d'esprit impartial et sans parti pris et forment leurs jugements sans ingérence."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Maintain Objectivity"@en,
        "Maintenir l'objectivité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 2 (page 20)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:4 a skos:Concept ;
    skos:broader iia-gias:II ;
    skos:definition "Internal auditors conform to the Standards and work with the prudence and skepticism suited to each service."@en,
        "Les auditeurs internes se conforment aux Normes et travaillent avec la prudence et le scepticisme adaptés à chaque service."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "4" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Exercise Due Professional Care"@en,
        "Exercer la diligence professionnelle requise"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 4 (page 29)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:6 a skos:Concept ;
    skos:broader iia-gias:III ;
    skos:definition "The board confers, records and backs the function's authority, role and responsibilities."@en,
        "Le conseil confère, consigne et soutient l'autorité, le rôle et les responsabilités de la fonction d'audit interne."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "6" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Authorized by the Board"@en,
        "Mandaté par le conseil"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 6 (page 39)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:8 a skos:Concept ;
    skos:broader iia-gias:III ;
    skos:definition "The board oversees the function's effectiveness, resources and quality, including periodic external assessment."@en,
        "Le conseil supervise l'efficacité, les ressources et la qualité de la fonction, y compris l'évaluation externe périodique."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "8" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Overseen by the Board"@en,
        "Supervisé par le conseil"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 8 (page 51)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:III a skos:Concept ;
    skos:definition "Groups the principles on how the board and senior management authorize, position and oversee the internal audit function."@en,
        "Regroupe les principes sur la manière dont le conseil et la direction générale autorisent, positionnent et supervisent la fonction d'audit interne."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "III" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Governing the Internal Audit Function"@en,
        "Gouvernance de la fonction d'audit interne"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/iia-gias> ;

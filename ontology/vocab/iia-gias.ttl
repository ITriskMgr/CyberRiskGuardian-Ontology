iia-gias:8.4 a skos:Concept ;
    skos:broader iia-gias:8 ;
    skos:definition "A qualified independent assessor must review the function at least every five years, with results shared with the board."@en,
        "Un évaluateur indépendant qualifié doit examiner la fonction au moins tous les cinq ans et les résultats doivent être transmis au conseil."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "8.4" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "External Quality Assessment"@en,
        "Évaluation externe de la qualité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 8.4 (page 57)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:9.1 a skos:Concept ;
    skos:broader iia-gias:9 ;
    skos:definition "The chief audit executive must understand how the organization governs, manages risk and exercises control, to inform strategy and planning."@en,
        "Le responsable doit comprendre comment l'organisation gouverne, gère les risques et exerce le contrôle, afin d'éclairer la stratégie et la planification."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "9.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Understanding Governance, Risk Management, and Control Processes"@en,
        "Compréhension des processus de gouvernance, de gestion des risques et de contrôle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 9.1 (page 61)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:9.2 a skos:Concept ;
    skos:broader iia-gias:9 ;
    skos:definition "The CAE must develop and periodically revise a strategy aligning the function's vision and objectives with organizational priorities."@en,
        "Le responsable doit élaborer et réviser périodiquement une stratégie alignant la vision et les objectifs de la fonction sur les priorités de l'organisation."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "9.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Internal Audit Strategy"@en,
        "Stratégie d'audit interne"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 9.2 (page 63)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:9.3 a skos:Concept ;
    skos:broader iia-gias:9 ;
    skos:definition "The chief audit executive must establish documented methods guiding how the function plans, performs and reports its services."@en,
        "Le responsable doit établir des méthodes documentées encadrant la planification, la réalisation et la communication des services."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "9.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Methodologies"@en,
        "Méthodologies"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 9.3 (page 65)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:9.4 a skos:Concept ;
    skos:broader iia-gias:9 ;
    skos:definition "The chief audit executive must build a risk-based plan, reviewed and approved by the board, and update it as risks change."@en,
        "Le responsable doit bâtir un plan fondé sur les risques, examiné et approuvé par le conseil, et l'actualiser selon l'évolution des risques."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "9.4" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Internal Audit Plan"@en,
        "Plan d'audit interne"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 9.4 (page 66)"@en ;

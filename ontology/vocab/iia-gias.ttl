    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:15 a skos:Concept ;
    skos:broader iia-gias:V ;
    skos:definition "Internal auditors issue final engagement communications and confirm that agreed actions are carried out."@en,
        "Les auditeurs internes émettent la communication finale de mission et confirment l'exécution des actions convenues."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "15" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Communicate Engagement Results and Monitor Action Plans"@en,
        "Communiquer les résultats de mission et suivre les plans d'action"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

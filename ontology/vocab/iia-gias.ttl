iia-gias:1.1 a skos:Concept ;
    skos:broader iia-gias:1 ;
    skos:definition "Auditors must be truthful and accurate, and must voice concerns or unwelcome conclusions even under pressure."@en,
        "Les auditeurs doivent être véridiques et exacts et exprimer leurs préoccupations ou conclusions défavorables, même sous pression."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "1.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Honesty and Professional Courage"@en,
        "Honnêteté et courage professionnel"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 1.1 (page 17)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:1.2 a skos:Concept ;
    skos:broader iia-gias:1 ;
    skos:definition "Auditors must respect the organization's ethical expectations, and the chief audit executive should foster an ethical culture in the function."@en,
        "Les auditeurs doivent respecter les attentes éthiques de l'organisation et le responsable doit favoriser une culture éthique au sein de la fonction."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "1.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Organization’s Ethical Expectations"@en,
        "Attentes éthiques de l'organisation"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 1.2 (page 18)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:1.3 a skos:Concept ;
    skos:broader iia-gias:1 ;
    skos:definition "Auditors must avoid illegal or discreditable conduct and must observe the laws and regulations that apply."@en,
        "Les auditeurs doivent éviter toute conduite illégale ou discréditante et respecter les lois et règlements applicables."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "1.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Legal and Ethical Behavior"@en,
        "Comportement légal et éthique"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 1.3 (page 19)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:10.1 a skos:Concept ;
    skos:broader iia-gias:10 ;
    skos:definition "The CAE must manage the function's budget so the mandate and plan can be delivered."@en,
        "Le responsable doit gérer le budget de la fonction de façon à réaliser le mandat et le plan."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "10.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Financial Resource Management"@en,
        "Gestion des ressources financières"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 10.1 (page 72)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:10.2 a skos:Concept ;
    skos:broader iia-gias:10 ;
    skos:definition "The chief audit executive must recruit, develop and retain staff with the right mix of competencies to perform the plan."@en,
        "Le responsable doit recruter, développer et retenir un personnel doté de la bonne combinaison de compétences pour exécuter le plan."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "10.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Human Resources Management"@en,
        "Gestion des ressources humaines"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 10.2 (page 73)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:10.3 a skos:Concept ;
    skos:broader iia-gias:10 ;
    skos:definition "The chief audit executive must ensure the function has technology that supports its processes and improves efficiency."@en,
        "Le responsable doit doter la fonction d'outils technologiques qui soutiennent ses processus et accroissent son efficience."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "10.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Technological Resources"@en,
        "Ressources technologiques"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 10.3 (page 76)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:11.1 a skos:Concept ;
    skos:broader iia-gias:11 ;
    skos:definition "The chief audit executive must foster trusted relationships and ongoing dialogue with stakeholders to understand their needs."@en,
        "Le responsable doit entretenir des relations de confiance et un dialogue continu avec les parties prenantes pour comprendre leurs besoins."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "11.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Building Relationships and Communicating with Stakeholders"@en,
        "Établissement de relations et communication avec les parties prenantes"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 11.1 (page 77)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:11.2 a skos:Concept ;
    skos:broader iia-gias:11 ;
    skos:definition "Communications from the function must be truthful, unbiased, understandable, brief, helpful, complete and delivered on time."@en,
        "Les communications de la fonction doivent être véridiques, impartiales, compréhensibles, brèves, utiles, complètes et livrées à temps."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "11.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Effective Communication"@en,
        "Communication efficace"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 11.2 (page 79)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:11.3 a skos:Concept ;
    skos:broader iia-gias:11 ;
    skos:definition "The chief audit executive must report engagement and overall results, including themes and conclusions, to senior management and the board."@en,
        "Le responsable doit communiquer au conseil et à la direction générale les résultats des missions et d'ensemble, y compris thèmes et conclusions."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "11.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Communicating Results"@en,
        "Communication des résultats"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 11.3 (page 80)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:11.4 a skos:Concept ;
    skos:broader iia-gias:11 ;
    skos:definition "When a final communication has a material error or omission, corrected information must go to everyone who received the original."@en,
        "Lorsqu'une communication finale comporte une erreur ou omission importante, l'information corrigée doit être transmise à tous ses destinataires initiaux."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "11.4" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Errors and Omissions"@en,
        "Erreurs et omissions"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 11.4 (page 83)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:11.5 a skos:Concept ;
    skos:broader iia-gias:11 ;
    skos:definition "If management accepts a risk beyond the organization's appetite, the chief audit executive must discuss it with management and, if unresolved, escalate to the board."@en,
        "Si la direction accepte un risque dépassant l'appétence de l'organisation, le responsable doit en discuter avec elle et, à défaut d'accord, saisir le conseil."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "11.5" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Communicating the Acceptance of Risks"@en,
        "Communication de l'acceptation des risques"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 11.5 (page 84)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:12.1 a skos:Concept ;
    skos:broader iia-gias:12 ;
    skos:definition "The chief audit executive must carry out ongoing monitoring and periodic self-assessment of conformance and performance."@en,
        "Le responsable doit assurer une surveillance continue et des autoévaluations périodiques de la conformité et de la performance."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "12.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Internal Quality Assessment"@en,
        "Évaluation interne de la qualité"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 12.1 (page 86)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:12.2 a skos:Concept ;
    skos:broader iia-gias:12 ;
    skos:definition "The chief audit executive must define objectives and measures to evaluate the function's performance and drive improvement."@en,
        "Le responsable doit définir des objectifs et des indicateurs pour évaluer la performance de la fonction et stimuler son amélioration."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "12.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Performance Measurement"@en,
        "Mesure de la performance"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 12.2 (page 88)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:12.3 a skos:Concept ;
    skos:broader iia-gias:12 ;
    skos:definition "The chief audit executive must supervise engagements so that work quality, sound conclusions and auditor development are assured."@en,
        "Le responsable doit superviser les missions afin d'assurer la qualité du travail, la solidité des conclusions et le développement des auditeurs."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "12.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Oversee and Improve Engagement Performance"@en,
        "Supervision et amélioration de l'exécution des missions"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 12.3 (page 90)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13.1 a skos:Concept ;
    skos:broader iia-gias:13 ;
    skos:definition "Auditors must communicate with relevant stakeholders throughout each engagement, from planning to results."@en,
        "Les auditeurs doivent communiquer avec les parties prenantes concernées tout au long de chaque mission, de la planification aux résultats."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Communication"@en,
        "Communication relative à la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 13.1 (page 93)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13.2 a skos:Concept ;
    skos:broader iia-gias:13 ;
    skos:definition "Auditors must understand the activity under review and assess its risks to focus the engagement."@en,
        "Les auditeurs doivent comprendre l'activité examinée et en évaluer les risques afin de cibler la mission."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Risk Assessment"@en,
        "Évaluation des risques de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 13.2 (page 95)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13.3 a skos:Concept ;
    skos:broader iia-gias:13 ;
    skos:definition "Auditors must set objectives and scope that reflect the assessed risks and the purpose of the engagement."@en,
        "Les auditeurs doivent fixer des objectifs et un périmètre reflétant les risques évalués et la finalité de la mission."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Objectives and Scope"@en,
        "Objectifs et périmètre de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 13.3 (page 98)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13.4 a skos:Concept ;
    skos:broader iia-gias:13 ;
    skos:definition "Auditors must identify suitable criteria against which governance, risk and control processes will be judged."@en,
        "Les auditeurs doivent déterminer des critères appropriés pour juger les processus de gouvernance, de gestion des risques et de contrôle."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13.4" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Evaluation Criteria"@en,
        "Critères d'évaluation"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 13.4 (page 100)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13.5 a skos:Concept ;
    skos:broader iia-gias:13 ;
    skos:definition "Auditors must determine and secure the resources needed to achieve engagement objectives."@en,
        "Les auditeurs doivent déterminer et obtenir les ressources nécessaires à l'atteinte des objectifs de la mission."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13.5" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Resources"@en,
        "Ressources de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 13.5 (page 101)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13.6 a skos:Concept ;
    skos:broader iia-gias:13 ;
    skos:definition "Auditors must document a work program listing the tasks and procedures that will achieve the objectives."@en,
        "Les auditeurs doivent documenter un programme de travail énumérant les tâches et procédures permettant d'atteindre les objectifs."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13.6" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Work Program"@en,
        "Programme de travail"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 13.6 (page 103)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:14.1 a skos:Concept ;
    skos:broader iia-gias:14 ;
    skos:definition "Auditors must collect relevant, reliable and sufficient information to support their analyses."@en,
        "Les auditeurs doivent recueillir une information pertinente, fiable et suffisante pour étayer leurs analyses."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14.1" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Gathering Information for Analyses and Evaluation"@en,
        "Collecte d'informations pour les analyses et l'évaluation"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 14.1 (page 104)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:14.2 a skos:Concept ;
    skos:broader iia-gias:14 ;
    skos:definition "Auditors must analyze information against criteria to spot possible findings, meaning gaps between conditions and criteria."@en,
        "Les auditeurs doivent analyser l'information au regard des critères pour repérer des constats possibles, soit les écarts entre situation et critères."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14.2" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Analyses and Potential Engagement Findings"@en,
        "Analyses et constats potentiels de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 14.2 (page 106)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:14.3 a skos:Concept ;
    skos:broader iia-gias:14 ;
    skos:definition "Auditors must judge the significance of each finding, considering root causes and potential effects, and prioritize them."@en,
        "Les auditeurs doivent juger l'importance de chaque constat, en tenant compte des causes profondes et des effets potentiels, et les prioriser."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14.3" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Evaluation of Findings"@en,
        "Évaluation des constats"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, standard 14.3 (page 107)"@en ;

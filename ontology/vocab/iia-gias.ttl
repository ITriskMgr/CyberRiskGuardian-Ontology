    crgo:CRGO_0000286 "IIA GIAS 2024, principle 11 (page 77)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:9 a skos:Concept ;
    skos:broader iia-gias:IV ;
    skos:definition "The chief audit executive sets the function's direction and plan from an understanding of governance, risk and control."@en,
        "Le responsable de l'audit interne définit l'orientation et le plan de la fonction à partir de sa compréhension de la gouvernance, des risques et du contrôle."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "9" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Plan Strategically"@en,
        "Planifier de façon stratégique"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 9 (page 60)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:IV a skos:Concept ;
    skos:definition "Groups the principles guiding the chief audit executive in strategic planning, resourcing, communication and quality of the function."@en,
        "Regroupe les principes qui guident le responsable de l'audit interne en matière de planification stratégique, de ressources, de communication et de qualité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "IV" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Managing the Internal Audit Function"@en,
        "Gestion de la fonction d'audit interne"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/iia-gias> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, domain IV (page 60)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:13 a skos:Concept ;
    skos:broader iia-gias:V ;
    skos:definition "Internal auditors plan each engagement by assessing risks and setting objectives, scope, criteria, resources and a work program."@en,
        "Les auditeurs internes planifient chaque mission en évaluant les risques et en fixant objectifs, périmètre, critères, ressources et programme de travail."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "13" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Plan Engagements Effectively"@en,
        "Planifier efficacement les missions"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 13 (page 93)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:14 a skos:Concept ;
    skos:broader iia-gias:V ;
    skos:definition "Internal auditors gather and analyze evidence, evaluate findings and reach documented engagement conclusions."@en,
        "Les auditeurs internes recueillent et analysent des éléments probants, évaluent les constats et formulent des conclusions documentées."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "14" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Conduct Engagement Work"@en,
        "Réaliser les travaux de mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, principle 14 (page 104)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

iia-gias:II a skos:Concept ;
    skos:definition "Groups the principles that set the ethical conduct and professional behaviour expected of every internal auditor."@en,
        "Regroupe les principes fixant la conduite éthique et le comportement professionnel attendus de tout auditeur interne."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/iia-gias> ;
    skos:notation "II" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Ethics and Professionalism"@en,
        "Éthique et professionnalisme"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/iia-gias> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "IIA GIAS 2024, domain II (page 16)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .


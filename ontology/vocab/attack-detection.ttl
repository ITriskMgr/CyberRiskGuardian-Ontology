attack-detection:AN0234 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0084#AN0234> ;
    skos:broader attack-detection:DET0084 ;
    skos:definition "Defenders can detect suspicious cloud instance deletions by correlating events across authentication, instance lifecycle, and account activity. From a defender’s perspective, behaviors of interest include instances deleted shortly after creation, deletions initiated by new or rarely used accounts, deletions following snapshot creation, and deletions originating from anomalous geolocations or access keys. These may indicate adversarial attempts to destroy forensic evidence or evade detection."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0234" ;
    skos:note "Log sources: AWS:CloudTrail [TerminateInstances]; AWS:CloudTrail [DescribeInstances]; azure:activity [MICROSOFT.COMPUTE/VIRTUALMACHINES/DELETE]"@en ;
    skos:prefLabel "Analytic 0234 (IaaS)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

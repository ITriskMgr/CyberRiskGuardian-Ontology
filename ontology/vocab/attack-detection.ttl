    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0242#AN0679> ;
    skos:broader attack-detection:DET0242 ;
    skos:definition "Database enumeration and export activity (e.g., `SELECT * FROM`, `SHOW DATABASES`) issued via ephemeral VMs, admin APIs, or cloud shell from non-monitoring accounts. Defender correlates audit logs (CloudTrail, GCP Admin, AzureDiagnostics), storage write ops, and cross-region transfers by identities not tied to DB operations."@en ;

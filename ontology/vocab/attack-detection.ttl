    skos:notation "AN1209" ;
    skos:note "Log sources: auditd:SYSCALL [execve with LD_PRELOAD or linker-related environment variables set]; auditd:PATH [creation of .so files in non-standard directories (e.g., /tmp, /home/*)]; linux:osquery [process environment variables containing LD_PRELOAD]"@en ;
    skos:prefLabel "Analytic 1209 (Linux)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;

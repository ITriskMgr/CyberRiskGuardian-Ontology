attack-detection:AN0001 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0001#AN0001> ;
    skos:broader attack-detection:DET0001 ;
    skos:definition "Detects access attempts to cloud instance metadata endpoints (e.g., 169.254.169.254) from virtual machines or containerized workloads. This includes both direct access and SSRF exploitation patterns."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0001" ;
    skos:note "Log sources: AWS:VPCFlowLogs [Outbound connection to 169.254.169.254 from EC2 workload]; AWS:CloudTrail [GetInstanceIdentityDocument]; ebpf:syscalls [Process within container accesses link-local address 169.254.169.254]"@en ;
    skos:prefLabel "Analytic 0001 (IaaS)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0070,
        attack-detection:DC0082,
        attack-detection:DC0085 .

attack-detection:AN0002 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0002#AN0002> ;
    skos:broader attack-detection:DET0002 ;
    skos:definition "Detects non-standard processes (e.g., PowerShell, python.exe, rundll32.exe) making outbound connections using publish/subscribe protocols (e.g., MQTT, AMQP) over non-browser, encrypted channels, often beaconing to message brokers."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0002" ;
    skos:note "Log sources: WinEventLog:Sysmon [EventCode=3, 22]; NSM:Flow [mqtt.log / xmpp.log (custom log feeds)]"@en ;
    skos:prefLabel "Analytic 0002 (Windows)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0082,
        attack-detection:DC0085 .

attack-detection:AN0003 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0002#AN0003> ;
    skos:broader attack-detection:DET0002 ;
    skos:definition "Detects CLI tools (e.g., mosquitto_pub, nc, python scripts) interacting with pub/sub brokers using unusual topic names, high-frequency publication rates, or obfuscated payloads to non-standard hosts."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0003" ;
    skos:note "Log sources: auditd:SYSCALL [execve]; NSM:Flow [mqtt.log or AMQP custom log]"@en ;
    skos:prefLabel "Analytic 0003 (Linux)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0032,
        attack-detection:DC0085 .

attack-detection:AN0004 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0002#AN0004> ;
    skos:broader attack-detection:DET0002 ;
    skos:definition "Detects osascript, curl, or custom binaries interacting with XMPP/MQTT brokers in unapproved destinations with encrypted payloads or frequent POST-like requests to broker URIs."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0004" ;
    skos:note "Log sources: macos:unifiedlog [log stream 'eventMessage contains pubsub or broker']; macos:osquery [socket_events]"@en ;
    skos:prefLabel "Analytic 0004 (macOS)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0032,
        attack-detection:DC0078 .

attack-detection:AN0005 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0002#AN0005> ;
    skos:broader attack-detection:DET0002 ;
    skos:definition "Detects pub/sub traffic over unusual ports, high-frequency topic publications, and connections to known-bad or dynamic broker endpoints outside allowlisted infrastructure."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0005" ;
    skos:note "Log sources: NSM:Flow [mqtt.log, xmpp.log, amqp.log]"@en ;

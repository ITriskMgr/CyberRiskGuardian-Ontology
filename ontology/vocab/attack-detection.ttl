    skos:note "Log sources: WinEventLog:Application [EventCode=1000]; WinEventLog:Sysmon [EventCode=11]; WinEventLog:Sysmon [EventCode=1]; WinEventLog:Sysmon [EventCode=3, 22]"@en ;

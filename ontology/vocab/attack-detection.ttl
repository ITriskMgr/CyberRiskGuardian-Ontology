    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0453#AN1249> ;
    skos:broader attack-detection:DET0453 ;
    skos:definition "Defenders may observe suspicious SNMP MIB enumeration through abnormal queries for large sets of OIDs, repeated SNMP GETBULK/GETNEXT requests, or queries originating from non-administrative IP addresses. Anomalous use of community strings, authentication failures, or enumeration activity outside maintenance windows may also indicate attempts to dump MIB contents. Correlation across syslog, NetFlow, and SNMP audit data can reveal chains of behavior such as repeated authentication failures followed by successful large-scale OID retrieval."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN1249" ;
    skos:note "Log sources: networkdevice:syslog [Authentication failures, unexpected community string usage, or unauthorized SNMPv1/v2 requests]; NSM:Flow [High-volume or repeated SNMP GETBULK/GETNEXT queries from untrusted or external IPs]; networkdevice:audit [SNMP configuration changes, such as enabling read/write access or modifying community strings]"@en ;
    skos:prefLabel "Analytic 1249 (Network Devices)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0061,
        attack-detection:DC0082,
        attack-detection:DC0085 .

attack-detection:AN1250 a skos:Concept ;

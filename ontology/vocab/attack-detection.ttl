attack-detection:AN0021 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0009#AN0021> ;
    skos:broader attack-detection:DET0009 ;
    skos:definition "Adversary manipulates dependencies/dev tools used by developers or CI: a package manager (npm/yarn/pnpm, pip/pipenv, nuget/dotnet, chocolatey/winget, maven/gradle) or a compiler/IDE downloads or restores content; files are written under project paths and execution paths (node_modules, packages, .nuget, .gradle, .m2, %AppData%\\npm, %UserProfile%\\.cargo\\bin, temp build dirs). First run of newly written components triggers scripts (preinstall/postinstall), shell/PowerShell spawning, or loader DLLs, followed by network egress to non-approved registries/CDNs."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0021" ;
    skos:note "Log sources: WinEventLog:Sysmon [EventCode=1]; WinEventLog:Sysmon [EventCode=7]; WinEventLog:Sysmon [EventCode=11]; WinEventLog:Sysmon [EventCode=13, 14]; WinEventLog:Microsoft-Windows-CodeIntegrity/Operational [Invalid/Unsigned image when developer tool launches newly installed binaries]; NSM:Flow [First-time outbound connections to package registries or unknown hosts immediately after restore/build]"@en ;
    skos:prefLabel "Analytic 0021 (Windows)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

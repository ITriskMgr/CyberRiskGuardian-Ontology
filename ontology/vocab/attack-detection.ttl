attack-detection:AN2029 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0898#AN2029> ;
    skos:broader attack-detection:DET0898 ;
    skos:definition "Process execution without GUI context (e.g., powershell.exe, wscript.exe) generates HTTP traffic with a spoofed User-Agent mimicking a legitimate browser. No corresponding UI application (e.g., msedge.exe) is active or in parent lineage. The User-Agent deviates from known enterprise baselines or contains spoofed platform indicators.  User-Agent strings can be gathered with API calls such as `ShellExecuteW` to open the default browser on a socket to receive an HTTP reply, or by hard coding the User-Agent string for a specific browser."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN2029" ;
    skos:note "Log sources: NSM:Flow [Inbound HTTP POST with suspicious payload size or user-agent]; WinEventLog:Sysmon [EventCode=3, 22]; etw:Microsoft-Windows-Kernel-Process [API Calls]"@en ;
    skos:prefLabel "Analytic 2029 (Windows)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;

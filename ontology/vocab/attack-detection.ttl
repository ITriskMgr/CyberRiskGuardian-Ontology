attack-detection:AN1196 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0428#AN1196> ;
    skos:broader attack-detection:DET0428 ;
    skos:definition "Abuse of bind mounts to obscure process directories. Defender perspective: detecting anomalous mount operations where a process’s /proc entry is remapped to another directory, often hiding malicious activity from native utilities (ps, top). Behavior chain includes: (1) execution of `mount` with `-o bind` or `-B` flags, (2) modification of /proc entries inconsistent with expected process lineage, and (3) subsequent anomalous activity from processes whose metadata no longer matches execution context."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN1196" ;
    skos:note "Log sources: auditd:SYSCALL [mount system call with bind or remap flags]; auditd:PATH [mount target path within /proc/*]; linux:osquery [process metadata mismatch between /proc and runtime attributes]"@en ;
    skos:prefLabel "Analytic 1196 (Linux)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;

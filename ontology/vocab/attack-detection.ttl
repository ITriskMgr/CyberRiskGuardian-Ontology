    skos:notation "AN0466" ;
    skos:note "Log sources: auditd:SYSCALL [execve, prctl, or ptrace activity affecting process memory or command-line arguments]; ebpf:tracepoints [Runtime memory overwrite of argv[] memory region]"@en ;

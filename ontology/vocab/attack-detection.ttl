    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0002,
        attack-detection:DC0013,
        attack-detection:DC0038,
        attack-detection:DC0067 .


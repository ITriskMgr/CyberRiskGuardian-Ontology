        attack-detection:DC0061 .

attack-detection:AN0012 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0005#AN0012> ;
    skos:broader attack-detection:DET0005 ;
    skos:definition "Execution of binaries where the on-disk filename does not match PE metadata such as OriginalFilename or InternalName. Often observed with renamed LOLBAS or system binaries like rundll32, powershell, or psexec."@en ;

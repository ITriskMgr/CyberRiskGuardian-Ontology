    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0085 .

attack-detection:AN0006 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0003#AN0006> ;
    skos:broader attack-detection:DET0003 ;
    skos:definition "Adversary uses built-in tools such as 'net user /add /domain' or PowerShell to create a domain user account. The behavior chain includes: (1) suspicious process execution on a domain controller followed by (2) user account creation event (Event ID 4720) on the same host."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0006" ;
    skos:note "Log sources: WinEventLog:Security [EventCode=4720]; WinEventLog:Sysmon [EventCode=1]"@en ;
    skos:prefLabel "Analytic 0006 (Windows)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0014,
        attack-detection:DC0032 .

attack-detection:AN0007 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0003#AN0007> ;
    skos:broader attack-detection:DET0003 ;
    skos:definition "Adversary with access to domain management tools (e.g., `realmd`, `samba-tool`, `ldapmodify`) creates a new domain user via command-line utilities. Behavior chain: LDAP command or script triggers → user entry added in AD via Kerberos/LDAP traffic."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0007" ;
    skos:note "Log sources: auditd:SYSCALL [execution of realmd, samba-tool, or ldapmodify with user-related arguments]; NSM:Flow [TGS-REQ and AS-REQ seen for new user shortly after domain-modifying process]"@en ;
    skos:prefLabel "Analytic 0007 (Linux)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0002,
        attack-detection:DC0064 .

attack-detection:AN0008 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0003#AN0008> ;
    skos:broader attack-detection:DET0003 ;
    skos:definition "macOS clients joined to AD via LDAP may script account provisioning via `dsconfigad`, `dscl`, or LDAP scripts. Detection occurs when such tools run on a domain-joined system, followed by authentication attempts by a previously unseen account."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0008" ;
    skos:note "Log sources: macos:unifiedlog [dsconfigad or dscl with create or append options for AD-bound users]; macos:unifiedlog [UserLoggedIn]"@en ;
    skos:prefLabel "Analytic 0008 (macOS)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0064,
        attack-detection:DC0067 .

attack-detection:AN0009 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0004#AN0009> ;
    skos:broader attack-detection:DET0004 ;
    skos:definition "Abnormal modification of the PATH environment variable or registry keys controlling system paths, combined with execution of binaries named after legitimate system tools from user-writable directories. Defender correlates registry modifications, file creation of suspicious binaries, and process execution paths inconsistent with baseline system directories."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0009" ;
    skos:note "Log sources: WinEventLog:Security [EventCode=4657]; WinEventLog:Sysmon [EventCode=11]; WinEventLog:Sysmon [EventCode=1]"@en ;
    skos:prefLabel "Analytic 0009 (Windows)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0032,
        attack-detection:DC0039,
        attack-detection:DC0063 .

attack-detection:AN0010 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0004#AN0010> ;
    skos:broader attack-detection:DET0004 ;
    skos:definition "User modification of the $PATH environment variable in shell configuration files or direct runtime PATH changes, followed by execution of binaries from user-controlled directories. Defender observes file edits to ~/.bashrc, ~/.profile, or /etc/paths.d and process execution resolving to unexpected binary locations."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0010" ;
    skos:note "Log sources: auditd:SYSCALL [open/write calls modifying ~/.bashrc, ~/.profile, or /etc/paths.d]; linux:osquery [Execution of binary resolved from $PATH not located in /usr/bin or /bin]"@en ;
    skos:prefLabel "Analytic 0010 (Linux)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-13"^^xsd:date ;
    crgo:CRGO_0000291 "0.10.0" ;
    crgo:CRGO_0001243 attack-detection:DC0032,
        attack-detection:DC0061 .

attack-detection:AN0011 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0004#AN0011> ;
    skos:broader attack-detection:DET0004 ;
    skos:definition "Modification of PATH or HOME environment variables through shell config files, launchctl, or /etc/paths.d entries, combined with process execution from attacker-controlled directories. Defender correlates file changes in /etc/paths.d with process execution resolving to malicious binaries."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0011" ;
    skos:note "Log sources: macos:unifiedlog [File modification in /etc/paths.d or user shell rc files]; macos:unifiedlog [Process execution path inconsistent with baseline PATH directories]"@en ;
    skos:prefLabel "Analytic 0011 (macOS)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;

attack-detection:AN0580 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0204#AN0580> ;
    skos:broader attack-detection:DET0204 ;
    skos:definition "Detects suspicious registry modifications under `HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Monitors\\*\\Driver`, DLL loads by `spoolsv.exe` of non-standard or unsigned modules, and abnormal usage of the `AddMonitor` API by non-installation processes. This pattern often indicates an attempt to persist a malicious DLL via the print monitor mechanism, particularly when correlated with creation of files in `C:\\Windows\\System32` not tied to known patches or installations."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0580" ;
    skos:note "Log sources: WinEventLog:Sysmon [EventCode=1]; WinEventLog:Sysmon [EventCode=7]; WinEventLog:Sysmon [EventCode=13]; WinEventLog:Sysmon [EventCode=11]; WinEventLog:Application [API call to AddMonitor invoked by non-installer process]"@en ;
    skos:prefLabel "Analytic 0580 (Windows)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;

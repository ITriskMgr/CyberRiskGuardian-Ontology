attack-detection:AN1136 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0406#AN1136> ;
    skos:broader attack-detection:DET0406 ;
    skos:definition "Abuse of extended attributes (xattrs) to hide payloads in com.apple.* or custom keys. Defender perspective: monitor suspicious use of xattr command with -w (write) and -p (print) flags, especially when followed by execution of interpreters like bash, Python, or osascript. Behavior chain includes: (1) suspicious file modification with new com.apple.* attributes, (2) attribute content inconsistent with expected metadata tags (e.g., high entropy), (3) subsequent process execution correlated with extraction of the attribute."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN1136" ;
    skos:note "Log sources: macos:unifiedlog [xattr utility execution with -w or -p flags]; macos:unifiedlog [extended attribute write or modification]"@en ;
    skos:prefLabel "Analytic 1136 (macOS)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;

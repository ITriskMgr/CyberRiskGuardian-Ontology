attack-detection:AN0233 a skos:Concept ;
    rdfs:seeAlso <https://attack.mitre.org/detectionstrategies/DET0083#AN0233> ;
    skos:broader attack-detection:DET0083 ;
    skos:definition "Execution of container orchestration commands (e.g., `docker exec`, `kubectl exec`) or API-driven interactions with running containers from unauthorized hosts or non-standard user contexts. Defender sees programmatic or interactive command execution within containers outside expected CI/CD tools or automation frameworks, often followed by file writes, privilege escalation, or lateral discovery."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/attack-detection> ;
    skos:notation "AN0233" ;
    skos:note "Log sources: auditd:SYSCALL [execve: Execution of container management CLIs (docker, crictl, kubectl) or interpreted shells (sh, bash, python) within container context]; docker:events [exec_create: docker exec events targeting running containers from non-CI sources]; kubernetes:apiserver [create/exec: Kubernetes API calls to exec into containers or create pods from curl, kubectl, or SDK clients]; AWS:CloudTrail [CreatePod: Programmatic creation of new pod resources using container images not seen before in the environment]; kubernetes:audit [Shell process (e.g., /bin/sh, /bin/bash) spawned in a container without an interactive session attached (i.e., automation anomaly)]"@en ;
    skos:prefLabel "Analytic 0233 (Containers)"@en ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE ATT&CK Enterprise 19.2 STIX bundle"@en ;

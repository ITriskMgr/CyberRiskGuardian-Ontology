itaf:ITAF-1001 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires a formally approved document stating the mandate, authority and accountability of the IT audit function."@en,
        "Exige un document formellement approuvé énonçant le mandat, les pouvoirs et la responsabilité de la fonction d'audit des TI."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1001" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Audit Charter"@en,
        "Charte d'audit"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1001 (page 15)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1002 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires the IT audit function to be positioned and to report so that no conflict or outside pressure compromises its engagements."@en,
        "Exige que la fonction d'audit des TI soit positionnée et rattachée de sorte qu'aucun conflit ni pression externe ne compromette ses missions."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1002" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Organizational Independence"@en,
        "Indépendance organisationnelle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1002 (page 20)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1003 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires each practitioner to judge impartially and to disclose and mitigate any actual or perceived threat to that impartiality."@en,
        "Exige de chaque praticien un jugement impartial ainsi que la divulgation et l'atténuation de toute menace réelle ou apparente à cette impartialité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1003" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Auditor Objectivity"@en,
        "Objectivité de l'auditeur"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1003 (page 23)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1004 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires practitioners to confirm, prior to taking on or renewing an assignment, that it can be completed with suitable scope, cooperation and conformance."@en,
        "Exige de confirmer, avant d'accepter ou de reconduire une mission, qu'elle peut être menée avec une portée, une collaboration et une conformité adéquates."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1004" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Reasonable Expectation"@en,
        "Attente raisonnable"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1004 (page 31)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1005 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires diligent, ethical and confidential conduct throughout every engagement, as prescribed by the professional ethics code of ISACA."@en,
        "Exige une conduite diligente, éthique et confidentielle, conforme au Code de déontologie professionnelle de l'ISACA, tout au long de chaque mission."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1005" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Due Professional Care"@en,
        "Diligence professionnelle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1005 (page 37)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1006 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires the engagement team to hold, collectively, the knowledge and skills the work demands and to keep them current."@en,
        "Exige que l'équipe de mission détienne collectivement les connaissances et habiletés requises par le travail et les maintienne à jour."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1006" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Proficiency"@en,
        "Compétence professionnelle"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1006 (page 45)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1007 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires practitioners to confirm that the claims made about the subject matter are auditable and adequate as a basis for conclusions."@en,
        "Exige de vérifier que les affirmations portant sur l'objet de la mission sont auditables et suffisantes pour fonder des conclusions."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1007" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Assertions"@en,
        "Assertions"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1007 (page 52)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1008 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Requires the yardsticks used to assess the subject matter to be objective, relevant, measurable, recognized and accessible to report users."@en,
        "Exige que les référentiels d'évaluation de l'objet soient objectifs, pertinents, mesurables, reconnus et accessibles aux utilisateurs du rapport."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1008" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Criteria"@en,
        "Critères"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1008 (page 59)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1201 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires a risk-based method to build the IT audit plan, rank priorities, allocate resources and scope each individual engagement."@en,
        "Exige une méthode fondée sur les risques pour bâtir le plan d'audit des TI, hiérarchiser les priorités, répartir les ressources et cadrer chaque mission."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1201" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Risk Assessment in Planning"@en,
        "Évaluation des risques lors de la planification"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1201 (page 65)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1202 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires approved short- and long-range audit schedules tied to enterprise strategy and risk, revised when circumstances change."@en,
        "Exige des calendriers d'audit à court et à long terme, approuvés, liés à la stratégie et aux risques de l'entreprise et révisés selon l'évolution du contexte."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1202" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Audit Scheduling"@en,
        "Calendrier des audits"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1202 (page 74)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1203 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires each engagement to be planned in terms of objectives, scope, resources, timing and the nature and extent of procedures."@en,
        "Exige que chaque mission soit planifiée quant aux objectifs, à la portée, aux ressources, à l'échéancier ainsi qu'à la nature et l'étendue des procédures."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1203" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Engagement Planning"@en,
        "Planification de la mission"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1203 (page 77)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1204 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires work to follow the approved plan under adequate supervision, with competent staff and properly documented support for conclusions."@en,
        "Exige que le travail suive le plan approuvé sous une supervision adéquate, avec un personnel compétent et des appuis documentés pour les conclusions."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1204" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Performance and Supervision"@en,
        "Exécution et supervision"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1204 (page 85)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1205 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires practitioners to gather enough suitable evidence, assess it with professional skepticism and retain it per approved retention rules."@en,
        "Exige de recueillir des éléments probants suffisants et adéquats, de les apprécier avec scepticisme professionnel et de les conserver selon les règles approuvées."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1205" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Evidence"@en,
        "Éléments probants"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1205 (page 94)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1206 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires practitioners to vet the competence and independence of outside experts prior to using their output, and to document that reliance."@en,
        "Exige de vérifier la compétence et l'indépendance des autres experts avant de s'appuyer sur leurs travaux, et de documenter ce recours."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1206" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Using the Work of Other Experts"@en,
        "Recours aux travaux d'autres experts"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1206 (page 101)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1207 a skos:Concept ;
    skos:broader itaf:ITAF-PERF ;
    skos:definition "Requires practitioners to stay alert to possible fraud or unlawful acts and to document and escalate any they find to proper parties."@en,
        "Exige de demeurer attentif aux fraudes ou actes illicites possibles, et de documenter et signaler ceux qui sont décelés aux parties compétentes."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1207" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Irregularities and Illegal Acts"@en,
        "Irrégularités et actes illégaux"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1207 (page 107)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1401 a skos:Concept ;
    skos:broader itaf:ITAF-REP ;
    skos:definition "Requires a report for every engagement whose findings rest on sufficient, appropriate evidence."@en,
        "Exige un rapport pour chaque mission, dont les constats reposent sur des éléments probants suffisants et adéquats."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1401" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Reporting"@en,
        "Rapport"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1401 (page 119)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-1402 a skos:Concept ;
    skos:broader itaf:ITAF-REP ;
    skos:definition "Requires practitioners to track and report management remediation of findings and to escalate overdue actions or risk accepted beyond appetite to governance bodies."@en,
        "Exige de suivre et de rapporter la correction des constats par la direction, et de remonter aux instances de gouvernance les retards ou risques acceptés au-delà de l'appétence."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/itaf> ;
    skos:notation "ITAF-1402" ;
    skos:note "French label translated by CRGO."@en ;
    skos:prefLabel "Follow-up Activities"@en,
        "Activités de suivi"@fr ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "ISACA ITAF 5th edition, standard ITAF-1402 (page 124)"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.9.0" .

itaf:ITAF-2001 a skos:Concept ;
    skos:broader itaf:ITAF-GEN ;
    skos:definition "Guidance on drafting, approving and maintaining the audit charter, including the elements it should contain."@en,

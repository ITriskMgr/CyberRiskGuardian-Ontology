    dcterms:title "Personal Information Protection and Electronic Documents Act (Canada): security and breach provisions"@en,
        "Loi sur la protection des renseignements personnels et les documents électroniques (Canada) : dispositions de sécurité et d'atteinte"@fr ;
    owl:versionIRI <https://w3id.org/crgo/vocab/0.10.0/pipeda> ;
    owl:versionInfo "S.C. 2000, c. 5, current to 2026-05-26 (last amended 2025-03-04)" ;

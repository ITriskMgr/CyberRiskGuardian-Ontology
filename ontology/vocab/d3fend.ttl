d3fend:D3-DO a skos:Concept ;
    rdfs:seeAlso <https://d3fend.mitre.org/technique/d3f:DecoyObject/> ;
    skos:definition "A Decoy Object is created and deployed for the purposes of deceiving attackers."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/d3fend> ;
    skos:notation "D3-DO" ;
    skos:prefLabel "Decoy Object"@en ;

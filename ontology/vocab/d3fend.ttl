d3fend:D3-AI a skos:Concept ;
    rdfs:seeAlso <https://d3fend.mitre.org/technique/d3f:AssetInventory/> ;
    skos:definition "Asset inventorying identifies and records the organization's assets and enriches each inventory item with knowledge about their vulnerabilities."@en ;

d3fend:D3-NI a skos:Concept ;
    rdfs:seeAlso <https://d3fend.mitre.org/technique/d3f:NetworkIsolation/> ;
    skos:definition "Network Isolation techniques prevent network hosts from accessing non-essential system network resources."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/d3fend> ;
    skos:notation "D3-NI" ;
    skos:prefLabel "Network Isolation"@en ;

    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

d3fend:D3-PA a skos:Concept ;
    rdfs:seeAlso <https://d3fend.mitre.org/technique/d3f:ProcessAnalysis/> ;
    skos:definition "Process Analysis consists of observing a running application process and analyzing it to watch for certain behaviors or conditions which may indicate adversary activity. Analysis can occur inside of the process or through a third-party monitoring application. Examples include monitoring system and privileged calls, monitoring process initiation chains, and memory boundary allocations."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/d3fend> ;
    skos:notation "D3-PA" ;
    skos:prefLabel "Process Analysis"@en ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/d3fend> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000063 ;
    crgo:CRGO_0000286 "MITRE D3FEND 1.6.0"@en ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-10-11"^^xsd:date ;
    crgo:CRGO_0000291 "0.7.0" .

d3fend:D3-PM a skos:Concept ;
    rdfs:seeAlso <https://d3fend.mitre.org/technique/d3f:PlatformMonitoring/> ;
    skos:definition "Monitoring platform components such as operating systems software, hardware devices, or firmware."@en ;
    skos:inScheme <https://w3id.org/crgo/vocab/d3fend> ;
    skos:notation "D3-PM" ;
    skos:prefLabel "Platform Monitoring"@en ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/d3fend> ;

    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class data_spill (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#data_spill> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:digital-forensics a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001123 ;
    skos:definition "The collection, preservation and analysis of digital evidence in a way that keeps its integrity and admissibility."@en,
        "Collecte, préservation et analyse de preuves numériques d'une manière qui en conserve l'intégrité et la recevabilité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "digital-forensics" ;
    skos:prefLabel "digital forensics"@en,
        "investigation numérique"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class digital_forensics (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#digital_forensics> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:digital-signature a skos:Concept ;
    skos:definition "A cryptographic value computed with a private key that lets others verify the origin and integrity of data with the matching public key."@en,
        "Valeur cryptographique calculée avec une clé privée qui permet à d'autres de vérifier l'origine et l'intégrité de données à l'aide de la clé publique correspondante."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "digital-signature" ;
    skos:prefLabel "digital signature"@en,
        "signature numérique"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class digital_signature (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#digital_signature> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:hashing a skos:Concept ;
    skos:definition "Computing a fixed-length value from data such that any change to the data changes the value."@en,
        "Calcul d'une valeur de longueur fixe à partir de données, de sorte que toute modification des données modifie la valeur."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "hashing" ;
    skos:prefLabel "hashing"@en,
        "hachage"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class hashing (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#hashing> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:industrial-control-system a skos:Concept ;
    skos:definition "A system that monitors and controls physical industrial processes, such as SCADA systems and programmable logic controllers."@en,
        "Système qui surveille et commande des procédés industriels physiques, comme les systèmes SCADA et les automates programmables."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "industrial-control-system" ;
    skos:prefLabel "industrial control system"@en,
        "système de contrôle industriel"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class industrial_control_system (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#industrial_control_system> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:information-sharing a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001105 ;
    skos:definition "The exchange of threat, vulnerability and incident information between organisations or with authorities."@en,
        "Échange d'informations sur les menaces, les vulnérabilités et les incidents entre organisations ou avec des autorités."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "information-sharing" ;

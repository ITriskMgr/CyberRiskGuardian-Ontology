glossary:advanced-persistent-threat a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0000294 ;
    skos:definition "A well-resourced adversary that pursues its objectives over a long period, adapts to defences and keeps access once obtained."@en,
        "Adversaire doté de moyens importants qui poursuit ses objectifs sur une longue période, s'adapte aux défenses et conserve l'accès une fois obtenu."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "advanced-persistent-threat" ;
    skos:prefLabel "advanced persistent threat"@en,
        "menace persistante avancée"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class advanced_persistent_threat (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#advanced_persistent_threat> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:air-gap a skos:Concept ;
    skos:definition "Isolation of a system from untrusted networks, with no direct electronic connection to them."@en,
        "Isolement d'un système par rapport aux réseaux non fiables, sans connexion électronique directe avec eux."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "air-gap" ;
    skos:prefLabel "air gap"@en,
        "isolement par coupure réseau"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class air_gap (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#air_gap> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:allowlist a skos:Concept ;
    skos:definition "A list of entities, such as applications, addresses or senders, that are permitted, everything else being denied."@en,
        "Liste d'entités, comme des applications, des adresses ou des expéditeurs, qui sont permises, tout le reste étant refusé."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "allowlist" ;
    skos:prefLabel "allowlist"@en,
        "liste d'autorisation"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class allowlist (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#allowlist> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:asymmetric-cryptography a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001331 ;
    skos:definition "Cryptography that uses a pair of related keys, one public and one private."@en,
        "Cryptographie qui utilise une paire de clés liées, l'une publique et l'autre privée."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "asymmetric-cryptography" ;
    skos:prefLabel "asymmetric cryptography"@en,
        "cryptographie asymétrique"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class asymmetric_cryptography (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#asymmetric_cryptography> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:attack-path a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0000026,
        crgo:CRGO_0001356 ;
    skos:definition "A sequence of steps and weaknesses that an adversary can chain to reach a target asset from a starting point."@en,
        "Suite d'étapes et de faiblesses qu'un adversaire peut enchaîner pour atteindre un actif cible à partir d'un point de départ."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "attack-path" ;
    skos:prefLabel "attack path"@en,
        "chemin d'attaque"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class attack_path (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#attack_path> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:attack-surface a skos:Concept ;
    skos:definition "The set of points of a system, service or organisation through which an adversary could try to enter, cause an effect or extract data."@en,
        "Ensemble des points d'un système, d'un service ou d'une organisation par lesquels un adversaire pourrait tenter d'entrer, de produire un effet ou d'extraire des données."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "attack-surface" ;
    skos:prefLabel "attack surface"@en,
        "surface d'attaque"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class attack_surface (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#attack_surface> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:authenticity a skos:Concept ;
    skos:definition "The property that an entity, message or data is what it claims to be and comes from its claimed source."@en,
        "Propriété selon laquelle une entité, un message ou des données sont ce qu'ils prétendent être et proviennent de la source déclarée."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "authenticity" ;
    skos:prefLabel "authenticity"@en,
        "authenticité"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class authenticity (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#authenticity> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:blocklist a skos:Concept ;
    skos:definition "A list of entities that are denied, everything else being permitted."@en,
        "Liste d'entités qui sont refusées, tout le reste étant permis."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;

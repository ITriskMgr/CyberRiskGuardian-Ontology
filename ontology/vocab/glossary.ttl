    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:botnet a skos:Concept ;
    skos:definition "A collection of compromised devices controlled remotely by an adversary, used for attacks such as denial of service, spam or credential stuffing."@en,
        "Ensemble d'appareils compromis contrôlés à distance par un adversaire et utilisés pour des attaques comme le déni de service, le pourriel ou le bourrage d'identifiants."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "botnet" ;
    skos:prefLabel "botnet"@en,
        "réseau de zombies"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class botnet (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#botnet> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:critical-infrastructure a skos:Concept ;
    skos:definition "Systems and assets whose disruption would seriously affect public safety, health, the economy or government functions."@en,
        "Systèmes et actifs dont la perturbation aurait de graves conséquences sur la sécurité ou la santé publiques, l'économie ou les fonctions gouvernementales."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "critical-infrastructure" ;
    skos:prefLabel "critical infrastructure"@en,
        "infrastructure essentielle"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class critical_infrastructure (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#critical_infrastructure> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:data-spill a skos:Concept ;
    skos:definition "The placement of sensitive information on a system or medium not authorised to hold it."@en,
        "Placement d'informations sensibles sur un système ou un support qui n'est pas autorisé à les contenir."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "data-spill" ;
    skos:prefLabel "data spill"@en,
        "déversement de données"@fr ;

glossary:public-key-infrastructure a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001330 ;
    skos:definition "The policies, authorities, systems and procedures used to issue, manage and revoke digital certificates."@en,
        "Politiques, autorités, systèmes et procédures servant à émettre, à gérer et à révoquer des certificats numériques."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "public-key-infrastructure" ;
    skos:prefLabel "public key infrastructure"@en,
        "infrastructure à clé publique"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class public_key_infrastructure (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#public_key_infrastructure> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:red-team a skos:Concept ;
    skos:definition "A group authorised to emulate an adversary's attacks against an organisation to test its defences."@en,
        "Groupe autorisé à imiter les attaques d'un adversaire contre une organisation afin d'en éprouver les défenses."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "red-team" ;
    skos:prefLabel "red team"@en,
        "équipe rouge"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class red_team (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#red_team> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:rootkit a skos:Concept ;
    skos:definition "Malicious software that hides its presence and that of other malicious code while keeping privileged access to a system."@en,
        "Logiciel malveillant qui dissimule sa présence et celle d'autre code malveillant tout en conservant un accès privilégié à un système."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "rootkit" ;
    skos:prefLabel "rootkit"@en,
        "trousse de dissimulation d'activité"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class rootkit (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#rootkit> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:security-automation a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001120 ;
    skos:definition "The use of software to carry out security tasks, such as triage or containment, with limited human intervention."@en,
        "Utilisation de logiciels pour accomplir des tâches de sécurité, comme le tri ou le confinement, avec une intervention humaine limitée."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "security-automation" ;
    skos:prefLabel "security automation"@en,
        "automatisation de la sécurité"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class security_automation (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#security_automation> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:security-by-design a skos:Concept ;
    skos:definition "Building security requirements into a system from its design rather than adding them afterwards."@en,
        "Intégration des exigences de sécurité à un système dès sa conception plutôt qu'après coup."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "security-by-design" ;
    skos:prefLabel "security by design"@en,
        "sécurité dès la conception"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class build_security_in (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#build_security_in> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:situational-awareness a skos:Concept ;
    skos:definition "An up-to-date understanding of the threats, vulnerabilities and state of an organisation's systems, used to make decisions."@en,
        "Compréhension à jour des menaces, des vulnérabilités et de l'état des systèmes d'une organisation, servant à prendre des décisions."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "situational-awareness" ;
    skos:prefLabel "situational awareness"@en,
        "connaissance de la situation"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class situational_awareness (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#situational_awareness> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:spoofing a skos:Concept ;
    skos:definition "Falsifying the apparent origin of a message, address or identity to deceive a person or system."@en,
        "Falsification de l'origine apparente d'un message, d'une adresse ou d'une identité pour tromper une personne ou un système."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "spoofing" ;
    skos:prefLabel "spoofing"@en,
        "usurpation"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class spoofing (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#spoofing> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:spyware a skos:Concept ;
    skos:definition "Malicious software that secretly gathers information about a user or organisation and sends it to a third party."@en,
        "Logiciel malveillant qui recueille secrètement des informations sur un utilisateur ou une organisation et les transmet à un tiers."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "spyware" ;
    skos:prefLabel "spyware"@en,
        "logiciel espion"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class spyware (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#spyware> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:supply-chain-risk-management a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0000342 ;
    skos:definition "Identifying, assessing and treating risks that arise from suppliers, their products and services, and their own suppliers."@en,
        "Détermination, évaluation et traitement des risques découlant des fournisseurs, de leurs produits et services, et de leurs propres fournisseurs."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "supply-chain-risk-management" ;
    skos:prefLabel "supply chain risk management"@en,
        "gestion des risques de la chaîne d'approvisionnement"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class supply_chain_risk_management (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#supply_chain_risk_management> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:symmetric-cryptography a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001331 ;
    skos:definition "Cryptography in which the same secret key is used to encrypt and decrypt."@en,
        "Cryptographie dans laquelle la même clé secrète sert à chiffrer et à déchiffrer."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "symmetric-cryptography" ;
    skos:prefLabel "symmetric cryptography"@en,
        "cryptographie symétrique"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class symmetric_cryptography (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#symmetric_cryptography> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:tabletop-exercise a skos:Concept ;
    rdfs:seeAlso crgo:CRGO_0001128 ;
    skos:definition "A discussion-based exercise in which participants walk through their response to a scenario without using live systems."@en,
        "Exercice fondé sur la discussion au cours duquel les participants passent en revue leur réponse à un scénario sans utiliser les systèmes réels."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "tabletop-exercise" ;
    skos:prefLabel "tabletop exercise"@en,
        "exercice sur table"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class tabletop_exercise (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#tabletop_exercise> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:trojan-horse a skos:Concept ;
    skos:definition "Malicious software that presents itself as legitimate so that a user installs or runs it."@en,
        "Logiciel malveillant qui se présente comme légitime afin qu'un utilisateur l'installe ou l'exécute."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "trojan-horse" ;
    skos:prefLabel "trojan horse"@en,
        "cheval de Troie"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class trojan_horse (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#trojan_horse> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:white-team a skos:Concept ;
    skos:definition "The group that plans, referees and evaluates a cyber exercise between red and blue teams."@en,
        "Groupe qui planifie, arbitre et évalue un exercice de cybersécurité entre équipes rouge et bleue."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "white-team" ;
    skos:prefLabel "white team"@en,
        "équipe blanche"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class white_team (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#white_team> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:work-factor a skos:Concept ;
    skos:definition "An estimate of the effort or time an adversary would need to defeat a security measure."@en,
        "Estimation de l'effort ou du temps dont un adversaire aurait besoin pour déjouer une mesure de sécurité."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "work-factor" ;
    skos:prefLabel "work factor"@en,
        "facteur de travail"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class work_factor (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#work_factor> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:worm a skos:Concept ;
    skos:definition "Malicious software that copies itself from system to system across a network without user action."@en,
        "Logiciel malveillant qui se copie d'un système à l'autre par le réseau sans action de l'utilisateur."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "worm" ;
    skos:prefLabel "worm"@en,
        "ver informatique"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class worm (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#worm> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;

    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:blue-team a skos:Concept ;
    skos:definition "The group that defends an organisation's systems, notably during an exercise against a red team."@en,
        "Groupe qui défend les systèmes d'une organisation, notamment lors d'un exercice contre une équipe rouge."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "blue-team" ;
    skos:prefLabel "blue team"@en,
        "équipe bleue"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;

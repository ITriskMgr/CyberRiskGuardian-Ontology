    crgo:CRGO_0000291 "0.11.0" .

glossary:moving-target-defence a skos:Concept ;
    skos:definition "Changing a system's configuration, addresses or components over time so that an adversary's knowledge of it becomes stale."@en,
        "Modification dans le temps de la configuration, des adresses ou des composants d'un système afin que la connaissance qu'en a un adversaire devienne périmée."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "moving-target-defence" ;
    skos:prefLabel "moving target defence"@en,
        "défense par cible mouvante"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class moving_target_defense (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#moving_target_defense> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:non-repudiation a skos:Concept ;
    skos:definition "The property that a party cannot credibly deny having performed an action, such as sending or approving a message."@en,
        "Propriété selon laquelle une partie ne peut nier de façon crédible avoir accompli une action, comme l'envoi ou l'approbation d'un message."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "non-repudiation" ;
    skos:prefLabel "non-repudiation"@en,
        "non-répudiation"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;
    crgo:CRGO_0000283 crgo:CRGO_0000069 ;
    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "Adapted from MOACCO 1.2a, class non-repudiation (term only; definition by CRGO)"@en ;
    crgo:CRGO_0000287 <http://www.semanticweb.org/maleger/ontologies/2022/3/MOACCO#non-repudiation> ;
    crgo:CRGO_0000288 crgo:CRGO_0000181 ;
    crgo:CRGO_0000289 crgo:CRGO_0000182 ;
    crgo:CRGO_0000290 "2026-11-02"^^xsd:date ;
    crgo:CRGO_0000291 "0.11.0" .

glossary:penetration-testing a skos:Concept ;
    skos:definition "Authorised simulated attacks on a system to find and show weaknesses an adversary could exploit."@en,
        "Attaques simulées et autorisées contre un système afin de trouver et de démontrer les faiblesses qu'un adversaire pourrait exploiter."@fr ;
    skos:inScheme <https://w3id.org/crgo/vocab/glossary> ;
    skos:notation "penetration-testing" ;
    skos:prefLabel "penetration testing"@en,
        "test d'intrusion"@fr ;
    skos:topConceptOf <https://w3id.org/crgo/vocab/glossary> ;

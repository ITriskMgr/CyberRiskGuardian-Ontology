    crgo:CRGO_0000284 crgo:CRGO_0000064 ;
    crgo:CRGO_0000286 "data/frameworks/legal_instruments.tsv; Royal Assent from the Public Safety Canada news release of 2026-06-16; enacted text not read"@en ;

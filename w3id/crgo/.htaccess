# w3id.org/crgo - CyberRiskGuardian Ontology (CRGO)
# Maintainer: Marc-André Léger (GitHub: ITriskMgr). Source: https://github.com/ITriskMgr/cyberriskguardian-ontology
# HTML goes to the documentation site (GitHub Pages); RDF goes to the Turtle files in the repository.
Options +FollowSymLinks
RewriteEngine on

# --- RDF requests (Turtle, RDF/XML, JSON-LD, N-Triples) ---------------------------------------------
# Terms: the documentation site carries the whole TBox in each serialisation
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^(CRGO_[0-9]+)$ https://itriskmgr.github.io/cyberriskguardian-ontology/doc/ontology.owl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(CRGO_[0-9]+)$ https://itriskmgr.github.io/cyberriskguardian-ontology/doc/ontology.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^(CRGO_[0-9]+)$ https://itriskmgr.github.io/cyberriskguardian-ontology/doc/ontology.nt [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^(CRGO_[0-9]+)$ https://itriskmgr.github.io/cyberriskguardian-ontology/doc/ontology.ttl [R=303,L]

# Modules (current version) and the full umbrella
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/main/ontology/crgo.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} (text/turtle|application/x-turtle|application/rdf\+xml|application/ld\+json|application/n-triples)
RewriteRule ^(crgo|crgo-gov|crgo-core|crgo-measure|crgo-crg|crgo-full)$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/main/ontology/$1.ttl [R=303,L]

# --- HTML (browsers and everything else) ------------------------------------------------------------
RewriteRule ^$ https://itriskmgr.github.io/cyberriskguardian-ontology/ [R=303,L]
RewriteRule ^(CRGO_[0-9]+)$ https://itriskmgr.github.io/cyberriskguardian-ontology/doc/index-en.html#$1 [R=303,NE,L]
RewriteRule ^(crgo|crgo-gov|crgo-core|crgo-measure|crgo-crg)$ https://itriskmgr.github.io/cyberriskguardian-ontology/doc/index-en.html [R=303,L]
RewriteRule ^crgo-full$ https://itriskmgr.github.io/cyberriskguardian-ontology/ [R=303,L]

# --- Files served as Turtle whatever the request -----------------------------------------------------
# Version IRIs: the file at the release tag (https://w3id.org/crgo/0.4.0/crgo-core -> tag v0.4.0)
RewriteRule ^([0-9]+\.[0-9]+\.[0-9]+)/(crgo|crgo-gov|crgo-core|crgo-measure|crgo-crg|crgo-full)$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/v$1/ontology/$2.ttl [R=303,L]
RewriteRule ^vocab/([0-9]+\.[0-9]+\.[0-9]+)/([a-z0-9-]+)$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/v$1/ontology/vocab/$2.ttl [R=303,L]
# Vocabularies and their concepts (https://w3id.org/crgo/vocab/csf2/PR.AA-05 -> the csf2 vocabulary)
RewriteRule ^vocab/([a-z0-9-]+)(/.*)?$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/main/ontology/vocab/$1.ttl [R=303,L]
# Scenario library and its individuals
RewriteRule ^data/library(/.*)?$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/main/data/abox/crgo-library.ttl [R=303,L]
# SHACL shapes and imports
RewriteRule ^shapes(/.*)?$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/main/shapes/crgo-shapes.ttl [R=303,L]
RewriteRule ^imports/cco-slice$ https://raw.githubusercontent.com/ITriskMgr/cyberriskguardian-ontology/main/imports/cco-slice.ttl [R=303,L]
